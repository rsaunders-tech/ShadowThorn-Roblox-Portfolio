					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Shared balance and catalog. Only server scripts may grant or spend credits.
-- Replace Id = 0 with IDs created under this experience before enabling Robux sales.
return {
	Title = "Shadow Racing",
	DataStoreName = "ShadowRacing_Player_v1",
	StudioPersistence = false,
	XPPerLevel = 200,
	StartingCredits = 250,
	DailyCredits = 350,
	DailyXP = 50,
	Race = { Laps = 3, Intermission = 18, Countdown = 4, MaxDuration = 210, Results = 10 },
	Vehicle = {
		MaxSpeed = 92, BoostSpeed = 130, Acceleration = 48, Brake = 75,
		TurnRate = 1.65, DriftTurnRate = 2.15, BoostDrain = 27, BoostRegen = 11,
		DriftCharge = 22, Width = 6, Length = 8,
	},
	Cosmetics = {
		{Key = "Shadow", Name = "Shadow Black", Slot = "Paint", Cost = 0, Level = 1, Color = {32, 33, 51}},
		{Key = "Voltage", Name = "Voltage Violet", Slot = "Paint", Cost = 400, Level = 1, Color = {136, 74, 255}},
		{Key = "Glacier", Name = "Glacier Blue", Slot = "Paint", Cost = 650, Level = 2, Color = {48, 213, 247}},
		{Key = "Inferno", Name = "Inferno Red", Slot = "Paint", Cost = 1100, Level = 3, Color = {255, 70, 92}},
		{Key = "Toxic", Name = "Toxic Lime", Slot = "Paint", Cost = 1600, Level = 5, Color = {168, 255, 72}},
		{Key = "Aurora", Name = "Aurora Pink", Slot = "Paint", Cost = 2500, Level = 7, Color = {255, 95, 214}},
		{Key = "Stock", Name = "Stock Alloy", Slot = "Wheels", Cost = 0, Level = 1, Color = {138, 146, 167}},
		{Key = "VioletRims", Name = "Violet Rims", Slot = "Wheels", Cost = 550, Level = 2, Color = {170, 99, 255}},
		{Key = "IceRims", Name = "Ice Rims", Slot = "Wheels", Cost = 950, Level = 3, Color = {95, 236, 255}},
		{Key = "GoldRims", Name = "Champion Gold", Slot = "Wheels", Cost = 2400, Level = 6, Color = {255, 196, 73}},
		{Key = "None", Name = "No Trail", Slot = "Trail", Cost = 0, Level = 1, Color = {154, 135, 255}},
		{Key = "VioletTrail", Name = "Violet Vapor", Slot = "Trail", Cost = 700, Level = 2, Color = {167, 103, 255}},
		{Key = "CyanTrail", Name = "Cyan Comet", Slot = "Trail", Cost = 1300, Level = 4, Color = {78, 236, 255}},
		{Key = "FlameTrail", Name = "Afterburn", Slot = "Trail", Cost = 2200, Level = 6, Color = {255, 128, 58}},
		{Key = "NightfallPaint", Name = "Nightfall Chrome", Slot = "Paint", Level = 1, Pass = "Nightfall", Color = {87, 44, 153}},
		{Key = "NightfallRims", Name = "Nightfall Halo", Slot = "Wheels", Level = 1, Pass = "Nightfall", Color = {202, 143, 255}},
		{Key = "NightfallTrail", Name = "Nightfall Rift", Slot = "Trail", Level = 1, Pass = "Nightfall", Color = {176, 82, 255}},
		{Key = "SolarPaint", Name = "Solar Gold", Slot = "Paint", Level = 1, Pass = "Solar", Color = {255, 180, 49}},
		{Key = "SolarRims", Name = "Solar Crown", Slot = "Wheels", Level = 1, Pass = "Solar", Color = {255, 223, 133}},
		{Key = "SolarTrail", Name = "Solar Flare", Slot = "Trail", Level = 1, Pass = "Solar", Color = {255, 144, 58}},
	},
	Passes = {
		{Key = "Nightfall", Id = 0, Name = "Nightfall Collection", Description = "Permanent exclusive paint, rims and trail. Cosmetic only.", Cosmetics = {"NightfallPaint", "NightfallRims", "NightfallTrail"}},
		{Key = "Solar", Id = 0, Name = "Solar Collection", Description = "Permanent golden paint, rims and trail. Cosmetic only.", Cosmetics = {"SolarPaint", "SolarRims", "SolarTrail"}},
	},
	Products = {
		{Key = "CreditsSmall", Id = 0, Name = "1,500 Garage Credits", Credits = 1500, Description = "Spend on earnable cosmetics. Level requirements still apply."},
		{Key = "CreditsLarge", Id = 0, Name = "4,500 Garage Credits", Credits = 4500, Description = "Spend on earnable cosmetics. Level requirements still apply."},
	},
}
]]></ProtectedString>
					<string name="ScriptGuid">{55D402CA-A5CB-4871-A1B0-9762EF1EBB18}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Config</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">4475d7b32a2b51bb0af0cdeb00000781</UniqueId>
