			<Item class="ModuleScript" referent="RBX000003A5">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Original environment. Generated scenes are also embedded in the standalone place.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local shared = ReplicatedStorage:WaitForChild("ShadowRacing")
local Track = require(shared:WaitForChild("Track"))
local Scene = require(shared:WaitForChild("WorldScene"))
local World = {}

local function vector(point)
	return Vector3.new(point[1], point[2], point[3])
end

local function frame(index)
	local point = vector(Track.Points[index])
	local nextPoint = vector(Track.Points[index % #Track.Points + 1])
	return CFrame.lookAt(point, nextPoint)
end

local function configureLighting()
	Lighting.ClockTime = 0.6
	Lighting.Brightness = 2.3
	Lighting.Ambient = Color3.fromRGB(88, 84, 115)
	Lighting.OutdoorAmbient = Color3.fromRGB(102, 109, 137)
	Lighting.FogColor = Color3.fromRGB(23, 26, 45)
	Lighting.FogStart = 450
	Lighting.FogEnd = 1200
	local bloom = Lighting:FindFirstChild("RacingBloom")
	if not bloom then
		bloom = Instance.new("BloomEffect")
		bloom.Name = "RacingBloom"
		bloom.Parent = Lighting
	end
	bloom.Intensity = 0.32
	bloom.Size = 22
	bloom.Threshold = 1.5
end

function World.build()
	configureLighting()
	local model = workspace:FindFirstChild("ShadowRacingWorld")
	if not model then
		model = Instance.new("Model")
		model.Name = "ShadowRacingWorld"
		model.Parent = workspace
		local groups = {}
		for _, name in ipairs({"Road", "Obstacles", "Scenery", "Lobby"}) do
			local folder = Instance.new("Folder")
			folder.Name = name
			folder.Parent = model
			groups[name] = folder
		end
		for _, spec in ipairs(Scene.Parts) do
			local part = Instance.new(spec.Spawn and "SpawnLocation" or "Part")
			part.Name = spec.Name
			part.Size = vector(spec.Size)
			part.CFrame = CFrame.new(vector(spec.Position)) * CFrame.Angles(
				math.rad(spec.Rotation[1]), math.rad(spec.Rotation[2]), math.rad(spec.Rotation[3]))
			part.Anchored = true
			part.CanCollide = spec.Collide ~= false
			part.CanQuery = spec.Collide ~= false
			part.CanTouch = false
			part.Color = Color3.fromRGB(spec.Color[1], spec.Color[2], spec.Color[3])
			part.Material = Enum.Material[spec.Material]
			part.Shape = Enum.PartType[spec.Shape or "Block"]
			part.Transparency = spec.Transparency or 0
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth
			if spec.Spawn then
				part.Neutral = true
				part.Duration = 0
			end
			part.Parent = groups[spec.Group] or groups.Scenery
			if spec.Text then
				local sign = Instance.new("BillboardGui")
				sign.Name = "Sign"
				sign.Size = UDim2.fromOffset(spec.TextWidth or 390, 64)
				sign.MaxDistance = 230
				sign.LightInfluence = 0
				sign.Parent = part
				local text = Instance.new("TextLabel")
				text.Size = UDim2.fromScale(1, 1)
				text.BackgroundTransparency = 1
				text.Font = Enum.Font.GothamBold
				text.TextSize = spec.TextSize or 23
				text.TextColor3 = part.Color
				text.TextStrokeTransparency = 0.4
				text.Text = spec.Text
				text.Parent = sign
			end
		end
	end
	return {
		Model = model,
		Spawn = CFrame.new(Track.Garage[1], Track.Garage[2], Track.Garage[3] - 27),
		Start = frame(1),
		Road = model:FindFirstChild("Road"),
		Obstacles = model:FindFirstChild("Obstacles"),
	}
end

function World.grid(index)
	local row = math.floor((index - 1) / 2)
	local lane = index % 2 == 1 and -8 or 8
	return frame(1) * CFrame.new(lane, 0, 14 + row * 13)
end

function World.checkpoint(index)
	return frame((index - 1) % #Track.Points + 1)
end

return World
]]></ProtectedString>
