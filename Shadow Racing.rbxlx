			<Item class="ModuleScript" referent="RBX000003A4">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Server-simulated arcade handling. Clients submit controls, never positions or rewards.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Rules = require(ReplicatedStorage.ShadowRacing.RacingRules)
local Vehicle = {}
Vehicle.__index = Vehicle
local NEUTRAL = {Throttle = 0, Steer = 0, Drift = false, Boost = false}

local function part(model, name, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Color, p.Material = color, material or Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.Parent = model
	return p
end

function Vehicle.new(player, config, track, world)
	local self = setmetatable({}, Vehicle)
	self.Player, self.Config, self.Track, self.World = player, config, track, world
	self.Input, self.LastInput = NEUTRAL, 0
	self.State = {Speed = 0, Yaw = 0, Vx = 0, Vz = 0, Boost = 100}
	local folder = Workspace:FindFirstChild("ShadowRacingVehicles")
	if not folder then folder = Instance.new("Folder"); folder.Name = "ShadowRacingVehicles"; folder.Parent = Workspace end
	local model = Instance.new("Model")
	model.Name = "ATV_" .. player.UserId
	model:SetAttribute("OwnerUserId", player.UserId)
	self.Model, self.Wheels, self.Painted, self.Rims, self.Trails = model, {}, {}, {}, {}
	local charcoal = Color3.fromRGB(23, 26, 36)
	local chassis = part(model, "Chassis", Vector3.new(4.4, 0.8, 6.5), CFrame.new(), charcoal)
	model.PrimaryPart = chassis
	self.Chassis = chassis
	for _, spec in {
		{"Nose", Vector3.new(4.1, 0.65, 1.8), CFrame.new(0, 0.65, -2.2)},
		{"RearFairing", Vector3.new(4.2, 0.6, 1.5), CFrame.new(0, 0.7, 2.1)},
		{"Tank", Vector3.new(2.1, 0.9, 1.9), CFrame.new(0, 0.65, -0.3)},
	} do
		table.insert(self.Painted, part(model, spec[1], spec[2], spec[3], Color3.fromRGB(104, 71, 255)))
	end
	for _, x in {-2.55, 2.55} do
		for _, z in {-2.05, 2.05} do
			local cf = CFrame.new(x, -0.1, z)
			local tire = part(model, "AllTerrainTire", Vector3.new(1.3, 2.6, 2.6), cf, Color3.fromRGB(12, 14, 20), Enum.Material.Rubber, Enum.PartType.Cylinder)
			local rim = part(model, "Rim", Vector3.new(1.34, 1.4, 1.4), cf, Color3.fromRGB(132, 148, 172), Enum.Material.Metal, Enum.PartType.Cylinder)
			table.insert(self.Wheels, tire)
			table.insert(self.Rims, rim)
		end
	end
	part(model, "Handlebar", Vector3.new(4.4, 0.22, 0.28), CFrame.new(0, 1.6, -1.3), charcoal, Enum.Material.Metal)
	for _, x in {-1.25, 1.25} do
		local light = part(model, "Headlight", Vector3.new(0.85, 0.3, 0.12), CFrame.new(x, 0.72, -3.13), Color3.fromRGB(133, 246, 255), Enum.Material.Neon)
		local spot = Instance.new("SpotLight")
		spot.Angle, spot.Range, spot.Brightness = 65, 45, 2
		spot.Color, spot.Face, spot.Parent = light.Color, Enum.NormalId.Front, light
		part(model, "TailLight", Vector3.new(0.7, 0.2, 0.12), CFrame.new(x, 0.7, 2.9), Color3.fromRGB(255, 69, 134), Enum.Material.Neon)
		local a, b = Instance.new("Attachment"), Instance.new("Attachment")
		a.Position, b.Position = Vector3.new(x, 0, 2.8), Vector3.new(x, 0.6, 2.8)
		a.Parent, b.Parent = chassis, chassis
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1, trail.Lifetime = a, b, 0.5
		trail.MinLength, trail.LightEmission, trail.Enabled = 0.1, 1, false
		trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)})
		trail.Parent = chassis
		table.insert(self.Trails, trail)
	end
	local seat = Instance.new("Seat")
	seat.Name, seat.Size, seat.CFrame = "DriverSeat", Vector3.new(2.2, 0.5, 2.4), CFrame.new(0, 1, 0.7)
	seat.Anchored, seat.CanCollide, seat.CanTouch, seat.CanQuery = true, false, false, false
	seat.Color, seat.Material, seat.Parent = charcoal, Enum.Material.SmoothPlastic, model
	self.Seat = seat
	model.Parent = folder
	self.GroundParams = RaycastParams.new()
	self.GroundParams.FilterType = Enum.RaycastFilterType.Include
	self.GroundParams.FilterDescendantsInstances = {world.Model:FindFirstChild("Road") or world.Model}
	self.WallParams = RaycastParams.new()
	self.WallParams.FilterType = Enum.RaycastFilterType.Include
	local obstacles = world.Model:FindFirstChild("Obstacles")
	self.WallParams.FilterDescendantsInstances = if obstacles then {obstacles} else {}
	self:reset(world.Start)
	return self
end

function Vehicle:apply(profile)
	self.TrailKey = "None"
	for _, cosmetic in self.Config.Cosmetics do
		if profile.Equipped[cosmetic.Slot] == cosmetic.Key then
			local c = cosmetic.Color or {138, 90, 255}
			local color = Color3.fromRGB(c[1], c[2], c[3])
			if cosmetic.Slot == "Paint" then
				for _, p in self.Painted do p.Color = color end
			elseif cosmetic.Slot == "Wheels" then
				for _, p in self.Rims do p.Color = color; p.Material = if cosmetic.Key == "Stock" then Enum.Material.Metal else Enum.Material.Neon end
			elseif cosmetic.Slot == "Trail" then
				self.TrailKey = cosmetic.Key
				for _, t in self.Trails do t.Color = ColorSequence.new(color) end
			end
		end
	end
end

function Vehicle:seatCharacter(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 8)
	if not humanoid or not root or not self.Model.Parent then return end
	humanoid.JumpPower, humanoid.JumpHeight = 0, 0
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	humanoid.AutoRotate = false
	for _, p in character:GetDescendants() do
		if p:IsA("BasePart") then p.CanCollide = false; p.Massless = true end
	end
	character:PivotTo(self.Seat.CFrame * CFrame.new(0, 2.4, 0))
	self.Seat:Sit(humanoid)
end

function Vehicle:setInput(throttle, steer, drift, boost)
	local input = Rules.input(throttle, steer, drift, boost)
	if input then self.Input, self.LastInput = input, os.clock() end
end

function Vehicle:reset(cf)
	self.Position = cf.Position + Vector3.new(0, 1.65, 0)
	self.State.Yaw = math.atan2(cf.LookVector.X, -cf.LookVector.Z)
	self.State.Speed, self.State.Vx, self.State.Vz = 0, 0, 0
	self.State.Boost = 75
	self.Input, self.VerticalSpeed = NEUTRAL, 0
	self.PreviousPosition = self.Position
	self.Model:PivotTo(CFrame.lookAt(self.Position, self.Position + cf.LookVector))
end

function Vehicle:step(dt, frozen)
	if not self.Model.Parent then return end
	self.PreviousPosition = self.Position
	local input = if os.clock() - self.LastInput < 0.65 and self.Seat.Occupant then self.Input else NEUTRAL
	if frozen then input = NEUTRAL; self.State.Speed, self.State.Vx, self.State.Vz = 0, 0, 0 end
	local roadDistance = Rules.roadDistance(self.Track.Points, self.Position.X, self.Position.Z)
	local dx, dz = Rules.drive(self.State, input, self.Config.Vehicle, dt, roadDistance < self.Track.Width * 0.57)
	local movement = Vector3.new(dx, 0, dz)
	if movement.Magnitude > 0.01 then
		local wall = Workspace:Raycast(self.Position, movement.Unit * (movement.Magnitude + 3), self.WallParams)
		if wall then
			movement *= math.max(0, wall.Distance - 3) / (movement.Magnitude + 3)
			self.State.Speed *= 0.4
			self.State.Vx, self.State.Vz = 0, 0
		end
	end
	local target = self.Position + movement
	local ground = Workspace:Raycast(target + Vector3.new(0, 5, 0), Vector3.new(0, -50, 0), self.GroundParams)
	local floorY = if ground then ground.Position.Y + 1.65 else -100
	self.VerticalSpeed = math.max(-90, self.VerticalSpeed - 100 * dt)
	local y = math.max(floorY, target.Y + self.VerticalSpeed * dt)
	if y == floorY then self.VerticalSpeed = 0 end
	self.Position = Vector3.new(target.X, y, target.Z)
	local direction = Vector3.new(math.sin(self.State.Yaw), 0, -math.cos(self.State.Yaw))
	self.Model:PivotTo(CFrame.lookAt(self.Position, self.Position + direction))
	for _, trail in self.Trails do trail.Enabled = self.TrailKey ~= "None" and self.State.Speed > 20 end
	self.Model:SetAttribute("Drifting", self.State.Drifting)
	self.Model:SetAttribute("Boosting", self.State.Boosting)
end

function Vehicle:snapshot()
	return {Speed = math.abs(self.State.Speed), Boost = self.State.Boost, Drifting = self.State.Drifting == true, Boosting = self.State.Boosting == true}
end

function Vehicle:destroy()
	if self.Model then self.Model:Destroy() end
end

return Vehicle
]]></ProtectedString>
					<string name="ScriptGuid">{CAC918E5-2D24-4CDB-82E1-51C22C5D793C}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Vehicle</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
