					<ProtectedString name="Source"><![CDATA[-- Server-owned progression and atomic purchases. Instantiate exactly once.
-- Receipt IDs and their grants live in the same session-locked player record.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Economy = {}
local MAX_STAT, LEASE_SECONDS, AUTOSAVE_SECONDS = 1000000000000, 180, 45
local MAX_RECEIPTS, PROMPT_RECEIPT_LIMIT = 12000, 10000
local DEFAULT_EQUIPPED = {Paint = "Shadow", Wheels = "Stock", Trail = "None"}

local function integer(value, fallback, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
	return math.clamp(math.floor(value), 0, maximum or MAX_STAT)
end

local function validId(value)
	return type(value) == "number" and value > 0 and value < math.huge and value == math.floor(value)
end

local function copy(source)
	if type(source) ~= "table" then return source end
	local result = {}
	for key, value in pairs(source) do result[key] = copy(value) end
	return result
end

local function retry(callback)
	local lastError
	for attempt = 1, 3 do
		local ok, result = pcall(callback)
		if ok then return true, result end
		lastError = result
		if attempt < 3 then task.wait(2 ^ (attempt - 1) + math.random() * 0.5) end
	end
	warn("Shadow Racing DataStore request failed:", lastError)
	return false, nil
end

function Economy.new(config, onChanged)
	local self = {}
	local states, cosmetics, products, productsById, passes, passesById = {}, {}, {}, {}, {}, {}
	local studioSession = RunService:IsStudio() and config.StudioPersistence ~= true
	local store = not studioSession and DataStoreService:GetDataStore(config.DataStoreName) or nil
	local closing = false
	local passConnection
	local xpPerLevel = config.XPPerLevel or 200
	for _, item in ipairs(config.Cosmetics) do
		assert(not cosmetics[item.Key] and DEFAULT_EQUIPPED[item.Slot], "Invalid cosmetic catalog")
		assert(item.Pass or integer(item.Cost, -1) == item.Cost, "Invalid cosmetic cost")
		cosmetics[item.Key] = item
	end
	for slot, key in pairs(DEFAULT_EQUIPPED) do
		assert(cosmetics[key] and cosmetics[key].Slot == slot and cosmetics[key].Cost == 0, "Missing starter cosmetic")
	end
	for _, item in ipairs(config.Products) do
		assert(integer(item.Credits, 0) == item.Credits and item.Credits > 0, "Invalid credit product")
		products[item.Key] = item
		if validId(item.Id) then
			assert(not productsById[item.Id], "Duplicate developer product ID")
			productsById[item.Id] = item
		end
	end
	for _, item in ipairs(config.Passes) do
		passes[item.Key] = item
		if validId(item.Id) then
			assert(not passesById[item.Id], "Duplicate pass ID")
			passesById[item.Id] = item
		end
	end

	local function profileFrom(raw)
		raw = type(raw) == "table" and raw or {}
		local owned = {Shadow = true, Stock = true, None = true}
		if type(raw.Owned) == "table" then
			for key, item in pairs(cosmetics) do
				if not item.Pass and raw.Owned[key] == true then owned[key] = true end
			end
		end
		local equipped = copy(DEFAULT_EQUIPPED)
		if type(raw.Equipped) == "table" then
			for slot in pairs(equipped) do
				local key = raw.Equipped[slot]
				if owned[key] and cosmetics[key] and cosmetics[key].Slot == slot then equipped[slot] = key end
			end
		end
		local xp = integer(raw.XP, 0)
		return {
			Credits = integer(raw.Credits, config.StartingCredits or 250), XP = xp,
			Level = 1 + math.floor(xp / xpPerLevel), Wins = integer(raw.Wins, 0), Races = integer(raw.Races, 0),
			BestLap = type(raw.BestLap) == "number" and raw.BestLap >= 0 and raw.BestLap < math.huge and raw.BestLap or 0,
			DailyAt = integer(raw.DailyAt, 0), Owned = owned, Equipped = equipped,
		}
	end

	local function storedProfile(profile)
		local result = copy(profile)
		result.Level = nil
		for key, item in pairs(cosmetics) do if item.Pass then result.Owned[key] = nil end end
		return result
	end

	local function decode(raw)
		if raw == nil then return {SchemaVersion = 1, Profile = storedProfile(profileFrom(nil)), Receipts = {}} end
		if type(raw) ~= "table" or raw.SchemaVersion ~= 1 or type(raw.Profile) ~= "table" or type(raw.Receipts) ~= "table" then return nil end
		for _, key in ipairs({"Credits", "XP", "Wins", "Races", "DailyAt"}) do
			local value = raw.Profile[key]
			if integer(value, -1) ~= value then return nil end
		end
		local lap = raw.Profile.BestLap
		if type(lap) ~= "number" or lap ~= lap or lap < 0 or lap > MAX_STAT then return nil end
		if type(raw.Profile.Owned) ~= "table" or type(raw.Profile.Equipped) ~= "table" then return nil end
		for id, granted in pairs(raw.Receipts) do
			if type(id) ~= "string" or #id == 0 or #id > 200 or granted ~= true then return nil end
		end
		if raw.Session ~= nil and (type(raw.Session) ~= "table" or type(raw.Session.Id) ~= "string"
			or integer(raw.Session.ExpiresAt, -1) ~= raw.Session.ExpiresAt) then return nil end
		return raw
	end

	local function healthy(state)
		return state.Ready and state.Healthy and not state.Removing and not state.Released
			and (studioSession or os.time() < state.LeaseUntil)
	end

	local function changed(player, message)
		if onChanged then
			local ok, err = pcall(onChanged, player, message)
			if not ok then warn("Shadow Racing profile notification failed:", err) end
		end
	end

	-- Serialize every mutation across yielding DataStore calls. Callbacks run outside this mutex.
	local function locked(player, callback, allowRemoving)
		local state = states[player]
		if not state or not state.Ready then return false, "Your profile is not ready. Rejoin to try again." end
		while state.Busy do
			task.wait()
			if states[player] ~= state then return false, "Your session has ended." end
		end
		if states[player] ~= state or (state.Removing and not allowRemoving) then return false, "Your session is closing." end
		state.Busy = true
		local result = table.pack(pcall(callback, state))
		state.Busy = false
		local notify = state.Notify
		state.Notify = false
		if notify and states[player] == state then changed(player) end
		if not result[1] then
			warn("Shadow Racing economy operation failed:", result[2])
			return false, "The server could not complete that action."
		end
		return table.unpack(result, 2, result.n)
	end

	local function saveLocked(state, release)
		if state.Released then return true end
		if state.SessionLost then return false end
		if studioSession then state.Released = release == true; return true end
		local profile, receipts = storedProfile(state.Profile), copy(state.Receipts)
		-- Preferences grant no ownership, but survive a pass ownership lookup on rejoin.
		profile.Equipped = copy(state.PreferredEquipped)
		local declined = false
		local ok, saved = retry(function()
			return store:UpdateAsync(state.Key, function(raw)
				declined = false
				local old = decode(raw)
				if not old or not old.Session or old.Session.Id ~= state.SessionId then declined = true; return nil end
				for id in pairs(old.Receipts) do
					if not receipts[id] then declined = true; return nil end
				end
				return {
					SchemaVersion = 1, Profile = profile, Receipts = receipts, LastSave = os.time(),
					Session = not release and {Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS} or nil,
				}, {state.UserId}
			end)
		end)
		if not ok or not saved or declined then
			-- Preserve the candidate after an ambiguous commit, and freeze all mutations until recovery.
			state.Healthy, state.SessionLost, state.Notify = false, state.SessionLost or declined, true
			return false
		end
		state.PersistedReceipts = copy(receipts)
		if not state.Healthy then state.Notify = true end
		state.Healthy, state.Released = true, release == true
		if not release then state.LeaseUntil = saved.Session.ExpiresAt end
		return true
	end

	local function receiptHandler(receipt)
		local pending = Enum.ProductPurchaseDecision.NotProcessedYet
		if studioSession or type(receipt) ~= "table" or type(receipt.PlayerId) ~= "number" then return pending end
		local item, id = productsById[receipt.ProductId], receipt.PurchaseId
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not item or not player or type(id) ~= "string" or #id == 0 or #id > 200 then return pending end
		local granted = locked(player, function(state)
			if not healthy(state) then return false end
			if state.PersistedReceipts[id] then return true end
			if not state.Receipts[id] then
				if state.ReceiptCount >= MAX_RECEIPTS or state.Profile.Credits > MAX_STAT - item.Credits then return false end
				state.Profile.Credits += item.Credits
				state.Receipts[id], state.ReceiptCount, state.Notify = true, state.ReceiptCount + 1, true
			end
			return saveLocked(state, false)
		end)
		return granted and Enum.ProductPurchaseDecision.PurchaseGranted or pending
	end

	function self:load(player)
		if closing then return false end
		if states[player] then return healthy(states[player]) end
		local state = {
			UserId = player.UserId, Key = "Player_" .. tostring(player.UserId),
			SessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false),
			Ready = false, Busy = false, Healthy = true, Removing = false, Released = false,
			Profile = profileFrom(nil), PassOwnership = {}, Receipts = {}, PersistedReceipts = {},
			ReceiptCount = 0, LeaseUntil = 0, LastPrompt = -math.huge,
			PreferredEquipped = copy(DEFAULT_EQUIPPED),
		}
		states[player] = state
		if not studioSession then
			local ok, loaded = retry(function()
				return store:UpdateAsync(state.Key, function(raw)
					local old = decode(raw)
					if not old then return nil end
					local session = old.Session
					if session and session.Id ~= state.SessionId and session.ExpiresAt > os.time() then return nil end
					return {SchemaVersion = 1, Profile = old.Profile, Receipts = old.Receipts,
						Session = {Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS}, LastSave = old.LastSave}, {player.UserId}
				end)
			end)
			if not ok or not loaded or not loaded.Session or loaded.Session.Id ~= state.SessionId then
				if states[player] == state then states[player] = nil end
				warn("Shadow Racing could not acquire data for user", player.UserId)
				return false
			end
			state.Profile = profileFrom(loaded.Profile)
			for slot, key in pairs(loaded.Profile.Equipped) do
				if cosmetics[key] and cosmetics[key].Slot == slot then state.PreferredEquipped[slot] = key end
			end
			state.Receipts, state.PersistedReceipts = copy(loaded.Receipts), copy(loaded.Receipts)
			for _ in pairs(state.Receipts) do state.ReceiptCount += 1 end
			state.LeaseUntil = loaded.Session.ExpiresAt
		end
		state.Ready = true
		if state.Removing or closing or states[player] ~= state or player.Parent ~= Players then
			saveLocked(state, true)
			if states[player] == state then states[player] = nil end
			return false
		end
		changed(player)
		task.spawn(function() self:refreshPasses(player) end)
		return true
	end

	function self:snapshot(player)
		local state = states[player]
		if not state or not state.Ready then return nil end
		local result = copy(state.Profile)
		result.Ready, result.SessionOnly, result.Passes = healthy(state), studioSession, copy(state.PassOwnership)
		result.DailyNextAt = state.Profile.DailyAt + 86400
		result.DailyReady = healthy(state) and (state.Profile.DailyAt == 0 or os.time() >= result.DailyNextAt)
		return result
	end

	function self:get(player) return self:snapshot(player) end

	function self:award(player, credits, xp, isWin, bestLap)
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Rewards are paused." end
			local profile = state.Profile
			profile.Credits = math.min(MAX_STAT, profile.Credits + integer(credits, 0))
			profile.XP = math.min(MAX_STAT, profile.XP + integer(xp, 0))
			profile.Level = 1 + math.floor(profile.XP / xpPerLevel)
			profile.Races = math.min(MAX_STAT, profile.Races + 1)
			if isWin == true then profile.Wins = math.min(MAX_STAT, profile.Wins + 1) end
			if type(bestLap) == "number" and bestLap > 0 and bestLap < math.huge
				and (profile.BestLap == 0 or bestLap < profile.BestLap) then profile.BestLap = bestLap end
			state.Notify = true
			return true
		end)
	end

	function self:buy(player, key)
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Try again shortly." end
			local item = type(key) == "string" and cosmetics[key]
			if not item then return false, "Unknown cosmetic." end
			if state.Profile.Owned[key] then return true, "Already in your garage." end
			if item.Pass then return false, "This item belongs to the " .. (passes[item.Pass] and passes[item.Pass].Name or item.Pass) .. "." end
			if state.Profile.Level < (item.Level or 1) then return false, "Reach level " .. tostring(item.Level) .. " to unlock this item." end
			if state.Profile.Credits < item.Cost then return false, "Earn more garage credits by racing." end
			state.Profile.Credits -= item.Cost
			state.Profile.Owned[key], state.Notify = true, true
			return true, item.Name .. " unlocked!"
		end)
	end

	function self:equip(player, key)
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Try again shortly." end
			local item = type(key) == "string" and cosmetics[key]
			if not item then return false, "Unknown cosmetic." end
			if not state.Profile.Owned[key] then return false, "Unlock this item before equipping it." end
			state.Profile.Equipped[item.Slot], state.PreferredEquipped[item.Slot], state.Notify = key, key, true
			return true, item.Name .. " equipped!"
		end)
	end

	function self:claimDaily(player)
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Try again shortly." end
			local profile = state.Profile
			if profile.DailyAt > 0 and os.time() < profile.DailyAt + 86400 then return false, "Your next daily reward is not ready yet." end
			profile.DailyAt = os.time()
			profile.Credits = math.min(MAX_STAT, profile.Credits + (config.DailyCredits or 350))
			profile.XP = math.min(MAX_STAT, profile.XP + (config.DailyXP or 50))
			profile.Level = 1 + math.floor(profile.XP / xpPerLevel)
			state.Notify = true
			if not saveLocked(state, false) then return false, "Your reward is pending while saving recovers." end
			return true, "+" .. tostring(config.DailyCredits or 350) .. " daily garage credits!"
		end)
	end

	function self:prompt(player, kind, key)
		return locked(player, function(state)
			if not healthy(state) then return false, "Your saved profile must be available before purchasing." end
			if RunService:IsStudio() then return false, "Robux purchases are disabled in Studio. Use a published test experience." end
			local item = type(key) == "string" and (kind == "Product" and products[key] or kind == "Pass" and passes[key])
			if not item or not validId(item.Id) then return false, "Robux purchases are not configured yet." end
			if kind == "Pass" and state.PassOwnership[key] then return false, "You already own this collection." end
			if kind == "Product" and (state.ReceiptCount >= PROMPT_RECEIPT_LIMIT or state.Profile.Credits > MAX_STAT - item.Credits) then
				return false, "Credit purchases are temporarily unavailable for this profile."
			end
			if os.clock() - state.LastPrompt < 3 then return false, "Please wait before opening another purchase." end
			state.LastPrompt = os.clock()
			local ok = pcall(function()
				if kind == "Product" then MarketplaceService:PromptProductPurchase(player, item.Id)
				else MarketplaceService:PromptGamePassPurchase(player, item.Id) end
			end)
			return ok, ok and "Confirm the price in Roblox's purchase window." or "The purchase window is unavailable. Try again."
		end)
	end

	function self:refreshPasses(player)
		if RunService:IsStudio() or not states[player] then return end
		local ownership = {}
		for key, item in pairs(passes) do
			if validId(item.Id) then
				local ok, owned = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, item.Id)
				if ok then ownership[key] = owned == true end
			end
		end
		locked(player, function(state)
			if not healthy(state) then return false end
			for key, owned in pairs(ownership) do
				if owned or state.PassOwnership[key] ~= true then state.PassOwnership[key] = owned end
			end
			for key, item in pairs(cosmetics) do
				if item.Pass then state.Profile.Owned[key] = state.PassOwnership[item.Pass] == true or nil end
			end
			for slot, key in pairs(state.PreferredEquipped) do
				state.Profile.Equipped[slot] = state.Profile.Owned[key] and key or DEFAULT_EQUIPPED[slot]
			end
			state.Notify = true
			return true
		end)
	end

	function self:save(player, release)
		local state = states[player]
		if not state then return false end
		if release then state.Removing = true end
		return locked(player, function(current) return saveLocked(current, release == true) end, true)
	end

	function self:remove(player)
		local state = states[player]
		if not state then return end
		state.Removing = true
		if state.Ready then self:save(player, true) end
		while state.Busy do task.wait() end
		if states[player] == state then states[player] = nil end
	end

	function self:close()
		closing = true
		local pending = 0
		for player, state in pairs(states) do
			state.Removing = true
			if state.Ready and not state.Released then
				pending += 1
				task.spawn(function() self:save(player, true); pending -= 1 end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do task.wait(0.05) end
		if passConnection then passConnection:Disconnect() end
	end

	-- One receipt owner for this experience. Merge future products in this catalog.
	MarketplaceService.ProcessReceipt = receiptHandler
	passConnection = MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, purchased)
		if purchased and passesById[id] then self:refreshPasses(player) end
	end)
	task.spawn(function()
		while not closing do
			task.wait(AUTOSAVE_SECONDS)
			if closing then break end
			for player, state in pairs(states) do
				if state.Ready and not state.Removing and not state.Released and not state.SessionLost then
					task.spawn(function() self:save(player, false) end)
				end
			end
		end
	end)
	return self
end

return Economy
]]></ProtectedString>
					<string name="ScriptGuid">{E9D2D540-E4D8-487B-95BF-005085B408A2}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Economy</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">4475d7b32a2b51bb0af0cdeb0000078c</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX000003A2">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local shared = ReplicatedStorage:WaitForChild("ShadowRacing")
local Config, Track = require(shared.Config), require(shared.Track)
local Economy, Vehicle, World = require(script.Parent.Economy), require(script.Parent.Vehicle), require(script.Parent.World)
local RaceService = require(script.Parent.RaceService)
local remotes = Instance.new("Folder")
remotes.Name, remotes.Parent = "Remotes", shared
local function remote(name)
	local event = Instance.new("RemoteEvent")
	event.Name, event.Parent = name, remotes
	return event
end
local inputEvent, actionEvent, stateEvent, notifyEvent = remote("Input"), remote("Action"), remote("State"), remote("Notify")
local vehicles, sessions, connections = {}, {}, {}
local closing = false
local function notify(player, text)
	if player.Parent == Players and type(text) == "string" then notifyEvent:FireClient(player, text) end
end
local economy
economy = Economy.new(Config, function(player, text)
	if vehicles[player] then
		local profile = economy and economy:snapshot(player)
		if profile then vehicles[player]:apply(profile) end
	end
	if text then notify(player, text) end
end)
local world = World.build()
local races = RaceService.new(Config, Track, World, vehicles, economy, notify)

local function state(player)
	local car = vehicles[player]
	stateEvent:FireClient(player, {Profile = economy:snapshot(player), Race = races:snapshot(player, os.clock()),
		Vehicle = car and car:snapshot() or {Speed = 0, Boost = 0}})
end

local function characterAdded(player, character)
	local car = vehicles[player]
	if not car then return end
	task.delay(0.3, function()
		if player.Character == character and vehicles[player] == car then car:seatCharacter(character) end
	end)
end

local function addPlayer(player)
	if closing or sessions[player] then return end
	sessions[player] = {InputAt = 0, ActionAt = 0, ResetAt = 0, SeatAt = 0}
	local ok = economy:load(player)
	if not ok or player.Parent ~= Players or closing then
		if player.Parent == Players then player:Kick("Your garage could not load safely. Please rejoin in a moment.") end
		economy:remove(player)
		return
	end
	local car = Vehicle.new(player, Config, Track, world)
	vehicles[player] = car
	car:reset(world.Spawn)
	car:apply(economy:snapshot(player))
	races:add(player)
	connections[player] = player.CharacterAdded:Connect(function(character) characterAdded(player, character) end)
	if player.Character then characterAdded(player, player.Character) end
	notify(player, "Welcome to Shadow Racing! You’re queued for the next race.")
	state(player)
end

inputEvent.OnServerEvent:Connect(function(player, throttle, steer, drift, boost)
	local session, car = sessions[player], vehicles[player]
	local now = os.clock()
	if not session or not car or now - session.InputAt < 0.04 then return end
	session.InputAt = now
	car:setInput(throttle, steer, drift, boost)
end)

actionEvent.OnServerEvent:Connect(function(player, action, key)
	local session = sessions[player]
	if not session or not vehicles[player] or type(action) ~= "string" then return end
	if key ~= nil and (type(key) ~= "string" or #key > 64) then return end
	local now = os.clock()
	if now - session.ActionAt < 0.2 then return end
	session.ActionAt = now
	local message
	if action == "Ready" then state(player)
	elseif action == "Join" then races:toggle(player)
	elseif action == "Reset" then
		if now - session.ResetAt < 3 then return end
		session.ResetAt = now
		local cf = races:reset(player)
		if cf then vehicles[player]:reset(cf); notify(player, if races.Phase == "Racing" then "Back on track · +2 seconds" else "Ready to ride.") end
	elseif action == "Buy" and key then local _, text = economy:buy(player, key); message = text
	elseif action == "Equip" and key then local _, text = economy:equip(player, key); message = text
	elseif action == "Daily" then local _, text = economy:claimDaily(player); message = text
	elseif action == "PurchasePass" and key then local _, text = economy:prompt(player, "Pass", key); message = text
	elseif action == "PurchaseProduct" and key then local _, text = economy:prompt(player, "Product", key); message = text
	end
	if message then notify(player, message) end
	if vehicles[player] then vehicles[player]:apply(economy:snapshot(player)); state(player) end
end)

Players.PlayerAdded:Connect(function(player) task.spawn(addPlayer, player) end)
Players.PlayerRemoving:Connect(function(player)
	races:remove(player)
	if connections[player] then connections[player]:Disconnect(); connections[player] = nil end
	if vehicles[player] then vehicles[player]:destroy(); vehicles[player] = nil end
	sessions[player] = nil
	economy:remove(player)
end)
for _, player in Players:GetPlayers() do task.spawn(addPlayer, player) end

local accumulator, broadcast, maintenance = 0, 0, 0
RunService.Heartbeat:Connect(function(delta)
	if closing then return end
	accumulator += math.min(delta, 0.15)
	while accumulator >= 1 / 30 do
		accumulator -= 1 / 30
		for player, car in vehicles do car:step(1 / 30, races:frozen(player)) end
		races:step(os.clock())
	end
	broadcast += delta
	if broadcast >= 0.2 then
		broadcast = 0
		for player in vehicles do if player.Parent == Players then state(player) end end
	end
	maintenance += delta
	if maintenance >= 1 then
		maintenance = 0
		for player, car in vehicles do
			local session = sessions[player]
			if car.Position.Y < -10 then
				local cf = races:reset(player)
				if cf then car:reset(cf) end
			end
			if session and not car.Seat.Occupant and player.Character and os.clock() - session.SeatAt > 2 then
				session.SeatAt = os.clock()
				task.spawn(function() car:seatCharacter(player.Character) end)
			end
		end
	end
end)

game:BindToClose(function() closing = true; economy:close() end)
print("Shadow Racing ready · server-authoritative arcade ATV racing")
]]></ProtectedString>
