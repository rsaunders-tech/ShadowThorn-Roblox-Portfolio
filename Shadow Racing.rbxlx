			<Item class="ModuleScript" referent="RBX0000039C">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Pure rules shared with the headless race regression tests.
local Rules = {}

function Rules.finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Rules.input(throttle, steer, drift, boost)
	if not Rules.finite(throttle) or not Rules.finite(steer) then return nil end
	if type(drift) ~= "boolean" or type(boost) ~= "boolean" then return nil end
	return {Throttle = math.clamp(throttle, -1, 1), Steer = math.clamp(steer, -1, 1), Drift = drift, Boost = boost}
end

function Rules.segmentDistance(x, z, a, b)
	local dx, dz = b[1] - a[1], b[3] - a[3]
	local length = dx * dx + dz * dz
	local t = if length > 0 then math.clamp(((x - a[1]) * dx + (z - a[3]) * dz) / length, 0, 1) else 0
	return math.sqrt((x - a[1] - dx * t)^2 + (z - a[3] - dz * t)^2)
end

function Rules.roadDistance(points, x, z)
	local distance = math.huge
	for index, a in points do
		distance = math.min(distance, Rules.segmentDistance(x, z, a, points[index % #points + 1]))
	end
	return distance
end

function Rules.drive(state, input, cfg, dt, onRoad)
	dt = math.clamp(dt, 0, 0.05)
	local drifting = input.Drift and math.abs(state.Speed) > 28 and math.abs(input.Steer) > 0.15
	local boosting = input.Boost and input.Throttle > 0 and state.Boost > 1 and state.Speed > 5
	local maxSpeed = if boosting then cfg.BoostSpeed else cfg.MaxSpeed
	if not onRoad then maxSpeed *= 0.56 end
	local target = input.Throttle * (if input.Throttle < 0 then 25 else maxSpeed)
	local acceleration = if input.Throttle == 0 or state.Speed * input.Throttle < 0 then cfg.Brake else cfg.Acceleration
	state.Speed += math.clamp(target - state.Speed, -acceleration * dt, acceleration * dt)
	local steeringPower = math.clamp(math.abs(state.Speed) / 24, 0, 1) * (if state.Speed < 0 then -1 else 1)
	state.Yaw += input.Steer * (if drifting then cfg.DriftTurnRate else cfg.TurnRate) * steeringPower * dt
	local blend = 1 - math.exp(-(if drifting then 3.8 else 11) * dt)
	state.Vx += (math.sin(state.Yaw) * state.Speed - state.Vx) * blend
	state.Vz += (-math.cos(state.Yaw) * state.Speed - state.Vz) * blend
	state.Boost = math.clamp(state.Boost + (if boosting then -cfg.BoostDrain elseif drifting then cfg.DriftCharge else cfg.BoostRegen) * dt, 0, 100)
	state.Drifting, state.Boosting = drifting, boosting
	return state.Vx * dt, state.Vz * dt
end

function Rules.newProgress(now)
	return {Next = 2, Passed = 0, LapsCompleted = 0, LapStarted = now, Penalty = 0, LapPenalty = 0, BestLap = 0, Finished = false}
end

function Rules.crossed(from, to, point, nextPoint, radius)
	-- Cross the gate's plane going forward; proximity alone never completes a lap.
	local nx, nz = nextPoint[1] - point[1], nextPoint[3] - point[3]
	local before = (from[1] - point[1]) * nx + (from[3] - point[3]) * nz
	local after = (to[1] - point[1]) * nx + (to[3] - point[3]) * nz
	if before >= 0 or after < 0 then return false end
	local t = -before / (after - before)
	local x = from[1] + (to[1] - from[1]) * t - point[1]
	local z = from[3] + (to[3] - from[3]) * t - point[3]
	local y = from[2] + (to[2] - from[2]) * t
	return x * x + z * z <= radius * radius and math.abs(y - point[2]) <= 15
end

function Rules.checkpoint(progress, index, count, laps, now)
	if progress.Finished or index ~= progress.Next then return false end
	progress.Passed += 1
	progress.Next = index % count + 1
	if index == 1 then
		local lap = now - progress.LapStarted + progress.LapPenalty
		progress.BestLap = if progress.BestLap == 0 then lap else math.min(progress.BestLap, lap)
		progress.LapsCompleted += 1
		progress.LapStarted, progress.LapPenalty = now, 0
		progress.Finished = progress.LapsCompleted >= laps
	end
	return true
end

return Rules
]]></ProtectedString>
