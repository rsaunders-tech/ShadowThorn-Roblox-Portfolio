672145626128, 72.28620817713373}, ["Position"] = {-476.89571072130553, 35.53068858250452, 255.17875559318503}, ["Color"] = {29, 31, 45}, ["Material"] = "Slate", ["Rotation"] = {0, -2.1784446558652135, 0.989248643499856}, ["Group"] = "Scenery"}, {["Name"] = "Horizon monolith 10", ["Size"] = {95.66364962815665, 121.30023929995983, 56.74258805169888}, ["Position"] = {-542.518600356046, 48.520095719983935, 142.5536622260219}, ["Color"] = {29, 31, 45}, ["Material"] = "Slate", ["Rotation"] = {0, 12.121686088127369, -5.679814112324491}, ["Group"] = "Scenery"}, {["Name"] = "Horizon monolith 11", ["Size"] = {62.10783053727083, 114.84912084104951, 81.76449847439464}, ["Position"] = {-565.0, 45.93964833641981, 20.000000000000245}, ["Color"] = {29, 31, 45}, ["Material"] = "Slate", ["Rotation"] = {0, 9.432279875412917, -2.680279868363611}, ["Group"] = "Scenery"}, {["Name"] = "Horizon monolith 12", ["Size"] = {90.49511766589606, 112.86418116329146, 58.0323198826524}, ["Position"] = {-542.5186003560461, 45.145672465316586, -102.55366222602179}, ["Color"] = {29, 31, 45}, ["Material"] = "Slate", ["Rotation"] = {0, -15.897244654658627, 2.761093932614079}, ["Group"] = "Scenery"}, {["Name"] = "Horizon monolith 13", ["Size"] = {82.42594170665711, 98.80538498151569, 62.63712127096023}, ["Position"] = {-476.8957107213056, 39.52215399260628, -215.17875559318495}, ["Color"] = {29, 31, 45}, ["Material"] = "Slate", ["Rotation"] = {0, 2.8879099009664486, 5.476345234525606}, ["Group"] = "Scenery"}, {["Name"] = "Horizon monolith 14", ["Size"] = {101.56120761055132, 99.41702527260959, 72.68032878699688}, ["Position"] = {-373.44770733963327, 39.76681010904384, -308.7510648441023}, ["Color"] = {29, 31, 45}, ["Material"] = "Slate", ["Rotation"] = {0, -16.212769142847584, -5.247413739762669}, ["Group"] = "Scenery"}, {["Name"] = "Horizon monolith 15", ["Size"] = {77.86771946996636, 144.33082903854717, 79.70655284141421}, ["Position"] = {-240.55533221604736, 57.73233161541887, -375.68991797921535}, ["C