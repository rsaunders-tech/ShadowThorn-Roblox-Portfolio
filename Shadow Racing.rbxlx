			<Item class="ModuleScript" referent="RBX000003A3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage.ShadowRacing.RacingRules)
local RaceService = {}
RaceService.__index = RaceService

function RaceService.new(config, track, world, vehicles, economy, notify)
	return setmetatable({Config = config, Track = track, World = world, Vehicles = vehicles, Economy = economy,
		Notify = notify, Queue = {}, Entries = {}, Results = {}, Phase = "Lobby", Deadline = os.clock() + config.Race.Intermission}, RaceService)
end

function RaceService:add(player)
	self.Queue[player] = true
end

function RaceService:remove(player)
	self.Queue[player], self.Entries[player] = nil, nil
end

function RaceService:toggle(player)
	if self.Entries[player] and (self.Phase == "Countdown" or self.Phase == "Racing") then
		self.Notify(player, "Finish this race first. You can leave the next grid in the pit break.")
		return
	end
	self.Queue[player] = not self.Queue[player]
	self.Notify(player, if self.Queue[player] then "On the grid for the next race!" else "Free ride enabled. Join the grid whenever you’re ready.")
end

function RaceService:frozen(player)
	local entry = self.Entries[player]
	return entry ~= nil and (self.Phase == "Countdown" or self.Phase == "Results" or entry.Progress.Finished)
end

function RaceService:reset(player)
	local entry = self.Entries[player]
	if entry and self.Phase == "Racing" and not entry.Progress.Finished then
		entry.Progress.Penalty += 2
		entry.Progress.LapPenalty += 2
		local last = (entry.Progress.Next - 2) % #self.Track.Points + 1
		return self.World.checkpoint(last)
	end
	if entry and (self.Phase == "Countdown" or self.Phase == "Results" or entry.Progress.Finished) then return nil end
	return self.World.Start
end

function RaceService:startGrid(now)
	local players = {}
	for player, queued in self.Queue do
		local profile = self.Economy:get(player)
		if queued and self.Vehicles[player] and profile and profile.Ready then table.insert(players, player) end
	end
	table.sort(players, function(a, b) return a.UserId < b.UserId end)
	if #players == 0 then self.Deadline = now + self.Config.Race.Intermission; return end
	self.Entries, self.Results = {}, {}
	for index, player in players do
		if index > 12 then break end
		local progress = Rules.newProgress(now)
		self.Entries[player] = {Player = player, Progress = progress}
		self.Vehicles[player]:reset(self.World.grid(index))
		self.Notify(player, "Obsidian Run · " .. self.Config.Race.Laps .. " laps. Drift to charge boost!")
	end
	self.Phase, self.Deadline = "Countdown", now + self.Config.Race.Countdown
end

function RaceService:finishRace(now)
	if self.Phase ~= "Racing" then return end
	-- Settlement can wait for a profile save. Transition before any yielding work.
	self.Phase, self.Deadline = "Results", now + self.Config.Race.Results
	local results = {}
	for player, entry in self.Entries do
		table.insert(results, {Name = player.DisplayName, UserId = player.UserId,
			Time = entry.Time or 0, Finished = entry.Progress.Finished, Passed = entry.Progress.Passed, Player = player})
	end
	table.sort(results, function(a, b)
		if a.Finished ~= b.Finished then return a.Finished end
		if a.Finished then return a.Time < b.Time end
		return a.Passed > b.Passed
	end)
	self.Results = {}
	for index, result in results do
		local entry = self.Entries[result.Player]
		entry.Place = index
		local credits, xp = 0, 0
		if result.Finished then
			credits, xp = 250 + math.max(0, 4 - index) * 90, 100 + math.max(0, 4 - index) * 30
		elseif result.Passed >= #self.Track.Points then credits, xp = 100, 40 end
		local public = {Name = result.Name, UserId = result.UserId, Place = index, Time = result.Time,
			Finished = result.Finished, Credits = 0, XP = 0, RewardPending = credits > 0}
		table.insert(self.Results, public)
		if credits > 0 and not entry.Awarded then
			entry.Awarded = true
			task.spawn(function()
				local awarded = false
				for attempt = 1, 3 do
					awarded = self.Economy:award(result.Player, credits, xp, result.Finished and index == 1, entry.Progress.BestLap)
					if awarded then break end
					if attempt < 3 then task.wait(1) end
				end
				public.RewardPending = false
				if awarded then
					public.Credits, public.XP = credits, xp
					self.Notify(result.Player, "+" .. credits .. " credits · +" .. xp .. " XP. Visit the garage for new looks.")
				else
					public.RewardFailed = true
					self.Notify(result.Player, "Garage saving is unavailable. This race reward could not be granted.")
				end
			end)
		end
	end
end

function RaceService:step(now)
	if self.Phase == "Lobby" then
		if now >= self.Deadline then self:startGrid(now) end
	elseif self.Phase == "Countdown" then
		if now >= self.Deadline then
			self.Phase, self.Started, self.Deadline = "Racing", now, now + self.Config.Race.MaxDuration
			for player, entry in self.Entries do
				entry.Progress = Rules.newProgress(now)
				self.Notify(player, "GO! Follow the cyan route. Space to drift, Shift to boost.")
			end
		end
	elseif self.Phase == "Racing" then
		local unfinished = 0
		for player, entry in self.Entries do
			local car, progress = self.Vehicles[player], entry.Progress
			if not progress.Finished then
				unfinished += 1
				if car and car.Seat.Occupant then
					local point, nextPoint = self.Track.Points[progress.Next], self.Track.Points[progress.Next % #self.Track.Points + 1]
					local from, to = car.PreviousPosition, car.Position
					if Rules.crossed({from.X, from.Y, from.Z}, {to.X, to.Y, to.Z}, point, nextPoint, self.Track.Width * 0.68) then
						local lapBefore = progress.LapsCompleted
						Rules.checkpoint(progress, progress.Next, #self.Track.Points, self.Config.Race.Laps, now)
						if progress.Finished then
							entry.Time = now - self.Started + progress.Penalty
							self.Notify(player, "FINISH! Results and rewards arrive when the race ends.")
						elseif progress.LapsCompleted > lapBefore then
							self.Notify(player, if progress.LapsCompleted == self.Config.Race.Laps - 1 then "FINAL LAP! Make it count." else "Lap complete! Keep the boost flowing.")
						end
					end
				end
			end
		end
		if unfinished == 0 or now >= self.Deadline then self:finishRace(now) end
	elseif self.Phase == "Results" and now >= self.Deadline then
		self.Phase, self.Deadline, self.Entries = "Lobby", now + self.Config.Race.Intermission, {}
	end
end

function RaceService:snapshot(player, now)
	local entry, count, ranked = self.Entries[player], 0, {}
	for racer, candidate in self.Entries do
		count += 1
		local distance = 0
		local car = self.Vehicles[racer]
		if car then
			local nextPoint = self.Track.Points[candidate.Progress.Next]
			distance = (car.Position - Vector3.new(nextPoint[1], nextPoint[2], nextPoint[3])).Magnitude
		end
		table.insert(ranked, {Player = racer, Entry = candidate, Distance = distance})
	end
	table.sort(ranked, function(a, b)
		if a.Entry.Progress.Finished ~= b.Entry.Progress.Finished then return a.Entry.Progress.Finished end
		if a.Entry.Progress.Finished then return (a.Entry.Time or 0) < (b.Entry.Time or 0) end
		if a.Entry.Progress.Passed ~= b.Entry.Progress.Passed then return a.Entry.Progress.Passed > b.Entry.Progress.Passed end
		return a.Distance < b.Distance
	end)
	local place = 0
	for index, candidate in ranked do if candidate.Player == player then place = index; break end end
	local progress = entry and entry.Progress
	return {Phase = self.Phase, Remaining = math.max(0, self.Deadline - now), Track = self.Track.Name,
		Laps = self.Config.Race.Laps, Queued = self.Queue[player] == true, Queue = self.Queue[player] == true,
		Racers = count, Position = entry and (entry.Place or place) or 0,
		Lap = progress and math.min(self.Config.Race.Laps, progress.LapsCompleted + 1) or 1,
		Checkpoint = progress and progress.Next or 2, CheckpointCount = #self.Track.Points,
		Elapsed = entry and (entry.Time or (self.Phase == "Racing" and now - self.Started + progress.Penalty or 0)) or 0,
		BestLap = progress and progress.BestLap or 0, Finished = progress and progress.Finished or false,
		Results = self.Results}
end

return RaceService
]]></ProtectedString>
					<string name="ScriptGuid">{AB84CFB5-E6BD-4A57-9EA9-B76E6A0B0C00}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RaceService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">4475d7b32a2b51bb0af0cdeb0000078e</UniqueId>
