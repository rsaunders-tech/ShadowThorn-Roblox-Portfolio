			<Item class="LocalScript" referent="RBX000003A8">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Shadow Racing: device-friendly driving, chase camera, HUD, and cosmetic garage.
-- Currency, unlocks, purchases, race progress and vehicle motion belong to the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("ShadowRacing")
local Config = require(shared:WaitForChild("Config"))
local Track = require(shared:WaitForChild("Track"))
local remotes = shared:WaitForChild("Remotes")
local inputRemote = remotes:WaitForChild("Input")
local actionRemote = remotes:WaitForChild("Action")
local stateRemote = remotes:WaitForChild("State")
local notifyRemote = remotes:WaitForChild("Notify")

local palette = {
	Ink = Color3.fromRGB(11, 15, 25), Panel = Color3.fromRGB(20, 26, 41),
	Raised = Color3.fromRGB(31, 39, 57), Line = Color3.fromRGB(55, 67, 89),
	Text = Color3.fromRGB(242, 247, 255), Muted = Color3.fromRGB(163, 180, 202),
	Cyan = Color3.fromRGB(77, 237, 224), Purple = Color3.fromRGB(162, 112, 255),
	Gold = Color3.fromRGB(255, 210, 112),
}
local state = { Profile = {}, Race = {}, Vehicle = {} }
local held, touchHeld = {}, {}
local stick = Vector2.zero
local activeMenu, activeSlot = nil, "Paint"
local welcomeOpen, connected, cameraActive = true, false, false
local lastGarageSignature, inputClock = "", 0
local priceCache, garageRows = {}, {}
local controlsText = UserInputService.TouchEnabled and "Hold arrows to drive  /  DRIFT through corners  /  BOOST on straights"
	or "WASD / arrows  DRIVE     SPACE  DRIFT     SHIFT  BOOST     R  RESET"

local function make(class, parent, props)
	local object = Instance.new(class)
	for name, value in pairs(props or {}) do object[name] = value end
	object.Parent = parent
	return object
end
local function corner(parent, radius)
	make("UICorner", parent, { CornerRadius = UDim.new(0, radius or 12) })
end
local function stroke(parent, color, transparency)
	return make("UIStroke", parent, { Color = color or palette.Line, Thickness = 1, Transparency = transparency or 0 })
end
local function panel(parent, props)
	local object = make("Frame", parent, props)
	object.BorderSizePixel = 0
	object.BackgroundColor3 = props.BackgroundColor3 or palette.Panel
	corner(object, 14)
	return object
end
local function label(parent, text, size, position, dimensions, color, bold)
	return make("TextLabel", parent, {
		Text = text, TextSize = size, Position = position, Size = dimensions,
		TextColor3 = color or palette.Text, Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		BackgroundTransparency = 1, BorderSizePixel = 0,
	})
end
local function button(parent, text, position, dimensions, callback, accent)
	local object = make("TextButton", parent, {
		Text = text, TextSize = 14, Font = Enum.Font.GothamBold,
		Position = position, Size = dimensions, BorderSizePixel = 0,
		BackgroundColor3 = accent or palette.Raised,
		TextColor3 = accent and palette.Ink or palette.Text,
		AutoButtonColor = true,
	})
	corner(object, 10)
	object.Activated:Connect(callback)
	return object
end
local function colorOf(item)
	local c = item.Color or { 100, 110, 130 }
	return Color3.fromRGB(c[1], c[2], c[3])
end
local function number(value)
	local text = tostring(math.floor(tonumber(value) or 0))
	return text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end
local function clock(seconds)
	seconds = math.max(0, tonumber(seconds) or 0)
	return string.format("%d:%05.2f", math.floor(seconds / 60), seconds % 60)
end

local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
	Name = "ShadowRacingHUD", ResetOnSpawn = false, IgnoreGuiInset = false,
	DisplayOrder = 20, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
})
local root = make("Frame", gui, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })

local brand = panel(root, { Position = UDim2.fromOffset(16, 14), Size = UDim2.fromOffset(212, 64), BackgroundTransparency = 0.12 })
label(brand, "SHADOW", 21, UDim2.fromOffset(14, 5), UDim2.new(1, -28, 0, 28), palette.Text, true)
label(brand, "R A C I N G  /  ATV CIRCUIT", 10, UDim2.fromOffset(15, 33), UDim2.new(1, -28, 0, 19), palette.Cyan, true)
local wallet = panel(root, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 14), Size = UDim2.fromOffset(232, 64), BackgroundTransparency = 0.12 })
local creditsLabel = label(wallet, "0 CREDITS", 18, UDim2.fromOffset(14, 5), UDim2.new(1, -28, 0, 27), palette.Gold, true)
local levelLabel = label(wallet, "LEVEL 1  /  0 XP", 11, UDim2.fromOffset(14, 33), UDim2.new(1, -28, 0, 19), palette.Muted, true)

local raceCard = panel(root, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(348, 64), BackgroundTransparency = 0.1 })
local phaseLabel = label(raceCard, "CONNECTING TO THE CIRCUIT", 13, UDim2.fromOffset(16, 5), UDim2.new(1, -32, 0, 24), palette.Cyan, true)
phaseLabel.TextXAlignment = Enum.TextXAlignment.Center
local raceDetail = label(raceCard, "Your ATV is warming up", 12, UDim2.fromOffset(12, 30), UDim2.new(1, -24, 0, 24), palette.Muted)
raceDetail.TextXAlignment = Enum.TextXAlignment.Center

local progressCard = panel(root, { Position = UDim2.fromOffset(16, 96), Size = UDim2.fromOffset(212, 109), BackgroundTransparency = 0.15 })
local lapLabel = label(progressCard, "FREE RIDE", 23, UDim2.fromOffset(14, 9), UDim2.new(1, -28, 0, 31), palette.Text, true)
local positionLabel = label(progressCard, "EXPLORE OBSIDIAN RUN", 11, UDim2.fromOffset(14, 43), UDim2.new(1, -28, 0, 19), palette.Cyan, true)
local checkpointLabel = label(progressCard, "Follow the cyan gates", 11, UDim2.fromOffset(14, 69), UDim2.new(1, -28, 0, 19), palette.Muted)

local speedCard = panel(root, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(208, 128), BackgroundTransparency = 0.08 })
local speedLabel = label(speedCard, "000", 47, UDim2.fromOffset(14, 4), UDim2.fromOffset(126, 57), palette.Text, true)
label(speedCard, "STUDS / S", 10, UDim2.fromOffset(139, 29), UDim2.fromOffset(62, 21), palette.Muted, true)
local drivingLabel = label(speedCard, "READY TO RIDE", 10, UDim2.fromOffset(15, 64), UDim2.new(1, -30, 0, 18), palette.Cyan, true)
local boostBack = panel(speedCard, { Position = UDim2.fromOffset(14, 91), Size = UDim2.new(1, -28, 0, 12), BackgroundColor3 = palette.Ink })
local boostFill = panel(boostBack, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = palette.Cyan })
label(speedCard, "DRIFT TO CHARGE BOOST", 9, UDim2.fromOffset(15, 106), UDim2.new(1, -30, 0, 16), palette.Muted, true)

local navigation = make("Frame", root, { Position = UDim2.new(0, 16, 1, -88), Size = UDim2.fromOffset(366, 72), BackgroundTransparency = 1 })
local menuButtons = {}
local openMenu
menuButtons.Garage = button(navigation, "GARAGE [G]", UDim2.fromOffset(0, 0), UDim2.fromOffset(110, 38), function() openMenu("Garage") end)
menuButtons.Shop = button(navigation, "SHOP [B]", UDim2.fromOffset(118, 0), UDim2.fromOffset(104, 38), function() openMenu("Shop") end)
menuButtons.Daily = button(navigation, "DAILY", UDim2.fromOffset(230, 0), UDim2.fromOffset(92, 38), function() actionRemote:FireServer("Daily") end)
local controlHint = label(navigation, controlsText, 10, UDim2.fromOffset(0, 43), UDim2.fromOffset(630, 20), palette.Muted)
local queueButton = button(root, "JOIN NEXT RACE", UDim2.new(0.5, -109, 1, -58), UDim2.fromOffset(218, 42), function()
	if state.Profile.Ready then actionRemote:FireServer("Join") end
end, palette.Cyan)

local countdown = label(root, "", 76, UDim2.new(0.5, -160, 0.36, 0), UDim2.fromOffset(320, 110), palette.Text, true)
countdown.TextXAlignment = Enum.TextXAlignment.Center
countdown.TextStrokeTransparency = 0.65
countdown.Visible = false

local toast = panel(root, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 94), Size = UDim2.new(0.6, 0, 0, 48), BackgroundColor3 = palette.Raised, Visible = false, ZIndex = 50 })
make("UISizeConstraint", toast, { MaxSize = Vector2.new(650, 80) })
local toastText = label(toast, "", 14, UDim2.fromOffset(15, 4), UDim2.new(1, -30, 1, -8), palette.Text, true)
toastText.TextXAlignment = Enum.TextXAlignment.Center
toastText.TextWrapped, toastText.ZIndex = true, 51
local toastSerial = 0
local function showToast(message)
	if type(message) ~= "string" or message == "" then return end
	toastSerial += 1
	local serial = toastSerial
	toastText.Text, toast.Visible = message, true
	task.delay(4.5, function() if serial == toastSerial then toast.Visible = false end end)
end

local results = panel(root, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 96), Size = UDim2.fromOffset(300, 204), BackgroundTransparency = 0.08, Visible = false })
label(results, "RACE RESULTS", 16, UDim2.fromOffset(16, 10), UDim2.new(1, -32, 0, 24), palette.Cyan, true)
local resultsText = label(results, "", 13, UDim2.fromOffset(16, 43), UDim2.new(1, -32, 1, -55), palette.Text)
resultsText.TextYAlignment, resultsText.TextWrapped = Enum.TextYAlignment.Top, true

local overlay = make("Frame", root, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = palette.Ink, BackgroundTransparency = 0.28, Visible = false, ZIndex = 70, Active = true })
local modal = panel(overlay, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.91, 0.85), ZIndex = 71 })
make("UISizeConstraint", modal, { MaxSize = Vector2.new(930, 650) })
stroke(modal, palette.Line)
local modalTitle = label(modal, "THE GARAGE", 24, UDim2.fromOffset(24, 18), UDim2.new(1, -100, 0, 35), palette.Text, true)
modalTitle.ZIndex = 72
local modalSubtitle = label(modal, "", 12, UDim2.fromOffset(24, 55), UDim2.new(1, -48, 0, 30), palette.Muted)
modalSubtitle.ZIndex, modalSubtitle.TextWrapped = 72, true
local closeButton = button(modal, "CLOSE", UDim2.new(1, -92, 0, 20), UDim2.fromOffset(70, 32), function() openMenu(nil) end)
closeButton.ZIndex = 73
local tabBar = make("Frame", modal, { Position = UDim2.fromOffset(24, 95), Size = UDim2.new(1, -48, 0, 35), BackgroundTransparency = 1, ZIndex = 72 })
local tabs = {}
local scroll = make("ScrollingFrame", modal, {
	Position = UDim2.fromOffset(24, 143), Size = UDim2.new(1, -48, 1, -193),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
	ScrollBarImageColor3 = palette.Cyan, CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 72,
})
make("UIListLayout", scroll, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
local modalFooter = label(modal, "Every ATV has equal racing stats. Make yours look legendary.", 11, UDim2.new(0, 24, 1, -40), UDim2.new(1, -48, 0, 29), palette.Muted)
modalFooter.ZIndex, modalFooter.TextWrapped = 72, true

local function clearRows()
	for _, child in ipairs(scroll:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
	garageRows = {}
end
local function row(name, detail, swatch)
	local narrow = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X < 600
	local card = panel(scroll, { Size = UDim2.new(1, -8, 0, narrow and 128 or 92), BackgroundColor3 = palette.Raised, ZIndex = 73 })
	local chip = panel(card, { Position = UDim2.fromOffset(12, 14), Size = UDim2.fromOffset(52, 64), BackgroundColor3 = swatch, ZIndex = 74 })
	stroke(chip, palette.Text, 0.78)
	local title = label(card, name, 16, UDim2.fromOffset(78, 10), UDim2.new(1, narrow and -90 or -234, 0, 27), palette.Text, true)
	title.ZIndex, title.TextTruncate = 74, Enum.TextTruncate.AtEnd
	local subtitle = label(card, detail, 11, UDim2.fromOffset(78, 40), UDim2.new(1, narrow and -90 or -234, 0, 39), palette.Muted)
	subtitle.ZIndex, subtitle.TextWrapped = 74, true
	return card, narrow
end

local function owns(item)
	local profile = state.Profile
	return (profile.Owned or {})[item.Key] == true or (item.Cost == 0 and not item.Pass)
		or (item.Pass and (profile.Passes or {})[item.Pass] == true)
end
local function garageSignature()
	local p = state.Profile
	local parts = { tostring(p.Credits), tostring(p.Level) }
	for _, item in ipairs(Config.Cosmetics) do
		table.insert(parts, item.Key .. tostring(owns(item)) .. tostring((p.Equipped or {})[item.Slot] == item.Key))
	end
	return table.concat(parts, "/")
end
local function renderGarage()
	clearRows()
	modalTitle.Text = "THE GARAGE"
	modalSubtitle.Text = "Race for credits. Unlock your signature look.  |  " .. number(state.Profile.Credits) .. " credits"
	modalFooter.Text = "Paint, wheels and trails are cosmetic. Every racer gets equal driving stats."
	tabBar.Visible = true
	for slot, tab in pairs(tabs) do
		tab.BackgroundColor3 = slot == activeSlot and palette.Cyan or palette.Raised
		tab.TextColor3 = slot == activeSlot and palette.Ink or palette.Text
	end
	for _, item in ipairs(Config.Cosmetics) do
		if item.Slot ~= activeSlot then continue end
		local owned, equipped = owns(item), (state.Profile.Equipped or {})[item.Slot] == item.Key
		local requiredLevel = tonumber(item.Level) or 1
		local enoughLevel = (tonumber(state.Profile.Level) or 1) >= requiredLevel
		local detail = item.Pass and "Exclusive cosmetic pack" or ("Level " .. requiredLevel .. "  /  " .. number(item.Cost) .. " credits")
		if owned then detail = "In your collection  /  " .. item.Slot end
		local card, narrow = row(item.Name, detail, colorOf(item))
		local buttonText = equipped and "EQUIPPED" or owned and "EQUIP" or item.Pass and "VIEW PACK" or not enoughLevel and ("LEVEL " .. requiredLevel) or "UNLOCK"
		local action = button(card, buttonText, UDim2.new(1, -145, 0, narrow and 83 or 27), UDim2.fromOffset(132, 38), function()
			if equipped then return end
			if owned then actionRemote:FireServer("Equip", item.Key)
			elseif item.Pass then openMenu("Shop")
			elseif not enoughLevel then showToast("Reach level " .. requiredLevel .. " by racing to unlock this cosmetic.")
			else actionRemote:FireServer("Buy", item.Key) end
		end, equipped and palette.Purple or (owned or enoughLevel) and palette.Cyan or nil)
		action.ZIndex = 75
		table.insert(garageRows, card)
	end
	lastGarageSignature = garageSignature()
end

local function fetchPrice(kind, item, targetButton)
	if not item.Id or item.Id <= 0 then
		targetButton.Text = "NOT LIVE YET"
		targetButton.BackgroundColor3, targetButton.TextColor3 = palette.Panel, palette.Muted
		return
	end
	local cacheKey = kind .. tostring(item.Id)
	if priceCache[cacheKey] then targetButton.Text = priceCache[cacheKey]; return end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(item.Id, kind == "Pass" and Enum.InfoType.GamePass or Enum.InfoType.Product)
		end)
		local text = ok and type(info) == "table" and type(info.PriceInRobux) == "number" and ("R$ " .. number(info.PriceInRobux)) or "VIEW ON ROBLOX"
		priceCache[cacheKey] = text
		if targetButton.Parent then targetButton.Text = text end
	end)
end
local function renderShop()
	clearRows()
	tabBar.Visible = false
	modalTitle.Text = "SHADOW SHOP"
	modalSubtitle.Text = "Optional cosmetics and credits for the garage. Choose exactly what you get."
	modalFooter.Text = "Purchases use Roblox's confirmation. Credits buy cosmetics. Paid items never increase racing speed."
	for _, category in ipairs({ { Kind = "Pass", Items = Config.Passes }, { Kind = "Product", Items = Config.Products } }) do
		for _, item in ipairs(category.Items or {}) do
			local owned = category.Kind == "Pass" and (state.Profile.Passes or {})[item.Key] == true
			local detail = item.Description or (item.Credits and (number(item.Credits) .. " garage credits")) or "Cosmetic collection"
			local card, narrow = row(item.Name, detail, category.Kind == "Pass" and palette.Purple or palette.Gold)
			local purchaseButton = button(card, owned and "OWNED" or "LOADING...", UDim2.new(1, -145, 0, narrow and 83 or 27), UDim2.fromOffset(132, 38), function()
				if owned then showToast("You own this pack. Equip its cosmetics in the garage."); return end
				if not item.Id or item.Id <= 0 then showToast("This offer is not live yet. Earn credits by racing in the meantime."); return end
				actionRemote:FireServer(category.Kind == "Pass" and "PurchasePass" or "PurchaseProduct", item.Key)
			end, owned and palette.Purple or palette.Cyan)
			purchaseButton.ZIndex = 75
			if not owned then fetchPrice(category.Kind, item, purchaseButton) end
		end
	end
end

openMenu = function(name)
	if welcomeOpen then return end
	if activeMenu == name then activeMenu = nil else activeMenu = name end
	overlay.Visible = activeMenu ~= nil
	held, touchHeld, stick = {}, {}, Vector2.zero
	if activeMenu == "Garage" then renderGarage() elseif activeMenu == "Shop" then renderShop() end
	if UserInputService:GetLastInputType() == Enum.UserInputType.Gamepad1 then
		GuiService.SelectedObject = activeMenu and closeButton or nil
	end
end
for i, slot in ipairs({ "Paint", "Wheels", "Trail" }) do
	tabs[slot] = button(tabBar, string.upper(slot), UDim2.fromOffset((i - 1) * 112, 0), UDim2.fromOffset(104, 34), function()
		activeSlot = slot
		renderGarage()
	end)
	tabs[slot].ZIndex = 73
end

local welcome = make("Frame", root, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = palette.Ink, BackgroundTransparency = 0.24, ZIndex = 90, Active = true })
local welcomeCard = panel(welcome, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.88, 0, 0, 390), BackgroundTransparency = 0.04, ZIndex = 91 })
make("UISizeConstraint", welcomeCard, { MaxSize = Vector2.new(720, 460) })
stroke(welcomeCard, palette.Purple)
local welcomeEyebrow = label(welcomeCard, "NEON NIGHTS. DIRT TIRES. YOUR SIGNATURE RIDE.", 11, UDim2.fromOffset(28, 24), UDim2.new(1, -56, 0, 24), palette.Cyan, true)
welcomeEyebrow.ZIndex, welcomeEyebrow.TextWrapped = 92, true
local welcomeTitle = label(welcomeCard, "SHADOW", 52, UDim2.fromOffset(26, 59), UDim2.new(1, -52, 0, 63), palette.Text, true)
welcomeTitle.Font, welcomeTitle.ZIndex = Enum.Font.GothamBlack, 92
local welcomeRacing = label(welcomeCard, "R A C I N G", 26, UDim2.fromOffset(29, 120), UDim2.new(1, -56, 0, 36), palette.Purple, true)
welcomeRacing.ZIndex = 92
local welcomeDescription = label(welcomeCard, "Carve the canyon. Drift to charge boost. Race for credits and build an ATV that is unmistakably yours.", 15, UDim2.fromOffset(29, 174), UDim2.new(1, -58, 0, 58), palette.Muted)
welcomeDescription.TextWrapped, welcomeDescription.ZIndex = true, 92
local welcomeControls = label(welcomeCard, controlsText, 11, UDim2.fromOffset(29, 242), UDim2.new(1, -58, 0, 39), palette.Text, true)
welcomeControls.TextWrapped, welcomeControls.ZIndex = true, 92
local rideButton = button(welcomeCard, "WARMING UP...", UDim2.new(0, 29, 1, -81), UDim2.new(1, -58, 0, 49), function()
	if not state.Profile.Ready then showToast("Your driver profile is still loading."); return end
	welcomeOpen, welcome.Visible = false, false
	actionRemote:FireServer("Ready")
	showToast("You are queued for the next race. Follow the cyan gates and drift to charge boost!")
end, palette.Cyan)
rideButton.ZIndex = 93
local sessionLabel = label(welcomeCard, "All racing is free. Every ATV has equal driving stats.", 10, UDim2.new(0, 29, 1, -28), UDim2.new(1, -58, 0, 18), palette.Muted)
sessionLabel.ZIndex = 92

-- Touch inputs hold until their individual finger is released.
local touchControls = make("Frame", root, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = UserInputService.TouchEnabled })
local touchBindings = {}
local touchButtons = {}
local function touchButton(name, text, position, dimensions, accent)
	local object = button(touchControls, text, position, dimensions, function() end, accent)
	object.BackgroundTransparency = 0.15
	object.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			touchBindings[input], touchHeld[name] = name, true
		end
	end)
	touchButtons[name] = object
	return object
end
touchButton("Left", "<", UDim2.new(0, 18, 1, -94), UDim2.fromOffset(64, 60))
touchButton("Right", ">", UDim2.new(0, 90, 1, -94), UDim2.fromOffset(64, 60))
touchButton("Forward", "GO", UDim2.new(1, -90, 1, -94), UDim2.fromOffset(72, 60), palette.Cyan)
touchButton("Back", "BRAKE", UDim2.new(1, -170, 1, -94), UDim2.fromOffset(72, 60))
touchButton("Drift", "DRIFT", UDim2.new(0, 18, 1, -164), UDim2.fromOffset(136, 52), palette.Purple)
touchButton("Boost", "BOOST", UDim2.new(1, -170, 1, -164), UDim2.fromOffset(152, 52), palette.Cyan)
local touchReset = button(touchControls, "RESET", UDim2.new(0, 18, 1, -208), UDim2.fromOffset(75, 34), function() actionRemote:FireServer("Reset") end)

-- A client-only beacon makes the next server-validated gate easy to find.
-- It does not report checkpoint hits or grant race progress.
local beacon = make("Part", workspace, {
	Name = "ShadowRacingNextGate", Anchored = true, CanCollide = false,
	CanQuery = false, CanTouch = false, CastShadow = false,
	Shape = Enum.PartType.Ball, Size = Vector3.new(2.5, 2.5, 2.5),
	Color = palette.Cyan, Material = Enum.Material.Neon, Transparency = 1,
})
local beaconGui = make("BillboardGui", beacon, {
	Size = UDim2.fromOffset(200, 64), StudsOffset = Vector3.new(0, 3, 0),
	AlwaysOnTop = true, MaxDistance = 1800, Adornee = beacon, Enabled = false,
})
local beaconTitle = label(beaconGui, "NEXT GATE", 18, UDim2.new(), UDim2.new(1, 0, 0, 29), palette.Cyan, true)
beaconTitle.TextXAlignment, beaconTitle.TextStrokeTransparency = Enum.TextXAlignment.Center, 0.2
local beaconDistance = label(beaconGui, "", 13, UDim2.fromOffset(0, 30), UDim2.new(1, 0, 0, 23), palette.Text, true)
beaconDistance.TextXAlignment, beaconDistance.TextStrokeTransparency = Enum.TextXAlignment.Center, 0.2

local function updateLayout()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	local compact = viewport.X < 900
	local portrait = viewport.X < 560
	local touchLandscape = UserInputService.TouchEnabled and viewport.X > viewport.Y
	brand.Size = UDim2.fromOffset(portrait and 148 or compact and 180 or 212, 64)
	wallet.Size = UDim2.fromOffset(portrait and 170 or compact and 205 or 232, 64)
	raceCard.Position = UDim2.new(0.5, 0, 0, compact and 88 or 14)
	raceCard.Size = UDim2.new(compact and 0.62 or 0, compact and 0 or 348, 0, compact and 55 or 64)
	progressCard.Position = UDim2.fromOffset(16, compact and 157 or 96)
	progressCard.Size = UDim2.fromOffset(portrait and 175 or 212, compact and 85 or 109)
	lapLabel.TextSize = compact and 19 or 23
	checkpointLabel.Visible = not compact
	navigation.Position = UserInputService.TouchEnabled and UDim2.new(0, 16, 0, compact and 252 or 221) or UDim2.new(0, 16, 1, -88)
	menuButtons.Garage.Text = UserInputService.TouchEnabled and "GARAGE" or "GARAGE [G]"
	menuButtons.Shop.Text = UserInputService.TouchEnabled and "SHOP" or "SHOP [B]"
	controlHint.Visible = not UserInputService.TouchEnabled and not compact
	if UserInputService.TouchEnabled then
		menuButtons.Garage.Size, menuButtons.Shop.Size, menuButtons.Daily.Size = UDim2.fromOffset(86, 34), UDim2.fromOffset(72, 34), UDim2.fromOffset(72, 34)
		menuButtons.Shop.Position, menuButtons.Daily.Position = UDim2.fromOffset(92, 0), UDim2.fromOffset(170, 0)
	end
	speedCard.Size = UDim2.fromOffset(UserInputService.TouchEnabled and 176 or 208, UserInputService.TouchEnabled and 112 or 128)
	speedCard.Position = UDim2.new(1, -16, 1, UserInputService.TouchEnabled and -228 or -16)
	queueButton.Position = UDim2.new(0.5, -109, 1, UserInputService.TouchEnabled and -55 or -58)
	queueButton.Size = UDim2.fromOffset(218, 38)
	if UserInputService.TouchEnabled then
		-- Driving pads occupy the bottom corners. Keep menus between them in
		-- landscape and beneath the race information in portrait.
		if touchLandscape then
			brand.Size, wallet.Size = UDim2.fromOffset(148, 64), UDim2.fromOffset(170, 64)
			raceCard.Position = UDim2.new(0.5, 0, 0, 14)
			raceCard.Size = UDim2.fromOffset(math.min(280, viewport.X - 360), 64)
			phaseLabel.TextSize, raceDetail.TextSize = 11, 10
			progressCard.Position = UDim2.fromOffset(16, 96)
			navigation.Position = UDim2.new(0.5, -121, 1, -106)
			speedCard.Position = UDim2.new(1, -16, 0, 96)
			queueButton.Position = UDim2.new(0.5, -109, 1, -58)
		else
			navigation.Position = UDim2.fromOffset(16, 252)
			queueButton.Position = UDim2.fromOffset(16, 296)
			queueButton.Size = UDim2.fromOffset(242, 38)
		end
		speedLabel.TextSize = 39
		speedLabel.Size = UDim2.fromOffset(100, 54)
		for _, child in ipairs(speedCard:GetChildren()) do
			if child:IsA("TextLabel") and child.Text == "STUDS / S" then child.Position = UDim2.fromOffset(112, 26); child.TextSize = 9 end
		end
		boostBack.Position = UDim2.fromOffset(14, 85)
	end
	results.Size = UDim2.fromOffset(portrait and 230 or 300, 204)
	results.Position = UDim2.new(1, -16, 0, compact and 151 or 96)
	toast.Position = UDim2.new(0.5, 0, 0, compact and 148 or 94)
	toast.Size = UDim2.new(compact and 0.9 or 0.6, 0, 0, 48)
	welcomeCard.Size = UDim2.new(0.88, 0, 0, math.min(390, viewport.Y - 30))
	welcomeTitle.TextSize = portrait and 38 or 52
	welcomeDescription.TextSize = portrait and 13 or 15
	-- Short landscape phones need a scrollable menu; preserve room for controls.
	local short = viewport.Y < 520
	if short then
		welcomeEyebrow.Visible, welcomeRacing.Visible, welcomeControls.Visible = false, false, false
		welcomeTitle.Position = UDim2.fromOffset(26, 14)
		welcomeDescription.Position = UDim2.fromOffset(29, 83)
		welcomeDescription.Size = UDim2.new(1, -58, 0, 58)
	else
		welcomeEyebrow.Visible, welcomeRacing.Visible, welcomeControls.Visible = true, true, true
		welcomeTitle.Position = UDim2.fromOffset(26, 59)
		welcomeDescription.Position = UDim2.fromOffset(29, 174)
	end
	modalTitle.TextSize = portrait and 19 or 24
	modalTitle.Size = UDim2.new(1, -125, 0, 35)
	if activeMenu == "Garage" then renderGarage() elseif activeMenu == "Shop" then renderShop() end
end

local function updateState(payload)
	if type(payload) ~= "table" then return end
	state.Profile = payload.Profile or state.Profile
	state.Race = payload.Race or state.Race
	state.Vehicle = payload.Vehicle or state.Vehicle
	connected = true
	local profile, race, vehicle = state.Profile, state.Race, state.Vehicle
	creditsLabel.Text = number(profile.Credits) .. " CREDITS"
	levelLabel.Text = "LEVEL " .. number(profile.Level or 1) .. "  /  " .. number(profile.XP) .. " XP"
	rideButton.Text = profile.Ready and "LET'S RIDE  >" or "LOADING DRIVER..."
	sessionLabel.Text = profile.SessionOnly and "STUDIO PREVIEW  /  Progress is temporary in this session." or "All racing is free. Every ATV has equal driving stats."
	menuButtons.Daily.Text = profile.DailyReady and "DAILY +" or "DAILY"
	menuButtons.Daily.TextColor3 = profile.DailyReady and palette.Gold or palette.Muted
	local remaining = math.max(0, math.ceil(tonumber(race.Remaining) or 0))
	local phase = race.Phase or "Lobby"
	local racing = phase == "Racing"
	phaseLabel.Text = phase == "Countdown" and "LIGHTS OUT IN " .. remaining
		or racing and "OBSIDIAN RUN  /  RACE LIVE"
		or phase == "Results" and "THE FINISH LINE"
		or (race.Queued and "NEXT RACE IN " .. remaining .. "s" or "FREE RIDE  /  JOIN A RACE")
	raceDetail.Text = racing and (clock(race.Elapsed) .. "  /  " .. tostring(race.Racers or 1) .. " RACERS")
		or (race.Track or "Obsidian Run") .. "  /  " .. tostring(race.Laps or 3) .. " laps  /  " .. tostring(race.Racers or 1) .. " racers"
	lapLabel.Text = racing and ("LAP " .. math.min(race.Lap or 1, race.Laps or 3) .. " / " .. (race.Laps or 3)) or "FREE RIDE"
	positionLabel.Text = racing and ("POSITION " .. tostring(race.Position or "-") .. " / " .. tostring(race.Racers or 1)) or (race.Queued and "QUEUED FOR NEXT RACE" or "EXPLORE THE CIRCUIT")
	checkpointLabel.Text = racing and ("Gate " .. tostring(race.Checkpoint or 0) .. " / " .. tostring(race.CheckpointCount or 48)) or "Follow the cyan gates"
	queueButton.Text = race.Queued and "QUEUED  /  LEAVE [J]" or "JOIN NEXT RACE [J]"
	if UserInputService.TouchEnabled then queueButton.Text = race.Queued and "QUEUED  /  LEAVE" or "JOIN NEXT RACE" end
	queueButton.BackgroundColor3 = race.Queued and palette.Purple or palette.Cyan
	countdown.Visible = phase == "Countdown" and not welcomeOpen and activeMenu == nil
	countdown.Text = tostring(remaining)
	speedLabel.Text = string.format("%03d", math.floor(math.abs(tonumber(vehicle.Speed) or 0)))
	boostFill.Size = UDim2.fromScale(math.clamp((tonumber(vehicle.Boost) or 0) / 100, 0, 1), 1)
	boostFill.BackgroundColor3 = vehicle.Drifting and palette.Purple or palette.Cyan
	drivingLabel.Text = vehicle.Drifting and "DRIFT  /  BOOST CHARGING" or phase == "Countdown" and "HOLD FOR THE GREEN LIGHT" or "FIND YOUR RACING LINE"
	results.Visible = phase == "Results" and not welcomeOpen and activeMenu == nil
	if results.Visible then
		local lines = {}
		for i, result in ipairs(race.Results or {}) do
			if i > 5 then break end
			table.insert(lines, tostring(result.Place or i) .. ".  " .. tostring(result.Name or "Racer") .. "   " .. (result.Time and clock(result.Time) or "DNF"))
		end
		resultsText.Text = #lines > 0 and table.concat(lines, "\n\n") or "The canyon wins this time.\n\nNext race begins shortly."
	end
	if payload.Message then showToast(payload.Message) end
	if activeMenu == "Garage" and garageSignature() ~= lastGarageSignature then renderGarage() end
end
stateRemote.OnClientEvent:Connect(updateState)
notifyRemote.OnClientEvent:Connect(showToast)

UserInputService.InputBegan:Connect(function(input, processed)
	local key = input.KeyCode
	if key == Enum.KeyCode.ButtonB and activeMenu then openMenu(nil); return end
	if processed or UserInputService:GetFocusedTextBox() then return end
	if welcomeOpen then
		if (key == Enum.KeyCode.Return or key == Enum.KeyCode.ButtonA) and state.Profile.Ready then
			welcomeOpen, welcome.Visible = false, false
			actionRemote:FireServer("Ready")
		end
		return
	end
	if key == Enum.KeyCode.G or key == Enum.KeyCode.ButtonL1 then openMenu("Garage"); return end
	if key == Enum.KeyCode.B or key == Enum.KeyCode.ButtonR1 then openMenu("Shop"); return end
	if key == Enum.KeyCode.J or key == Enum.KeyCode.ButtonStart then actionRemote:FireServer("Join"); return end
	if activeMenu then return end
	if key == Enum.KeyCode.R or key == Enum.KeyCode.DPadUp then actionRemote:FireServer("Reset"); return end
	held[key] = true
end)
UserInputService.InputEnded:Connect(function(input)
	held[input.KeyCode] = nil
	local name = touchBindings[input]
	if name then touchHeld[name], touchBindings[input] = nil, nil end
end)
UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then stick = Vector2.new(input.Position.X, input.Position.Y) end
end)
UserInputService.WindowFocusReleased:Connect(function() held, touchHeld, stick = {}, {}, Vector2.zero end)

task.spawn(function()
	local ok, module = pcall(function() return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)) end)
	if ok and module then module:GetControls():Disable() end
end)
local function down(...)
	for _, key in ipairs({ ... }) do if held[key] then return 1 end end
	return 0
end
local lastLayoutSize = Vector2.zero
RunService.RenderStepped:Connect(function(dt)
	inputClock += dt
	local camera = workspace.CurrentCamera
	if camera and camera.ViewportSize ~= lastLayoutSize then lastLayoutSize = camera.ViewportSize; updateLayout() end
	local blocked = welcomeOpen or activeMenu ~= nil or UserInputService:GetFocusedTextBox() ~= nil
	touchControls.Visible = UserInputService.TouchEnabled and not blocked
	if inputClock >= 1 / 12 then
		inputClock = 0
		local throttle = down(Enum.KeyCode.W, Enum.KeyCode.Up) - down(Enum.KeyCode.S, Enum.KeyCode.Down)
		local steer = down(Enum.KeyCode.D, Enum.KeyCode.Right) - down(Enum.KeyCode.A, Enum.KeyCode.Left)
		if math.abs(stick.Y) > 0.15 then throttle = stick.Y end
		if math.abs(stick.X) > 0.15 then steer = stick.X end
		throttle += (touchHeld.Forward and 1 or 0) - (touchHeld.Back and 1 or 0)
		steer += (touchHeld.Right and 1 or 0) - (touchHeld.Left and 1 or 0)
		local drift = down(Enum.KeyCode.Space, Enum.KeyCode.ButtonX) == 1 or touchHeld.Drift == true
		local boost = down(Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonA) == 1 or touchHeld.Boost == true
		inputRemote:FireServer(blocked and 0 or math.clamp(throttle, -1, 1), blocked and 0 or math.clamp(steer, -1, 1), not blocked and drift, not blocked and boost)
	end
	if not camera then return end
	local folder = workspace:FindFirstChild("ShadowRacingVehicles")
	local atv = folder and folder:FindFirstChild("ATV_" .. player.UserId)
	local chassis = atv and atv.PrimaryPart
	local race = state.Race
	local nextPoint = Track.Points and Track.Points[tonumber(race.Checkpoint) or 0]
	local showBeacon = race.Phase == "Racing" and (tonumber(race.Position) or 0) > 0 and nextPoint ~= nil and not welcomeOpen and not activeMenu
	beaconGui.Enabled = showBeacon
	beacon.Transparency = showBeacon and 0.25 or 1
	if showBeacon then
		beacon.Position = Vector3.new(nextPoint[1], nextPoint[2] + 13, nextPoint[3])
		if chassis then
			beaconDistance.Text = tostring(math.floor((beacon.Position - chassis.Position).Magnitude)) .. " studs"
		end
	end
	if not chassis then
		if cameraActive then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			cameraActive = false
		end
		return
	end
	local speed = math.abs(tonumber(state.Vehicle.Speed) or 0)
	local forward = chassis.CFrame.LookVector
	local target = chassis.Position + Vector3.new(0, 2.5, 0) + forward * 6
	local desiredPosition = chassis.Position - forward * (welcomeOpen and 24 or 19 + speed * 0.055) + Vector3.new(0, welcomeOpen and 12 or 9, 0)
	local desired = CFrame.lookAt(desiredPosition, target)
	camera.CameraType = Enum.CameraType.Scriptable
	if not cameraActive then camera.CFrame = desired; cameraActive = true end
	camera.CFrame = camera.CFrame:Lerp(desired, 1 - math.exp(-dt * 7))
	camera.FieldOfView += ((70 + math.min(speed * 0.12, 15)) - camera.FieldOfView) * (1 - math.exp(-dt * 3))
end)

updateLayout()
if UserInputService:GetLastInputType() == Enum.UserInputType.Gamepad1 then GuiService.SelectedObject = rideButton end
actionRemote:FireServer("Ready")
task.delay(12, function()
	if not connected then showToast("The server is still loading. Check Studio's Output window if this continues.") end
end)
]]></ProtectedString>
