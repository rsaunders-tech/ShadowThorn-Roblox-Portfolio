			</Item>
			<Item class="ModuleScript" referent="RBX00000190">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Authoritative three-night survival simulation. No client-supplied damage or rewards.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Survival = {}
local MODES = {First=true, Last=true, Strongest=true, Closest=true}

local function finite(n)
	return type(n)=="number" and n==n and math.abs(n)<1000000
end
local function horizontal(v) return Vector3.new(v.X,0,v.Z) end
local function distance(a,b) return (horizontal(a)-horizontal(b)).Magnitude end
local function alive(player)
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health>0 then return root,humanoid end
	return nil,nil
end
local function copy(t) local out={};for k,v in pairs(t) do out[k]=v end;return out end

function Survival.new(config,rules,world,profiles,remotes,commerce,cosmetics)
	local self={Phase="Lobby",Clock=0,Night=1,Wave=0,Health=config.CommandHealth,Deadline=0}
	local states,occupied,defenses,enemies,nodes,connections,votes={},{},{},{},{},{},{}
	local nextDefense,nextEnemy,enemyCount=0,0,0
	local queue,spawnAt,nightStarted,wavesThisNight,nextWaveAt={},0,0,0,nil
	local closed=false
	local fast=RunService:IsStudio() and config.StudioFastMode==true
	local function duration(value) return fast and math.max(1,value*0.08) or value end
	local function notice(player,message)
		if remotes.Effect and player.Parent==Players then remotes.Effect:FireClient(player,{Kind="Notice",Text=message}) end
	end
	local function effect(payload) if remotes.Effect then remotes.Effect:FireAllClients(payload) end end
	local function eachState(callback)
		for player,state in pairs(states) do callback(player,state) end
	end
	local function clearEnemies()
		for _,enemy in pairs(enemies) do if enemy.Model then enemy.Model:Destroy() end end
		enemies={};enemyCount=0;queue={};nextWaveAt=nil
	end
	local function removeDefense(id)
		local defense=defenses[id]
		if defense then if defense.Model then defense.Model:Destroy() end;defenses[id]=nil end
	end
	local function clearDefenses(owner)
		local ids={};for id,d in pairs(defenses) do if owner==nil or d.Owner==owner then table.insert(ids,id) end end
		for _,id in ipairs(ids) do removeDefense(id) end
	end
	local function rebuildHut(player,state)
		state.Hut.Model=world:CreateHut(state.Index,state.Hut.Tier,state.Hut.Health,player.DisplayName)
		state.Hut.Model:SetAttribute("PlotIndex",state.Index)
		state.Hut.Model:SetAttribute("OwnerId",player.UserId)
		if cosmetics then cosmetics:Apply(player,state.Hut.Model) end
	end
	local function resetState(player,state)
		state.Resources=copy(config.Starting)
		state.Hut={Tier=1,Health=config.Huts[1].Health}
		state.Weapon={Ammo=config.Weapon.Magazine,NextFire=0,ReloadAt=0}
		state.Stats={Kills=0,Damage=0,Nights=0,CreditsEarned=0}
		state.MatchAwarded=false
		rebuildHut(player,state)
	end
	local function resetNodes()
		for _,node in pairs(nodes) do
			node.Remaining=config.Resources[node.Kind].Capacity;node.RefillAt=0;node.Holds={}
		end
	end
	local function setPhase(phase,seconds)
		self.Phase=phase;self.Deadline=self.Clock+(seconds or 0)
		world:SetPhase(phase,self.Night)
		for _,node in pairs(nodes) do node.Prompt.Enabled=phase=="Day" and node.Remaining>0 end
	end
	local function resetMatch()
		clearEnemies();clearDefenses();votes={};self.Night=1;self.Wave=0;self.Health=config.CommandHealth
		world:UpdateCommand(self.Health);resetNodes()
		eachState(resetState);setPhase("Lobby",0)
	end
	local function charge(state,cost)
		for _,key in ipairs({"Wood","Scrap","Credits"}) do if state.Resources[key]<(cost[key] or 0) then return false end end
		for _,key in ipairs({"Wood","Scrap","Credits"}) do state.Resources[key]-=cost[key] or 0 end
		return true
	end
	local function near(player,position,maxDistance)
		local root=alive(player)
		return root~=nil and (root.Position-position).Magnitude<=maxDistance
	end
	local function canBuild(player,state)
		return (self.Phase=="Day" or self.Phase=="Warning") and alive(player)~=nil and state.Hut.Health>0
	end
	local function killEnemy(enemy,owner)
		if enemies[enemy.Id]~=enemy then return end
		enemies[enemy.Id]=nil;enemyCount-=1;enemy.Model:Destroy()
		local state=owner and states[owner]
		if state then
			state.Resources.Credits+=enemy.Spec.Reward
			state.Stats.CreditsEarned+=enemy.Spec.Reward;state.Stats.Kills+=1
			profiles:Award(owner,{XP=enemy.Spec.XP,Kills=1})
		end
	end
	local function damageEnemy(enemy,raw,owner)
		if enemies[enemy.Id]~=enemy then return end
		local amount=math.max(1,raw*(1-(enemy.Spec.Armor or 0)))
		local actual=math.min(amount,enemy.Health)
		enemy.Health=math.max(0,enemy.Health-amount)
		if owner and states[owner] then states[owner].Stats.Damage+=actual end
		world:UpdateHealth(enemy.Model,enemy.Health,enemy.Spec.Health)
		if enemy.Health<=0 then killEnemy(enemy,owner) end
	end
	local function finish(result)
		if self.Phase=="Victory" or self.Phase=="Defeat" then return end
		setPhase(result,0);clearEnemies()
		eachState(function(player,state)
			if not state.MatchAwarded then
				state.MatchAwarded=true
				profiles:Award(player,{XP=result=="Victory" and 150 or 25,Wins=result=="Victory" and 1 or 0})
			end
		end)
	end
	local function commandDamage(amount)
		self.Health=math.max(0,self.Health-amount);world:UpdateCommand(self.Health)
		effect({Kind="BaseHit",Text=self.Health<=200 and "LAST STAND — protect the command post" or "Command post under attack"})
		if self.Health<=0 then finish("Defeat") end
	end
	local function damageHut(player,state,amount)
		if state.Hut.Health<=0 then return end
		state.Hut.Health=math.max(0,state.Hut.Health-amount)
		world:UpdateHealth(state.Hut.Model,state.Hut.Health,config.Huts[state.Hut.Tier].Health)
		if state.Hut.Health<=0 then notice(player,"Your hut was destroyed. Repair it during the next day; your unlocked blueprint is safe.") end
	end
	local function spawnWave()
		self.Wave+=1;wavesThisNight+=1;queue={}
		eachState(function(player) profiles:Award(player,{BestWave=self.Wave}) end)
		for _,group in ipairs(config.Waves[self.Wave] or {}) do
			for _=1,group.Count do table.insert(queue,{Kind=group.Kind,Interval=group.Interval}) end
		end
		spawnAt=self.Clock;nextWaveAt=nil
	end
	local function beginNight()
		setPhase("Night",0);nightStarted=self.Clock;wavesThisNight=0;spawnWave()
	end
	local function endNight()
		eachState(function(player,state)
			state.Resources.Credits+=100;state.Stats.CreditsEarned+=100;state.Stats.Nights+=1
			profiles:Award(player,{XP=50,Nights=1,Tokens=15,BestWave=self.Wave})
		end)
		if self.Night>=config.Nights then finish("Victory") else self.Night+=1;setPhase("Day",duration(config.DayDuration)) end
	end
	local function createEnemy(kind)
		nextEnemy+=1;local spec=config.Enemies[kind];local start=config.Path[1]
		local model=world:CreateEnemy(kind,nextEnemy)
		model:SetAttribute("Id",nextEnemy);model:SetAttribute("Kind",kind)
		local enemy={Id=nextEnemy,Kind=kind,Spec=spec,Model=model,Health=spec.Health,
			Position=Vector3.new(start.X,0,start.Z),Waypoint=2,AttackAt=0,Raider=nextEnemy%3==0,Raided=false,Progress=0}
		model:PivotTo(CFrame.new(enemy.Position));enemies[nextEnemy]=enemy;enemyCount+=1
	end
	local function nearestHut(position)
		local best,bestPlayer,bestDistance=nil,nil,math.huge
		for player,state in pairs(states) do
			if state.Hut.Health>0 then
				local d=distance(position,world:GetPlotPosition(state.Index))
				if d<bestDistance then best,bestPlayer,bestDistance=state,player,d end
			end
		end
		return best,bestPlayer
	end
	local function moveEnemy(enemy,target,dt)
		local delta=horizontal(target-enemy.Position);local length=delta.Magnitude
		if length<0.001 then return true end
		local travel=math.min(length,enemy.Spec.Speed*dt)
		enemy.Position+=delta.Unit*travel
		local facing=enemy.Position+delta.Unit
		enemy.Model:PivotTo(CFrame.lookAt(enemy.Position,facing))
		return length<=travel+0.05
	end
	local function stepEnemy(enemy,dt)
		if enemies[enemy.Id]~=enemy then return end
		-- A bounded player engagement radius prevents chasing across the whole map.
		for player in pairs(states) do
			local root,humanoid=alive(player)
			if root and (root.Position-(enemy.Position+Vector3.new(0,2.5,0))).Magnitude<6 then
				if self.Clock>=enemy.AttackAt then enemy.AttackAt=self.Clock+enemy.Spec.AttackInterval;humanoid:TakeDamage(enemy.Spec.Damage) end
				return
			end
		end
		local target
		local raidState,raidPlayer
		if enemy.Raider and not enemy.Raided and enemy.Waypoint>=3 then
			raidState,raidPlayer=nearestHut(enemy.Position)
			if raidState then target=world:GetPlotPosition(raidState.Index) else enemy.Raided=true end
		end
		if not target then
			local waypoint=config.Path[enemy.Waypoint]
			if not waypoint then
				if self.Clock>=enemy.AttackAt then enemy.AttackAt=self.Clock+enemy.Spec.AttackInterval;commandDamage(enemy.Spec.Damage) end
				return
			end
			target=Vector3.new(waypoint.X,0,waypoint.Z)
		end
		-- Attack physical player constructions when they intercept the current route.
		local delta=horizontal(target-enemy.Position)
		for id,defense in pairs(defenses) do
			local offset=horizontal(defense.Position-enemy.Position)
			local forward=delta.Magnitude>0 and offset:Dot(delta.Unit) or 0
			if distance(enemy.Position,defense.Position)<config.Defenses[defense.Kind].Radius+2 and forward>=-1 then
				if self.Clock>=enemy.AttackAt then
					enemy.AttackAt=self.Clock+enemy.Spec.AttackInterval;defense.Health=math.max(0,defense.Health-enemy.Spec.Damage)
					world:UpdateHealth(defense.Model,defense.Health,config.Defenses[defense.Kind].Health)
					if defense.Health<=0 then removeDefense(id) end
				end
				return
			end
		end
		if raidState and distance(enemy.Position,target)<config.HutRadius+2 then
			if self.Clock>=enemy.AttackAt then enemy.AttackAt=self.Clock+enemy.Spec.AttackInterval;damageHut(raidPlayer,raidState,enemy.Spec.Damage) end
			if raidState.Hut.Health<=0 then enemy.Raided=true end
			return
		end
		if moveEnemy(enemy,target,dt) and not raidState then enemy.Waypoint+=1 end
		-- Used by First/Last target priorities. Raiders retain route ordering.
		enemy.Progress=(enemy.Waypoint-1)*100-math.min(99,distance(enemy.Position,target))
	end
	local function targetFor(defense,range)
		local best,score=nil,nil
		local from=defense.Position+Vector3.new(0,4,0)
		local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances={defense.Model}
		for _,enemy in pairs(enemies) do
			local d=distance(defense.Position,enemy.Position)
			if d<=range then
				local hit=workspace:Raycast(from,enemy.Position+Vector3.new(0,3,0)-from,ray)
				if hit and not hit.Instance:IsDescendantOf(enemy.Model) then continue end
				local value=defense.Target=="Closest" and -d or defense.Target=="Strongest" and enemy.Health
					or defense.Target=="Last" and -enemy.Progress or enemy.Progress
				if score==nil or value>score then best,score=enemy,value end
			end
		end
		return best
	end
	local function stepTower(defense)
		if defense.Kind~="Rifleman" or self.Clock<defense.FireAt then return end
		local definition=config.Defenses.Rifleman
		if defense.ReloadAt and defense.ReloadAt>0 then
			if self.Clock<defense.ReloadAt then return end
			defense.Ammo=definition.Magazine or 12;defense.ReloadAt=0
		end
		local spec=config.Defenses.Rifleman.Levels[defense.Level]
		local target=targetFor(defense,spec.Range)
		if not target then return end
		local from=defense.Position+Vector3.new(0,4,0);local to=target.Position+Vector3.new(0,3,0)
		if world.AimDefense then world:AimDefense(defense.Model,to) end
		defense.FireAt=self.Clock+spec.Cooldown
		defense.Ammo=(defense.Ammo or definition.Magazine or 12)-1
		if defense.Ammo<=0 then defense.ReloadAt=self.Clock+(definition.Reload or 2) end
		local owner=Players:GetPlayerByUserId(defense.Owner)
		damageEnemy(target,spec.Damage,owner)
		effect({Kind="Shot",From=from,To=to,Color=owner and cosmetics and cosmetics:TracerColor(owner) or Color3.fromRGB(220,190,110)})
	end
	local function gather(player,id)
		local state,node=states[player],nodes[id]
		if not state or not node or self.Phase~="Day" then return end
		local held=node.Holds[player];node.Holds[player]=nil
		local spec=config.Resources[node.Kind]
		if not held or self.Clock-held<spec.Hold*0.85 or not near(player,node.Part.Position,12) then return end
		if node.Remaining<=0 or self.Clock<(state.NextGather or 0) then return end
		state.NextGather=self.Clock+0.5;node.Remaining-=1
		state.Resources[node.Kind]+=spec.Amount
		if node.Remaining==0 then node.RefillAt=self.Clock+spec.Respawn;node.Prompt.Enabled=false end
		node.Part:SetAttribute("Remaining",node.Remaining)
		notice(player,"+"..spec.Amount.." "..node.Kind)
	end
	local resourceFolder=workspace:FindFirstChild("ShadowZoneWorld")
	resourceFolder=resourceFolder and resourceFolder:FindFirstChild("Resources")
	if resourceFolder then
		for _,part in ipairs(resourceFolder:GetChildren()) do
			local id=part:GetAttribute("NodeId");local kind=part:GetAttribute("Kind")
			if part:IsA("BasePart") and type(id)=="number" and config.Resources[kind] then
				local spec=config.Resources[kind];local prompt=Instance.new("ProximityPrompt")
				prompt.Name="Gather";prompt.ActionText="Gather "..kind;prompt.ObjectText=kind.." salvage"
				prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.HoldDuration=spec.Hold;prompt.MaxActivationDistance=10
				prompt.RequiresLineOfSight=false;prompt.Enabled=false;prompt.Parent=part
				local node={Part=part,Kind=kind,Prompt=prompt,Remaining=spec.Capacity,RefillAt=0,Holds={}}
				nodes[id]=node;part:SetAttribute("Remaining",spec.Capacity)
				table.insert(connections,prompt.PromptButtonHoldBegan:Connect(function(player)
					if self.Phase=="Day" and states[player] and near(player,part.Position,12) then node.Holds[player]=self.Clock end
				end))
				table.insert(connections,prompt.PromptButtonHoldEnded:Connect(function(player)
					local began=node.Holds[player]
					task.delay(0.15,function() if node.Holds[player]==began then node.Holds[player]=nil end end)
				end))
				table.insert(connections,prompt.Triggered:Connect(function(player) gather(player,id) end))
			end
		end
	end
	function self:RefreshCosmetics(player)
		local state=states[player]
		if state and cosmetics then cosmetics:Apply(player,state.Hut.Model) end
	end
	function self:AddPlayer(player)
		if states[player] then return true end
		local index
		for i=1,config.MaxPlayers do if not occupied[i] then index=i;break end end
		if not index then notice(player,"All four survival plots are occupied.");return false end
		occupied[index]=player
		local state={Index=index,Connections={}};states[player]=state;resetState(player,state)
		if self.Phase~="Lobby" and self.Phase~="Victory" and self.Phase~="Defeat" then profiles:Award(player,{Matches=1,BestWave=self.Wave}) end
		local function characterAdded(character)
			task.spawn(function()
				local root=character:WaitForChild("HumanoidRootPart",10)
				local humanoid=character:WaitForChild("Humanoid",10)
				if states[player]~=state or player.Character~=character or not root or not humanoid then return end
				-- CharacterAdded can run before Roblox finishes applying SpawnLocation.
				-- Let that initial placement settle, then validate the same live character again.
				task.wait(0.3)
				if states[player]~=state or player.Character~=character or player.Parent~=Players or humanoid.Health<=0 then return end
				character:PivotTo(CFrame.new(world:GetPlotPosition(index)+Vector3.new(0,4,12)))
				world:CreateRifle(character)
				state.Weapon.Ammo=config.Weapon.Magazine;state.Weapon.ReloadAt=0
			end)
		end
		table.insert(state.Connections,player.CharacterAdded:Connect(characterAdded))
		if player.Character then characterAdded(player.Character) end
		return true
	end
	function self:RemovePlayer(player)
		local state=states[player];if not state then return end
		for _,connection in ipairs(state.Connections) do connection:Disconnect() end
		if state.Hut.Model then state.Hut.Model:Destroy() end
		clearDefenses(player.UserId);occupied[state.Index]=nil;states[player]=nil;votes[player.UserId]=nil
		for _,node in pairs(nodes) do node.Holds[player]=nil end
		local count=0;for _ in pairs(states) do count+=1 end
		if count==0 then resetMatch() else self:CheckRestart() end
	end
	function self:CheckRestart()
		if self.Phase~="Victory" and self.Phase~="Defeat" then return end
		local count,needed=0,0
		for player in pairs(states) do needed+=1;if votes[player.UserId] then count+=1 end end
		if needed>0 and count>=math.floor(needed/2)+1 then resetMatch() end
	end
	local function placement(player,state,data)
		local kind=data.Kind;local spec=config.Defenses[kind]
		if not spec or not finite(data.X) or not finite(data.Z) or not finite(data.Rotation or 0) then return false,"Choose a valid defense and location." end
		if not canBuild(player,state) then return false,"Build during preparation with a standing hut." end
		local x=math.round(data.X/config.Grid)*config.Grid;local z=math.round(data.Z/config.Grid)*config.Grid
		local rotation=math.round((data.Rotation or 0)/90)*90%360;local pos=Vector3.new(x,0,z)
		local plot=config.Plots[state.Index];local radius=spec.Radius
		if math.abs(x-plot.X)+radius>config.PlotHalfSize or math.abs(z-plot.Z)+radius>config.PlotHalfSize then return false,"Stay inside your plot boundary." end
		if distance(pos,world:GetPlotPosition(state.Index))<config.HutRadius+radius then return false,"Keep the hut entrance and walls clear." end
		if not near(player,pos,45) then return false,"Move closer to your plot before building." end
		local count=0
		for _,defense in pairs(defenses) do
			if defense.Owner==player.UserId and defense.Kind==kind then count+=1 end
			if distance(pos,defense.Position)<radius+config.Defenses[defense.Kind].Radius then return false,"That location overlaps another defense." end
		end
		if count>=spec.MaxPerPlayer then return false,"You reached this defense's placement limit." end
		-- Broad-phase collision check covers props/characters as well as authored build rules.
		local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Exclude
		overlap.FilterDescendantsInstances={player.Character}
		for _,part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(pos+Vector3.new(0,2.6,0))*CFrame.Angles(0,math.rad(rotation),0),Vector3.new(radius*2,4,radius*2),overlap)) do
			if part.CanCollide and part.Position.Y+part.Size.Y/2>0.5 then return false,"That location is blocked." end
		end
		if not charge(state,spec) then return false,"You need more resources for that defense." end
		nextDefense+=1
		local model=world:CreateDefense(kind,pos,rotation,nextDefense,player.DisplayName)
		model:SetAttribute("Id",nextDefense);model:SetAttribute("Kind",kind);model:SetAttribute("OwnerId",player.UserId)
		defenses[nextDefense]={Id=nextDefense,Kind=kind,Position=pos,Rotation=rotation,Owner=player.UserId,
			Model=model,Health=spec.Health,Level=1,Target="First",FireAt=0,Spent=spec.Credits}
		return true,"Defense placed."
	end
	function self:Handle(player,action,data)
		local state=states[player];if not state then return false,"No survival plot is available." end
		data=data or {}
		if action=="Sync" then return true end
		if action=="Play" then
			if self.Phase~="Lobby" then return false,"The match is already running." end
			eachState(function(p) profiles:Award(p,{Matches=1}) end)
			setPhase("Day",duration(config.DayDuration));return true,"Gather wood and scrap before nightfall."
		elseif action=="Restart" then
			if self.Phase~="Victory" and self.Phase~="Defeat" then return false,"Restart after the match ends." end
			votes[player.UserId]=true;self:CheckRestart();return true,"Restart vote recorded."
		elseif action=="Gather" then return false,"Hold the resource node's interaction prompt to gather."
		elseif action=="Place" then return placement(player,state,data)
		elseif action=="UpgradeHut" then
			if not canBuild(player,state) or not near(player,world:GetPlotPosition(state.Index),28) then return false,"Stand near your hut during preparation." end
			local nextTier=state.Hut.Tier+1;local spec=config.Huts[nextTier]
			if not spec then return false,"The prototype's highest hut tier is Military Outpost." end
			if not charge(state,spec) then return false,"Need "..spec.Wood.." Wood and "..spec.Scrap.." Scrap." end
			state.Hut.Tier=nextTier;state.Hut.Health=spec.Health;profiles:UnlockTier(player,nextTier);rebuildHut(player,state)
			return true,spec.Name.." constructed."
		elseif action=="RepairHut" then
			if self.Phase~="Day" or not near(player,world:GetPlotPosition(state.Index),28) then return false,"Repair your hut nearby during the day." end
			local max=config.Huts[state.Hut.Tier].Health
			if state.Hut.Health>=max then return false,"Your hut is already fully repaired." end
			if not charge(state,config.HutRepair) then return false,"Repairs need 10 Wood and 5 Scrap." end
			state.Hut.Health=math.min(max,state.Hut.Health+config.HutRepair.Amount)
			world:UpdateHealth(state.Hut.Model,state.Hut.Health,max);return true,"Hut repaired."
		elseif action=="Reload" then
			if not alive(player) or state.Weapon.ReloadAt>0 or state.Weapon.Ammo>=config.Weapon.Magazine then return false end
			state.Weapon.ReloadAt=self.Clock+config.Weapon.Reload;return true,"Reloading."
		elseif action=="Shoot" then
			local direction=data.Direction
			if typeof(direction)~="Vector3" or not finite(direction.X) or not finite(direction.Y) or not finite(direction.Z) or direction.Magnitude<0.1 then return false end
			if self.Phase~="Night" and self.Phase~="Day" and self.Phase~="Warning" then return false end
			local root=alive(player);local tool=player.Character and player.Character:FindFirstChildOfClass("Tool")
			if not root or not tool or not tool:GetAttribute("ShadowRifle") then return false end
			if state.Weapon.ReloadAt>0 or self.Clock<state.Weapon.NextFire or state.Weapon.Ammo<=0 then return false end
			state.Weapon.Ammo-=1;state.Weapon.NextFire=self.Clock+config.Weapon.FireInterval
			local from=root.Position+Vector3.new(0,1.2,0)
			local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances={player.Character}
			local hit=workspace:Raycast(from,direction.Unit*config.Weapon.Range,ray)
			local to=hit and hit.Position or from+direction.Unit*config.Weapon.Range
			if hit then
				local model=hit.Instance:FindFirstAncestorOfClass("Model");local id=model and model:GetAttribute("Id")
				local enemy=id and enemies[id]
				if enemy and hit.Instance:IsDescendantOf(enemy.Model) then
					damageEnemy(enemy,config.Weapon.Damage,player)
					if remotes.Effect then remotes.Effect:FireClient(player,{Kind="Hit",From=from,To=to}) end
				end
			end
			effect({Kind="Shot",From=from,To=to,Color=cosmetics and cosmetics:TracerColor(player) or Color3.fromRGB(220,190,110)})
			return true
		elseif action=="Upgrade" or action=="Sell" or action=="Target" or action=="Repair" then
			if not finite(data.Id) or data.Id%1~=0 then return false end
			local defense=defenses[data.Id]
			if not defense or defense.Owner~=player.UserId then return false,"You can only manage your own defenses." end
			if not near(player,defense.Position,45) then return false,"Move closer to your defense." end
			if action=="Target" then
				if not MODES[data.Mode] or defense.Kind~="Rifleman" then return false end
				defense.Target=data.Mode;return true,"Target priority: "..data.Mode
			end
			if self.Phase~="Day" and self.Phase~="Warning" then return false,"Manage defenses during preparation." end
			if action=="Upgrade" then
				local prices=config.Defenses[defense.Kind].UpgradeCosts;local price=prices and prices[defense.Level]
				if not price then return false,"Defense is at its highest level." end
				if not charge(state,{Credits=price}) then return false,"Not enough requisition credits." end
				defense.Level+=1;defense.Spent+=price;defense.Model:SetAttribute("Level",defense.Level)
				if world.UpdateDefense then world:UpdateDefense(defense.Model,defense.Level,defense.Health,config.Defenses[defense.Kind].Health) end
				return true,"Rifleman upgraded to level "..defense.Level
			elseif action=="Sell" then
				state.Resources.Credits+=math.floor(defense.Spent*0.7);removeDefense(defense.Id);return true,"Defense sold for 70% of spent credits."
			else
				local max=config.Defenses[defense.Kind].Health
				if defense.Health>=max then return false,"Defense is fully repaired." end
				if not charge(state,{Wood=5,Scrap=2}) then return false,"Repairs need 5 Wood and 2 Scrap." end
				defense.Health=math.min(max,defense.Health+60);world:UpdateHealth(defense.Model,defense.Health,max)
				return true,"Defense repaired."
			end
		end
		return false,"Unknown action."
	end
	function self:Step(dt)
		if closed or not finite(dt) or dt<=0 then return end
		dt=math.min(dt,0.1);self.Clock+=dt
		eachState(function(_,state)
			if state.Weapon.ReloadAt>0 and self.Clock>=state.Weapon.ReloadAt then state.Weapon.ReloadAt=0;state.Weapon.Ammo=config.Weapon.Magazine end
		end)
		for _,node in pairs(nodes) do
			if node.Remaining==0 and self.Clock>=node.RefillAt then
				node.Remaining=config.Resources[node.Kind].Capacity;node.Part:SetAttribute("Remaining",node.Remaining)
				node.Prompt.Enabled=self.Phase=="Day"
			end
		end
		if self.Phase=="Day" and self.Clock>=self.Deadline then setPhase("Warning",duration(config.WarningDuration))
		elseif self.Phase=="Warning" and self.Clock>=self.Deadline then beginNight()
		elseif self.Phase=="Night" then
			if #queue>0 and self.Clock>=spawnAt then
				local item=table.remove(queue,1);createEnemy(item.Kind);spawnAt=self.Clock+item.Interval
			end
			for _,defense in pairs(defenses) do stepTower(defense) end
			local living={};for _,enemy in pairs(enemies) do table.insert(living,enemy) end
			for _,enemy in ipairs(living) do if self.Phase=="Night" then stepEnemy(enemy,dt) end end
			if self.Phase=="Night" and #queue==0 and enemyCount==0 then
				if wavesThisNight<2 then
					if not nextWaveAt then nextWaveAt=self.Clock+duration(config.InterWave) end
					if self.Clock>=nextWaveAt then spawnWave() end
				elseif self.Clock-nightStarted>=duration(config.NightMinimum) then endNight() end
			end
		end
	end
	function self:GetState(player)
		local state=states[player];local profile=profiles:Get(player)
		if not state then return {Ready=false,Phase=self.Phase,Message="All four survival plots are occupied."} end
		local list={}
		for id,defense in pairs(defenses) do if defense.Owner==player.UserId then
			local spec=config.Defenses[defense.Kind];local costs=spec.UpgradeCosts
			table.insert(list,{Id=id,Kind=defense.Kind,Level=defense.Level,X=defense.Position.X,Z=defense.Position.Z,
				Health=defense.Health,MaxHealth=spec.Health,Target=defense.Target,UpgradeCost=costs and costs[defense.Level],SellValue=math.floor(defense.Spent*0.7)})
		end end
		table.sort(list,function(a,b) return a.Id<b.Id end)
		local count,needed=0,0;for p in pairs(states) do needed+=1;if votes[p.UserId] then count+=1 end end
		local countdown=(self.Phase=="Day" or self.Phase=="Warning") and math.max(0,math.ceil(self.Deadline-self.Clock))
			or self.Phase=="Night" and math.max(0,math.ceil(duration(config.NightMinimum)-(self.Clock-nightStarted))) or 0
		return {Ready=profile~=nil,Phase=self.Phase,Countdown=countdown,
			Night=self.Night,Wave=self.Wave,TotalWaves=#config.Waves,Enemies=enemyCount,CommandHealth=self.Health,MaxCommandHealth=config.CommandHealth,
			Resources=copy(state.Resources),PlotIndex=state.Index,Hut={Tier=state.Hut.Tier,Health=state.Hut.Health,MaxHealth=config.Huts[state.Hut.Tier].Health,UnlockedTier=profile and profile.HutTier or 1},
			Defenses=list,Weapon={Ammo=state.Weapon.Ammo,Magazine=config.Weapon.Magazine,Reloading=state.Weapon.ReloadAt>0},Stats=copy(state.Stats),Profile=profile,
			Shop=commerce and commerce:GetState(player) or nil,RestartVotes=count,RestartNeeded=math.floor(needed/2)+1}
	end
	function self:Close()
		closed=true;clearEnemies();clearDefenses()
		for _,connection in ipairs(connections) do connection:Disconnect() end
		for _,state in pairs(states) do for _,connection in ipairs(state.Connections) do connection:Disconnect() end end
	end
	return self
end
return Survival
]]></ProtectedString>
					<string name="ScriptGuid">{00F2F0FB-4423-42BC-ABF2-07668883F5B4}</string>
