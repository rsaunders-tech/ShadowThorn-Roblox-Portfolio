			<Item class="ModuleScript" referent="RBX0000018D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Catalog=require(game:GetService("ReplicatedStorage"):WaitForChild("ShadowZoneDefense"):WaitForChild("Catalog"))
local Visuals={}
local function color(rgb) return Color3.fromRGB(rgb[1],rgb[2],rgb[3]) end
function Visuals.new(_config,profiles)
	local self={}
	local function owned(player,profile,key)
		local item=Catalog.Cosmetics[key]
		return item and (item.Default or (profile.Cosmetics and profile.Cosmetics[key]) or (item.Pass and player:GetAttribute("SZDSupporter")==true))
	end
	function self:TracerColor(player)
		local profile=profiles:Get(player)
		local key=profile and profile.Equipped.Tracer or "Standard"
		if not profile or not owned(player,profile,key) then key="Standard" end
		return color(Catalog.Cosmetics[key].Color)
	end
	function self:Apply(player,hut)
		if not hut or not hut.Parent then return end
		local profile=profiles:Get(player)
		if not profile then return end
		local key=profile.Equipped.Hut
		if not owned(player,profile,key) or Catalog.Cosmetics[key].Slot~="Hut" then key="FieldOlive" end
		for _,part in ipairs(hut:GetDescendants()) do
			if part:IsA("BasePart") and (part:GetAttribute("CosmeticSurface")==true or part.Name=="CosmeticSurface") then part.Color=color(Catalog.Cosmetics[key].Color) end
		end
		local previous=hut:FindFirstChild("CosmeticFlag")
		if previous then previous:Destroy() end
		local flagKey=profile.Equipped.Flag
		local flag=Catalog.Cosmetics[flagKey]
		if flagKey=="None" or not flag or flag.Slot~="Flag" or not owned(player,profile,flagKey) then return end
		local decoration=Instance.new("Model");decoration.Name="CosmeticFlag";decoration.Parent=hut
		local pivot=hut:GetPivot()
		local function part(name,size,offset,tint)
			local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=pivot*CFrame.new(offset);p.Color=tint
			p.Material=Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=decoration
			return p
		end
		part("Pole",Vector3.new(0.2,8,0.2),Vector3.new(6,4,5),Color3.fromRGB(115,122,115))
		local cloth=part("Banner",Vector3.new(3,2,0.12),Vector3.new(7.5,6.5,5),color(flag.Color))
		local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(240,160);gui.Parent=cloth
		local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1
		text.Text=flagKey=="SupporterFlag" and "★\nSUPPORTER" or "SZD\nOUTPOST";text.TextColor3=Color3.fromRGB(31,40,32)
		text.Font=Enum.Font.GothamBold;text.TextScaled=true;text.Parent=gui
	end
	return self
end
return Visuals
]]></ProtectedString>
					<string name="ScriptGuid">{A190EBEB-8002-4E68-80C5-F64BA3097A8F}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CosmeticVisuals</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7d1df30f2087bb050af1baf500000568</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX0000018E">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local shared=ReplicatedStorage:WaitForChild("ShadowZoneDefense")
local Config=require(shared:WaitForChild("Config"))
local Rules=require(shared:WaitForChild("Rules")).new(Config)
local function folder(parent,name)
	local found=parent:FindFirstChild(name)
	if found then return found end
	local item=Instance.new("Folder");item.Name=name;item.Parent=parent;return item
end
local remotesFolder=folder(shared,"Remotes")
local remotes={}
for _,name in ipairs({"Action","State","Effect"}) do
	local remote=remotesFolder:FindFirstChild(name) or Instance.new("RemoteEvent")
	remote.Name=name;remote.Parent=remotesFolder;remotes[name]=remote
end
local world=require(script.Parent.World).new(Config);world:Build()
local profiles=require(script.Parent.Profiles).new(Config)
local commerce=require(script.Parent.Commerce).new(Config,profiles);commerce:Init()
local cosmetics=require(script.Parent.CosmeticVisuals).new(Config,profiles)
local survival=require(script.Parent.Survival).new(Config,Rules,world,profiles,remotes,commerce,cosmetics)
local rates,loading={},{}
local closing=false
local function send(player,message)
	if player.Parent~=Players then return end
	local state=survival:GetState(player);state.Message=message;remotes.State:FireClient(player,state)
end
local function add(player)
	if loading[player] then return end
	loading[player]=true
	task.spawn(function()
		local ok,loaded=pcall(function() return profiles:Load(player) end)
		if closing or not loading[player] or player.Parent~=Players then profiles:Remove(player);return end
		if not ok or loaded==false then warn("[Shadow Zone Defense] Profile could not load:",loaded) end
		survival:AddPlayer(player);send(player)
	end)
end
Players.PlayerAdded:Connect(add)
Players.PlayerRemoving:Connect(function(player)
	loading[player]=nil;rates[player]=nil;survival:RemovePlayer(player);commerce:Remove(player)
	task.spawn(function() profiles:Remove(player) end)
end)
for _,player in ipairs(Players:GetPlayers()) do add(player) end
local ACTIONS={Sync=true,Play=true,Restart=true,UpgradeHut=true,RepairHut=true,Place=true,Upgrade=true,Sell=true,Target=true,Repair=true,Shoot=true,Reload=true,ShopPurchase=true,EquipCosmetic=true}
remotes.Action.OnServerEvent:Connect(function(player,action,data)
	if closing or type(action)~="string" or not ACTIONS[action] or (data~=nil and type(data)~="table") then return end
	local now=os.clock();local rate=rates[player] or {Tokens=20,At=now};rates[player]=rate
	rate.Tokens=math.min(20,rate.Tokens+(now-rate.At)*12);rate.At=now
	if rate.Tokens<1 then return end;rate.Tokens-=1
	data=data or {}
	local ok,accepted,message=pcall(function()
		if action=="ShopPurchase" or action=="EquipCosmetic" then
			local result,text=commerce:Handle(player,action,data)
			if result then survival:RefreshCosmetics(player) end
			return result,text
		end
		return survival:Handle(player,action,data)
	end)
	if not ok then warn("[Shadow Zone Defense] Action failed:",accepted);message="The server could not complete that action." end
	-- Fire-rate traffic does not force additional full UI snapshots.
	if action~="Shoot" then send(player,message) end
end)
local accumulator,broadcast,stepping=0,0,false
RunService.Heartbeat:Connect(function(dt)
	if closing or stepping then return end
	accumulator=math.min(accumulator+dt,0.5);broadcast+=dt;stepping=true
	local ok,err=pcall(function()
		while accumulator>=0.05 do accumulator-=0.05;survival:Step(0.05) end
	end)
	stepping=false
	if not ok then warn("[Shadow Zone Defense] Simulation error:",err) end
	if broadcast>=0.25 then broadcast=0;for _,player in ipairs(Players:GetPlayers()) do send(player) end end
end)
game:BindToClose(function() closing=true;survival:Close();commerce:Close();profiles:Close() end)
print("[Shadow Zone Defense] Prototype ready: 3 nights / 6 waves / hut survival / Rifleman / cosmetics catalog")
]]></ProtectedString>
