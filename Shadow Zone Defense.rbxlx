				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local C = {
	Title="Shadow Zone Defense", MaxPlayers=4, CommandHealth=1000,
	Grid=2, PlotHalfSize=17, HutRadius=7, GroundY=0,
	DayDuration=120, WarningDuration=10, NightMinimum=90, InterWave=5, Nights=3,
	StudioFastMode=false, StudioPersistence=false, StudioCosmeticPreview=false,
	DataStoreName="ShadowZoneDefense_Profiles_v1", XPPerLevel=250,
	Starting={Wood=20,Scrap=10,Credits=250},
	Plots={{X=-42,Z=-30},{X=42,Z=-30},{X=-42,Z=32},{X=42,Z=32}},
	Path={{X=0,Z=-110},{X=0,Z=-80},{X=0,Z=-45},{X=0,Z=-10},{X=0,Z=18}},
	Weapon={Damage=18,Magazine=24,FireInterval=0.16,Range=180,Reload=2},
	Huts={
		{Name="Survivor Hut",Health=100,Wood=0,Scrap=0},
		{Name="Fortified Cabin",Health=200,Wood=60,Scrap=20},
		{Name="Military Outpost",Health=400,Wood=120,Scrap=80},
	},
	HutRepair={Wood=10,Scrap=5,Amount=60},
	Defenses={
		Rifleman={Name="Rifleman",Credits=250,Wood=0,Scrap=0,Health=160,Radius=3,MaxPerPlayer=6,Magazine=12,Reload=2,
			UpgradeCosts={180,350},Levels={{Damage=10,Range=55,Cooldown=0.55},{Damage=16,Range=60,Cooldown=0.48},{Damage=24,Range=65,Cooldown=0.4}}},
		Barricade={Name="Wooden Barricade",Credits=0,Wood=20,Scrap=0,Health=150,Radius=4,MaxPerPlayer=10},
	},
	Nodes={
		{X=-66,Z=-45,Kind="Wood"},{X=-67,Z=-18,Kind="Scrap"},{X=67,Z=-45,Kind="Wood"},{X=67,Z=-18,Kind="Scrap"},
		{X=-67,Z=45,Kind="Wood"},{X=-65,Z=18,Kind="Scrap"},{X=67,Z=45,Kind="Wood"},{X=65,Z=18,Kind="Scrap"},
	},
	Resources={Wood={Amount=20,Capacity=6,Hold=1.2,Respawn=35},Scrap={Amount=10,Capacity=6,Hold=1.5,Respawn=35}},
	Enemies={
		Shambler={Name="Shambler",Health=50,Speed=6,Damage=10,AttackInterval=1.2,Reward=25,XP=4,Color={116,135,99},Scale=1},
		Sprinter={Name="Sprinter",Health=35,Speed=10,Damage=8,AttackInterval=1,Reward=30,XP=5,Color={166,153,82},Scale=0.9},
		Armored={Name="Armored Infected",Health=140,Speed=4.5,Armor=0.3,Damage=18,AttackInterval=1.5,Reward=50,XP=8,Color={90,108,118},Scale=1.15},
	},
	Waves={
		{{Kind="Shambler",Count=6,Interval=1.5}},
		{{Kind="Shambler",Count=8,Interval=1.3}},
		{{Kind="Shambler",Count=8,Interval=1.1},{Kind="Sprinter",Count=3,Interval=1.5}},
		{{Kind="Shambler",Count=10,Interval=1},{Kind="Sprinter",Count=4,Interval=1.3}},
		{{Kind="Shambler",Count=10,Interval=0.9},{Kind="Armored",Count=2,Interval=2}},
		{{Kind="Shambler",Count=12,Interval=0.8},{Kind="Sprinter",Count=6,Interval=1},{Kind="Armored",Count=3,Interval=2}},
	},
}
return C
]]></ProtectedString>
					<string name="ScriptGuid">{D7D35E8D-08BC-42D5-A081-FD1F70EA6C9B}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Config</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7d1df30f2087bb050af1baf500000563</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000188">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Pure rules shared by previews, server validation and offline regression tests.
local Rules = {}
function Rules.IsFinite(n) return type(n)=="number" and n==n and math.abs(n)<1e6 end
function Rules.new(C)
	local self={IsFinite=Rules.IsFinite}
	function self.Snap(n) return math.floor(n/C.Grid+0.5)*C.Grid end
	function self.CanAfford(resources,cost)
		if type(resources)~="table" or type(cost)~="table" then return false end
		for _,key in ipairs({"Wood","Scrap","Credits"}) do
			local price=cost[key] or 0
			if not Rules.IsFinite(price) or price<0 or not Rules.IsFinite(resources[key]) or resources[key]<price then return false end
		end
		return true
	end
	function self.Placement(index,kind,x,z,rotation,existing)
		local plot,def=C.Plots[index],C.Defenses[kind]
		if not plot or not def or not Rules.IsFinite(x) or not Rules.IsFinite(z) or not Rules.IsFinite(rotation) then return false,"Invalid construction request." end
		if rotation%90~=0 or x%C.Grid~=0 or z%C.Grid~=0 then return false,"Snap to the construction grid." end
		local radius=def.Radius
		if math.abs(x-plot.X)>C.PlotHalfSize-radius or math.abs(z-plot.Z)>C.PlotHalfSize-radius then return false,"Build inside your own plot." end
		if math.sqrt((x-plot.X)^2+(z-plot.Z)^2)<C.HutRadius+radius then return false,"Leave the hut entrance clear." end
		local count=0
		for _,other in pairs(existing or {}) do
			local otherDef=C.Defenses[other.Kind]
			if otherDef and Rules.IsFinite(other.X) and Rules.IsFinite(other.Z) then
				if math.sqrt((x-other.X)^2+(z-other.Z)^2)<radius+otherDef.Radius then return false,"Another defense is too close." end
			end
			if other.Kind==kind and (other.PlotIndex==nil or other.PlotIndex==index) then count+=1 end
		end
		if count>=def.MaxPerPlayer then return false,"Defense limit reached." end
		return true
	end
	function self.Damage(raw,armor)
		if not Rules.IsFinite(raw) or raw<0 then return 0 end
		return raw*(1-math.clamp(type(armor)=="number" and armor or 0,0,0.9))
	end
	return self
end
return Rules
]]></ProtectedString>
