			<Item class="ModuleScript" referent="RBX00000186">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Proposed launch catalog. IDs must belong to this experience. Zero means unconfigured.
-- SuggestedRobux is a planning number only; never display it as a live price.
local Catalog = {
	SalesEnabled=false,
	SupportersPass={Key="SupportersPass",Name="Shadow Zone Supporters Pass",Id=0,SuggestedRobux=199,
		Description="Permanent supporter emblem, Signal Gold tracer and Founder Olive hut finish. Cosmetic benefits only."},
	Products={
		{Key="Tokens100",Name="100 Cosmetic Tokens",Id=0,Tokens=100,SuggestedRobux=29,Description="100 tokens for named cosmetics. No combat or survival resources."},
		{Key="Tokens350",Name="350 Cosmetic Tokens",Id=0,Tokens=350,SuggestedRobux=79,Description="350 tokens for named cosmetics. No randomized rewards."},
		{Key="Tokens800",Name="800 Cosmetic Tokens",Id=0,Tokens=800,SuggestedRobux=149,Description="800 tokens for named cosmetics. Tokens cannot be traded or exchanged for Robux."},
	},
	Order={"FieldOlive","SlateCamo","DesertCamo","FounderOlive","Standard","AmberTracer","IceTracer","SignalGold","None","OutpostFlag","SupporterFlag"},
	Cosmetics={
		FieldOlive={Name="Field Olive",Description="Original olive hut finish.",Slot="Hut",Color={97,110,77},TokenCost=0,Default=true},
		SlateCamo={Name="Slate Camouflage",Description="Cool slate hut finish with dark accent panels.",Slot="Hut",Color={80,98,111},TokenCost=120},
		DesertCamo={Name="Desert Camouflage",Description="Sand and tan hut finish.",Slot="Hut",Color={163,143,99},TokenCost=120},
		FounderOlive={Name="Founder Olive",Description="Supporter olive and gold hut finish.",Slot="Hut",Color={114,127,69},Pass=true},
		Standard={Name="Standard Tracer",Description="Default rifle tracer.",Slot="Tracer",Color={235,220,164},TokenCost=0,Default=true},
		AmberTracer={Name="Amber Tracer",Description="Warm amber rifle tracer; identical damage.",Slot="Tracer",Color={255,181,67},TokenCost=80},
		IceTracer={Name="Ice Tracer",Description="Pale cyan rifle tracer; identical damage.",Slot="Tracer",Color={133,226,245},TokenCost=80},
		SignalGold={Name="Signal Gold",Description="Supporter gold rifle tracer; identical damage.",Slot="Tracer",Color={255,221,90},Pass=true},
		None={Name="No Flag",Description="Keep your hut undecorated.",Slot="Flag",Color={97,110,77},TokenCost=0,Default=true},
		OutpostFlag={Name="Outpost Standard",Description="An olive outpost banner beside your hut.",Slot="Flag",Color={130,159,98},TokenCost=100},
		SupporterFlag={Name="Supporter Emblem",Description="A gold supporter standard beside your hut.",Slot="Flag",Color={226,188,72},Pass=true},
	},
}
return Catalog
]]></ProtectedString>
