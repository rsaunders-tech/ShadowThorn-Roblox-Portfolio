					<ProtectedString name="Source"><![CDATA[local MarketplaceService=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Catalog=require(game:GetService("ReplicatedStorage"):WaitForChild("ShadowZoneDefense"):WaitForChild("Catalog"))
local Commerce={}
local function validId(id) return type(id)=="number" and id>0 and id%1==0 end
function Commerce.new(config,profiles)
	local self,cache,connections,lastPrompt={},{},{},{}
	local preview=RunService:IsStudio() and config.StudioCosmeticPreview==true
	local function refresh(player)
		local record=cache[player]
		if not record or record.Loading then return end
		record.Loading=true
		record.RetryAt=os.clock()+120
		if preview then record.Supporter=true
		elseif validId(Catalog.SupportersPass.Id) then
			local ok,owns=pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId,Catalog.SupportersPass.Id) end)
			if ok then record.Supporter=owns==true else record.RetryAt=os.clock()+60 end
		end
		if cache[player]~=record or not player.Parent then return end
		record.Loading=false
		player:SetAttribute("SZDSupporter",record.Supporter==true)
	end
	local function recordFor(player)
		if not cache[player] then
			cache[player]={Supporter=false,Loading=false,RetryAt=0}
			task.spawn(function() refresh(player) end)
		end
		return cache[player]
	end
	function self:GetState(player)
		local record=recordFor(player)
		if not record.Loading and os.clock()>=(record.RetryAt or 0) then task.spawn(function() refresh(player) end) end
		local profile=profiles:Get(player)
		local enabled=Catalog.SalesEnabled==true and profile~=nil and profile.Persistence=="Saved" and not RunService:IsStudio()
		local result={Enabled=enabled,Supporter=record.Supporter==true,Preview=preview,Items={}}
		for _,key in ipairs(Catalog.Order) do
			local item=Catalog.Cosmetics[key]
			local owned=item.Default==true or (profile and profile.Cosmetics[key]==true) or (item.Pass==true and record.Supporter==true)
			table.insert(result.Items,{Key=key,Name=item.Name,Description=item.Description,Slot=item.Slot,Color=item.Color,Type="Cosmetic",
				Owned=owned==true,Equipped=profile~=nil and profile.Equipped[item.Slot]==key,TokenCost=item.TokenCost,
				CanPurchase=not owned and not item.Pass and profile~=nil,PriceText=item.Pass and "Supporters Pass" or tostring(item.TokenCost or 0).." tokens"})
		end
		local pass=Catalog.SupportersPass
		table.insert(result.Items,{Key=pass.Key,Name=pass.Name,Description=pass.Description,Type="Pass",Owned=record.Supporter==true,
			CanPurchase=enabled and validId(pass.Id) and not record.Supporter,PriceText=validId(pass.Id) and "Roblox confirms price" or "Setup pending",Color={226,188,72}})
		for _,product in ipairs(Catalog.Products) do
			table.insert(result.Items,{Key=product.Key,Name=product.Name,Description=product.Description,Type="Product",
				Owned=false,CanPurchase=enabled and validId(product.Id),PriceText=validId(product.Id) and "Roblox confirms price" or "Setup pending",Color={136,168,125}})
		end
		return result
	end
	function self:Handle(player,action,data)
		if type(data)~="table" or type(data.Key)~="string" or #data.Key>80 then return false,"Invalid shop request." end
		local key,profile=data.Key,profiles:Get(player)
		if not profile then return false,"Profile is still loading." end
		local item=Catalog.Cosmetics[key]
		local record=recordFor(player)
		if action=="EquipCosmetic" then
			if not item then return false,"Unknown cosmetic." end
			local owned=item.Default or profile.Cosmetics[key] or (item.Pass and record.Supporter)
			if not owned then return false,"Unlock this cosmetic first." end
			return profiles:Equip(player,key,item.Slot),"Cosmetic equipped."
		end
		if action~="ShopPurchase" then return false,"Unknown shop action." end
		if item then
			if item.Pass then return false,"This finish is included in the Supporters Pass." end
			if profile.Cosmetics[key] or item.Default then return false,"Already unlocked. Choose Equip." end
			if not profiles:BuyCosmetic(player,key,item.TokenCost or 0) then return false,"Not enough cosmetic tokens, or profile is busy." end
			profiles:Equip(player,key,item.Slot)
			return true,"Cosmetic unlocked and equipped."
		end
		local offer,isPass
		if key==Catalog.SupportersPass.Key then offer,isPass=Catalog.SupportersPass,true end
		for _,product in ipairs(Catalog.Products) do if product.Key==key then offer=product end end
		if not offer then return false,"Unknown offer." end
		if Catalog.SalesEnabled~=true or not validId(offer.Id) then return false,"Robux sales await Creator Dashboard setup and purchase testing." end
		if RunService:IsStudio() or profile.Persistence~="Saved" then return false,"Purchases require a published server and working persistent saves." end
		if isPass and record.Supporter then return false,"You already own the Supporters Pass." end
		if os.clock()-(lastPrompt[player] or -100)<10 then return false,"Please wait before opening another purchase prompt." end
		lastPrompt[player]=os.clock()
		local ok=pcall(function()
			if isPass then MarketplaceService:PromptGamePassPurchase(player,offer.Id)
			else MarketplaceService:PromptProductPurchase(player,offer.Id) end
		end)
		return ok,ok and "Confirm the current price in Roblox's purchase window." or "The Roblox shop is temporarily unavailable."
	end
	function self:Init()
		MarketplaceService.ProcessReceipt=function(receipt)
			local retry=Enum.ProductPurchaseDecision.NotProcessedYet
			if type(receipt)~="table" then return retry end
			local product
			for _,offer in ipairs(Catalog.Products) do if validId(offer.Id) and offer.Id==receipt.ProductId then product=offer; break end end
			local player=Players:GetPlayerByUserId(receipt.PlayerId)
			if not product or not player then return retry end
			local ok,granted=pcall(function() return profiles:GrantReceipt(player,receipt,product.Tokens) end)
			return ok and granted and Enum.ProductPurchaseDecision.PurchaseGranted or retry
		end
		table.insert(connections,MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
			if purchased and id==Catalog.SupportersPass.Id then recordFor(player); task.spawn(function() refresh(player) end) end
		end))
	end
	function self:Remove(player) cache[player]=nil;lastPrompt[player]=nil end
	function self:Close() for _,connection in ipairs(connections) do connection:Disconnect() end end
	return self
end
return Commerce
]]></ProtectedString>
					<string name="ScriptGuid">{40F9522B-CEC5-4EF3-8ED5-A4DA3FC787EC}</string>
