					<token name="RunContext">0</token>
					<string name="ScriptGuid">{E22625C9-8E8E-4F64-864B-B43E34C129C2}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Main</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7d1df30f2087bb050af1baf500000569</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000018F">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Server-only progression. Match cash never enters this store.
-- Exclusive leases and serialized writes prevent an older server saving over a new one.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Profiles = {}
local FIELDS = {"XP", "Tokens", "Kills", "Wins", "Matches", "Nights", "BestWave"}
local MAX_STAT, LEASE_SECONDS, SAVE_INTERVAL = 1000000000000, 180, 45

local function validInteger(value)
	return type(value) == "number" and value == value and value >= 0 and value <= MAX_STAT and value % 1 == 0
end

local function profileFrom(raw)
	local profile = {}
	for _, field in ipairs(FIELDS) do
		profile[field] = type(raw) == "table" and validInteger(raw[field]) and raw[field] or 0
	end
	profile.HutTier = type(raw)=="table" and validInteger(raw.HutTier) and math.clamp(raw.HutTier,1,3) or 1
	profile.Cosmetics = {FieldOlive=true,Standard=true,None=true}
	profile.Equipped = {Hut="FieldOlive",Tracer="Standard",Flag="None"}
	profile.Receipts = {}
	if type(raw)=="table" then
		for _,field in ipairs({"Cosmetics","Equipped","Receipts"}) do
			if type(raw[field])=="table" then
				for key,value in pairs(raw[field]) do profile[field][key]=value end
			end
		end
	end
	return profile
end

local function decode(raw)
	if raw == nil then return {SchemaVersion = 1, Profile = profileFrom(nil)} end
	if type(raw) ~= "table" or raw.SchemaVersion ~= 1 or type(raw.Profile) ~= "table" then return nil end
	for _, field in ipairs(FIELDS) do if not validInteger(raw.Profile[field]) then return nil end end
	if not validInteger(raw.Profile.HutTier) or raw.Profile.HutTier<1 or raw.Profile.HutTier>3 then return nil end
	for _,field in ipairs({"Cosmetics","Equipped","Receipts"}) do
		if type(raw.Profile[field])~="table" then return nil end
		for key,value in pairs(raw.Profile[field]) do
			if type(key)~="string" or #key>160 then return nil end
			if field=="Equipped" then
				if (key~="Hut" and key~="Tracer" and key~="Flag") or type(value)~="string" or #value>80 then return nil end
			elseif value~=true then return nil end
		end
	end
	if raw.Session ~= nil and (type(raw.Session) ~= "table" or type(raw.Session.Id) ~= "string"
		or not validInteger(raw.Session.ExpiresAt)) then return nil end
	return raw
end

local function retry(callback)
	for attempt = 1, 3 do
		local ok, result = pcall(callback)
		if ok then return true, result end
		if attempt < 3 then task.wait(attempt) end
	end
	warn("[Shadow Zone Defense] Profiles saving is unavailable; this session remains playable.")
	return false, nil
end

function Profiles.new(config)
	local self, states = {}, {}
	local closing = false
	local xpPerLevel = validInteger(config.XPPerLevel) and config.XPPerLevel > 0 and config.XPPerLevel or 250
	local studioOnly = RunService:IsStudio() and config.StudioPersistence ~= true
	local store
	if not studioOnly then
		local ok, result = pcall(function() return DataStoreService:GetDataStore(config.DataStoreName) end)
		if ok then store = result end
	end

	local function fallback(state)
		-- Never reacquire and overwrite with a fallback profile. Rejoining can retry safely.
		state.Writable = false
		state.Persistence = "Session only"
	end

	local function hasLease(state)
		if state.Writable and os.time() >= state.LeaseUntil then fallback(state) end
		return state.Writable
	end

	local function locked(player, callback, allowRemoving)
		local state = states[player]
		if not state or not state.Ready then return false end
		while state.Busy do
			task.wait()
			if states[player] ~= state then return false end
		end
		if state.Released or (state.Removing and not allowRemoving) or states[player] ~= state then return false end
		state.Busy = true
		local result = table.pack(pcall(callback, state))
		state.Busy = false
		if not result[1] then
			warn("[Shadow Zone Defense] Profiles operation failed:", result[2])
			fallback(state)
			return false
		end
		return table.unpack(result, 2, result.n)
	end

	local function saveLocked(state, release)
		if state.Released then return true end
		if not hasLease(state) then
			if release then state.Released = true end
			return false
		end
		local profile = profileFrom(state.Profile)
		local writeId = state.SessionId .. ":" .. HttpService:GenerateGUID(false)
		local ok, saved = retry(function()
			return store:UpdateAsync(state.Key, function(raw)
				local old = decode(raw)
				-- The preceding request may have committed before reporting a transport error.
				if old and old.LastWriteId == writeId then
					if release or (old.Session and old.Session.Id == state.SessionId) then return old end
					return nil
				end
				if not old or not old.Session or old.Session.Id ~= state.SessionId
					or old.Session.ExpiresAt <= os.time() then return nil end
				return {SchemaVersion = 1, Profile = profile, LastWriteId = writeId, LastSave = os.time(),
					Session = not release and {Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS} or nil}, {state.UserId}
			end)
		end)
		if not ok or not saved or saved.LastWriteId ~= writeId
			or (not release and (not saved.Session or saved.Session.Id ~= state.SessionId)) then
			fallback(state)
			if release then state.Released = true end
			return false
		end
		state.Released = release == true
		if not release then state.LeaseUntil = saved.Session.ExpiresAt end
		return true
	end

	function self:Load(player)
		if closing then return false end
		if states[player] then
			local previous = states[player]
			while previous.Loading do task.wait() end
			return states[player] == previous and previous.Ready and not previous.Removing
		end
		local state = {UserId = player.UserId, Key = "Player_" .. tostring(player.UserId),
			SessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false), Profile = profileFrom(nil),
			Ready = false, Loading = true, Busy = false, Removing = false, Released = false,
			Writable = false, LeaseUntil = 0, Persistence = "Session only"}
		states[player] = state
		if store then
			local ok, loaded = retry(function()
				return store:UpdateAsync(state.Key, function(raw)
					local old = decode(raw)
					if not old then return nil end
					if old.Session and old.Session.Id ~= state.SessionId and old.Session.ExpiresAt > os.time() then return nil end
					return {SchemaVersion = 1, Profile = old.Profile, LastWriteId = old.LastWriteId, LastSave = old.LastSave,
						Session = {Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS}}, {player.UserId}
				end)
			end)
			if ok and loaded and loaded.Session and loaded.Session.Id == state.SessionId then
				state.Profile = profileFrom(loaded.Profile)
				state.Writable, state.LeaseUntil, state.Persistence = true, loaded.Session.ExpiresAt, "Saved"
			end
		end
		state.Ready, state.Loading = true, false
		if state.Removing or closing then
			saveLocked(state, true)
			if states[player] == state then states[player] = nil end
			return false
		end
		return true
	end

	function self:Get(player)
		local state = states[player]
		if not state or not state.Ready or state.Released then return nil end
		hasLease(state)
		local profile = profileFrom(state.Profile)
		profile.Receipts = nil -- Receipt ledger is server-only and never replicated in HUD snapshots.
		profile.Level = 1 + math.floor(profile.XP / xpPerLevel)
		profile.Persistence = state.Persistence
		return profile
	end

	function self:Award(player, awards)
		if type(awards) ~= "table" then return false end
		-- Validate the whole award before changing any field, including unknown fields.
		for field, value in pairs(awards) do
			if not table.find(FIELDS, field) or not validInteger(value) or value > 10000000 then return false end
		end
		local state = states[player]
		if not state or not state.Ready or state.Removing or state.Released then return false end
		-- Combat calls Award from the simulation. Never wait for a DataStore save here:
		-- a yielding Heartbeat would let a second frame enter the same match state.
		-- saveLocked captured its own immutable copy before yielding; later awards
		-- remain in Profile and are included by the next serialized save.
		hasLease(state)
		for _, field in ipairs(FIELDS) do
			if field=="BestWave" then state.Profile[field]=math.max(state.Profile[field],awards[field] or 0)
			else state.Profile[field] = math.min(MAX_STAT, state.Profile[field] + (awards[field] or 0)) end
		end
		return true
	end

	function self:UnlockTier(player,tier)
		local state=states[player]
		if not state or not state.Ready or state.Removing or state.Released or not validInteger(tier) or tier<1 or tier>3 then return false end
		state.Profile.HutTier=math.max(state.Profile.HutTier,tier)
		return true
	end

	function self:BuyCosmetic(player,key,cost)
		local state=states[player]
		if not state or not state.Ready or state.Removing or state.Released or state.Busy or type(key)~="string" or #key>80 or not validInteger(cost) then return false end
		if state.Profile.Cosmetics[key] then return true end
		if state.Profile.Tokens<cost then return false end
		state.Profile.Tokens-=cost
		state.Profile.Cosmetics[key]=true
		return true
	end

	function self:Equip(player,key,slot)
		local state=states[player]
		if not state or not state.Ready or state.Removing or state.Released or state.Busy or type(key)~="string" or #key>80
			or (slot~="Hut" and slot~="Tracer" and slot~="Flag") then return false end
		-- Only server Commerce calls this after checking a catalog item and entitlement.
		state.Profile.Equipped[slot]=key
		return true
	end

	function self:GrantReceipt(player,receipt,amount)
		if type(receipt)~="table" or receipt.PlayerId~=player.UserId or type(receipt.PurchaseId)~="string"
			or #receipt.PurchaseId<1 or #receipt.PurchaseId>160 or not validInteger(amount) or amount<1 or amount>100000 then return false end
		return locked(player,function(state)
			if not hasLease(state) or studioOnly then return false end
			local id=receipt.PurchaseId
			if state.Profile.Receipts[id] then return true end
			local snapshot=profileFrom(state.Profile)
			snapshot.Tokens=math.min(MAX_STAT,snapshot.Tokens+amount)
			snapshot.Receipts[id]=true
			local ok,saved=retry(function()
				return store:UpdateAsync(state.Key,function(raw)
					local old=decode(raw)
					if not old or not old.Session or old.Session.Id~=state.SessionId or old.Session.ExpiresAt<=os.time() then return nil end
					if old.Profile.Receipts[id] then return old end
					return {SchemaVersion=1,Profile=snapshot,LastSave=os.time(),Session={Id=state.SessionId,ExpiresAt=os.time()+LEASE_SECONDS}}, {state.UserId}
				end)
			end)
			if not ok or not saved or not saved.Profile or not saved.Profile.Receipts[id]
				or not saved.Session or saved.Session.Id~=state.SessionId then fallback(state); return false end
			-- Rewards arriving while UpdateAsync yielded remain in memory. Only apply receipt delta.
			if not state.Profile.Receipts[id] then
				state.Profile.Tokens=math.min(MAX_STAT,state.Profile.Tokens+amount)
				state.Profile.Receipts[id]=true
			end
			state.LeaseUntil=saved.Session.ExpiresAt
			return true
		end)
	end

	function self:Save(player, release)
		local state = states[player]
		if not state then return false end
		if release then state.Removing = true end
		return locked(player, function(current) return saveLocked(current, release == true) end, true)
	end

	function self:Remove(player)
		local state = states[player]
		if not state then return end
		state.Removing = true
		while state.Loading do task.wait() end
		if states[player] == state and state.Ready then self:Save(player, true) end
		while state.Busy do task.wait() end
		if states[player] == state then states[player] = nil end
	end

	function self:Close()
		closing = true
		local pending, deadline = 0, os.clock() + 25
		local players = {}
		for player in pairs(states) do table.insert(players, player) end
		for _, player in ipairs(players) do
			pending += 1
			task.spawn(function()
				self:Remove(player)
				pending -= 1
			end)
		end
		while pending > 0 and os.clock() < deadline do task.wait(0.05) end
	end

	task.spawn(function()
		while not closing do
			task.wait(SAVE_INTERVAL)
			if closing then break end
			for player, state in pairs(states) do
				if state.Ready and not state.Removing and not state.Released and state.Writable and not state.Busy then
					task.spawn(function() self:Save(player, false) end)
				end
			end
		end
	end)
	return self
end

return Profiles
]]></ProtectedString>
					<string name="ScriptGuid">{7B5B62DE-F250-43E6-9FAD-C3FB241D0016}</string>
