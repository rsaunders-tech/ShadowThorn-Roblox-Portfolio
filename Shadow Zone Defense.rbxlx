				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">StarterPlayerScripts</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7d1df30f2087bb050af1baf50000056e</UniqueId>
			</Properties>
			<Item class="LocalScript" referent="RBX00000194">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Presentation and input. The server owns combat, resources, placement, and purchases.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("ShadowZoneDefense")
local Config = require(shared:WaitForChild("Config"))
local remotes = shared:WaitForChild("Remotes")
local action = remotes:WaitForChild("Action")
local stateRemote = remotes:WaitForChild("State")
local effectRemote = remotes:WaitForChild("Effect")
local C = {
	BG=Color3.fromRGB(16,21,20), Panel=Color3.fromRGB(28,35,31), Raised=Color3.fromRGB(43,51,44),
	Line=Color3.fromRGB(80,91,74), Text=Color3.fromRGB(234,237,224), Muted=Color3.fromRGB(170,181,161),
	Olive=Color3.fromRGB(163,184,110), Amber=Color3.fromRGB(235,187,92), Red=Color3.fromRGB(232,112,95),
}
local state = {
	Ready=false, Phase="Lobby", Countdown=0, Night=0, Wave=0, TotalWaves=6, Enemies=0,
	CommandHealth=Config.CommandHealth, MaxCommandHealth=Config.CommandHealth,
	Resources={Wood=0,Scrap=0,Credits=0}, Hut={}, Defenses={}, Weapon={}, Stats={}, Profile={}, Shop={Items={}},
}
local connections = {}
local alive, menuOpen, page, selectedId = true, true, "Home", nil
local placingKind, ghost, rangePart, placementPoint, placementValid = nil, nil, nil, nil, false
local placementPinned
local rotation, placementReason = 0, "Point at your plot."
local holdingFire, nextShot, lastTouch = false, 0, nil
local lastSends, toastUntil, lastNotice = {}, 0, ""
local shopSignature, pageDirty, effectsEnabled = "", true, true
local compact, viewport = false, Vector2.new(1280,720)
local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end
local function make(className, parent, props)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do object[key] = value end
	object.Parent = parent
	return object
end
local function corners(object, radius)
	make("UICorner", object, {CornerRadius=UDim.new(0,radius or 8)})
end
local function label(parent, text, size, props)
	props = props or {}
	props.Text, props.TextSize = text, size or 15
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextColor3 = props.TextColor3 or C.Text
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	props.Size = props.Size or UDim2.new(1,0,0,25)
	return make("TextLabel", parent, props)
end
local function panel(parent, props)
	props = props or {}
	props.BorderSizePixel = 0
	props.BackgroundColor3 = props.BackgroundColor3 or C.Panel
	local object = make("Frame", parent, props)
	corners(object)
	make("UIStroke", object, {Color=C.Line,Thickness=1,Transparency=.25})
	return object
end
local function button(parent, text, callback, accent)
	local object = make("TextButton", parent, {Size=UDim2.new(1,0,0,42),Text=text,TextSize=14,
		Font=Enum.Font.GothamBold,TextColor3=accent and C.BG or C.Text,
		BackgroundColor3=accent or C.Raised,BorderSizePixel=0,AutoButtonColor=true})
	corners(object,6)
	object.Activated:Connect(callback)
	return object
end
local function num(value) return tostring(math.floor(tonumber(value) or 0)) end
local function notice(text)
	lastNotice, toastUntil = tostring(text or ""), os.clock()+5
end
local function send(name, data)
	local now = os.clock()
	local interval = name == "Shoot" and Config.Weapon.FireInterval*.9 or .18
	if now-(lastSends[name] or -100)<interval then return end
	lastSends[name]=now
	action:FireServer(name,data or {})
end
local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {Name="ShadowZoneDefenseUI",ResetOnSpawn=false,
	IgnoreGuiInset=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=20})
local root = make("Frame",gui,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1})
local header = panel(root,{Position=UDim2.fromOffset(10,8),Size=UDim2.new(1,-20,0,86)})
local title = label(header,"SHADOW ZONE DEFENSE",16,{Position=UDim2.fromOffset(12,7),TextColor3=C.Olive,Size=UDim2.fromOffset(260,23),Font=Enum.Font.GothamBold})
local phaseLabel = label(header,"LOADING OUTPOST",13,{Position=UDim2.fromOffset(12,32),Size=UDim2.fromOffset(300,22)})
local resourcesLabel = label(header,"WOOD 0   /   SCRAP 0   /   CREDITS 0",14,{TextColor3=C.Amber})
local commandLabel = label(header,"COMMAND 1,000 / 1,000",12,{TextColor3=C.Muted})
local commandTrack = make("Frame",header,{BackgroundColor3=C.BG,BorderSizePixel=0})
corners(commandTrack,3)
local commandFill = make("Frame",commandTrack,{Size=UDim2.fromScale(1,1),BackgroundColor3=C.Olive,BorderSizePixel=0})
corners(commandFill,3)
local toolbar = make("Frame",root,{BackgroundTransparency=1})
make("UIListLayout",toolbar,{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,6),HorizontalAlignment=Enum.HorizontalAlignment.Right})
local function openPage(name)
	holdingFire=false
	menuOpen,page,pageDirty=true,name,true
end
local toolbarButtons={}
for _,entry in ipairs({{"BUILD","Build"},{"HUT","Hut"},{"COSMETICS","Cosmetics"},{"MENU","Home"}}) do
	local b=button(toolbar,entry[1],function() openPage(entry[2]) end)
	toolbarButtons[#toolbarButtons+1]=b
end
local vitals = panel(root,{Position=UDim2.fromOffset(10,112),Size=UDim2.fromOffset(254,78)})
local healthLabel=label(vitals,"HEALTH 100 / 100",13,{Position=UDim2.fromOffset(10,7),Size=UDim2.new(1,-20,0,20)})
local ammoLabel=label(vitals,"RIFLE 24 / 24",16,{Position=UDim2.fromOffset(10,28),Size=UDim2.new(1,-20,0,24),TextColor3=C.Amber})
local hutLabel=label(vitals,"HUT 100 / 100",12,{Position=UDim2.fromOffset(10,52),Size=UDim2.new(1,-20,0,18),TextColor3=C.Muted})
local crosshair=label(root,"+",23,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(24,24),TextXAlignment=Enum.TextXAlignment.Center,TextStrokeTransparency=.3})
local toast=label(root,"",14,{AnchorPoint=Vector2.new(.5,0),TextXAlignment=Enum.TextXAlignment.Center,TextWrapped=true,TextStrokeTransparency=.3})
local hint=label(root,"WASD move  •  Hold E to gather  •  R reload  •  B build  •  Q rotate",12,{TextColor3=C.Muted,TextXAlignment=Enum.TextXAlignment.Center,TextStrokeTransparency=.2,AnchorPoint=Vector2.new(.5,1)})
local shade=make("TextButton",root,{Size=UDim2.fromScale(1,1),Text="",BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=.35,AutoButtonColor=false,BorderSizePixel=0,Visible=false,ZIndex=10,Modal=false})
local menu=panel(root,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.52),Size=UDim2.fromOffset(600,440),Visible=false,ZIndex=11})
local menuTitle=label(menu,"OUTPOST BRIEFING",19,{Position=UDim2.fromOffset(16,10),Size=UDim2.new(1,-74,0,32),Font=Enum.Font.GothamBold,ZIndex=12})
local closeButton=button(menu,"×",function() menuOpen=false end)
closeButton.Position=UDim2.new(1,-50,0,10);closeButton.Size=UDim2.fromOffset(34,32);closeButton.ZIndex=12
local scroll=make("ScrollingFrame",menu,{Position=UDim2.fromOffset(16,54),Size=UDim2.new(1,-32,1,-70),CanvasSize=UDim2.fromOffset(0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,
	BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=C.Olive,ZIndex=12})
make("UIListLayout",scroll,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder})
make("UIPadding",scroll,{PaddingRight=UDim.new(0,8),PaddingBottom=UDim.new(0,6)})
local placementPanel=panel(root,{AnchorPoint=Vector2.new(.5,0),Visible=false,Size=UDim2.fromOffset(430,114)})
local placementLabel=label(placementPanel,"",13,{Position=UDim2.fromOffset(12,5),Size=UDim2.new(1,-24,0,44),TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Center})
local cancelPlacement
local rotateButton=button(placementPanel,"ROTATE",function() rotation=(rotation+90)%360 end)
local confirmButton=button(placementPanel,"PLACE",function()
	if placementPoint and placementValid then
		send("Place",{Kind=placingKind,X=placementPoint.X,Z=placementPoint.Z,Rotation=rotation})
	else notice(placementReason) end
end,C.Olive)
local cancelButton=button(placementPanel,"CANCEL",function() cancelPlacement() end)
for i,b in ipairs({rotateButton,confirmButton,cancelButton}) do b.Position=UDim2.new((i-1)/3,8,1,-54);b.Size=UDim2.new(1/3,-16,0,42) end
local fireButton=button(root,"FIRE",function() end,C.Amber)
fireButton.Size=UDim2.fromOffset(76,76);fireButton.AnchorPoint=Vector2.new(1,.5)
local reloadButton=button(root,"RELOAD",function() send("Reload") end)
reloadButton.Size=UDim2.fromOffset(82,40);reloadButton.AnchorPoint=Vector2.new(1,.5)
connect(fireButton.InputBegan,function(input)
	if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then holdingFire=true end
end)
connect(fireButton.InputEnded,function(input)
	if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then holdingFire=false end
end)

local function clearPreview()
	if ghost then ghost:Destroy();ghost=nil end
	if rangePart then rangePart:Destroy();rangePart=nil end
	placementPoint,placementValid=nil,false
	placementPinned=nil
end
cancelPlacement=function()
	placingKind=nil
	clearPreview()
end
local function localPart(parent,name,size,offset)
	return make("Part",parent,{Name=name,Size=size,CFrame=CFrame.new(offset),Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,
		Material=Enum.Material.Neon,Color=C.Olive,Transparency=.5,CastShadow=false})
end
local function beginPlacement(kind)
	if not state.Ready then notice("Wait for your outpost to load.");return end
	if state.Phase~="Day" and state.Phase~="Warning" then notice("Build during daytime preparation with a standing hut.");return end
	cancelPlacement()
	placingKind,rotation,selectedId,menuOpen=kind,0,nil,false
	ghost=make("Model",workspace,{Name="ShadowZonePlacementPreview"})
	local pivot=localPart(ghost,"Pivot",Vector3.new(.1,.1,.1),Vector3.zero);pivot.Transparency=1;ghost.PrimaryPart=pivot
	if kind=="Rifleman" then
		localPart(ghost,"Base",Vector3.new(5,.35,5),Vector3.new(0,.2,0))
		localPart(ghost,"Unit",Vector3.new(2.6,3,2.6),Vector3.new(0,1.9,0))
		localPart(ghost,"Rifle",Vector3.new(.5,.5,4),Vector3.new(0,3,-1.6))
		rangePart=localPart(workspace,"ShadowZoneRangePreview",Vector3.new(.08,110,110),Vector3.zero)
		rangePart.Shape=Enum.PartType.Cylinder;rangePart.Transparency=.94
	else
		localPart(ghost,"Barricade",Vector3.new(8,3,1.5),Vector3.new(0,1.5,0))
	end
	notice("Click or tap clear ground in your plot. Q rotates. Confirm with PLACE.")
end
local function selectedDefense()
	for _,defense in ipairs(state.Defenses or {}) do if defense.Id==selectedId then return defense end end
	return nil
end
local function hasRifle()
	local character=player.Character
	if not character then return false end
	for _,tool in ipairs(character:GetChildren()) do
		if tool:IsA("Tool") and (tool:GetAttribute("ShadowZoneRifle")==true or tool.Name=="Service Rifle" or tool.Name=="Starter Rifle") then return true end
	end
	return false
end
local function screenRay(point)
	local camera=workspace.CurrentCamera
	if not camera then return nil end
	return camera:ScreenPointToRay(point.X,point.Y)
end
local function pointerPoint()
	if UserInputService.TouchEnabled and lastTouch then return lastTouch end
	return UserInputService:GetMouseLocation()
end
local function groundHit()
	local ray=screenRay(pointerPoint());if not ray then return nil end
	local map=workspace:FindFirstChild("ShadowZoneWorld");if not map then return nil end
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={map}
	return workspace:Raycast(ray.Origin,ray.Direction*500,params)
end
local function placementCheck(point)
	local plot=Config.Plots[state.PlotIndex or 0]
	if not plot then return false,"Your plot is not ready." end
	local def=Config.Defenses[placingKind];if not def then return false,"Choose a defense." end
	if state.Phase~="Day" and state.Phase~="Warning" then return false,"Build during daytime preparation." end
	if (state.Hut.Health or 0)<=0 then return false,"Repair your hut before building." end
	local x,z=point.X-plot.X,point.Z-plot.Z
	if math.abs(x)>Config.PlotHalfSize-def.Radius or math.abs(z)>Config.PlotHalfSize-def.Radius then return false,"Build inside your assigned plot." end
	if Vector2.new(x,z).Magnitude<Config.HutRadius+def.Radius then return false,"Leave clear space around your hut." end
	if math.abs(point.X)<12 then return false,"Keep the command route clear." end
	local count=0
	for _,other in ipairs(state.Defenses or {}) do
		if other.Kind==placingKind then count+=1 end
		local radius=(Config.Defenses[other.Kind] or {}).Radius or 3
		if Vector2.new(point.X-other.X,point.Z-other.Z).Magnitude<def.Radius+radius then return false,"Too close to another defense." end
	end
	if count>=def.MaxPerPlayer then return false,"Defense limit reached." end
	for _,currency in ipairs({"Wood","Scrap","Credits"}) do
		if (state.Resources[currency] or 0)<(def[currency] or 0) then return false,"Need "..num(def[currency]).." "..string.lower(currency).."." end
	end
	local character=player.Character;local rootPart=character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return false,"Respawn before building." end
	if (rootPart.Position-point).Magnitude>45 then return false,"Move closer to your plot." end
	local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances={character}
	for _,part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(point+Vector3.new(0,2.6,0))*CFrame.Angles(0,math.rad(rotation),0),Vector3.new(def.Radius*2,4,def.Radius*2),overlap)) do
		if part.CanCollide and part.Position.Y+part.Size.Y/2>.5 then return false,"That location is blocked." end
	end
	return true,"Place "..def.Name.." • "..(placingKind=="Rifleman" and "250 credits" or "20 Wood")
end

local order=0
local function contentText(text,size,tint)
	order+=1
	return label(scroll,text,size or 15,{TextColor3=tint or C.Text,TextWrapped=true,AutomaticSize=Enum.AutomaticSize.Y,
		Size=UDim2.new(1,0,0,0),TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=order,ZIndex=13})
end
local function contentButton(text,callback,accent,enabled)
	order+=1
	local b=button(scroll,text,function() if enabled~=false then callback() end end,accent)
	b.LayoutOrder=order;b.ZIndex=13
	if enabled==false then b.Active=false;b.AutoButtonColor=false;b.BackgroundColor3=C.Raised;b.TextColor3=C.Muted end
	return b
end
local function backButton() contentButton("BACK TO MENU",function() openPage("Home") end) end
local function renderPage()
	pageDirty=false
	for _,child in ipairs(scroll:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
	order=0
	local isResult=state.Phase=="Victory" or state.Phase=="Defeat"
	if page=="Home" then
		menuTitle.Text=isResult and (state.Phase=="Victory" and "THREE NIGHTS SURVIVED" or "COMMAND POST LOST") or "SHADOW ZONE DEFENSE"
		if isResult then
			contentText(state.Phase=="Victory" and "Your team held the outpost through all six waves." or "The command post has fallen. Your earned progression stays with you.",17)
			contentText("Eliminations "..num(state.Stats.Kills).."   •   Best wave "..num(state.Profile.BestWave).."   •   Level "..num(state.Profile.Level),14,C.Amber)
			contentButton("VOTE TO RESTART  "..num(state.RestartVotes).." / "..num(state.RestartNeeded),function() send("Restart") end,C.Olive,state.Ready)
		elseif state.Phase=="Lobby" then
			contentText("Protect the shared command post for three nights. Gather Wood and Scrap, improve your hut, and fight beside automated Riflemen.",17)
			contentButton(state.Ready and "START SURVIVAL" or "LOADING YOUR PLOT…",function() if state.Ready then send("Play");menuOpen=false end end,C.Olive,state.Ready)
		else
			contentText("Night "..num(state.Night).." / "..num(Config.Nights).."   •   Wave "..num(state.Wave).." / "..num(state.TotalWaves),17,C.Amber)
			contentButton("RETURN TO OUTPOST",function() menuOpen=false end,C.Olive)
		end
		if state.PlotIndex then contentText("Your shelter is on PLOT "..num(state.PlotIndex)..", marked with your name.",14,C.Olive) end
		contentText(UserInputService.TouchEnabled and "Use the movement stick and drag the world to look. Hold the gathering prompt near logs or salvage. Equip your rifle, aim with the center crosshair, then hold FIRE. Tap RELOAD when needed." or "WASD moves; drag the right mouse button to look. Hold E near logs or salvage to gather. Equip the Service Rifle from your backpack, hold left mouse to fire, and press R to reload.",14,C.Muted)
		contentText("During the day, collect supplies and build within your marked plot. The shared command post has 1,000 health. Huts and defenses can be destroyed and repaired. Night ends after both waves and the defense timer finish.",14)
		contentButton("BUILD DEFENSES",function() openPage("Build") end)
		contentButton("HUT UPGRADES & REPAIR",function() openPage("Hut") end)
		contentButton("COSMETICS & SUPPORTERS PASS",function() openPage("Cosmetics") end)
		contentButton("PROGRESSION",function() openPage("Progress") end)
		contentButton("VISUAL EFFECTS: "..(effectsEnabled and "ON" or "OFF"),function() effectsEnabled=not effectsEnabled;pageDirty=true end)
	elseif page=="Hut" then
		menuTitle.Text="YOUR SHELTER"
		local hut=state.Hut or {};local tier=hut.Tier or 1;local def=Config.Huts[tier] or Config.Huts[1]
		contentText(def.Name.."  •  Tier "..num(tier),18,C.Olive)
		contentText("Assigned plot "..num(state.PlotIndex),14,C.Muted)
		contentText("Health "..num(hut.Health).." / "..num(hut.MaxHealth).."   •   Highest blueprint "..num(hut.UnlockedTier or state.Profile.HutTier or 1),14)
		contentText("Current match supplies: "..num(state.Resources.Wood).." Wood, "..num(state.Resources.Scrap).." Scrap.",14,C.Amber)
		local nextDef=Config.Huts[tier+1]
		if nextDef then
			contentText("Next: "..nextDef.Name.." — "..num(nextDef.Health).." health. Construction costs "..num(nextDef.Wood).." Wood and "..num(nextDef.Scrap).." Scrap.",15)
			contentButton("UPGRADE HUT",function() send("UpgradeHut") end,C.Olive,state.Ready)
		else contentText("Military Outpost is the highest hut tier in this prototype. The Command Bunker belongs to Phase 2.",15) end
		contentButton("REPAIR +"..num(Config.HutRepair.Amount).." HP  •  "..num(Config.HutRepair.Wood).." Wood + "..num(Config.HutRepair.Scrap).." Scrap",function() send("RepairHut") end,nil,state.Ready)
		contentText("Move near your hut to upgrade or repair. A destroyed hut keeps its blueprint unlock. Match resources and structures reset when the team restarts.",14,C.Muted)
		backButton()
	elseif page=="Build" then
		menuTitle.Text="BUILD DEFENSES"
		contentText("Use your own marked plot. Keep the hut entrance and command road clear. Rotation snaps to quarter turns.",15)
		contentButton("RIFLEMAN  •  250 CREDITS",function() beginPlacement("Rifleman") end,C.Olive,state.Ready)
		contentText("Medium-range automatic defense. Three levels; select a deployed Rifleman to upgrade, repair, sell, or change its target priority.",14,C.Muted)
		contentButton("WOODEN BARRICADE  •  20 WOOD",function() beginPlacement("Barricade") end,nil,state.Ready)
		contentText("A destructible obstacle that delays nearby infected. Barricades cannot close the command route.",14,C.Muted)
		contentText("Select one of your deployed defenses in the world to manage it. On touch, tap the defense while the construction preview is closed.",14)
		backButton()
	elseif page=="Tower" then
		menuTitle.Text="DEFENSE CONTROLS"
		local defense=selectedDefense()
		if not defense then contentText("Select one of your defenses in the world.",15);backButton();return end
		contentText((Config.Defenses[defense.Kind] or {}).Name or tostring(defense.Kind),18,C.Olive)
		contentText("Level "..num(defense.Level).."   •   Health "..num(defense.Health).." / "..num(defense.MaxHealth),15)
		if defense.UpgradeCost then contentButton("UPGRADE  •  "..num(defense.UpgradeCost).." CREDITS",function() send("Upgrade",{Id=selectedId}) end,C.Olive) end
		if defense.Kind=="Rifleman" then
			local modes={"First","Last","Strongest","Closest"}
			contentText("Target priority: "..tostring(defense.Target or "First"),15)
			contentButton("CHANGE TARGET PRIORITY",function()
				local index=table.find(modes,defense.Target or "First") or 1
				send("Target",{Id=selectedId,Mode=modes[index%#modes+1]})
			end)
		end
		contentButton("REPAIR +60 HP  •  5 WOOD + 2 SCRAP",function() send("Repair",{Id=selectedId}) end)
		contentButton(defense.Kind=="Barricade" and "REMOVE  •  NO CREDIT REFUND" or "SELL  •  "..num(defense.SellValue).." CREDITS",function() send("Sell",{Id=selectedId});selectedId=nil;openPage("Build") end)
		backButton()
	elseif page=="Cosmetics" then
		menuTitle.Text="COSMETICS & SUPPORTERS"
		contentText("Cosmetic tokens: "..num(state.Profile.Tokens),17,C.Amber)
		contentText("Finishes, tracers, flags, and supporter styling change appearance. Survival stats and all campaign content remain available to everyone.",14)
		if not state.Shop.Enabled then contentText("Robux sales are awaiting game setup. Earned-token cosmetics can still be unlocked here.",14,C.Muted) end
		for _,item in ipairs(state.Shop.Items or {}) do
			local nameLabel=contentText(tostring(item.Name)..(item.Equipped and "  •  EQUIPPED" or item.Owned and "  •  OWNED" or ""),16,item.Equipped and C.Olive or C.Text)
			if type(item.Color)=="table" then
				make("UIPadding",nameLabel,{PaddingLeft=UDim.new(0,22)})
				local swatch=make("Frame",nameLabel,{Position=UDim2.fromOffset(0,3),Size=UDim2.fromOffset(13,13),BorderSizePixel=0,BackgroundColor3=Color3.fromRGB(table.unpack(item.Color)),ZIndex=14})
				corners(swatch,3)
			end
			contentText(tostring(item.Description or ""),14,C.Muted)
			local key=item.Key
			if item.Owned and item.Slot then
				contentButton(item.Equipped and "EQUIPPED" or "EQUIP",function() if not item.Equipped then send("EquipCosmetic",{Key=key}) end end,item.Equipped and nil or C.Olive,not item.Equipped)
			elseif item.TokenCost and item.TokenCost>0 then
				contentButton("UNLOCK  •  "..num(item.TokenCost).." TOKENS",function() send("ShopPurchase",{Key=key}) end,nil,state.Ready)
			elseif item.Owned then
				contentButton("OWNED",function() end,nil,false)
			else
				contentButton(tostring(item.PriceText or "SETUP PENDING"),function() if item.CanPurchase then send("ShopPurchase",{Key=key}) end end,item.CanPurchase and C.Amber or nil,item.CanPurchase==true)
			end
		end
		backButton()
	elseif page=="Progress" then
		menuTitle.Text="SURVIVOR RECORD"
		local profile=state.Profile or {}
		contentText("LEVEL "..num(profile.Level or 1).."  •  "..num(profile.XP).." XP",20,C.Olive)
		contentText("Eliminations: "..num(profile.Kills).."\nNights survived: "..num(profile.Nights).."\nBest wave: "..num(profile.BestWave).."\nVictories: "..num(profile.Wins).."\nHut blueprint: tier "..num(profile.HutTier or 1).."\nCosmetic tokens: "..num(profile.Tokens),16)
		contentText("Save status: "..tostring(profile.Persistence or "Loading"),14,C.Amber)
		contentText("Experience, blueprints, survivor records, and cosmetics carry between matches when saving is available. Wood, Scrap, credits, health, and defenses belong to the current match.",14,C.Muted)
		backButton()
	end
	pageDirty=false
end

local function layout()
	local camera=workspace.CurrentCamera
	viewport=camera and camera.ViewportSize or Vector2.new(1280,720)
	local inset=GuiService:GetGuiInset();local width,height=viewport.X,viewport.Y-inset.Y
	compact=width<700
	header.Size=UDim2.new(1,-20,0,compact and 100 or 86)
	title.TextSize=compact and 14 or 16
	phaseLabel.TextSize=compact and 12 or 13
	phaseLabel.Size=compact and UDim2.new(1,-24,0,22) or UDim2.fromOffset(320,22)
	if compact then
		resourcesLabel.Position=UDim2.fromOffset(12,55);resourcesLabel.Size=UDim2.new(1,-24,0,20);resourcesLabel.TextSize=12
		commandLabel.Position=UDim2.fromOffset(12,77);commandLabel.Size=UDim2.new(1,-24,0,17);commandLabel.TextSize=11
		commandTrack.Position=UDim2.new(.58,0,0,83);commandTrack.Size=UDim2.new(.42,-12,0,5)
	else
		resourcesLabel.Position=UDim2.new(1,-370,0,10);resourcesLabel.Size=UDim2.fromOffset(355,25);resourcesLabel.TextSize=14
		commandLabel.Position=UDim2.new(1,-370,0,40);commandLabel.Size=UDim2.fromOffset(355,20);commandLabel.TextSize=12
		commandTrack.Position=UDim2.new(1,-370,0,67);commandTrack.Size=UDim2.fromOffset(355,6)
	end
	toolbar.Position=UDim2.new(1,-math.min(460,width-20)-10,0,compact and 116 or 104)
	toolbar.Size=UDim2.fromOffset(math.min(460,width-20),36)
	for _,b in ipairs(toolbarButtons) do b.Size=UDim2.new(.25,-5,1,0);b.TextSize=compact and 11 or 13 end
	vitals.Position=UDim2.fromOffset(10,compact and 162 or 104)
	vitals.Size=UDim2.fromOffset(compact and 218 or 254,78)
	menu.Size=UDim2.fromOffset(math.min(600,width-24),math.max(210,math.min(460,height-48)))
	menu.Position=UDim2.fromScale(.5,.52)
	menuTitle.TextSize=compact and 16 or 19
	toast.Position=UDim2.new(.5,0,0,compact and 249 or 195);toast.Size=UDim2.new(1,-36,0,44)
	hint.Position=UDim2.new(.5,0,1,-10);hint.Size=UDim2.new(1,-24,0,30);hint.Visible=not UserInputService.TouchEnabled and height>380
	placementPanel.Position=UDim2.new(.5,0,0,math.min(compact and 250 or 194,math.max(154,height-122)))
	placementPanel.Size=UDim2.fromOffset(math.min(430,width-24),114)
	-- Leave Roblox's jump control clear at the lower right and movement stick clear at the lower left.
	fireButton.Position=UDim2.new(1,-112,.55,0);reloadButton.Position=UDim2.new(1,-109,.55,72)
end
layout()
local lastSize=Vector2.zero
local function shoot()
	if not state.Ready or menuOpen or placingKind or not hasRifle() then return end
	if state.Phase~="Night" and state.Phase~="Day" and state.Phase~="Warning" then return end
	local camera=workspace.CurrentCamera;if not camera then return end
	local point=UserInputService.TouchEnabled and Vector2.new(camera.ViewportSize.X*.5,camera.ViewportSize.Y*.5) or UserInputService:GetMouseLocation()
	local ray=UserInputService.TouchEnabled and camera:ViewportPointToRay(point.X,point.Y) or camera:ScreenPointToRay(point.X,point.Y)
	local character=player.Character;local rootPart=character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end
	local filter=RaycastParams.new();filter.FilterType=Enum.RaycastFilterType.Exclude;filter.FilterDescendantsInstances={character}
	local hit=workspace:Raycast(ray.Origin,ray.Direction*Config.Weapon.Range,filter)
	local destination=hit and hit.Position or ray.Origin+ray.Direction*Config.Weapon.Range
	local direction=destination-(rootPart.Position+Vector3.new(0,1.2,0))
	if direction.Magnitude>.1 then send("Shoot",{Direction=direction.Unit}) end
end
local function selectAt(point)
	local ray=screenRay(point);if not ray then return end
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=player.Character and {player.Character} or {}
	local hit=workspace:Raycast(ray.Origin,ray.Direction*500,params)
	local model=hit and hit.Instance:FindFirstAncestorOfClass("Model")
	while model and model~=workspace do
		local id=model:GetAttribute("Id")
		if model:GetAttribute("OwnerId")==player.UserId and id and Config.Defenses[model:GetAttribute("Kind")] then
			selectedId=id;openPage("Tower");return true
		end
		model=model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
	end
	return false
end
local function overUI(point)
	for _,object in ipairs(player.PlayerGui:GetGuiObjectsAtPosition(point.X,point.Y)) do
		for _,surface in ipairs({header,toolbar,vitals,placementPanel,menu,fireButton,reloadButton}) do
			if object==surface or object:IsDescendantOf(surface) then return true end
		end
	end
	return false
end
connect(UserInputService.InputBegan,function(input,processed)
	if processed or UserInputService:GetFocusedTextBox() then return end
	if (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) and overUI(Vector2.new(input.Position.X,input.Position.Y)) then return end
	if input.KeyCode==Enum.KeyCode.R then send("Reload")
	elseif input.KeyCode==Enum.KeyCode.B then if placingKind then cancelPlacement() else openPage("Build") end
	elseif input.KeyCode==Enum.KeyCode.Q and placingKind then rotation=(rotation+90)%360
	elseif input.KeyCode==Enum.KeyCode.Escape then if placingKind then cancelPlacement() else menuOpen=false end
	elseif input.UserInputType==Enum.UserInputType.MouseButton1 and not menuOpen then
		if placingKind then
			-- A world click selects the point; a separate PLACE button confirms it.
			local hit=groundHit()
			if hit then placementPinned=Vector3.new(math.floor(hit.Position.X/Config.Grid+.5)*Config.Grid,0,math.floor(hit.Position.Z/Config.Grid+.5)*Config.Grid) end
		elseif not selectAt(UserInputService:GetMouseLocation()) then holdingFire=true end
	elseif input.UserInputType==Enum.UserInputType.Touch then lastTouch=Vector2.new(input.Position.X,input.Position.Y) end
end)
connect(UserInputService.InputEnded,function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then holdingFire=false end
end)
connect(UserInputService.TouchTapInWorld,function(position,processed)
	if processed or menuOpen or overUI(position) then return end
	lastTouch=position
	placementPinned=nil
	if not placingKind then selectAt(position) end
end)
connect(UserInputService.WindowFocusReleased,function() holdingFire=false end)
connect(stateRemote.OnClientEvent,function(snapshot)
	if type(snapshot)~="table" then return end
	local previousPhase=state.Phase
	state=snapshot
	state.Resources=state.Resources or {};state.Hut=state.Hut or {};state.Profile=state.Profile or {}
	state.Stats=state.Stats or {};state.Weapon=state.Weapon or {};state.Shop=state.Shop or {Items={}}
	if state.Message and state.Message~="" then notice(state.Message) end
	if state.Phase~=previousPhase then
		if state.Phase=="Victory" or state.Phase=="Defeat" then cancelPlacement();openPage("Home")
		elseif previousPhase=="Lobby" and state.Phase~="Lobby" then menuOpen=false end
		pageDirty=true
	end
	local signature=tostring(state.Ready)..":"..tostring(state.Phase)..":"..tostring(state.Profile.Tokens)..":"..tostring(state.Hut.Tier)..":"..tostring(state.Hut.Health)..":"..tostring(state.RestartVotes)
	signature..=":"..tostring(state.Resources.Wood)..tostring(state.Resources.Scrap)..tostring(state.Profile.XP)..tostring(state.Profile.BestWave)..tostring(state.Profile.Persistence)
	for _,item in ipairs(state.Shop.Items or {}) do signature..=":"..tostring(item.Key)..tostring(item.Owned)..tostring(item.Equipped)..tostring(item.PriceText) end
	local defense=selectedDefense()
	if defense then signature..=":"..tostring(defense.Id)..tostring(defense.Level)..tostring(defense.Health)..tostring(defense.Target) end
	if signature~=shopSignature then shopSignature=signature;pageDirty=true end
end)
connect(effectRemote.OnClientEvent,function(effect)
	if type(effect)~="table" then return end
	if effect.Kind=="Notice" then notice(effect.Text or effect.Message or "");return end
	if not effectsEnabled then return end
	if effect.Kind=="Shot" and typeof(effect.From)=="Vector3" and typeof(effect.To)=="Vector3" then
		local distance=(effect.To-effect.From).Magnitude
		if distance<.05 or distance>300 then return end
		local tracer=make("Part",workspace,{Name="ShadowZoneTracer",Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,
			Size=Vector3.new(.07,.07,distance),CFrame=CFrame.lookAt((effect.From+effect.To)/2,effect.To),Material=Enum.Material.Neon,
			Color=typeof(effect.Color)=="Color3" and effect.Color or C.Amber,Transparency=.12,CastShadow=false})
		Debris:AddItem(tracer,.075)
	elseif effect.Kind=="Hit" then
		crosshair.TextColor3=C.Amber
		task.delay(.12,function() if alive and crosshair.Parent then crosshair.TextColor3=C.Text end end)
	elseif effect.Kind=="BaseHit" then notice("Command post under attack!") end
end)
connect(RunService.RenderStepped,function()
	if not alive then return end
	local camera=workspace.CurrentCamera
	if camera and camera.ViewportSize~=lastSize then lastSize=camera.ViewportSize;layout() end
	local now=os.clock()
	if holdingFire and now>=nextShot then nextShot=now+Config.Weapon.FireInterval;shoot() end
	local phase=tostring(state.Phase or "Lobby")
	local seconds=math.max(0,math.ceil(state.Countdown or 0))
	local timeText=phase=="Night" and seconds==0 and "CLEAR INFECTED" or num(seconds).."s"
	phaseLabel.Text=string.upper(phase).."  •  N"..num(state.Night).."/"..num(Config.Nights).."  W"..num(state.Wave).."/"..num(state.TotalWaves).."  •  "..timeText.."  •  "..num(state.Enemies).." infected"
	phaseLabel.TextColor3=(phase=="Night" or phase=="Warning") and C.Amber or C.Text
	resourcesLabel.Text="WOOD "..num(state.Resources.Wood).."   /   SCRAP "..num(state.Resources.Scrap).."   /   CREDITS "..num(state.Resources.Credits)
	local commandRatio=math.clamp((state.CommandHealth or 0)/math.max(1,state.MaxCommandHealth or Config.CommandHealth),0,1)
	commandLabel.Text=(commandRatio<.2 and "LAST STAND  •  " or "COMMAND  ")..num(state.CommandHealth).." / "..num(state.MaxCommandHealth)
	commandFill.Size=UDim2.fromScale(commandRatio,1);commandFill.BackgroundColor3=commandRatio<.2 and C.Red or C.Olive
	local character=player.Character;local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	healthLabel.Text="HEALTH "..num(humanoid and humanoid.Health).." / "..num(humanoid and humanoid.MaxHealth)
	ammoLabel.Text=state.Weapon.Reloading and "RELOADING…" or "RIFLE "..num(state.Weapon.Ammo).." / "..num(state.Weapon.Magazine or Config.Weapon.Magazine)
	hutLabel.Text="PLOT "..num(state.PlotIndex).."  •  HUT T"..num(state.Hut.Tier or 1).."  •  "..num(state.Hut.Health).." / "..num(state.Hut.MaxHealth)
	shade.Visible=menuOpen;menu.Visible=menuOpen
	if menuOpen and pageDirty then renderPage() end
	local rifleEquipped=hasRifle()
	if UserInputService.TouchEnabled and camera then local inset=GuiService:GetGuiInset();crosshair.Position=UDim2.fromOffset(camera.ViewportSize.X*.5,camera.ViewportSize.Y*.5-inset.Y)
	else local mouse=UserInputService:GetMouseLocation();local inset=GuiService:GetGuiInset();crosshair.Position=UDim2.fromOffset(mouse.X,mouse.Y-inset.Y) end
	crosshair.Visible=rifleEquipped and not menuOpen and not placingKind
	fireButton.Visible=UserInputService.TouchEnabled and rifleEquipped and not menuOpen and not placingKind
	reloadButton.Visible=fireButton.Visible
	vitals.Visible=not menuOpen and not placingKind
	toast.Text=now<toastUntil and lastNotice or "";toast.Visible=not menuOpen and not placingKind
	placementPanel.Visible=placingKind~=nil and not menuOpen
	if placingKind then
		local hit=not placementPinned and groundHit() or nil
		if placementPinned or hit then
			local point=placementPinned or hit.Position
			point=Vector3.new(math.floor(point.X/Config.Grid+.5)*Config.Grid,0,math.floor(point.Z/Config.Grid+.5)*Config.Grid)
			placementPoint=point;placementValid,placementReason=placementCheck(point)
			local tint=placementValid and C.Olive or C.Red
			if ghost then
				ghost:PivotTo(CFrame.new(point)*CFrame.Angles(0,math.rad(rotation),0))
				for _,part in ipairs(ghost:GetChildren()) do if part:IsA("BasePart") then part.Color=tint end end
			end
			if rangePart then rangePart.CFrame=CFrame.new(point.X,.16,point.Z)*CFrame.Angles(0,0,math.pi/2);rangePart.Color=tint end
		else placementPoint=nil;placementValid=false;placementReason="Point at clear ground in your plot." end
		placementLabel.Text=placementReason;placementLabel.TextColor3=placementValid and C.Olive or C.Red
		confirmButton.BackgroundColor3=placementValid and C.Olive or C.Raised
		confirmButton.TextColor3=placementValid and C.BG or C.Muted
	end
end)
connect(gui.Destroying,function()
	alive=false;holdingFire=false;clearPreview()
	for _,connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
end)
send("Sync")
task.delay(3,function() if alive and not state.Ready then send("Sync") end end)
