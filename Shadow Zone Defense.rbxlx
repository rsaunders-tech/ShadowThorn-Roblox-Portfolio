				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Original native Roblox parts. Simulation and purchase decisions belong to server services.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Scene = require(ReplicatedStorage:WaitForChild("ShadowZoneDefense"):WaitForChild("WorldScene"))
local World = {}
local olive, timber, steel, dark, sand = Color3.fromRGB(90,105,72), Color3.fromRGB(117,90,58), Color3.fromRGB(122,131,125), Color3.fromRGB(40,46,43), Color3.fromRGB(144,135,103)
local function rgb(c) return Color3.fromRGB(c[1],c[2],c[3]) end
local function folder(parent,name)
	local value=parent:FindFirstChild(name)
	if not value then value=Instance.new("Folder"); value.Name=name; value.Parent=parent end
	return value
end
local function part(parent,name,size,position,color,material,collide)
	local p=Instance.new("Part")
	p.Name,p.Size,p.CFrame=name,size,CFrame.new(position)
	p.Color,p.Material=color,material or Enum.Material.SmoothPlastic
	p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,collide==true,false,true
	p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent=parent
	return p
end
local function label(parent,adornee,text,width,offset)
	local gui=Instance.new("BillboardGui")
	gui.Name,gui.Adornee="HealthLabel",adornee
	gui.Size,gui.StudsOffset=UDim2.fromOffset(width or 220,48),Vector3.new(0,offset or 3,0)
	gui.MaxDistance,gui.LightInfluence=105,0
	local t=Instance.new("TextLabel")
	t.Name,t.Size,t.BackgroundTransparency="Label",UDim2.fromScale(1,1),1
	t.Font,t.TextSize,t.Text=Enum.Font.GothamBold,15,text
	t.TextColor3,t.TextStrokeTransparency=Color3.fromRGB(229,232,211),.35
	t.Parent,gui.Parent=gui,parent
	return gui
end
local function model(name)
	local m=Instance.new("Model"); m.Name=name
	local root=part(m,"Root",Vector3.new(.1,.1,.1),Vector3.zero,dark,nil,false)
	root.Transparency,root.CanQuery=1,false
	m.PrimaryPart=root
	return m
end
local function healthText(m,hp,max)
	local gui=m:FindFirstChild("HealthLabel")
	if gui then
		local text=m:GetAttribute("DisplayName") or m.Name
		local level=m:GetAttribute("Level")
		gui.Label.Text=text..(level and "  L"..level or "").."\n"..math.ceil(hp).." / "..max.." HP"
	end
end

function World.new(config)
	local self={}
	local world,entities,command
	function self:GetPlotPosition(index)
		local p=config.Plots[index]
		return p and Vector3.new(p.X,0,p.Z) or Vector3.zero
	end
	function self:Build()
		world=workspace:FindFirstChild("ShadowZoneWorld")
		if not world then
			world=Instance.new("Model"); world.Name="ShadowZoneWorld"; world.Parent=workspace
			for _,s in ipairs(Scene.Parts) do
				local target=folder(world,s.Group or "Geometry")
				local p
				if s.Spawn then
					p=Instance.new("SpawnLocation")
					p.Name,p.Size,p.Color=s.Name,Vector3.new(table.unpack(s.Size)),rgb(s.Color)
					p.Anchored,p.Neutral,p.Duration,p.CanTouch=true,true,0,false
					p.CanCollide,p.CanQuery=s.Collide~=false,true
					p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
					p.Material=Enum.Material[s.Material]
					p.Parent=target
				else
					p=part(target,s.Name,Vector3.new(table.unpack(s.Size)),Vector3.new(table.unpack(s.Position)),rgb(s.Color),Enum.Material[s.Material],s.Collide~=false)
				end
				local r=s.Rotation or {0,0,0}
				p.CFrame=CFrame.new(table.unpack(s.Position))*CFrame.Angles(math.rad(r[1]),math.rad(r[2]),math.rad(r[3]))
				p.Transparency=s.Transparency or 0
				if p.Transparency>=1 then p.CanQuery=false end
				if s.Shape then p.Shape=Enum.PartType[s.Shape] end
				if s.Light then
					local l=Instance.new("PointLight"); l.Color,l.Brightness,l.Range=rgb(s.Color),s.Light,s.LightRange or 18
					l.Shadows,l.Parent=false,p
				end
				if s.Text then
					local sign=label(p,p,s.Text,s.TextWidth or 280,s.TextOffset or 3)
					sign.Name,sign.MaxDistance="Sign",200
					sign.Label.TextSize=20
					if s.TextColor then sign.Label.TextColor3=rgb(s.TextColor) end
				end
			end
		end
		local old=world:FindFirstChild("Resources")
		if old then old:Destroy() end
		local resources=folder(world,"Resources")
		for index,node in ipairs(config.Nodes) do
			local isWood=node.Kind=="Wood"
			local p=part(resources,"Resource_"..index,Vector3.new(4,2.5,4),Vector3.new(node.X,1.25,node.Z),isWood and timber or steel,isWood and Enum.Material.Wood or Enum.Material.Metal,true)
			p:SetAttribute("NodeId",index); p:SetAttribute("Kind",node.Kind)
			label(p,p,isWood and "WOOD SALVAGE" or "SCRAP SALVAGE",170,3)
		end
		entities=folder(workspace,"ShadowZoneEntities")
		for _,name in ipairs({"Huts","Enemies","Defenses"}) do folder(entities,name) end
		command=world:FindFirstChild("CommandObjective")
		if not command then
			command=part(world,"CommandObjective",Vector3.new(1,1,1),Vector3.new(0,4,18),dark,nil,false)
			command.Transparency=1; command.CanQuery=false
			label(command,command,"COMMAND POST",290,4)
		end
		self:UpdateCommand(config.CommandHealth)
		Lighting.ClockTime,Lighting.Brightness=10,2
		Lighting.Ambient,Lighting.OutdoorAmbient=Color3.fromRGB(91,104,94),Color3.fromRGB(122,135,118)
		Lighting.FogStart,Lighting.FogEnd,Lighting.FogColor=160,360,Color3.fromRGB(99,113,99)
		Lighting.ExposureCompensation,Lighting.GlobalShadows=.1,true
		return world
	end
	function self:UpdateCommand(hp)
		if not command then return end
		command:SetAttribute("Health",hp); command:SetAttribute("MaxHealth",config.CommandHealth)
		local gui=command:FindFirstChild("HealthLabel")
		if gui then
			gui.Label.Text=(hp<=config.CommandHealth*.2 and "LAST STAND" or "COMMAND POST").."\n"..math.ceil(hp).." / "..config.CommandHealth.." HP"
			gui.Label.TextColor3=hp<=config.CommandHealth*.2 and Color3.fromRGB(236,135,108) or Color3.fromRGB(228,227,198)
		end
	end
	function self:SetPhase(phase,night)
		local isNight=phase=="Night"
		Lighting.ClockTime=isNight and 1.3 or phase=="Warning" and 18.5 or 10
		Lighting.Brightness=isNight and 1.4 or 2
		Lighting.OutdoorAmbient=isNight and Color3.fromRGB(71,81,85) or Color3.fromRGB(122,135,118)
		if world then world:SetAttribute("Phase",phase); world:SetAttribute("Night",night or 0) end
	end
	function self:CreateHut(index,tier,hp,ownerName)
		local huts=folder(entities or folder(workspace,"ShadowZoneEntities"),"Huts")
		local previous=huts:FindFirstChild("Hut_"..index)
		if previous then previous:Destroy() end
		local definition=config.Huts[tier]
		local m=model("Hut_"..index)
		m:SetAttribute("PlotIndex",index); m:SetAttribute("Tier",tier)
		m:SetAttribute("OwnerName",ownerName); m:SetAttribute("DisplayName",ownerName.." / "..definition.Name)
		local wallColor=tier==1 and timber or tier==2 and Color3.fromRGB(110,111,82) or Color3.fromRGB(118,127,110)
		local material=tier==1 and Enum.Material.WoodPlanks or tier==2 and Enum.Material.WoodPlanks or Enum.Material.Concrete
		local floor=part(m,"Foundation",Vector3.new(11,.4,11),Vector3.new(0,.2,0),tier==3 and steel or dark,tier==3 and Enum.Material.Concrete or Enum.Material.WoodPlanks,true)
		for _,s in ipairs({{Vector3.new(.5,7,10),Vector3.new(-5,3.9,0)},{Vector3.new(.5,7,10),Vector3.new(5,3.9,0)},{Vector3.new(10.5,7,.5),Vector3.new(0,3.9,-5)},{Vector3.new(3,7,.5),Vector3.new(-3.75,3.9,5)},{Vector3.new(3,7,.5),Vector3.new(3.75,3.9,5)}}) do
			local wall=part(m,"Wall",s[1],s[2],wallColor,material,true)
			wall:SetAttribute("CosmeticSurface",true)
		end
		part(m,"DoorLintel",Vector3.new(4.5,.6,.6),Vector3.new(0,7.1,5),dark,Enum.Material.Metal,true)
		local roof=part(m,"Roof",Vector3.new(12,.6,12),Vector3.new(0,7.7,0),tier==1 and Color3.fromRGB(83,71,52) or dark,tier==1 and Enum.Material.WoodPlanks or Enum.Material.Metal,true)
		roof:SetAttribute("CosmeticSurface",true)
		part(m,"Chest",Vector3.new(2.4,1.6,1.8),Vector3.new(-3,1.2,-3.4),timber,Enum.Material.WoodPlanks,true)
		part(m,"ChestBand",Vector3.new(2.5,.25,1.9),Vector3.new(-3,1.5,-3.4),steel,Enum.Material.Metal,false)
		if tier>=2 then
			for _,x in ipairs({-5.3,5.3}) do
				part(m,"Reinforcement",Vector3.new(.5,7.6,.5),Vector3.new(x,4,5.25),steel,Enum.Material.Metal,true)
				part(m,"Reinforcement",Vector3.new(.5,7.6,.5),Vector3.new(x,4,-5.25),steel,Enum.Material.Metal,true)
			end
			part(m,"DoorPlate",Vector3.new(2.8,1,.15),Vector3.new(-3.75,3,5.35),steel,Enum.Material.Metal,false)
		end
		if tier==3 then
			for _,x in ipairs({-4,4}) do
				part(m,"Sandbags",Vector3.new(3.6,1.2,2),Vector3.new(x,.6,6.5),sand,Enum.Material.Fabric,true)
				local lightPart=part(m,"Floodlight",Vector3.new(1,.6,.5),Vector3.new(x,7,5.7),Color3.fromRGB(228,213,160),Enum.Material.Neon,false)
				local light=Instance.new("PointLight")
				light.Color,light.Brightness,light.Range,light.Shadows,light.Parent=lightPart.Color,.7,20,false,lightPart
			end
			part(m,"Locker",Vector3.new(2,4,1.7),Vector3.new(3.2,2.4,-3.4),olive,Enum.Material.Metal,true)
			part(m,"Aerial",Vector3.new(.15,4,.15),Vector3.new(4,10,1),steel,Enum.Material.Metal,false)
		end
		label(m,floor,"",290,9)
		m:PivotTo(CFrame.new(self:GetPlotPosition(index))); m.Parent=huts
		self:UpdateHealth(m,hp,definition.Health)
		return m
	end
	function self:CreateDefense(kind,position,rotation,id,ownerName)
		local d=config.Defenses[kind]
		local m=model(kind.."_"..id)
		m:SetAttribute("Id",id); m:SetAttribute("Kind",kind); m:SetAttribute("Level",1)
		m:SetAttribute("OwnerName",ownerName); m:SetAttribute("DisplayName",d.Name)
		local top
		if kind=="Barricade" then
			for _,x in ipairs({-3,3}) do part(m,"Stake",Vector3.new(.55,3.8,.6),Vector3.new(x,1.9,0),timber,Enum.Material.Wood,true) end
			for _,y in ipairs({1,2.2,3.3}) do top=part(m,"Timber",Vector3.new(7.5,.8,.45),Vector3.new(0,y,0),timber,Enum.Material.WoodPlanks,true) end
		else
			part(m,"Foundation",Vector3.new(5.5,.3,5.5),Vector3.new(0,.15,0),dark,Enum.Material.Metal,true)
			for _,x in ipairs({-1,1}) do part(m,"Boot",Vector3.new(.8,1.6,1),Vector3.new(x*.5,1.1,0),dark,Enum.Material.Fabric,false) end
			part(m,"Uniform",Vector3.new(1.8,1.7,1),Vector3.new(0,2.7,0),olive,Enum.Material.Fabric,false)
			top=part(m,"Helmet",Vector3.new(1.6,.8,1.5),Vector3.new(0,4.3,0),olive,Enum.Material.Metal,false)
			part(m,"Face",Vector3.new(1.2,.9,1.1),Vector3.new(0,3.75,-.1),Color3.fromRGB(180,157,116),nil,false)
			part(m,"Rifle",Vector3.new(.45,.5,3.5),Vector3.new(0,3,-1.6),dark,Enum.Material.Metal,false)
			local muzzle=part(m,"Muzzle",Vector3.new(.25,.25,.3),Vector3.new(0,3,-3.4),steel,Enum.Material.Metal,false)
			muzzle.CanQuery=false
			for _,x in ipairs({-1.1,1.1}) do part(m,"Sleeve",Vector3.new(.55,1.5,.7),Vector3.new(x,2.9,-.2),olive,Enum.Material.Fabric,false) end
		end
		label(m,top,"",190,3)
		m:PivotTo(CFrame.new(position)*CFrame.Angles(0,math.rad(rotation or 0),0))
		m.Parent=folder(entities or folder(workspace,"ShadowZoneEntities"),"Defenses")
		self:UpdateDefense(m,1,d.Health,d.Health)
		return m
	end
	function self:AimDefense(m,target)
		if not m or not m.Parent or m:GetAttribute("Kind")~="Rifleman" then return end
		local position=m:GetPivot().Position
		local flat=Vector3.new(target.X,position.Y,target.Z)
		if (flat-position).Magnitude>.05 then m:PivotTo(CFrame.lookAt(position,flat)) end
	end
	function self:UpdateDefense(m,level,hp,maxHP)
		if not m or not m.Parent then return end
		m:SetAttribute("Level",level)
		self:UpdateHealth(m,hp or m:GetAttribute("Health") or 0,maxHP or m:GetAttribute("MaxHealth") or 1)
		local previous=m:FindFirstChild("RankStripes")
		if previous then previous:Destroy() end
		if m:GetAttribute("Kind")~="Rifleman" then return end
		local stripes=folder(m,"RankStripes")
		local pivot=m:GetPivot()
		for i=1,level do
			local mark=part(stripes,"Rank",Vector3.new(.55,.12,1),Vector3.zero,Color3.fromRGB(221,188,95),Enum.Material.Neon,false)
			mark.CFrame=pivot*CFrame.new(-1+(i-1)*.75,.37,1.7)
			mark.CanQuery=false
		end
	end
	function self:CreateEnemy(kind,id)
		local d=config.Enemies[kind]
		local m=model(kind.."_"..id)
		m:SetAttribute("Id",id); m:SetAttribute("Kind",kind); m:SetAttribute("DisplayName",d.Name)
		local s=d.Scale or 1
		local function limb(name,size,pos,color,material)
			return part(m,name,size*s,pos*s,color,material,false)
		end
		for _,x in ipairs({-.5,.5}) do limb("Leg",Vector3.new(.8,1.6,.85),Vector3.new(x,.8,0),dark) end
		limb("Coat",Vector3.new(1.9,1.8,1),Vector3.new(0,2.5,0),kind=="Armored" and steel or olive,Enum.Material.Fabric)
		for _,x in ipairs({-1.25,1.25}) do limb("Arm",Vector3.new(.65,1.7,.7),Vector3.new(x,2.7,-.35),rgb(d.Color)) end
		local head=limb("Head",Vector3.new(1.4,1.3,1.2),Vector3.new(0,4.05,0),rgb(d.Color))
		for _,x in ipairs({-.32,.32}) do limb("Eye",Vector3.new(.2,.17,.08),Vector3.new(x,4.2,-.65),Color3.fromRGB(219,222,132),Enum.Material.Neon) end
		if kind=="Armored" then
			limb("ArmorPlate",Vector3.new(2.1,1.5,.2),Vector3.new(0,2.5,-.65),steel,Enum.Material.Metal)
			limb("Helmet",Vector3.new(1.6,.5,1.4),Vector3.new(0,4.7,0),dark,Enum.Material.Metal)
		end
		label(m,head,"",155,2.2*s)
		m.Parent=folder(entities or folder(workspace,"ShadowZoneEntities"),"Enemies")
		self:UpdateHealth(m,d.Health,d.Health)
		return m
	end
	function self:UpdateHealth(m,hp,maxHP)
		if not m or not m.Parent then return end
		m:SetAttribute("Health",hp); m:SetAttribute("MaxHealth",maxHP)
		healthText(m,hp,maxHP)
		-- A destroyed shelter keeps its blueprint while its shell becomes a ruin.
		if m:GetAttribute("PlotIndex") then
			for _,p in ipairs(m:GetDescendants()) do
				if p:IsA("BasePart") and p.Name~="Root" then
					if p:GetAttribute("OriginalCollide")==nil then p:SetAttribute("OriginalCollide",p.CanCollide) end
					p.CanCollide=hp>0 and p:GetAttribute("OriginalCollide")==true
					p.Transparency=hp<=0 and .65 or 0
				end
			end
		end
	end
	function self:CreateRifle(character)
		local old=character:FindFirstChild("Service Rifle")
		if old then return old end
		local tool=Instance.new("Tool")
		tool.Name,tool.ToolTip,tool.CanBeDropped="Service Rifle","Aim at infected • R to reload",false
		tool:SetAttribute("ShadowZoneRifle",true)
		tool:SetAttribute("ShadowRifle",true)
		local handle=part(tool,"Handle",Vector3.new(.35,.8,1.6),Vector3.zero,dark,Enum.Material.Metal,false)
		handle.Anchored,handle.Massless=false,true
		local barrel=part(tool,"Barrel",Vector3.new(.2,.2,2),Vector3.new(0,.25,-1.6),steel,Enum.Material.Metal,false)
		barrel.Anchored,barrel.Massless=false,true
		local stock=part(tool,"Stock",Vector3.new(.3,.65,1.4),Vector3.new(0,.1,1.1),olive,Enum.Material.Metal,false)
		stock.Anchored,stock.Massless=false,true
		for _,p in ipairs({barrel,stock}) do
			local weld=Instance.new("WeldConstraint"); weld.Part0,weld.Part1,weld.Parent=handle,p,handle
		end
		local muzzle=Instance.new("Attachment"); muzzle.Name,muzzle.Position,muzzle.Parent="Muzzle",Vector3.new(0,0,-1),barrel
		tool.Grip=CFrame.new(0,-.2,-.6)
		tool.Parent=character
		return tool
	end
	return self
end
return World
]]></ProtectedString>
