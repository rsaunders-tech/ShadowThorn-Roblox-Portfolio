  <Item class="ServerScriptService" referent="RBX000000AD">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX000000AE">
      <Properties>
        <string name="Name">ShadowBlox</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX000000AF">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source">-- Server-only persistence and purchases. Require exactly once from Main.
-- Never grant developer products from a prompt-finished event.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Economy = {}
local config
local onChanged
local store
local initialized = false
local studioSession = false
local states = {}
local productsByKey, productsById, passesByKey, passesById, aurasByKey = {}, {}, {}, {}, {}

local SCHEMA_VERSION = 1
local LEASE_SECONDS = 180
local AUTOSAVE_SECONDS = 45
local MAX_STAT = 1000000000000
local MAX_RECEIPTS = 12000
local PROMPT_RECEIPT_LIMIT = 10000 -- Leave room for already pending/external purchases.

local function integer(value, fallback, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
		return fallback
	end
	return math.clamp(math.floor(value), 0, maximum or MAX_STAT)
end

local function validId(id)
	return type(id) == "number" and id &gt; 0 and id &lt; math.huge and id == math.floor(id)
end

local function copyMap(source)
	local result = {}
	for key, value in pairs(source) do
		result[key] = value
	end
	return result
end

local function profileFrom(raw)
	raw = type(raw) == "table" and raw or {}
	local upgrades = type(raw.Upgrades) == "table" and raw.Upgrades or {}
	local owned = { Violet = true }
	if type(raw.OwnedAuras) == "table" then
		for key in pairs(aurasByKey) do
			-- Marketplace ownership is rechecked each session, never trusted from a save.
			if key ~= "Eclipse" and raw.OwnedAuras[key] == true then
				owned[key] = true
			end
		end
	end
	local xp = integer(raw.XP, 0)
	return {
		Shards = integer(raw.Shards, 0),
		XP = xp,
		Level = 1 + math.floor(xp / 100),
		Kills = integer(raw.Kills, 0),
		BestWave = integer(raw.BestWave, 0),
		Upgrades = {
			Power = integer(upgrades.Power, 0, config.Upgrade.Power.MaxLevel),
			Vitality = integer(upgrades.Vitality, 0, config.Upgrade.Vitality.MaxLevel),
		},
		EquippedAura = owned[raw.EquippedAura] and raw.EquippedAura or "Violet",
		OwnedAuras = owned,
		VIP = false,
		DataMode = studioSession and "Studio session" or "Saved",
	}
end

local function snapshot(profile)
	local result = copyMap(profile)
	result.Upgrades = copyMap(profile.Upgrades)
	result.OwnedAuras = copyMap(profile.OwnedAuras)
	return result
end

local function storedProfile(profile)
	local result = snapshot(profile)
	result.DataMode = nil
	result.Level = nil -- Derived from XP.
	result.VIP = nil
	result.OwnedAuras.Eclipse = nil
	return result
end

local function decode(raw)
	if raw == nil then
		return { SchemaVersion = SCHEMA_VERSION, Profile = storedProfile(profileFrom(nil)), Receipts = {} }
	end
	if type(raw) ~= "table" or raw.SchemaVersion ~= SCHEMA_VERSION
		or type(raw.Profile) ~= "table" or type(raw.Receipts) ~= "table" then
		return nil
	end
	for _, key in ipairs({ "Shards", "XP", "Kills", "BestWave" }) do
		local value = raw.Profile[key]
		if type(value) ~= "number" or value ~= value or value &lt; 0 or value &gt; MAX_STAT or value ~= math.floor(value) then
			return nil -- Do not replace a damaged live balance with defaults.
		end
	end
	if type(raw.Profile.Upgrades) ~= "table" or type(raw.Profile.OwnedAuras) ~= "table"
		or type(raw.Profile.EquippedAura) ~= "string" then
		return nil
	end
	-- Reject damaged receipt history rather than silently resetting paid purchases.
	for id, granted in pairs(raw.Receipts) do
		if type(id) ~= "string" or #id &gt; 200 or granted ~= true then
			return nil
		end
	end
	if raw.Session ~= nil and (type(raw.Session) ~= "table"
		or type(raw.Session.Id) ~= "string" or type(raw.Session.ExpiresAt) ~= "number"
		or raw.Session.ExpiresAt ~= raw.Session.ExpiresAt or math.abs(raw.Session.ExpiresAt) == math.huge) then
		return nil
	end
	return raw
end

local function notify(player)
	if onChanged then
		local ok, err = pcall(onChanged, player)
		if not ok then
			warn("Shadow Blox profile notification failed:", err)
		end
	end
end

local function retry(callback)
	local lastError
	for attempt = 1, 3 do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if attempt &lt; 3 then
			task.wait(2 ^ (attempt - 1) + math.random() * 0.5)
		end
	end
	warn("Shadow Blox DataStore request failed:", lastError)
	return false, nil
end

local function healthy(state)
	return state.Ready and state.Healthy and not state.Removing and not state.Released
		and (studioSession or os.time() &lt; state.LeaseUntil)
end

-- Every operation and all of its retries finish before the next operation starts.
-- Notification callbacks run AFTER releasing this mutex, so they may call Get/Save.
local function locked(player, callback, allowRemoving)
	local state = states[player]
	if not state or not state.Ready then
		return false, "Your data is not ready. Rejoin to try again."
	end
	while state.Busy do
		task.wait()
		if states[player] ~= state then
			return false, "Your session has ended."
		end
	end
	if states[player] ~= state or (state.Removing and not allowRemoving) then
		return false, "Your session is closing."
	end
	state.Busy = true
	local result = table.pack(pcall(callback, state))
	state.Busy = false
	local changed = state.Notify
	state.Notify = false
	if changed and states[player] == state then
		notify(player)
	end
	if not result[1] then
		warn("Shadow Blox economy operation failed:", result[2])
		return false, "The server could not complete that action."
	end
	return table.unpack(result, 2, result.n)
end

local function unavailable(state, lost)
	state.Healthy = false
	state.SessionLost = state.SessionLost or lost
	state.Profile.DataMode = lost and "Session unavailable" or "Saving unavailable"
	state.Notify = true
end

-- Profile and receipt IDs are committed in ONE UpdateAsync on ONE player key.
-- A pending grant remains in memory on ambiguous failures. Freezing mutations
-- prevents a later autosave from overwriting a grant that actually committed.
local function saveLocked(state, release)
	if state.Released then
		return true
	end
	if state.SessionLost then
		return false
	end
	if studioSession then
		state.Released = release == true
		return true
	end
	local profile = storedProfile(state.Profile)
	-- Remember a pass aura selection while its ownership query is in flight.
	-- This preference grants no entitlement by itself.
	profile.EquippedAura = state.PreferredAura or profile.EquippedAura
	local receipts = copyMap(state.Receipts)
	local declined = false
	local ok, saved = retry(function()
		return store:UpdateAsync(state.Key, function(raw)
			declined = false
			local old = decode(raw)
			if not old or not old.Session or old.Session.Id ~= state.SessionId then
				declined = true
				return nil
			end
			-- Never remove a receipt written by an unexpected writer.
			for id in pairs(old.Receipts) do
				if not receipts[id] then
					declined = true
					return nil
				end
			end
			return {
				SchemaVersion = SCHEMA_VERSION,
				Profile = profile,
				Receipts = receipts,
				Session = not release and { Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS } or nil,
				LastSave = os.time(),
			}, { state.UserId }
		end)
	end)
	if not ok or not saved or declined then
		unavailable(state, declined)
		return false
	end
	state.PersistedReceipts = copyMap(receipts)
	state.Healthy = true
	state.Released = release == true
	if not release then
		state.LeaseUntil = saved.Session.ExpiresAt
	end
	if state.Profile.DataMode ~= "Saved" then
		state.Profile.DataMode = "Saved"
		state.Notify = true
	end
	return true
end

local function receiptHandler(receipt)
	local defer = Enum.ProductPurchaseDecision.NotProcessedYet
	if studioSession or type(receipt) ~= "table" or type(receipt.PlayerId) ~= "number" then
		return defer
	end
	local product = productsById[receipt.ProductId]
	local purchaseId = receipt.PurchaseId
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not product or not player or type(purchaseId) ~= "string" or #purchaseId == 0 or #purchaseId &gt; 200 then
		return defer
	end
	local processed = locked(player, function(state)
		if not healthy(state) then
			return false
		end
		if state.PersistedReceipts[purchaseId] then
			return true
		end
		if not state.Receipts[purchaseId] then
			if state.ReceiptCount &gt;= MAX_RECEIPTS or state.Profile.Shards &gt; MAX_STAT - product.Shards then
				warn("Shadow Blox purchase requires storage-capacity review for user", player.UserId)
				return false
			end
			state.Profile.Shards += product.Shards
			state.Receipts[purchaseId] = true
			state.ReceiptCount += 1
			state.Notify = true
		end
		-- Only acknowledge after both the grant and its deduplication ID are durable.
		return saveLocked(state, false)
	end)
	return processed and Enum.ProductPurchaseDecision.PurchaseGranted or defer
end

function Economy.Init(settings, changedCallback)
	assert(not initialized, "Economy.Init must only run once")
	initialized = true
	config = settings
	onChanged = changedCallback
	studioSession = RunService:IsStudio() and config.StudioPersistence ~= true
	if not studioSession then
		store = DataStoreService:GetDataStore(config.DataStoreName)
	end
	for _, aura in ipairs(config.Auras) do
		aurasByKey[aura.Key] = aura
	end
	for _, product in ipairs(config.Products) do
		productsByKey[product.Key] = product
		assert(integer(product.Shards, 0) == product.Shards and product.Shards &gt; 0, "Invalid shard product")
		if validId(product.Id) then
			assert(not productsById[product.Id], "Duplicate developer product ID")
			productsById[product.Id] = product
		end
	end
	for _, pass in ipairs(config.Passes) do
		passesByKey[pass.Key] = pass
		if validId(pass.Id) then
			assert(not passesById[pass.Id], "Duplicate pass ID")
			passesById[pass.Id] = pass
		end
	end
	-- This experience has exactly one receipt owner. Merge handlers here when
	-- adding new products; another script must not overwrite ProcessReceipt.
	MarketplaceService.ProcessReceipt = receiptHandler
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passesById[passId] then
			Economy.RefreshPasses(player)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player, state in pairs(states) do
				if state.Ready and not state.Removing and not state.Released and not state.SessionLost then
					task.spawn(Economy.Save, player, false)
				end
			end
		end
	end)
end

function Economy.Load(player)
	assert(initialized, "Call Economy.Init before Load")
	if states[player] then
		return Economy.IsReady(player)
	end
	local state = {
		UserId = player.UserId,
		Key = "Player_" .. tostring(player.UserId),
		SessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false),
		Ready = false,
		Busy = false,
		Healthy = true,
		Removing = false,
		Profile = profileFrom(nil),
		PassOwnership = {},
		Receipts = {},
		PersistedReceipts = {},
		ReceiptCount = 0,
		LeaseUntil = 0,
		LastPrompt = -math.huge,
		PreferredAura = "Violet",
	}
	states[player] = state
	if not studioSession then
		local ok, loaded = retry(function()
			return store:UpdateAsync(state.Key, function(raw)
				local old = decode(raw)
				if not old then
					return nil
				end
				local session = old.Session
				if session and session.Id ~= state.SessionId and session.ExpiresAt &gt; os.time() then
					return nil
				end
				return {
					SchemaVersion = SCHEMA_VERSION,
					Profile = old.Profile,
					Receipts = old.Receipts,
					Session = { Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS },
					LastSave = old.LastSave,
				}, { player.UserId }
			end)
		end)
		if not ok or not loaded or not loaded.Session or loaded.Session.Id ~= state.SessionId then
			if states[player] == state then
				states[player] = nil
			end
			warn("Shadow Blox could not acquire saved data for user", player.UserId)
			return false
		end
		state.Profile = profileFrom(loaded.Profile)
		if aurasByKey[loaded.Profile.EquippedAura] then
			state.PreferredAura = loaded.Profile.EquippedAura
		end
		state.Receipts = copyMap(loaded.Receipts)
		state.PersistedReceipts = copyMap(loaded.Receipts)
		for _ in pairs(state.Receipts) do
			state.ReceiptCount += 1
		end
		state.LeaseUntil = loaded.Session.ExpiresAt
	end
	state.Ready = true
	-- A player may leave while UpdateAsync is in flight. Release that acquired
	-- session using this local state even if Remove already detached the player.
	if state.Removing or states[player] ~= state or player.Parent ~= Players then
		saveLocked(state, true)
		if states[player] == state then
			states[player] = nil
		end
		return false
	end
	notify(player)
	task.spawn(Economy.RefreshPasses, player)
	return true
end

function Economy.Get(player)
	local state = states[player]
	if not state or not state.Ready then
		return nil
	end
	local result = snapshot(state.Profile)
	if not studioSession and not state.Released and os.time() &gt;= state.LeaseUntil then
		result.DataMode = "Saving unavailable"
	end
	return result
end

function Economy.IsReady(player)
	local state = states[player]
	return state ~= nil and healthy(state)
end

function Economy.Award(player, shards, xp, kills, wave)
	return locked(player, function(state)
		if not healthy(state) then
			return false, "Saving is unavailable. Rewards are paused."
		end
		local profile = state.Profile
		profile.Shards = math.min(MAX_STAT, profile.Shards + integer(shards, 0))
		profile.XP = math.min(MAX_STAT, profile.XP + integer(xp, 0))
		profile.Level = 1 + math.floor(profile.XP / 100)
		profile.Kills = math.min(MAX_STAT, profile.Kills + integer(kills, 0))
		profile.BestWave = math.max(profile.BestWave, integer(wave, 0))
		state.Notify = true
		return true
	end)
end

function Economy.Upgrade(player, key)
	return locked(player, function(state)
		if not healthy(state) then
			return false, "Saving is unavailable. Try again shortly."
		end
		local upgrade = type(key) == "string" and config.Upgrade[key]
		if not upgrade then
			return false, "Unknown upgrade."
		end
		local level = state.Profile.Upgrades[key]
		if not level or level &gt;= upgrade.MaxLevel then
			return false, "This upgrade is at its maximum."
		end
		local cost = math.floor(upgrade.BaseCost * upgrade.CostGrowth ^ level)
		if state.Profile.Shards &lt; cost then
			return false, "Earn more shards to upgrade."
		end
		state.Profile.Shards -= cost
		state.Profile.Upgrades[key] += 1
		state.Notify = true
		return true, upgrade.Name and (upgrade.Name .. " upgraded!") or (key .. " upgraded!")
	end)
end

function Economy.Equip(player, key)
	return locked(player, function(state)
		if not healthy(state) then
			return false, "Saving is unavailable. Try again shortly."
		end
		local aura = type(key) == "string" and aurasByKey[key]
		if not aura then
			return false, "Unknown aura."
		end
		if not state.Profile.OwnedAuras[key] then
			if key == "Eclipse" or type(aura.Cost) ~= "number" then
				return false, "This cosmetic requires the Eclipse Aura pass."
			end
			local cost = integer(aura.Cost, 0)
			if state.Profile.Shards &lt; cost then
				return false, "Earn more shards to unlock this aura."
			end
			state.Profile.Shards -= cost
			state.Profile.OwnedAuras[key] = true
		end
		state.Profile.EquippedAura = key
		state.PreferredAura = key
		state.Notify = true
		return true, aura.Name .. " equipped!"
	end)
end

function Economy.Purchase(player, key)
	return locked(player, function(state)
		if not healthy(state) then
			return false, "Your saved data must be available before purchasing."
		end
		if RunService:IsStudio() then
			return false, "Robux purchases are disabled in Studio. Use a published test experience."
		end
		local product = type(key) == "string" and productsByKey[key]
		local pass = type(key) == "string" and passesByKey[key]
		local item = product or pass
		if not item or not validId(item.Id) then
			return false, "Purchases are not configured yet."
		end
		if pass and state.PassOwnership[key] then
			return false, "You already own this pass."
		end
		if product and (state.ReceiptCount &gt;= PROMPT_RECEIPT_LIMIT or state.Profile.Shards &gt; MAX_STAT - product.Shards) then
			return false, "Shard purchases are temporarily unavailable for this profile."
		end
		if os.clock() - state.LastPrompt &lt; 3 then
			return false, "Please wait before opening another purchase."
		end
		state.LastPrompt = os.clock()
		local ok = pcall(function()
			if product then
				MarketplaceService:PromptProductPurchase(player, item.Id)
			else
				MarketplaceService:PromptGamePassPurchase(player, item.Id)
			end
		end)
		return ok, ok and "Confirm the price in Roblox's purchase window." or "The purchase window is unavailable. Try again."
	end)
end

function Economy.RefreshPasses(player)
	if RunService:IsStudio() or not states[player] then
		return
	end
	-- Query ownership outside the mutex. This service call may yield; the
	-- profile and session are checked again before applying its result.
	local ownership = {}
	for key, pass in pairs(passesByKey) do
		if validId(pass.Id) then
			local ok, owned = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok then
				ownership[key] = owned == true
			end
		end
	end
	locked(player, function(state)
		if not healthy(state) then
			return false
		end
		for key, owned in pairs(ownership) do
			-- A slower join query must not revoke a newer verified purchase.
			if owned or state.PassOwnership[key] ~= true then
				state.PassOwnership[key] = owned
			end
		end
		state.Profile.VIP = state.PassOwnership.VIP == true
		state.Profile.OwnedAuras.Eclipse = state.PassOwnership.Eclipse == true or nil
		if state.PreferredAura == "Eclipse" and state.Profile.OwnedAuras.Eclipse then
			state.Profile.EquippedAura = "Eclipse"
		end
		if state.Profile.EquippedAura == "Eclipse" and not state.Profile.OwnedAuras.Eclipse then
			state.Profile.EquippedAura = "Violet"
		end
		state.Notify = true
		return true
	end)
end

function Economy.Save(player, release)
	local state = states[player]
	if not state then
		return false
	end
	if release then
		state.Removing = true
	end
	return locked(player, function(current)
		return saveLocked(current, release == true)
	end, true)
end

function Economy.Remove(player)
	local state = states[player]
	if state then
		state.Removing = true
		while state.Busy do
			task.wait()
		end
		states[player] = nil
	end
end

return Economy
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX000000B0">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">-- Server-owned combat, waves, and arena membership. Clients send intentions only.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("ShadowBlox")
local Config = require(Shared:WaitForChild("Config"))
local World = require(script.Parent:WaitForChild("World"))
local Economy = require(script.Parent:WaitForChild("Economy"))
local Combat = Config.Combat
local WaveConfig = Config.Waves
local random = Random.new()

local remotes = Shared:FindFirstChild("Remotes") or Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = Shared
local function remote(name)
	local event = remotes:FindFirstChild(name) or Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = remotes
	return event
end
local Action = remote("Action")
local State = remote("State")
local FX = remote("FX")
local arena = World.Build()

local cooldownDurations = {
	Attack = Combat.AttackCooldown,
	Dash = Combat.DashCooldown,
	Nova = Combat.NovaCooldown,
}
local sessions = {}
local enemies = {}
local phase = "Intermission"
local wave = 0
local deadline = workspace:GetServerTimeNow() + WaveConfig.Intermission
local shuttingDown = false
local sendState
local applyCharacter

local function toast(player, message, kind)
	if player.Parent == Players then
		FX:FireClient(player, "Toast", {Text = message, Kind = kind or "info"})
	end
end

local function body(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health &gt; 0 and root and root:IsA("BasePart") then
		return character, humanoid, root
	end
	return nil, nil, nil
end

local function ready(player)
	return sessions[player] ~= nil and Economy.IsReady(player)
end

local function activePlayers()
	local active = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("InArena") == true and ready(player) then
			local _, humanoid, root = body(player)
			if root then
				table.insert(active, {Player = player, Humanoid = humanoid, Root = root})
			end
		end
	end
	return active
end

local function enemyCount()
	local count = 0
	for _ in enemies do
		count += 1
	end
	return count
end

local function cooldown(player, name)
	local session = sessions[player]
	if not session then return false end
	local now = workspace:GetServerTimeNow()
	if now &lt; (session.CooldownEnds[name] or 0) then return false end
	session.CooldownEnds[name] = now + cooldownDurations[name]
	return true
end

sendState = function(player)
	local session = sessions[player]
	if not session or player.Parent ~= Players then return end
	State:FireClient(player, {
		Profile = Economy.Get(player),
		Wave = wave,
		Phase = phase,
		Remaining = math.max(0, math.ceil(deadline - workspace:GetServerTimeNow())),
		Enemies = enemyCount(),
		InArena = player:GetAttribute("InArena") == true,
		Cooldowns = cooldownDurations,
		CooldownEnds = table.clone(session.CooldownEnds),
		DataReady = Economy.IsReady(player),
	})
end

local function broadcastState()
	for _, player in Players:GetPlayers() do sendState(player) end
end

local function auraDefinition(key)
	for _, aura in Config.Auras do
		if aura.Key == key then return aura end
	end
	return Config.Auras[1]
end

applyCharacter = function(player)
	local character, humanoid, root = body(player)
	local profile = Economy.Get(player)
	if not character or not profile then return end
	local upgrades = profile.Upgrades or {}
	local maxHealth = Combat.BaseHealth + (upgrades.Vitality or 0) * Combat.HealthPerUpgrade
	local difference = maxHealth - humanoid.MaxHealth
	humanoid.MaxHealth = maxHealth
	humanoid.Health = math.min(maxHealth, humanoid.Health + math.max(0, difference))
	humanoid.WalkSpeed = Combat.WalkSpeed
	local aura = auraDefinition(profile.EquippedAura)
	if not aura then return end
	local cosmeticKey = tostring(aura.Key) .. ":" .. tostring(profile.VIP == true)
	if character:GetAttribute("ShadowAura") == cosmeticKey then return end
	character:SetAttribute("ShadowAura", cosmeticKey)
	local old = character:FindFirstChild("ShadowAuraEffect")
	if old then old:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name = "ShadowAuraEffect"
	folder.Parent = character
	local highlight = Instance.new("Highlight")
	highlight.Name = "AuraOutline"
	highlight.Adornee = character
	highlight.FillTransparency = 1
	highlight.OutlineColor = aura.Color
	highlight.OutlineTransparency = 0.35
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = folder
	local light = Instance.new("PointLight")
	light.Name = "AuraGlow"
	light.Color = aura.Color
	light.Brightness = 0.7
	light.Range = 8
	light.Parent = folder
	-- Lights must be attached to a BasePart/Attachment to render.
	local attachment = Instance.new("Attachment")
	attachment.Name = "AuraAnchor"
	attachment.Parent = root
	attachment:SetAttribute("ShadowAuraAttachment", true)
	for _, child in root:GetChildren() do
		if child ~= attachment and child:GetAttribute("ShadowAuraAttachment") then child:Destroy() end
	end
	light.Parent = attachment
	local particles = Instance.new("ParticleEmitter")
	particles.Name = "ShadowWisps"
	particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Color = ColorSequence.new(aura.Color)
	particles.LightEmission = 0.8
	particles.Rate = profile.VIP and 14 or 8
	particles.Lifetime = NumberRange.new(0.45, 0.8)
	particles.Speed = NumberRange.new(0.7, 1.6)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.13), NumberSequenceKeypoint.new(1, 0)})
	particles.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
	particles.Parent = attachment
	if profile.VIP then
		local nameplate = Instance.new("BillboardGui")
		nameplate.Name = "Supporter"
		nameplate.Adornee = character:FindFirstChild("Head") or root
		nameplate.Size = UDim2.fromOffset(130, 24)
		nameplate.StudsOffset = Vector3.new(0, 2.4, 0)
		nameplate.MaxDistance = 60
		nameplate.Parent = folder
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "★ VIP SUPPORTER"
		label.Font = Enum.Font.GothamBold
		label.TextSize = 11
		label.TextColor3 = Color3.fromRGB(255, 208, 99)
		label.TextStrokeTransparency = 0.5
		label.Parent = nameplate
	end
end

local function teleport(player, position, inArena)
	local character, _, root = body(player)
	if not root then return false end
	player:SetAttribute("InArena", inArena)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(CFrame.lookAt(position, Vector3.new(0, position.Y, 0)))
	local session = sessions[player]
	if session then session.InvulnerableUntil = workspace:GetServerTimeNow() + 1.5 end
	sendState(player)
	return true
end

local function toggleArena(player)
	local session = sessions[player]
	if not session then return end
	local now = workspace:GetServerTimeNow()
	if now &lt; session.NextToggle then return end
	session.NextToggle = now + 1
	if player:GetAttribute("InArena") then
		teleport(player, arena.LobbySpawn, false)
		return
	end
	if not ready(player) then
		toast(player, "Your data is still loading. Try again in a moment.", "error")
		return
	end
	local angle = random:NextNumber(0, math.pi * 2)
	local spawn = Vector3.new(arena.ArenaCenter.X + math.cos(angle) * 15, arena.LobbySpawn.Y, arena.ArenaCenter.Z + math.sin(angle) * 15)
	if teleport(player, spawn, true) then
		toast(player, "Stay in the arena, defeat shadows, and survive the wave.", "info")
	end
end

local enemyKinds = {
	Stalker = {Health = 48, Speed = 10, Damage = 10, Reach = 4.6, Interval = 1.25, Scale = 1, Color = Color3.fromRGB(121, 67, 196), Reward = 7},
	Wisp = {Health = 30, Speed = 15, Damage = 7, Reach = 4, Interval = 1.05, Scale = 0.8, Color = Color3.fromRGB(50, 195, 222), Reward = 6},
	Brute = {Health = 105, Speed = 7.5, Damage = 16, Reach = 5.4, Interval = 1.7, Scale = 1.3, Color = Color3.fromRGB(216, 64, 104), Reward = 12},
	Boss = {Health = 360, Speed = 8, Damage = 24, Reach = 6.6, Interval = 1.6, Scale = 2, Color = Color3.fromRGB(245, 124, 52), Reward = 60},
}

local function block(model, name, size, offset, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = CFrame.new(offset)
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function spawnEnemy(kind, playerCount)
	local spec = enemyKinds[kind]
	local model = Instance.new("Model")
	model.Name = kind == "Boss" and "ECLIPSE WARDEN" or kind
	model:SetAttribute("ShadowEnemy", true)
	model:SetAttribute("EnemyType", kind)
	local scale = spec.Scale
	local dark = Color3.fromRGB(23, 18, 37)
	local root = block(model, "Root", Vector3.new(2, 3, 2) * scale, Vector3.zero, dark)
	root.Transparency = 1
	model.PrimaryPart = root
	block(model, "Torso", Vector3.new(2.1, 2.6, 1.35) * scale, Vector3.new(0, 0.2, 0) * scale, dark)
	block(model, "Head", Vector3.new(1.75, 1.65, 1.5) * scale, Vector3.new(0, 2.2, 0) * scale, spec.Color)
	block(model, "LeftArm", Vector3.new(0.7, 2.5, 0.85) * scale, Vector3.new(-1.5, 0.1, 0) * scale, dark)
	block(model, "RightArm", Vector3.new(0.7, 2.5, 0.85) * scale, Vector3.new(1.5, 0.1, 0) * scale, dark)
	block(model, "LeftLeg", Vector3.new(0.85, 1.7, 0.9) * scale, Vector3.new(-0.55, -1.75, 0) * scale, dark)
	block(model, "RightLeg", Vector3.new(0.85, 1.7, 0.9) * scale, Vector3.new(0.55, -1.75, 0) * scale, dark)
	block(model, "LeftEye", Vector3.new(0.42, 0.25, 0.1) * scale, Vector3.new(-0.43, 2.35, -0.79) * scale, Color3.new(1, 1, 1), Enum.Material.Neon)
	block(model, "RightEye", Vector3.new(0.42, 0.25, 0.1) * scale, Vector3.new(0.43, 2.35, -0.79) * scale, Color3.new(1, 1, 1), Enum.Material.Neon)
	block(model, "Core", Vector3.new(0.65, 1.2, 0.15) * scale, Vector3.new(0, 0.3, -0.76) * scale, spec.Color, Enum.Material.Neon)
	if kind == "Boss" then
		for index = -1, 1 do
			block(model, "Crown", Vector3.new(0.35, 1 + (index == 0 and 0.5 or 0), 0.4) * scale, Vector3.new(index * 0.65, 3.35, 0) * scale, spec.Color, Enum.Material.Neon)
		end
	end
	local spawnPoint = arena.EnemySpawns[random:NextInteger(1, #arena.EnemySpawns)]
	local offset = Vector3.new(random:NextNumber(-3, 3), 0, random:NextNumber(-3, 3))
	local position = Vector3.new(spawnPoint.X, 2 + 2.6 * scale, spawnPoint.Z) + offset
	model:PivotTo(CFrame.new(position))
	model.Parent = arena.EnemyFolder
	local maxHealth = math.ceil(spec.Health * (1 + (wave - 1) * 0.13 + (playerCount - 1) * 0.2))
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("MaxHealth", maxHealth)
	local bar = Instance.new("BillboardGui")
	bar.Name = "EnemyHealth"
	bar.Adornee = root
	bar.Size = UDim2.fromOffset(kind == "Boss" and 180 or 105, 34)
	bar.StudsOffset = Vector3.new(0, 3.7 * scale, 0)
	bar.AlwaysOnTop = false
	bar.MaxDistance = kind == "Boss" and 180 or 90
	bar.Parent = model
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 22)
	label.Font = Enum.Font.GothamBold
	label.TextSize = kind == "Boss" and 14 or 11
	label.TextColor3 = spec.Color
	label.TextStrokeTransparency = 0.4
	label.Text = model.Name
	label.Parent = bar
	local track = Instance.new("Frame")
	track.BackgroundColor3 = Color3.fromRGB(30, 25, 42)
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0, 0, 0, 24)
	track.Size = UDim2.new(1, 0, 0, 5)
	track.Parent = bar
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = spec.Color
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = track
	enemies[model] = {
		Model = model, Root = root, Kind = kind, Spec = spec, Health = maxHealth,
		MaxHealth = maxHealth, Fill = fill, Contributors = {}, NextAttack = 0,
		Turn = random:NextNumber() &gt; 0.5 and 1 or -1,
	}
end

local function clearEnemies()
	for model in enemies do model:Destroy() end
	table.clear(enemies)
end

local function rewardKill(enemy, killer)
	for player, contribution in enemy.Contributors do
		local _, _, root = body(player)
		if player.Parent == Players and root and ready(player) and player:GetAttribute("InArena") == true then
			local fraction = math.clamp(contribution / enemy.MaxHealth, 0, 1)
			local amount = math.max(2, math.floor(enemy.Spec.Reward * (0.5 + fraction * 0.5)))
			Economy.Award(player, amount, amount * 2, player == killer and 1 or 0)
		end
	end
end

local function hitEnemy(enemy, player, damage, critical)
	if not enemies[enemy.Model] or enemy.Health &lt;= 0 then return end
	local dealt = math.min(enemy.Health, damage)
	enemy.Health -= dealt
	enemy.Contributors[player] = (enemy.Contributors[player] or 0) + dealt
	enemy.Model:SetAttribute("Health", enemy.Health)
	enemy.Fill.Size = UDim2.fromScale(math.max(0, enemy.Health / enemy.MaxHealth), 1)
	FX:FireAllClients("Damage", {Position = enemy.Root.Position + Vector3.new(0, 2.5, 0), Amount = dealt, Critical = critical == true})
	if enemy.Health &lt;= 0 then
		enemies[enemy.Model] = nil
		rewardKill(enemy, player)
		enemy.Model:Destroy()
	end
end

local function combatReady(player)
	if phase ~= "Wave" or not ready(player) or player:GetAttribute("InArena") ~= true then return nil end
	local _, _, root = body(player)
	return root
end

local function lineOfSight(from, to)
	local excluded = {arena.EnemyFolder, arena.EffectsFolder}
	for _, player in Players:GetPlayers() do
		if player.Character then table.insert(excluded, player.Character) end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = excluded
	params.IgnoreWater = true
	return workspace:Raycast(from, to - from, params) == nil
end

local function attack(player)
	local root = combatReady(player)
	if not root or not cooldown(player, "Attack") then return end
	local profile = Economy.Get(player)
	local damage = Combat.AttackDamage + ((profile and profile.Upgrades.Power) or 0) * Combat.DamagePerUpgrade
	FX:FireAllClients("Attack", {Position = root.Position, Radius = Combat.AttackRange})
	local candidates = {}
	for _, enemy in enemies do
		local offset = enemy.Root.Position - root.Position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		local distance = flat.Magnitude
		if distance &lt;= Combat.AttackRange and math.abs(offset.Y) &lt;= 10 then
			local facing = distance &lt; 3 or root.CFrame.LookVector:Dot(flat.Unit) &gt; -0.1
			if facing and lineOfSight(root.Position, enemy.Root.Position) then
				table.insert(candidates, {Enemy = enemy, Distance = distance})
			end
		end
	end
	table.sort(candidates, function(a, b) return a.Distance &lt; b.Distance end)
	for index = 1, math.min(3, #candidates) do hitEnemy(candidates[index].Enemy, player, damage, false) end
	sendState(player)
end

local function dash(player)
	local root = combatReady(player)
	if not root or not cooldown(player, "Dash") then return end
	local character, humanoid = body(player)
	local direction = humanoid.MoveDirection
	if direction.Magnitude &lt; 0.1 then direction = root.CFrame.LookVector end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude &lt; 0.1 then direction = Vector3.new(0, 0, -1) end
	direction = direction.Unit
	local distance = Combat.DashDistance
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character, arena.EnemyFolder, arena.EffectsFolder}
	params.IgnoreWater = true
	local obstruction = workspace:Raycast(root.Position, direction * distance, params)
	if obstruction then distance = math.max(0, obstruction.Distance - 3) end
	local from = root.Position
	local destination = from + direction * distance
	local centerOffset = Vector3.new(destination.X - arena.ArenaCenter.X, 0, destination.Z - arena.ArenaCenter.Z)
	local safeRadius = arena.ArenaRadius - 4
	if centerOffset.Magnitude &gt; safeRadius then
		local clamped = arena.ArenaCenter + centerOffset.Unit * safeRadius
		destination = Vector3.new(clamped.X, from.Y, clamped.Z)
	end
	-- A downward probe prevents a dash onto a hole or off the platform.
	local floor = workspace:Raycast(destination + Vector3.new(0, 4, 0), Vector3.new(0, -16, 0), params)
	if floor then
		character:PivotTo(CFrame.lookAt(destination, destination + direction))
		root.AssemblyLinearVelocity = Vector3.zero
		sessions[player].InvulnerableUntil = workspace:GetServerTimeNow() + 0.4
		FX:FireAllClients("Dash", {From = from, To = destination})
	end
	sendState(player)
end

local function nova(player)
	local root = combatReady(player)
	if not root or not cooldown(player, "Nova") then return end
	local profile = Economy.Get(player)
	local damage = Combat.NovaDamage + ((profile and profile.Upgrades.Power) or 0) * Combat.DamagePerUpgrade * 1.5
	FX:FireAllClients("Nova", {Position = root.Position, Radius = Combat.NovaRadius})
	local targets = {}
	for _, enemy in enemies do
		if (enemy.Root.Position - root.Position).Magnitude &lt;= Combat.NovaRadius and lineOfSight(root.Position, enemy.Root.Position) then
			table.insert(targets, enemy)
		end
	end
	for _, enemy in targets do hitEnemy(enemy, player, damage, true) end
	sendState(player)
end

local function beginWave(active)
	wave += 1
	phase = "Wave"
	deadline = workspace:GetServerTimeNow() + WaveConfig.TimeLimit
	local count = math.min(WaveConfig.MaxEnemies, WaveConfig.BaseEnemies + (wave - 1) * WaveConfig.EnemiesPerWave + (#active - 1) * 2)
	local bossWave = wave % WaveConfig.BossEvery == 0
	for index = 1, count do
		local kind = "Stalker"
		if bossWave and index == count then
			kind = "Boss"
		elseif wave &gt;= 3 and index % 5 == 0 then
			kind = "Brute"
		elseif wave &gt;= 2 and index % 3 == 0 then
			kind = "Wisp"
		end
		spawnEnemy(kind, #active)
	end
	for _, entry in active do
		FX:FireClient(entry.Player, "Wave", {Wave = wave})
		toast(entry.Player, bossWave and "The Eclipse Warden has arrived!" or ("Wave " .. wave .. " — shadows incoming!"), "info")
	end
	broadcastState()
end

local function completeWave(active)
	-- Set the phase before calling economy operations: a save can hold its mutex
	-- and yield, while another Heartbeat is already running.
	phase = "Intermission"
	deadline = workspace:GetServerTimeNow() + WaveConfig.Intermission
	local reward = 18 + wave * 7
	local completedWave = wave
	for _, entry in active do
		entry.Humanoid.Health = math.min(entry.Humanoid.MaxHealth, entry.Humanoid.Health + 30)
		task.spawn(function()
			local awarded = Economy.Award(entry.Player, reward, 30 + completedWave * 12, 0, completedWave)
			if awarded then toast(entry.Player, "Wave cleared! +" .. reward .. " shards • +30 health", "success") end
		end)
	end
	broadcastState()
end

local function resetWaves()
	clearEnemies()
	wave = 0
	phase = "Intermission"
	deadline = workspace:GetServerTimeNow() + WaveConfig.Intermission
end

local function moveEnemies(active, dt)
	local excluded = {arena.EnemyFolder, arena.EffectsFolder}
	for _, player in Players:GetPlayers() do
		if player.Character then table.insert(excluded, player.Character) end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = excluded
	params.IgnoreWater = true
	local now = workspace:GetServerTimeNow()
	for _, enemy in enemies do
		local position = enemy.Root.Position
		local target, nearest = nil, math.huge
		for _, entry in active do
			local offset = entry.Root.Position - position
			local distance = Vector3.new(offset.X, 0, offset.Z).Magnitude
			if distance &lt; nearest then target, nearest = entry, distance end
		end
		if target then
			local offset = target.Root.Position - position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if flat.Magnitude &gt; 0.05 then
				local direction = flat.Unit
				local nextPosition = position
				if nearest &gt; enemy.Spec.Reach * 0.75 then
					local step = math.min(nearest, enemy.Spec.Speed * dt)
					local obstacle = workspace:Raycast(position, direction * (step + 2.5), params)
					if obstacle then
						local side = Vector3.new(-direction.Z, 0, direction.X) * enemy.Turn
						if workspace:Raycast(position, side * (step + 2.5), params) then enemy.Turn *= -1 else direction = side end
					end
					nextPosition += direction * step
					local radial = Vector3.new(nextPosition.X - arena.ArenaCenter.X, 0, nextPosition.Z - arena.ArenaCenter.Z)
					if radial.Magnitude &gt; arena.ArenaRadius - 2 then
						local edge = arena.ArenaCenter + radial.Unit * (arena.ArenaRadius - 2)
						nextPosition = Vector3.new(edge.X, position.Y, edge.Z)
					end
				end
				enemy.Model:PivotTo(CFrame.lookAt(nextPosition, nextPosition + flat.Unit))
			end
			if nearest &lt;= enemy.Spec.Reach and math.abs(offset.Y) &lt; 10 and now &gt;= enemy.NextAttack then
				enemy.NextAttack = now + enemy.Spec.Interval
				local session = sessions[target.Player]
				if session and now &gt;= session.InvulnerableUntil and lineOfSight(position, target.Root.Position) then
					local damage = math.ceil(enemy.Spec.Damage * (1 + (wave - 1) * 0.06))
					target.Humanoid:TakeDamage(damage)
				end
			end
		end
	end
end

Economy.Init(Config, function(player)
	if sessions[player] and player.Parent == Players then
		applyCharacter(player)
		sendState(player)
	end
end)

local function characterAdded(player, character)
	player:SetAttribute("InArena", false)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or player.Character ~= character or not sessions[player] then return end
	teleport(player, arena.LobbySpawn, false)
	applyCharacter(player)
	humanoid.Died:Connect(function()
		if player.Character ~= character then return end
		player:SetAttribute("InArena", false)
		toast(player, "The shadows got you. Respawn, upgrade, and jump back in.", "info")
		sendState(player)
	end)
end

local function playerAdded(player)
	if sessions[player] then return end
	sessions[player] = {CooldownEnds = {}, Tokens = 24, LastToken = workspace:GetServerTimeNow(), NextToggle = 0, InvulnerableUntil = 0, NextShop = 0}
	player:SetAttribute("InArena", false)
	player.CharacterAdded:Connect(function(character) task.spawn(characterAdded, player, character) end)
	if player.Character then task.spawn(characterAdded, player, player.Character) end
	task.spawn(function()
		local ok, result = pcall(Economy.Load, player)
		if not sessions[player] or player.Parent ~= Players then return end
		if not ok or result == false or not Economy.IsReady(player) then
			warn("Shadow Blox: profile unavailable for user " .. player.UserId)
			toast(player, "Your data could not be loaded. Please rejoin before entering the arena.", "error")
		else
			applyCharacter(player)
		end
		sendState(player)
	end)
end

local function playerRemoving(player)
	player:SetAttribute("InArena", false)
	sessions[player] = nil
	for _, enemy in enemies do enemy.Contributors[player] = nil end
	local ok, saved = pcall(Economy.Save, player, true)
	if not ok or saved == false then warn("Shadow Blox: profile save was not confirmed for user " .. player.UserId .. ": " .. tostring(saved)) end
	Economy.Remove(player)
end

Players.PlayerAdded:Connect(playerAdded)
Players.PlayerRemoving:Connect(playerRemoving)
for _, player in Players:GetPlayers() do playerAdded(player) end

local function allowRemote(player)
	local session = sessions[player]
	if not session then return false end
	local now = workspace:GetServerTimeNow()
	session.Tokens = math.min(24, session.Tokens + (now - session.LastToken) * 10)
	session.LastToken = now
	if session.Tokens &lt; 1 then return false end
	session.Tokens -= 1
	return true
end

local function shopAction(player, kind, key)
	local session = sessions[player]
	if not session or not ready(player) or type(key) ~= "string" or #key &gt; 40 then return end
	local now = workspace:GetServerTimeNow()
	if now &lt; session.NextShop then return end
	session.NextShop = now + 0.35
	local ok, message
	if kind == "Upgrade" then
		ok, message = Economy.Upgrade(player, key)
	elseif kind == "Equip" then
		ok, message = Economy.Equip(player, key)
	elseif kind == "Purchase" then
		ok, message = Economy.Purchase(player, key)
	end
	if type(message) == "string" then toast(player, message, ok and "success" or "error") end
	sendState(player)
end

Action.OnServerEvent:Connect(function(player, kind, argument)
	if shuttingDown or type(kind) ~= "string" or #kind &gt; 20 or not allowRemote(player) then return end
	if kind == "Attack" then attack(player)
	elseif kind == "Dash" then dash(player)
	elseif kind == "Nova" then nova(player)
	elseif kind == "ToggleArena" then toggleArena(player)
	elseif kind == "Sync" then sendState(player)
	elseif kind == "Upgrade" or kind == "Equip" or kind == "Purchase" then shopAction(player, kind, argument)
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	if shuttingDown or not sessions[player] or not prompt:IsDescendantOf(workspace) then return end
	local _, _, root = body(player)
	local parent = prompt.Parent
	local position
	if parent and parent:IsA("Attachment") then position = parent.WorldPosition
	elseif parent and parent:IsA("BasePart") then position = parent.Position end
	if not root or not position or (root.Position - position).Magnitude &gt; math.min(18, prompt.MaxActivationDistance + 4) then return end
	local kind = prompt:GetAttribute("Action") or (parent and parent:GetAttribute("Action"))
	if kind == "ToggleArena" then toggleArena(player)
	elseif kind == "Upgrade" then shopAction(player, "Upgrade", prompt:GetAttribute("UpgradeKey") or parent:GetAttribute("UpgradeKey")) end
end)

local movementElapsed = 0
local stateElapsed = 0
RunService.Heartbeat:Connect(function(dt)
	if shuttingDown then return end
	movementElapsed += dt
	stateElapsed += dt
	if movementElapsed &gt;= 0.1 then
		local step = math.min(movementElapsed, 0.25)
		movementElapsed = 0
		local active = activePlayers()
		local now = workspace:GetServerTimeNow()
		if #active == 0 then
			if wave ~= 0 or phase ~= "Intermission" or enemyCount() &gt; 0 then resetWaves() end
			deadline = now + WaveConfig.Intermission
		elseif phase == "Intermission" then
			if now &gt;= deadline then beginWave(active) end
		elseif phase == "Wave" then
			if enemyCount() == 0 then completeWave(active)
			elseif now &gt;= deadline then
				for _, entry in active do
					teleport(entry.Player, arena.LobbySpawn, false)
					toast(entry.Player, "Time ran out. Regroup and try a fresh run.", "info")
				end
				resetWaves()
			else moveEnemies(active, step) end
		end
	end
	if stateElapsed &gt;= 1 then
		stateElapsed = 0
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("InArena") then
				local _, _, root = body(player)
				if root then
					local offset = root.Position - arena.ArenaCenter
					if Vector3.new(offset.X, 0, offset.Z).Magnitude &gt; arena.ArenaRadius + 7 or root.Position.Y &lt; -8 or not ready(player) then
						teleport(player, arena.LobbySpawn, false)
						toast(player, "You returned to the sanctuary.", "info")
					end
				end
			end
			sendState(player)
		end
	end
end)

game:BindToClose(function()
	shuttingDown = true
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			local ok, saved = pcall(Economy.Save, player, true)
			if not ok or saved == false then warn("Shadow Blox shutdown save was not confirmed for user " .. player.UserId .. ": " .. tostring(saved)) end
			pending -= 1
		end)
	end
	local untilTime = os.clock() + 25
	while pending &gt; 0 and os.clock() &lt; untilTime do task.wait(0.1) end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000000B1">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">-- The same scene is embedded in the .rbxlx and generated at runtime for Rojo.
local World = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local scene = require(ReplicatedStorage:WaitForChild("ShadowBlox"):WaitForChild("WorldScene"))

local function createPart(spec, parent)
	local part = Instance.new(spec.Spawn and "SpawnLocation" or "Part")
	part.Name = spec.Name
	part.Anchored = true
	part.Size = Vector3.new(unpack(spec.Size))
	part.CFrame = CFrame.new(unpack(spec.Position)) * CFrame.Angles(math.rad(spec.Rotation[1]), math.rad(spec.Rotation[2]), math.rad(spec.Rotation[3]))
	part.Color = Color3.fromRGB(unpack(spec.Color))
	part.Material = Enum.Material[spec.Material or "Slate"]
	part.Shape = Enum.PartType[spec.Shape or "Block"]
	part.Transparency = spec.Transparency or 0
	part.CanCollide = spec.Collide ~= false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if spec.Spawn then part.Neutral = true; part.Duration = 0; part.Enabled = true end
	part.Parent = parent
	if spec.Light then
		local light = Instance.new("PointLight")
		light.Color = part.Color; light.Brightness = spec.Light; light.Range = 18; light.Parent = part
	end
	if spec.Text then
		local gui = Instance.new("BillboardGui")
		gui.Name = "Sign"; gui.Size = UDim2.fromOffset(spec.TextWidth or 380, 64)
		gui.StudsOffset = Vector3.new(0, spec.TextOffset or 4, 0); gui.AlwaysOnTop = false; gui.MaxDistance = 160; gui.Parent = part
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1; label.Text = spec.Text
		label.TextColor3 = Color3.fromRGB(226, 221, 255); label.TextStrokeTransparency = 0.35
		label.TextSize = 24; label.Font = Enum.Font.GothamBold; label.Parent = gui
	end
	if spec.Action then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "ShadowAction"; prompt.ActionText = spec.ActionText or "Enter arena"
		prompt.ObjectText = "Shadow Rift"; prompt.KeyboardKeyCode = Enum.KeyCode.F
		prompt.HoldDuration = 0; prompt.MaxActivationDistance = 12; prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Action", spec.Action); part:SetAttribute("Action", spec.Action); prompt.Parent = part
	end
	return part
end

function World.Build()
	local model = workspace:FindFirstChild("ShadowBloxWorld")
	if not model then
		model = Instance.new("Model"); model.Name = "ShadowBloxWorld"; model.Parent = workspace
		for _, spec in ipairs(scene.Parts) do createPart(spec, model) end
	end
	-- Attributes are applied here as well so generated XML and Rojo behave alike.
	for _, spec in ipairs(scene.Parts) do
		if spec.Action then
			local part = model:FindFirstChild(spec.Name)
			if part then
				local prompt = part:FindFirstChildOfClass("ProximityPrompt") or Instance.new("ProximityPrompt")
				prompt.Name = "ShadowAction"; prompt.ActionText = spec.ActionText or "Enter arena"
				prompt.ObjectText = "Shadow Rift"; prompt.KeyboardKeyCode = Enum.KeyCode.F
				prompt.HoldDuration = 0; prompt.MaxActivationDistance = 12; prompt.RequiresLineOfSight = false
				prompt:SetAttribute("Action", spec.Action); part:SetAttribute("Action", spec.Action); prompt.Parent = part
			end
		end
	end
	local enemyFolder = workspace:FindFirstChild("ShadowEnemies") or Instance.new("Folder")
	enemyFolder.Name = "ShadowEnemies"; enemyFolder.Parent = workspace
	local effectsFolder = workspace:FindFirstChild("ShadowEffects") or Instance.new("Folder")
	effectsFolder.Name = "ShadowEffects"; effectsFolder.Parent = workspace
	local lighting = game:GetService("Lighting")
	lighting.ClockTime = 0; lighting.Brightness = 2
	lighting.Ambient = Color3.fromRGB(60, 42, 90); lighting.OutdoorAmbient = Color3.fromRGB(76, 59, 105)
	lighting.FogColor = Color3.fromRGB(28, 21, 48); lighting.FogStart = 100; lighting.FogEnd = 520
	if not lighting:FindFirstChild("ShadowBloom") then
		local bloom = Instance.new("BloomEffect"); bloom.Name = "ShadowBloom"; bloom.Intensity = 0.6; bloom.Size = 28; bloom.Threshold = 1.25; bloom.Parent = lighting
	end
	-- FallenPartsDestroyHeight is configured in Studio (plugin-only property).
	local spawns = {}
	for i = 1, 8 do local angle = i * math.pi / 4; table.insert(spawns, Vector3.new(math.cos(angle) * 59, 7, math.sin(angle) * 59)) end
	return {ArenaCenter = Vector3.new(0, 4, 0), ArenaRadius = 76, LobbySpawn = Vector3.new(0, 7, 118), EnemySpawns = spawns, EnemyFolder = enemyFolder, EffectsFolder = effectsFolder}
end

return World
