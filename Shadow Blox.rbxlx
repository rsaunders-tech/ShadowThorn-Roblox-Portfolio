          <string name="Name">ShadowBloxClient</string>
          <ProtectedString name="Source">-- Shadow Blox: responsive, asset-free client presentation.
-- Purchases are requested only after a deliberate click; all grants live on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local package = ReplicatedStorage:WaitForChild("ShadowBlox")
local Config = require(package:WaitForChild("Config"))
local remotes = package:WaitForChild("Remotes")
local action = remotes:WaitForChild("Action")
local stateRemote = remotes:WaitForChild("State")
local fxRemote = remotes:WaitForChild("FX")

local C = {
	Background = Color3.fromRGB(12, 13, 25),
	Panel = Color3.fromRGB(23, 23, 42),
	Raised = Color3.fromRGB(34, 32, 58),
	Line = Color3.fromRGB(73, 66, 106),
	Text = Color3.fromRGB(245, 243, 255),
	Muted = Color3.fromRGB(184, 182, 209),
	Violet = Color3.fromRGB(161, 104, 255),
	Cyan = Color3.fromRGB(92, 239, 241),
	Red = Color3.fromRGB(255, 112, 146),
	Gold = Color3.fromRGB(255, 213, 111),
}

local state = { Profile = {}, Wave = 0, Phase = "Intermission", Remaining = 0, Enemies = 0, InArena = false }
local panelName: string? = nil
local welcomeVisible = true
local compact = false
local cooldownEnds = { Attack = 0, Dash = 0, Nova = 0 }
local cooldowns = { Attack = 0.48, Dash = 3, Nova = 9 }
local prices = {}
local auraCards = {}
local shopCards = {}
local upgradeCards = {}
local connections = {}

local function make(className: string, props, parent: Instance?)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function round(parent, radius: number?)
	make("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

local function outline(parent, color: Color3?, transparency: number?)
	return make("UIStroke", { Color = color or C.Line, Transparency = transparency or 0.25, Thickness = 1 }, parent)
end

local function label(parent, text: string, size: number, color: Color3?, props)
	local defaults = {
		BackgroundTransparency = 1, Text = text, TextColor3 = color or C.Text,
		TextSize = size, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center, BorderSizePixel = 0,
	}
	for key, value in pairs(props or {}) do defaults[key] = value end
	return make("TextLabel", defaults, parent)
end

local function button(parent, text: string, accent: Color3?, props)
	local defaults = {
		BackgroundColor3 = accent or C.Raised, Text = text,
		TextColor3 = accent and C.Background or C.Text, TextSize = 15,
		Font = Enum.Font.GothamBold, AutoButtonColor = true, BorderSizePixel = 0,
		Selectable = true,
	}
	for key, value in pairs(props or {}) do defaults[key] = value end
	local item = make("TextButton", defaults, parent)
	round(item, 10)
	return item
end

local function number(value): string
	local n = math.floor(tonumber(value) or 0)
	if n &gt;= 1000000 then return string.format("%.1fm", n / 1000000) end
	if n &gt;= 10000 then return string.format("%.1fk", n / 1000) end
	local result = tostring(n)
	while true do
		local nextResult, count = string.gsub(result, "^(-?%d+)(%d%d%d)", "%1,%2")
		result = nextResult
		if count == 0 then break end
	end
	return result
end

local gui = make("ScreenGui", {
	Name = "ShadowBloxUI", ResetOnSpawn = false, IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10,
}, player:WaitForChild("PlayerGui"))
pcall(function() gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets end)

