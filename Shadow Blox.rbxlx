local healthTrack = make("Frame", { BackgroundColor3 = C.Raised, BorderSizePixel = 0, Position = UDim2.fromOffset(14, 102), Size = UDim2.new(1, -28, 0, 8), ClipsDescendants = true }, profile)
round(healthTrack, 4)
local healthFill = make("Frame", { BackgroundColor3 = C.Cyan, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, healthTrack)
round(healthFill, 4)
local healthText = label(profile, "100 / 100 HP", 14, C.Muted, { Position = UDim2.fromOffset(14, 112), Size = UDim2.new(1, -28, 0, 18) })

local waveCard = make("Frame", { BackgroundColor3 = C.Background, BackgroundTransparency = 0.08, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(310, 100) }, root)
round(waveCard, 14)
outline(waveCard, C.Violet)
local waveLabel = label(waveCard, "THE SHADOW RIFT", 17, C.Text, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 28), Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center })
local phaseLabel = label(waveCard, "Preparing the arena...", 14, C.Muted, { Position = UDim2.fromOffset(10, 40), Size = UDim2.new(1, -20, 0, 24), TextXAlignment = Enum.TextXAlignment.Center })
local enemiesLabel = label(waveCard, "Gather shards. Grow stronger.", 14, C.Cyan, { Position = UDim2.fromOffset(10, 69), Size = UDim2.new(1, -20, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })

local menuBar = make("Frame", { Size = UDim2.fromOffset(312, 48), Position = UDim2.new(0, 20, 1, -68), BackgroundTransparency = 1 }, root)
local menuButtons = {}
for index, item in ipairs({ { "Upgrades", "U", C.Violet }, { "Auras", "C", C.Cyan }, { "Shop", "B", C.Gold } }) do
	local b = button(menuBar, string.upper(item[1]), nil, { Position = UDim2.fromOffset((index - 1) * 106, 0), Size = UDim2.fromOffset(100, 48), TextSize = 14 })
	outline(b, item[3], 0.1)
	menuButtons[item[1]] = b
end
local arenaButton = button(root, "ENTER ARENA", C.Violet, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 20, 1, -82), Size = UDim2.fromOffset(312, 48), TextSize = 16 })
local dataLabel = label(root, "Connecting to your save...", 14, C.Muted, { Position = UDim2.new(0, 20, 1, -158), Size = UDim2.fromOffset(330, 24) })

local abilities = make("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Size = UDim2.fromOffset(316, 94), BackgroundTransparency = 1 }, root)
local abilityButtons = {}
local abilityLabels = {}
local abilityKeys = { Attack = "CLICK / R2", Dash = "Q / X", Nova = "E / Y" }
local abilityOrder = { "Attack", "Dash", "Nova" }
for index, name in ipairs(abilityOrder) do
	local b = button(abilities, "", nil, { Position = UDim2.fromOffset((index - 1) * 108, 0), Size = UDim2.fromOffset(100, 94) })
	outline(b, name == "Nova" and C.Violet or C.Cyan, 0.1)
	label(b, string.upper(name), 15, C.Text, { Position = UDim2.fromOffset(4, 10), Size = UDim2.new(1, -8, 0, 25), TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold })
	local sub = label(b, abilityKeys[name], 14, C.Muted, { Position = UDim2.fromOffset(4, 40), Size = UDim2.new(1, -8, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	local line = make("Frame", { BackgroundColor3 = name == "Nova" and C.Violet or C.Cyan, BorderSizePixel = 0, Position = UDim2.new(0, 8, 1, -12), Size = UDim2.new(1, -16, 0, 3) }, b)
	round(line, 2)
	abilityButtons[name] = b
	abilityLabels[name] = { Text = sub, Line = line }
end

local modalBackdrop = make("TextButton", { Name = "ModalBackdrop", Visible = false, Size = UDim2.fromScale(1, 1), Text = "", BackgroundColor3 = Color3.new(), BackgroundTransparency = 0.3, AutoButtonColor = false, ZIndex = 20, BorderSizePixel = 0, Selectable = false }, gui)
local modal = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(630, 530), BackgroundColor3 = C.Background, ZIndex = 21 }, modalBackdrop)
round(modal, 18)
outline(modal, C.Violet, 0.1)
local modalTitle = label(modal, "UPGRADES", 24, C.Text, { Position = UDim2.fromOffset(22, 16), Size = UDim2.new(1, -90, 0, 34), Font = Enum.Font.GothamBlack, ZIndex = 22 })
local close = button(modal, "X", nil, { Position = UDim2.new(1, -58, 0, 14), Size = UDim2.fromOffset(42, 42), ZIndex = 22 })
local content = make("ScrollingFrame", { Position = UDim2.fromOffset(20, 64), Size = UDim2.new(1, -40, 1, -84), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5, ScrollBarImageColor3 = C.Violet, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 22 }, modal)
local pages = {}
for _, name in ipairs({ "Upgrades", "Auras", "Shop", "Welcome" }) do
	local page = make("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 23 }, content)
	make("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, page)
	make("UIPadding", { PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 1), PaddingRight = UDim.new(0, 1) }, page)
	pages[name] = page
end

local function paragraph(parent, text: string, height: number, color: Color3?, size: number?)
	return label(parent, text, size or 15, color or C.Muted, { Size = UDim2.new(1, 0, 0, height), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 24 })
end

local function row(parent, height: number, color: Color3?)
	local item = make("Frame", { BackgroundColor3 = C.Panel, Size = UDim2.new(1, 0, 0, height), ZIndex = 24 }, parent)
	round(item, 12)
	outline(item, color or C.Line, 0.4)
	return item
end

paragraph(pages.Upgrades, "Spend earned shards on permanent power. Your upgrades stay with you between runs.", 52)
for _, key in ipairs({ "Power", "Vitality" }) do
	local item = row(pages.Upgrades, 148, key == "Power" and C.Violet or C.Cyan)
	local title = label(item, string.upper(key), 19, C.Text, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 26), Font = Enum.Font.GothamBold, ZIndex = 25 })
	local upgrade = (Config.Upgrade or {})[key]
	local description = label(item, upgrade and upgrade.Description or (key == "Power" and "Increase your attack and nova damage." or "Increase your maximum health."), 14, C.Muted, { Position = UDim2.fromOffset(16, 42), Size = UDim2.new(1, -32, 0, 35), TextWrapped = true, ZIndex = 25 })
	local buy = button(item, "Loading...", key == "Power" and C.Violet or C.Cyan, { Position = UDim2.fromOffset(16, 90), Size = UDim2.new(1, -32, 0, 42), ZIndex = 25 })
	buy.Activated:Connect(function() action:FireServer("Upgrade", key) end)
	upgradeCards[key] = { Title = title, Button = buy, Description = description }
end

paragraph(pages.Auras, "Auras change your glow. Earn shard auras by playing; equip your favorite at any time.", 52)
for _, aura in ipairs(Config.Auras or {}) do
	local color = typeof(aura.Color) == "Color3" and aura.Color or C.Violet
	local item = row(pages.Auras, 116, color)
	local dot = make("Frame", { BackgroundColor3 = color, Position = UDim2.fromOffset(16, 17), Size = UDim2.fromOffset(16, 16), ZIndex = 25 }, item)
	round(dot, 8)
	label(item, aura.Name or aura.Key, 18, C.Text, { Position = UDim2.fromOffset(42, 10), Size = UDim2.new(1, -58, 0, 30), Font = Enum.Font.GothamBold, ZIndex = 25 })
	local b = button(item, "Loading...", nil, { Position = UDim2.fromOffset(16, 58), Size = UDim2.new(1, -32, 0, 42), ZIndex = 25 })
	b.Activated:Connect(function()
		local owned = state.Profile.OwnedAuras or {}
		if owned[aura.Key] then
			action:FireServer("Equip", aura.Key)
		elseif aura.Key == "Eclipse" or aura.Pass then
			panelName = "Shop"
			for name, page in pairs(pages) do page.Visible = name == "Shop" end
			modalTitle.Text = "OPTIONAL SHOP"
			content.CanvasPosition = Vector2.zero
		else
			action:FireServer("Equip", aura.Key)
		end
	end)
	auraCards[aura.Key] = { Button = b, Aura = aura }
end

paragraph(pages.Shop, "Optional purchases support Shadow Blox. All combat is playable for free. Shards can also be earned in the arena. Roblox shows the final price before you buy.", 84)
local shopStatus = paragraph(pages.Shop, "Checking configured Roblox products...", 40, C.Gold, 14)

local function shopItem(item, kind: string)
	local card = row(pages.Shop, 174, kind == "Pass" and C.Violet or C.Cyan)
	label(card, item.Name or item.Key, 19, C.Text, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 30), Font = Enum.Font.GothamBold, ZIndex = 25 })
	local description = kind == "Product" and (number(item.Shards) .. " shards • repeatable purchase") or (item.Description or "Permanent cosmetic unlock.")
	label(card, description, 14, C.Muted, { Position = UDim2.fromOffset(16, 46), Size = UDim2.new(1, -32, 0, 46), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 25 })
	local b = button(card, "Not configured", nil, { Position = UDim2.fromOffset(16, 112), Size = UDim2.new(1, -32, 0, 44), ZIndex = 25, Active = false, AutoButtonColor = false })
	local record = { Item = item, Kind = kind, Button = b, Ready = false, RequestedAt = 0 }
	table.insert(shopCards, record)
	b.Activated:Connect(function()
		if not record.Ready or os.clock() - record.RequestedAt &lt; 2 then return end
		if kind == "Pass" and ((item.Key == "VIP" and state.Profile.VIP) or ((state.Profile.OwnedAuras or {})[item.Key])) then return end
		record.RequestedAt = os.clock()
		action:FireServer("Purchase", item.Key)
	end)
end
for _, product in ipairs(Config.Products or {}) do shopItem(product, "Product") end
for _, pass in ipairs(Config.Passes or {}) do shopItem(pass, "Pass") end

paragraph(pages.Welcome, "THE RIFT IS OPEN.", 44, C.Cyan, 25)
paragraph(pages.Welcome, "Defend a neon sanctuary against waves of shadows. Fight, collect shards, upgrade your strength, and see how long you can survive.", 88, C.Text, 17)
local tutorial = row(pages.Welcome, 220, C.Violet)
label(tutorial, "YOUR FIRST RUN", 16, C.Violet, { Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 26), Font = Enum.Font.GothamBold, ZIndex = 25 })
label(tutorial, "1  Enter the arena and stay on the move.\n2  Attack nearby shadows. Dash out of danger.\n3  Use Nova when enemies crowd around you.\n4  Spend shards on upgrades and new auras.", 15, C.Text, { Position = UDim2.fromOffset(16, 45), Size = UDim2.new(1, -32, 0, 164), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 25 })
local play = button(pages.Welcome, "PLAY SHADOW BLOX", C.Violet, { Size = UDim2.new(1, 0, 0, 52), TextSize = 18, ZIndex = 24 })
local explore = button(pages.Welcome, "EXPLORE SANCTUARY", nil, { Size = UDim2.new(1, 0, 0, 44), ZIndex = 24 })
paragraph(pages.Welcome, "Mouse / R2: Attack   •   Q / X: Dash   •   E / Y: Nova\nOn a phone or tablet, use the ability buttons.", 54, C.Muted, 14)

local function showPanel(name: string?)
	panelName = name
	welcomeVisible = name == "Welcome"
	modalBackdrop.Visible = name ~= nil
	modalTitle.Text = name == "Shop" and "OPTIONAL SHOP" or (name == "Welcome" and "SHADOW BLOX" or string.upper(name or ""))
	for key, page in pairs(pages) do page.Visible = key == name end
	content.CanvasPosition = Vector2.zero
end

local function togglePanel(name: string)
	if panelName == name then
		showPanel(nil)
	else
		showPanel(name)
	end
end
for name, b in pairs(menuButtons) do b.Activated:Connect(function() togglePanel(name) end) end
close.Activated:Connect(function() showPanel(nil) end)
modalBackdrop.Activated:Connect(function() showPanel(nil) end)
explore.Activated:Connect(function() showPanel(nil) end)
play.Activated:Connect(function()
	showPanel(nil)
	if not state.InArena then action:FireServer("ToggleArena") end
end)
arenaButton.Activated:Connect(function()
	if panelName then return end
	action:FireServer("ToggleArena")
end)

local toastHost = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 132), Size = UDim2.fromOffset(430, 210), BackgroundTransparency = 1, ZIndex = 30 }, gui)
make("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, toastHost)
local activeToasts = {}
local function toast(text: string, kind: string?)
	if #activeToasts &gt;= 3 then
		local oldest = table.remove(activeToasts, 1)
		oldest:Destroy()
	end
	local normalizedKind = string.lower(tostring(kind or "info"))
	local color = normalizedKind == "error" and C.Red or (normalizedKind == "success" and C.Cyan or C.Violet)
	local item = label(toastHost, text, 15, C.Text, { BackgroundColor3 = C.Panel, BackgroundTransparency = 0.05, Size = UDim2.new(1, 0, 0, 58), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 31 })
	round(item, 10)
	outline(item, color, 0.1)
	make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, item)
	table.insert(activeToasts, item)
	task.delay(3.5, function()
		local index = table.find(activeToasts, item)
		if index then table.remove(activeToasts, index) end
		if item.Parent then
			TweenService:Create(item, TweenInfo.new(0.25), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
			task.delay(0.3, function() item:Destroy() end)
		end
	end)
end

local function useAbility(name: string)
	if panelName or welcomeVisible or not state.InArena then return end
	local now = workspace:GetServerTimeNow()
	if now &lt; (cooldownEnds[name] or 0) then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then return end
	cooldownEnds[name] = now + (cooldowns[name] or 1)
	action:FireServer(name)
end
for name, b in pairs(abilityButtons) do b.Activated:Connect(function() useAbility(name) end) end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then return end
	if input.KeyCode == Enum.KeyCode.Return and panelName == "Welcome" then
		showPanel(nil)
		if not state.InArena then action:FireServer("ToggleArena") end
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then useAbility("Attack") end
	if input.KeyCode == Enum.KeyCode.B then togglePanel("Shop") end
	if input.KeyCode == Enum.KeyCode.U then togglePanel("Upgrades") end
	if input.KeyCode == Enum.KeyCode.C then togglePanel("Auras") end
end)
for _, binding in ipairs({ { "Attack", Enum.KeyCode.ButtonR2 }, { "Dash", Enum.KeyCode.Q, Enum.KeyCode.ButtonX }, { "Nova", Enum.KeyCode.E, Enum.KeyCode.ButtonY } }) do
	local name = binding[1]
	local keys = {}
	for index = 2, #binding do table.insert(keys, binding[index]) end
	ContextActionService:BindAction("ShadowBlox" .. name, function(_, inputState)
		if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
		if inputState == Enum.UserInputState.Begin then useAbility(name) end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(keys))
end

local function updateHealth(humanoid)
	local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
	healthFill.BackgroundColor3 = ratio &lt; 0.3 and C.Red or C.Cyan
	TweenService:Create(healthFill, TweenInfo.new(0.15), { Size = UDim2.fromScale(ratio, 1) }):Play()
	healthText.Text = number(math.ceil(humanoid.Health)) .. " / " .. number(humanoid.MaxHealth) .. " HP"
end
local function bindCharacter(character)
	for _, connection in ipairs(connections) do connection:Disconnect() end
	connections = {}
	local humanoid = character:WaitForChild("Humanoid", 15)
	if not humanoid then return end
	updateHealth(humanoid)
	table.insert(connections, humanoid.HealthChanged:Connect(function() updateHealth(humanoid) end))
	table.insert(connections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function() updateHealth(humanoid) end))
	action:FireServer("Sync")
end
player.CharacterAdded:Connect(bindCharacter)
if player.Character then task.spawn(bindCharacter, player.Character) end

local function updateShop()
	local configured = 0
	for _, record in ipairs(shopCards) do
		local item = record.Item
		local id = tonumber(item.Id) or 0
		local owned = record.Kind == "Pass" and ((item.Key == "VIP" and state.Profile.VIP) or ((state.Profile.OwnedAuras or {})[item.Key]))
		local price = prices[record.Kind .. ":" .. tostring(id)]
		if id &gt; 0 then configured += 1 end
		record.Ready = not owned and price ~= nil and price.Ready == true
		record.Button.Active = record.Ready
		record.Button.AutoButtonColor = record.Ready
		record.Button.BackgroundColor3 = record.Ready and C.Gold or C.Raised
		record.Button.TextColor3 = record.Ready and C.Background or C.Muted
		if owned then record.Button.Text = "OWNED"
		elseif id &lt;= 0 then record.Button.Text = "Not configured"
		elseif not price or price.Loading then record.Button.Text = "Checking Roblox price..."
		elseif price.Ready then record.Button.Text = "BUY  •  R$ " .. string.format("%d", price.Amount)
		else record.Button.Text = "Unavailable on Roblox" end
	end
	shopStatus.Text = configured == 0 and "The creator has not connected Roblox products yet. Purchases are currently disabled." or "Prices are fetched from Roblox for your account. Purchases open Roblox's confirmation prompt."
end

local function refresh()
	local p = state.Profile or {}
	shards.Text = number(p.Shards) .. " SHARDS"
	progression.Text = "LEVEL " .. number(p.Level or 1) .. "  /  " .. number(p.XP) .. " XP"
	arenaButton.Text = state.InArena and "RETURN TO SANCTUARY" or "ENTER ARENA"
	arenaButton.BackgroundColor3 = state.InArena and C.Raised or C.Violet
	arenaButton.TextColor3 = state.InArena and C.Text or C.Background
	waveLabel.Text = "WAVE " .. number(state.Wave)
	if state.Phase == "Wave" then
		phaseLabel.Text = state.InArena and "Survive the shadows" or "Battle in progress"
		enemiesLabel.Text = number(state.Enemies) .. " SHADOWS REMAIN"
	else
		phaseLabel.Text = "Next wave in " .. number(state.Remaining) .. "s"
		enemiesLabel.Text = "Upgrade. Recover. Return."
	end
	if p.DataMode and p.DataMode ~= "Saved" then
		dataLabel.Text = p.DataMode == "Studio session" and "Studio session • progress won't save" or "Saving unavailable • try again shortly"
		dataLabel.TextColor3 = C.Gold
	elseif p.DataMode then
		dataLabel.Text = "Best wave " .. number(p.BestWave) .. "  •  " .. number(p.Kills) .. " defeats"
		dataLabel.TextColor3 = C.Muted
	end
	for key, card in pairs(upgradeCards) do
		local config = (Config.Upgrades or Config.Upgrade or {})[key] or {}
		local current = tonumber((p.Upgrades or {})[key]) or 0
		local max = config.MaxLevel or 12
		local cost = math.floor((config.BaseCost or 60) * (config.CostGrowth or 1.6) ^ current)
		card.Title.Text = string.upper(key) .. "  " .. current .. " / " .. max
		card.Button.Text = current &gt;= max and "MAX LEVEL" or ("UPGRADE  •  " .. number(cost) .. " SHARDS")
		card.Button.Active = current &lt; max
		card.Button.AutoButtonColor = current &lt; max
		card.Button.BackgroundTransparency = current &gt;= max and 0.45 or 0
	end
	for key, record in pairs(auraCards) do
		local owned = (p.OwnedAuras or {})[key] == true
		local equipped = p.EquippedAura == key
		record.Button.Text = equipped and "EQUIPPED" or (owned and "EQUIP" or ((key == "Eclipse" or record.Aura.Pass) and "VIEW IN OPTIONAL SHOP" or ("UNLOCK + EQUIP  •  " .. number(record.Aura.Cost) .. " SHARDS")))
		record.Button.BackgroundColor3 = equipped and C.Violet or C.Raised
		record.Button.TextColor3 = equipped and C.Background or C.Text
	end
	updateShop()
end

stateRemote.OnClientEvent:Connect(function(nextState)
	if typeof(nextState) ~= "table" then return end
	state = nextState
	state.Profile = state.Profile or {}
	if typeof(nextState.Cooldowns) == "table" then
		for name, duration in pairs(nextState.Cooldowns) do
			if cooldowns[name] and type(duration) == "number" then cooldowns[name] = duration end
		end
	end
	if typeof(nextState.CooldownEnds) == "table" then
		for name, timestamp in pairs(nextState.CooldownEnds) do
			if cooldownEnds[name] and type(timestamp) == "number" then cooldownEnds[name] = timestamp end
		end
	end
	refresh()
end)

-- Query each configured item once. SuggestedPrice is intentionally never shown.
local function loadPrices()
	for _, record in ipairs(shopCards) do
		local id = tonumber(record.Item.Id) or 0
		local key = record.Kind .. ":" .. tostring(id)
		if id &gt; 0 and not prices[key] then
			prices[key] = { Ready = false, Loading = true }
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfoAsync(id, record.Kind == "Product" and Enum.InfoType.Product or Enum.InfoType.GamePass)
				end)
				local amount = ok and typeof(info) == "table" and tonumber(info.PriceInRobux) or nil
				prices[key] = { Ready = amount ~= nil and amount &gt;= 0 and info.IsForSale ~= false, Amount = amount }
				updateShop()
			end)
		end
	end
	updateShop()
end

local fxFolder = make("Folder", { Name = "ShadowBloxLocalFX" }, workspace)
local function fxPart(position: Vector3)
	return make("Part", { Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false, Material = Enum.Material.Neon, Color = C.Violet, Position = position, Size = Vector3.one, Transparency = 0.2 }, fxFolder)
end
local function pulse(position: Vector3, radius: number, color: Color3)
	local part = fxPart(position + Vector3.new(0, -2.4, 0))
	part.Shape = Enum.PartType.Cylinder
	part.Orientation = Vector3.new(0, 0, 90)
	part.Size = Vector3.new(0.12, 0.5, 0.5)
	part.Color = color
	TweenService:Create(part, TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.08, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(part, 0.45)
end
local function floatText(position: Vector3, text: string, color: Color3)
	local part = fxPart(position + Vector3.new(0, 2, 0))
	part.Transparency = 1
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	local billboard = make("BillboardGui", { Size = UDim2.fromOffset(160, 58), AlwaysOnTop = true, MaxDistance = 110, Adornee = part }, part)
	local textLabel = label(billboard, text, 27, color, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeColor3 = C.Background, TextStrokeTransparency = 0.1, Font = Enum.Font.GothamBlack })
	TweenService:Create(part, TweenInfo.new(0.85), { Position = part.Position + Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(textLabel, TweenInfo.new(0.85), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(part, 0.9)
end
fxRemote.OnClientEvent:Connect(function(kind, payload)
	if typeof(payload) ~= "table" then return end
	if kind == "Toast" then
		toast(tostring(payload.Text or ""), payload.Kind)
	elseif kind == "Wave" then
		toast("WAVE " .. number(payload.Wave) .. "  •  The shadows are rising", "Info")
	elseif (kind == "Attack" or kind == "Slash" or kind == "Nova" or kind == "Burst") and typeof(payload.Position) == "Vector3" then
		local nova = kind == "Nova" or kind == "Burst"
		pulse(payload.Position, math.clamp(tonumber(payload.Radius) or (nova and 18 or 8), 1, 60), typeof(payload.Color) == "Color3" and payload.Color or (nova and C.Violet or C.Cyan))
	elseif (kind == "Damage" or kind == "Hit") and typeof(payload.Position) == "Vector3" then
		floatText(payload.Position, "-" .. number(payload.Amount), payload.Critical and C.Gold or C.Text)
	elseif kind == "Float" and typeof(payload.Position) == "Vector3" then
		floatText(payload.Position, tostring(payload.Text or ""), typeof(payload.Color) == "Color3" and payload.Color or C.Cyan)
	elseif kind == "Dash" and typeof(payload.From) == "Vector3" and typeof(payload.To) == "Vector3" then
		local distance = (payload.To - payload.From).Magnitude
		if distance &lt; 0.1 then return end
		local part = fxPart((payload.From + payload.To) / 2)
		part.CFrame = CFrame.lookAt((payload.From + payload.To) / 2, payload.To)
		part.Size = Vector3.new(1.2, 0.25, math.min(distance, 50))
		part.Color = C.Cyan
		TweenService:Create(part, TweenInfo.new(0.24), { Transparency = 1, Size = Vector3.new(0.1, 0.1, math.min(distance, 50)) }):Play()
		Debris:AddItem(part, 0.3)
	end
end)

local function layout()
	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local available = root.AbsoluteSize
	local width, height = available.X, available.Y
	if width &lt;= 0 or height &lt;= 0 then return end
	local touch = UserInputService.TouchEnabled
	local touchLandscape = touch and width &gt; height
	compact = viewport.X &lt; 900 or touch
	-- Reset child positions when rotating between compact and landscape layouts.
	brand.Position = UDim2.fromOffset(14, 9)
	shards.Position = UDim2.fromOffset(14, 36)
	progression.Position = UDim2.fromOffset(14, 71)
	healthTrack.Position = UDim2.fromOffset(14, 102)
	healthText.Visible = true
	dataLabel.Visible = not touchLandscape
	if touchLandscape then
		-- Keep Roblox's thumbstick and jump button clear at both bottom corners.
		-- A centered ability row fits between them on short landscape screens.
		local sideWidth = math.min(216, math.floor(width * 0.3))
		profile.Position = UDim2.fromOffset(10, 8)
		profile.Size = UDim2.fromOffset(math.min(200, math.floor(width * 0.3)), 100)
		brand.TextSize = 14
		brand.Position = UDim2.fromOffset(14, 5)
		shards.TextSize = 21
		shards.Position = UDim2.fromOffset(14, 28)
		progression.Position = UDim2.fromOffset(14, 58)
		healthTrack.Position = UDim2.fromOffset(14, 85)
		healthText.Visible = false
		waveCard.AnchorPoint = Vector2.new(0.5, 0)
		waveCard.Position = UDim2.new(0.5, 0, 0, 8)
		waveCard.Size = UDim2.fromOffset(math.min(220, math.floor(width * 0.3)), 100)
		waveLabel.TextSize = 16
		phaseLabel.Position = UDim2.fromOffset(10, 35)
		phaseLabel.Size = UDim2.new(1, -20, 0, 28)
		phaseLabel.TextWrapped = true
		enemiesLabel.Position = UDim2.fromOffset(10, 65)
		enemiesLabel.Size = UDim2.new(1, -20, 0, 28)
		enemiesLabel.TextWrapped = true
		menuBar.Position = UDim2.new(1, -sideWidth - 10, 0, 8)
		menuBar.Size = UDim2.fromOffset(sideWidth, 42)
		for i, name in ipairs({ "Upgrades", "Auras", "Shop" }) do
			menuButtons[name].Position = UDim2.new((i - 1) / 3, (i - 1) * 2, 0, 0)
			menuButtons[name].Size = UDim2.new(1 / 3, -4, 1, 0)
		end
		arenaButton.AnchorPoint = Vector2.new(1, 0)
		arenaButton.Position = UDim2.new(1, -10, 0, 60)
		arenaButton.Size = UDim2.fromOffset(sideWidth, 44)
		arenaButton.TextSize = 14
		abilities.AnchorPoint = Vector2.new(0.5, 1)
		abilities.Position = UDim2.new(0.5, 0, 1, -14)
		abilities.Size = UDim2.fromOffset(math.clamp(width - 380, 186, 290), 86)
		toastHost.Position = UDim2.new(0.5, 0, 0, 116)
		toastHost.Size = UDim2.fromOffset(math.min(410, width - 30), 190)
	elseif compact then
		profile.Position = UDim2.fromOffset(10, 8)
		profile.Size = UDim2.new(0.49, -14, 0, 132)
		brand.TextSize = 14
		shards.TextSize = 21
		waveCard.AnchorPoint = Vector2.new(1, 0)
		waveCard.Position = UDim2.new(1, -10, 0, 8)
		waveCard.Size = UDim2.new(0.51, -10, 0, 132)
		waveLabel.TextSize = 16
		phaseLabel.Position = UDim2.fromOffset(10, 43)
		phaseLabel.Size = UDim2.new(1, -20, 0, 40)
		phaseLabel.TextWrapped = true
		enemiesLabel.Position = UDim2.fromOffset(10, 88)
		enemiesLabel.Size = UDim2.new(1, -20, 0, 34)
		enemiesLabel.TextWrapped = true
		menuBar.Position = UDim2.fromOffset(10, 150)
		menuBar.Size = UDim2.new(1, -20, 0, 44)
		local i = 0
		for _, name in ipairs({ "Upgrades", "Auras", "Shop" }) do
			menuButtons[name].Position = UDim2.new(i / 3, i * 2, 0, 0)
			menuButtons[name].Size = UDim2.new(1 / 3, -4, 0, 44)
			i += 1
		end
		arenaButton.AnchorPoint = Vector2.new(0.5, 1)
		-- Preserve native movement space, while allowing short portrait screens.
		local movementReserve = touch and math.clamp(height - 600, 160, 210) or 0
		arenaButton.Position = UDim2.new(0.5, 0, 1, -114 - movementReserve)
		arenaButton.Size = UDim2.new(1, -36, 0, 44)
		arenaButton.TextSize = 16
		abilities.AnchorPoint = Vector2.new(0.5, 1)
		abilities.Position = UDim2.new(0.5, 0, 1, -14 - movementReserve)
		abilities.Size = UDim2.fromOffset(math.min(width - 36, 330), 90)
		dataLabel.Position = UDim2.fromOffset(12, 199)
		dataLabel.Size = UDim2.new(1, -24, 0, 26)
		toastHost.Position = UDim2.new(0.5, 0, 0, 233)
		toastHost.Size = UDim2.new(1, -28, 0, 210)
	else
		profile.Position = UDim2.fromOffset(20, 14)
		profile.Size = UDim2.fromOffset(264, 132)
		brand.TextSize = 16
		shards.TextSize = 24
		waveCard.AnchorPoint = Vector2.new(0.5, 0)
		waveCard.Position = UDim2.new(0.5, 0, 0, 14)
		waveCard.Size = UDim2.fromOffset(310, 100)
		waveLabel.TextSize = 17
		phaseLabel.Position = UDim2.fromOffset(10, 40)
		phaseLabel.Size = UDim2.new(1, -20, 0, 24)
		enemiesLabel.Position = UDim2.fromOffset(10, 69)
		enemiesLabel.Size = UDim2.new(1, -20, 0, 22)
		menuBar.Position = UDim2.new(0, 20, 1, -68)
		menuBar.Size = UDim2.fromOffset(312, 48)
		for i, name in ipairs({ "Upgrades", "Auras", "Shop" }) do
			menuButtons[name].Position = UDim2.fromOffset((i - 1) * 106, 0)
			menuButtons[name].Size = UDim2.fromOffset(100, 48)
		end
		arenaButton.AnchorPoint = Vector2.new(0, 1)
		arenaButton.Position = UDim2.new(0, 20, 1, -82)
		arenaButton.Size = UDim2.fromOffset(312, 48)
		arenaButton.TextSize = 16
		abilities.AnchorPoint = Vector2.new(1, 1)
		abilities.Position = UDim2.new(1, -20, 1, -20)
		abilities.Size = UDim2.fromOffset(316, 94)
		dataLabel.Position = UDim2.new(0, 20, 1, -158)
		dataLabel.Size = UDim2.fromOffset(330, 24)
		toastHost.Position = UDim2.new(0.5, 0, 0, 132)
		toastHost.Size = UDim2.fromOffset(430, 210)
	end
	for i, name in ipairs(abilityOrder) do
		local b = abilityButtons[name]
		b.Position = UDim2.new((i - 1) / 3, (i - 1) * 3, 0, 0)
		b.Size = UDim2.new(1 / 3, -6, 1, 0)
	end
	modal.Size = UDim2.fromOffset(math.min(630, width - 20), math.min(580, height - 20))
	modalTitle.TextSize = width &lt; 400 and 21 or 24
end
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
local lastCamera = workspace.CurrentCamera
if lastCamera then lastCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
	layout()
end)

local renderAccumulator = 0
RunService.RenderStepped:Connect(function(dt)
	renderAccumulator += dt
	if renderAccumulator &lt; 0.05 then return end
	renderAccumulator = 0
	local now = workspace:GetServerTimeNow()
	for name, b in pairs(abilityButtons) do
		local remaining = math.max(0, (cooldownEnds[name] or 0) - now)
		local disabled = not state.InArena or panelName ~= nil
		abilityLabels[name].Text.Text = remaining &gt; 0 and string.format("%.1fs", remaining) or (compact and "TAP" or abilityKeys[name])
		abilityLabels[name].Text.TextColor3 = remaining &gt; 0 and C.Gold or C.Muted
		abilityLabels[name].Line.Size = UDim2.fromOffset(math.max(0, b.AbsoluteSize.X - 16) * (1 - math.clamp(remaining / (cooldowns[name] or 1), 0, 1)), 3)
		abilityLabels[name].Line.Visible = remaining &lt;= (cooldowns[name] or 1) * 0.95
		b.BackgroundTransparency = disabled and 0.4 or 0
		b.AutoButtonColor = not disabled and remaining &lt;= 0
	end
end)

layout()
refresh()
showPanel("Welcome")
loadPrices()
action:FireServer("Sync")
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX000000B5">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
</roblox>