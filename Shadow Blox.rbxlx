Name"] = "Crystal tree branch", ["Position"] = {-33.40566, 8, -58.23738}, ["Size"] = {0.65, 5, 0.65}, ["Color"] = {74, 55, 97}, ["Material"] = "Slate", ["Rotation"] = {0, 120, 42}}, {["Name"] = "Crystal tree bloom", ["Position"] = {-32.20566, 10, -58.23738}, ["Size"] = {0.9, 1.8, 0.9}, ["Color"] = {151, 79, 255}, ["Material"] = "Neon", ["Rotation"] = {20, 35, 20}, ["Collide"] = false}, {["Name"] = "Crystal tree trunk", ["Position"] = {44.5388, 6, -51.3838}, ["Size"] = {1.2, 7, 1.2}, ["Color"] = {58, 45, 77}, ["Material"] = "Slate", ["Rotation"] = {0, 204, 10}}, {["Name"] = "Crystal tree branch", ["Position"] = {42.8388, 8, -51.3838}, ["Size"] = {0.65, 5, 0.65}, ["Color"] = {74, 55, 97}, ["Material"] = "Slate", ["Rotation"] = {0, 160, -42}}, {["Name"] = "Crystal tree bloom", ["Position"] = {41.6388, 10, -51.3838}, ["Size"] = {0.9, 1.8, 0.9}, ["Color"] = {151, 79, 255}, ["Material"] = "Neon", ["Rotation"] = {20, 35, 20}, ["Collide"] = false}, {["Name"] = "Crystal tree branch", ["Position"] = {46.2388, 8, -51.3838}, ["Size"] = {0.65, 5, 0.65}, ["Color"] = {74, 55, 97}, ["Material"] = "Slate", ["Rotation"] = {0, 160, 42}}, {["Name"] = "Crystal tree bloom", ["Position"] = {47.4388, 10, -51.3838}, ["Size"] = {0.9, 1.8, 0.9}, ["Color"] = {151, 79, 255}, ["Material"] = "Neon", ["Rotation"] = {20, 35, 20}, ["Collide"] = false}, {["Name"] = "Distant moon", ["Position"] = {-120, 108, -170}, ["Size"] = {35, 35, 35}, ["Color"] = {194, 175, 241}, ["Material"] = "Neon", ["Rotation"] = {0, 0, 0}, ["Shape"] = "Ball", ["Collide"] = false}}}
