      <Item class="ModuleScript" referent="RBX000000AB">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Shadow Blox: edit product/pass IDs here after publishing the experience.
local Config = {}

Config.Title = "SHADOW BLOX"
Config.Version = "0.1.0"
Config.DataStoreName = "ShadowBlox_v1"
-- Keep Studio tests separate from live player data. See docs/MONETIZATION.md.
Config.StudioPersistence = false

Config.Combat = {
	AttackDamage = 24, AttackRange = 14, AttackCooldown = 0.48,
	DashCooldown = 3, DashDistance = 22,
	NovaDamage = 55, NovaRadius = 23, NovaCooldown = 9,
	BaseHealth = 100, HealthPerUpgrade = 15, DamagePerUpgrade = 5, WalkSpeed = 22,
}
Config.Waves = {
	Intermission = 12, TimeLimit = 120, BaseEnemies = 4,
	EnemiesPerWave = 2, MaxEnemies = 24, BossEvery = 5,
}
Config.Upgrade = {
	Power = {Name = "Shadow Power", Description = "+5 slash damage per level", BaseCost = 60, CostGrowth = 1.6, MaxLevel = 12},
	Vitality = {Name = "Vitality", Description = "+15 maximum health per level", BaseCost = 75, CostGrowth = 1.6, MaxLevel = 12},
}
Config.Auras = {
	{Key = "Violet", Name = "Void Violet", Color = Color3.fromRGB(166, 92, 255), Cost = 0},
	{Key = "Cyan", Name = "Spectral Cyan", Color = Color3.fromRGB(61, 234, 255), Cost = 250},
	{Key = "Crimson", Name = "Blood Moon", Color = Color3.fromRGB(255, 79, 116), Cost = 500},
	{Key = "Gold", Name = "Solar Gold", Color = Color3.fromRGB(255, 206, 93), Cost = 1000},
	{Key = "Eclipse", Name = "Eclipse", Color = Color3.fromRGB(222, 208, 255), Pass = "Eclipse"},
}
-- SuggestedPrice is planning guidance only. The client fetches the actual Roblox
-- price for the current player. Zero IDs disable purchasing safely.
Config.Products = {
	{Key = "ShardsSmall", Name = "250 Shards", Id = 0, Shards = 250, SuggestedPrice = 29},
	{Key = "ShardsLarge", Name = "1,200 Shards", Id = 0, Shards = 1200, SuggestedPrice = 99},
}
Config.Passes = {
	{Key = "Eclipse", Name = "Eclipse Aura", Description = "Permanent exclusive cosmetic aura", Id = 0, SuggestedPrice = 149},
	{Key = "VIP", Name = "VIP Supporter", Description = "Gold nameplate and supporter aura accents", Id = 0, SuggestedPrice = 299},
}

return Config
</ProtectedString>
        </Properties>
      </Item>
