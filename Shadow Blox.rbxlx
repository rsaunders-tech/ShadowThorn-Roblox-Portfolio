local brand = label(profile, "SHADOW BLOX", 16, C.Text, { Position = UDim2.fromOffset(14, 9), Size = UDim2.new(1, -28, 0, 24), Font = Enum.Font.GothamBlack })
local shards = label(profile, "0 SHARDS", 24, C.Cyan, { Position = UDim2.fromOffset(14, 36), Size = UDim2.new(1, -28, 0, 30), Font = Enum.Font.GothamBold })
