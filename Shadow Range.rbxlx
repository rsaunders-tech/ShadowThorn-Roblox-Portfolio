  <Item class="ServerScriptService" referent="RBX0000023A">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX0000023B">
      <Properties>
        <string name="Name">ShadowRange</string>
      </Properties>
      <Item class="Script" referent="RBX0000023C">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local shared = ReplicatedStorage:WaitForChild("ShadowRange")
local Config, Layout = require(shared.Config), require(shared.RangeLayout)
local Profiles, World, RangeService = require(script.Parent.Profiles), require(script.Parent.World), require(script.Parent.RangeService)
local remoteFolder = Instance.new("Folder")
remoteFolder.Name, remoteFolder.Parent = "Remotes", shared
local function remote(name)
	local event = Instance.new("RemoteEvent")
	event.Name, event.Parent = name, remoteFolder
	return event
end
local shotEvent, actionEvent, stateEvent, notifyEvent, feedbackEvent = remote("Shot"), remote("Action"), remote("State"), remote("Notify"), remote("Feedback")
local connections, controls = {}, {}
local closing, ranges = false, nil
local function present(player) return player.Parent == Players end
local function notify(player, text)
	if present(player) and type(text) == "string" then notifyEvent:FireClient(player, text) end
end
local profiles
local function sendState(player)
	if present(player) and profiles and ranges then
		stateEvent:FireClient(player, {Profile = profiles:snapshot(player), Session = ranges:snapshot(player)})
	end
end
local function leaderstats(player)
	local profile = profiles:get(player)
	if not profile then return end
	local stats = player:FindFirstChild("leaderstats")
	if not stats then stats = Instance.new("Folder"); stats.Name, stats.Parent = "leaderstats", player end
	for name, value in {Credits = profile.Credits, Level = profile.Level, Best = profile.BestScore} do
		local stat = stats:FindFirstChild(name)
		if not stat then stat = Instance.new("IntValue"); stat.Name, stat.Parent = name, stats end
		stat.Value = value
	end
end
profiles = Profiles.new(Config, function(player, text)
	leaderstats(player)
	if text then notify(player, text) end
	sendState(player)
end)
local world = World.build()
ranges = RangeService.new(Config, Layout, world, profiles, notify, function(player, payload)
	if player then if present(player) then feedbackEvent:FireClient(player, payload) end
	else feedbackEvent:FireAllClients(payload) end
end, sendState)

local function characterAdded(player, character)
	if ranges:active(player) then ranges:finish(player, false, false) end
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and present(player) and player.Character == character and not ranges:active(player) then character:PivotTo(World.lobby()) end
end
local function addPlayer(player)
	if closing or controls[player] then return end
	controls[player] = {ShotAt = -math.huge, ActionAt = -math.huge}
	if not profiles:load(player) or not present(player) or closing then
		if present(player) then player:Kick("Your range locker could not load safely. Please rejoin in a moment.") end
		profiles:remove(player)
		return
	end
	connections[player] = player.CharacterAdded:Connect(function(character) task.spawn(characterAdded, player, character) end)
	if player.Character then task.spawn(characterAdded, player, player.Character) end
	leaderstats(player)
	sendState(player)
end

shotEvent.OnServerEvent:Connect(function(player, direction)
	local control = controls[player]
	local now = os.clock()
	if closing or not control or now - control.ShotAt &lt; 0.025 then return end
	control.ShotAt = now
	ranges:shoot(player, direction)
end)
actionEvent.OnServerEvent:Connect(function(player, action, key)
	local control = controls[player]
	if closing or not control or type(action) ~= "string" or #action &gt; 32 then return end
	if key ~= nil and (type(key) ~= "string" or #key &gt; 48) then return end
	local now = os.clock()
	if now - control.ActionAt &lt; 0.18 then return end
	control.ActionAt = now
	local text
	if action == "Ready" then sendState(player); return
	elseif action == "Start" and key then local _, message = ranges:start(player, key); text = message
	elseif action == "Reload" then ranges:reload(player)
	elseif action == "Leave" then ranges:finish(player, false); text = "Challenge ended. Complete the timer to earn rewards."
	elseif action == "Daily" then local _, message = profiles:claimDaily(player); text = message
	elseif ranges:active(player) then text = "Switch firearms and finishes between challenges."
	elseif action == "UnlockWeapon" and key then local _, message = profiles:unlockWeapon(player, key); text = message
	elseif action == "EquipWeapon" and key then local _, message = profiles:equipWeapon(player, key); text = message
	elseif action == "BuySkin" and key then local _, message = profiles:buySkin(player, key); text = message
	elseif action == "EquipSkin" and key then local _, message = profiles:equipSkin(player, key); text = message
	end
	if text then notify(player, text) end
	sendState(player)
end)
Players.PlayerAdded:Connect(function(player) task.spawn(addPlayer, player) end)
Players.PlayerRemoving:Connect(function(player)
	if connections[player] then connections[player]:Disconnect(); connections[player] = nil end
	-- Let a completed reward leave the mutation mutex before releasing the saved profile.
	while ranges.Sessions[player] and ranges.Sessions[player].Settling do task.wait(0.05) end
	ranges:remove(player)
	profiles:remove(player)
	controls[player] = nil
end)
for _, player in Players:GetPlayers() do task.spawn(addPlayer, player) end

local tickTime, stateTime = 0, 0
RunService.Heartbeat:Connect(function(dt)
	if closing then return end
	tickTime += dt
	if tickTime &gt;= 1 / 30 then tickTime = 0; ranges:step(os.clock()) end
	stateTime += dt
	if stateTime &gt;= 0.2 then
		stateTime = 0
		for player in controls do sendState(player) end
	end
end)
game:BindToClose(function()
	closing = true
	profiles:close(function(player)
		local session = ranges.Sessions[player]
		return not session or not session.Settling
	end)
end)
print("Shadow Range ready · targets only · eight independent firing bays")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000023D">
        <Properties>
          <string name="Name">Profiles</string>
          <ProtectedString name="Source">-- Server-owned range progression with exclusive leases and serialized saves.
-- Instantiate once. No client may call this module or choose its own rewards.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Profiles = {}
local MAX_STAT, LEASE_SECONDS, SAVE_INTERVAL = 1000000000000, 180, 45

local function integer(value, fallback, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
	return math.clamp(math.floor(value), 0, maximum or MAX_STAT)
end
local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, item in pairs(value) do result[key] = copy(item) end
	return result
end
local function retry(callback)
	local lastError
	for attempt = 1, 3 do
		local ok, result = pcall(callback)
		if ok then return true, result end
		lastError = result
		if attempt &lt; 3 then task.wait(2 ^ (attempt - 1) + math.random() * 0.3) end
	end
	warn("Shadow Range DataStore request failed:", lastError)
	return false, nil
end

function Profiles.new(config, onChanged)
	local self, states, weapons, skins, modes = {}, {}, {}, {}, {}
	local studioSession = RunService:IsStudio() and config.StudioPersistence ~= true
	local store = not studioSession and DataStoreService:GetDataStore(config.DataStoreName) or nil
	local closing = false
	local xpPerLevel = config.XPPerLevel or 250
	for _, item in ipairs(config.Weapons) do
		assert(type(item.Key) == "string" and not weapons[item.Key] and integer(item.Cost, -1) == item.Cost, "Invalid weapon catalog")
		weapons[item.Key] = item
	end
	for _, item in ipairs(config.Skins) do
		assert(type(item.Key) == "string" and not skins[item.Key] and integer(item.Cost, -1) == item.Cost, "Invalid skin catalog")
		skins[item.Key] = item
	end
	for _, mode in ipairs(config.Modes) do modes[mode.Key] = true end
	assert(weapons.Rookie and weapons.Rookie.Cost == 0 and skins.Factory and skins.Factory.Cost == 0, "Missing starter items")

	local function profileFrom(raw)
		raw = type(raw) == "table" and raw or {}
		local ownedWeapons, ownedSkins = {Rookie = true}, {Factory = true}
		for key in pairs(weapons) do if type(raw.OwnedWeapons) == "table" and raw.OwnedWeapons[key] == true then ownedWeapons[key] = true end end
		for key in pairs(skins) do if type(raw.OwnedSkins) == "table" and raw.OwnedSkins[key] == true then ownedSkins[key] = true end end
		local bests = {}
		for key in pairs(modes) do if type(raw.PersonalBests) == "table" then bests[key] = integer(raw.PersonalBests[key], 0) end end
		local xp = integer(raw.XP, 0)
		return {
			Credits = integer(raw.Credits, config.StartingCredits or 0), XP = xp, Level = 1 + math.floor(xp / xpPerLevel),
			OwnedWeapons = ownedWeapons, EquippedWeapon = ownedWeapons[raw.EquippedWeapon] and raw.EquippedWeapon or "Rookie",
			OwnedSkins = ownedSkins, EquippedSkin = ownedSkins[raw.EquippedSkin] and raw.EquippedSkin or "Factory",
			Sessions = integer(raw.Sessions, 0), BestScore = integer(raw.BestScore, 0), BestCombo = integer(raw.BestCombo, 0),
			TotalHits = integer(raw.TotalHits, 0), TotalShots = integer(raw.TotalShots, 0), DailyAt = integer(raw.DailyAt, 0),
			PersonalBests = bests,
		}
	end
	local function stored(profile)
		local result = copy(profile)
		result.Level = nil
		return result
	end
	local function decode(raw)
		if raw == nil then return {SchemaVersion = 1, Profile = stored(profileFrom(nil))} end
		if type(raw) ~= "table" or raw.SchemaVersion ~= 1 or type(raw.Profile) ~= "table" then return nil end
		local p = raw.Profile
		for _, key in ipairs({"Credits", "XP", "Sessions", "BestScore", "BestCombo", "TotalHits", "TotalShots", "DailyAt"}) do
			if integer(p[key], -1) ~= p[key] then return nil end
		end
		if type(p.OwnedWeapons) ~= "table" or type(p.OwnedSkins) ~= "table" or type(p.EquippedWeapon) ~= "string" or type(p.EquippedSkin) ~= "string" then return nil end
		if p.PersonalBests ~= nil and type(p.PersonalBests) ~= "table" then return nil end
		if raw.Session ~= nil and (type(raw.Session) ~= "table" or type(raw.Session.Id) ~= "string" or integer(raw.Session.ExpiresAt, -1) ~= raw.Session.ExpiresAt) then return nil end
		return raw
	end
	local function healthy(state)
		return state.Ready and state.Healthy and not state.Removing and not state.Released and (studioSession or os.time() &lt; state.LeaseUntil)
	end
	local function changed(player)
		if onChanged then
			local ok, err = pcall(onChanged, player)
			if not ok then warn("Shadow Range profile notification failed:", err) end
		end
	end
	local function locked(player, callback, allowRemoving)
		local state = states[player]
		if not state or not state.Ready then return false, "Your range profile is still loading." end
		while state.Busy do
			task.wait()
			if states[player] ~= state then return false, "Your session has ended." end
		end
		if states[player] ~= state or (state.Removing and not allowRemoving) then return false, "Your session is closing." end
		state.Busy = true
		local result = table.pack(pcall(callback, state))
		state.Busy = false
		local notify = state.Notify
		state.Notify = false
		if notify and states[player] == state then changed(player) end
		if not result[1] then warn("Shadow Range profile operation failed:", result[2]); return false, "The server could not complete that action." end
		return table.unpack(result, 2, result.n)
	end
	local function saveLocked(state, release)
		if state.Released then return true end
		if state.SessionLost then return false end
		if studioSession then state.Healthy, state.Released = true, release == true; return true end
		local profile = stored(state.Profile)
		local writeId = state.SessionId .. ":" .. HttpService:GenerateGUID(false)
		local declined = false
		local ok, saved = retry(function()
			return store:UpdateAsync(state.Key, function(raw)
				declined = false
				local old = decode(raw)
				-- Recognize a write committed before a transport error, including a release.
				if old and old.LastWriteId == writeId then return old end
				if not old or not old.Session or old.Session.Id ~= state.SessionId then declined = true; return nil end
				return {SchemaVersion = 1, Profile = profile, LastWriteId = writeId, LastSave = os.time(),
					Session = not release and {Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS} or nil}, {state.UserId}
			end)
		end)
		if not ok or not saved or declined then
			state.Healthy, state.SessionLost, state.Notify = false, state.SessionLost or declined, true
			return false
		end
		if not state.Healthy then state.Notify = true end
		state.Healthy, state.Released = true, release == true
		if not release then state.LeaseUntil = saved.Session.ExpiresAt end
		return true
	end

	function self:load(player)
		if closing then return false end
		if states[player] then return healthy(states[player]) end
		local state = {UserId = player.UserId, Key = "Player_" .. tostring(player.UserId),
			SessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false), Profile = profileFrom(nil),
			Ready = false, Healthy = true, Busy = false, Removing = false, Released = false, LeaseUntil = 0}
		states[player] = state
		if not studioSession then
			local ok, loaded = retry(function()
				return store:UpdateAsync(state.Key, function(raw)
					local old = decode(raw)
					if not old then return nil end
					if old.Session and old.Session.Id ~= state.SessionId and old.Session.ExpiresAt &gt; os.time() then return nil end
					return {SchemaVersion = 1, Profile = old.Profile, LastWriteId = old.LastWriteId, LastSave = old.LastSave,
						Session = {Id = state.SessionId, ExpiresAt = os.time() + LEASE_SECONDS}}, {player.UserId}
				end)
			end)
			if not ok or not loaded or not loaded.Session or loaded.Session.Id ~= state.SessionId then
				if states[player] == state then states[player] = nil end
				return false
			end
			state.Profile, state.LeaseUntil = profileFrom(loaded.Profile), loaded.Session.ExpiresAt
		end
		state.Ready = true
		if state.Removing or closing or states[player] ~= state or player.Parent ~= Players then
			saveLocked(state, true)
			if states[player] == state then states[player] = nil end
			return false
		end
		changed(player)
		return true
	end
	function self:snapshot(player)
		local state = states[player]
		if not state or not state.Ready then return nil end
		local result = copy(state.Profile)
		result.Ready, result.SessionOnly = healthy(state), studioSession
		result.DailyNextAt = state.Profile.DailyAt + 86400
		result.DailyReady = healthy(state) and (state.Profile.DailyAt == 0 or os.time() &gt;= result.DailyNextAt)
		return result
	end
	function self:get(player) return self:snapshot(player) end
	local function unlock(player, key, catalog, ownership)
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Try again shortly." end
			local item = type(key) == "string" and catalog[key]
			if not item then return false, "Unknown range item." end
			if state.Profile[ownership][key] then return true, "Already unlocked." end
			if state.Profile.Level &lt; (item.Level or 1) then return false, "Reach level " .. tostring(item.Level) .. " to unlock this item." end
			if state.Profile.Credits &lt; item.Cost then return false, "Earn more credits in a range challenge." end
			state.Profile.Credits -= item.Cost
			state.Profile[ownership][key], state.Notify = true, true
			return true, item.Name .. " unlocked!"
		end)
	end
	local function equip(player, key, catalog, ownership, field)
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Try again shortly." end
			local item = type(key) == "string" and catalog[key]
			if not item then return false, "Unknown range item." end
			if not state.Profile[ownership][key] then return false, "Unlock this item before equipping it." end
			state.Profile[field], state.Notify = key, true
			return true, item.Name .. " equipped!"
		end)
	end
	function self:unlockWeapon(player, key) return unlock(player, key, weapons, "OwnedWeapons") end
	function self:equipWeapon(player, key) return equip(player, key, weapons, "OwnedWeapons", "EquippedWeapon") end
	function self:buySkin(player, key) return unlock(player, key, skins, "OwnedSkins") end
	function self:equipSkin(player, key) return equip(player, key, skins, "OwnedSkins", "EquippedSkin") end

	function self:claimDaily(player)
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Try again shortly." end
			local p = state.Profile
			if p.DailyAt &gt; 0 and os.time() &lt; p.DailyAt + 86400 then return false, "Your next daily reward is not ready yet." end
			p.DailyAt = os.time()
			p.Credits = math.min(MAX_STAT, p.Credits + (config.DailyCredits or 200))
			p.XP = math.min(MAX_STAT, p.XP + (config.DailyXP or 50))
			p.Level = 1 + math.floor(p.XP / xpPerLevel)
			state.Notify = true
			if not saveLocked(state, false) then return false, "Your daily reward is pending while saving recovers." end
			return true, "+" .. tostring(config.DailyCredits or 200) .. " daily range credits!"
		end)
	end
	function self:awardSession(player, summary)
		if type(summary) ~= "table" or not modes[summary.Mode] or summary.Completed ~= true then return false, "Complete a range challenge to earn its reward." end
		local score, hits, shots = integer(summary.Score, -1, 100000), integer(summary.Hits, -1, 1500), integer(summary.Shots, -1, 3000)
		local combo, perfects = integer(summary.BestCombo, -1, 1500), integer(summary.Perfects, 0, 1500)
		if score ~= summary.Score or hits ~= summary.Hits or shots ~= summary.Shots or combo ~= summary.BestCombo
			or perfects ~= (summary.Perfects or 0) or hits &gt; shots * 6 or combo &gt; hits or perfects &gt; hits then
			return false, "That challenge summary is invalid."
		end
		return locked(player, function(state)
			if not healthy(state) then return false, "Saving is unavailable. Rewards are paused." end
			local p, r = state.Profile, config.Rewards or {}
			local credits, xp = 0, 0
			if hits &gt; 0 and score &gt; 0 then
				credits = math.min(r.MaxCredits or 800, (r.BaseCredits or 100) + math.floor(score / (r.ScoreDivisor or 40)) + math.min(combo, 30) * (r.ComboCredits or 3))
				xp = math.min(r.MaxXP or 350, (r.BaseXP or 70) + math.min(hits, 100) * (r.HitXP or 2) + math.min(perfects, 30) * (r.PerfectXP or 2))
			end
			local oldLevel, newBest = p.Level, score &gt; p.BestScore
			p.Credits, p.XP = math.min(MAX_STAT, p.Credits + credits), math.min(MAX_STAT, p.XP + xp)
			p.Level = 1 + math.floor(p.XP / xpPerLevel)
			p.Sessions, p.TotalHits, p.TotalShots = math.min(MAX_STAT, p.Sessions + 1), math.min(MAX_STAT, p.TotalHits + hits), math.min(MAX_STAT, p.TotalShots + shots)
			p.BestScore, p.BestCombo = math.max(p.BestScore, score), math.max(p.BestCombo, combo)
			p.PersonalBests[summary.Mode] = math.max(p.PersonalBests[summary.Mode] or 0, score)
			state.Notify = true
			return true, "+" .. credits .. " credits · +" .. xp .. " XP", {Credits = credits, XP = xp, LevelUp = p.Level &gt; oldLevel, NewBest = newBest}
		end)
	end

	function self:save(player, release)
		local state = states[player]
		if not state then return false end
		if release then state.Removing = true end
		return locked(player, function(current) return saveLocked(current, release == true) end, true)
	end
	function self:remove(player)
		local state = states[player]
		if not state then return end
		state.Removing = true
		if state.Ready then self:save(player, true) end
		while state.Busy do task.wait() end
		if states[player] == state then states[player] = nil end
	end
	function self:close(readyToRelease)
		closing = true
		local pending, deadline = 0, os.clock() + 25
		for player, state in pairs(states) do
			if state.Ready and not state.Released then
				pending += 1
				task.spawn(function()
					-- Completed range rewards may be waiting behind a yielding save.
					-- Keep that profile mutable until its settlement is done; other
					-- profiles release in parallel within the same shutdown deadline.
					local warned = false
					while readyToRelease and states[player] == state and os.clock() &lt; deadline do
						local ok, ready = pcall(readyToRelease, player)
						if ok and ready then break end
						if not ok and not warned then warned = true; warn("Shadow Range release coordination failed:", ready) end
						task.wait(0.05)
					end
					if states[player] == state then state.Removing = true; self:save(player, true) end
					pending -= 1
				end)
			else state.Removing = true end
		end
		while pending &gt; 0 and os.clock() &lt; deadline do task.wait(0.05) end
	end
	task.spawn(function()
		while not closing do
			task.wait(SAVE_INTERVAL)
			if closing then break end
			for player, state in pairs(states) do
				if state.Ready and not state.Removing and not state.Released and not state.SessionLost then task.spawn(function() self:save(player, false) end) end
			end
		end
	end)
	return self
end

return Profiles
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000023E">
        <Properties>
          <string name="Name">RangeService</string>
          <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local shared = ReplicatedStorage.ShadowRange
local Rules = require(shared.RangeRules)
local Targets, Weapons = require(script.Parent.Targets), require(script.Parent.Weapons)
local RangeService = {}
RangeService.__index = RangeService

local function vector(point) return Vector3.new(point[1], point[2], point[3]) end
local function coordinates(point) return {point.X, point.Y, point.Z} end
local function find(list, key)
	for _, item in list do if item.Key == key then return item end end
	return nil
end
local function rig(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health &lt;= 0 then return nil end
	return root, humanoid
end

function RangeService.new(config, layout, world, profiles, notify, feedback, changed)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "ShadowRangeTargets", Workspace
	return setmetatable({Config = config, Layout = layout, World = world, Profiles = profiles,
		Notify = notify, Feedback = feedback, Changed = changed, Sessions = {}, Bays = {}, Folder = folder,
		Random = Random.new()}, RangeService)
end

function RangeService:active(player)
	local session = self.Sessions[player]
	return session and (session.Active or session.Settling) or false
end

function RangeService:placeTarget(session, target, now)
	local x = session.BaySpec.Origin[1] + self.Random:NextNumber(-6, 6)
	local y = self.Random:NextNumber(5.5, 10)
	local z = if session.Mode == "Bullseye" then self.Layout.TargetZ[target.Index]
		elseif session.Mode == "Reflex" then self.Layout.TargetZ[self.Random:NextInteger(1, #self.Layout.TargetZ)] else -52
	Targets.move(target, Vector3.new(x, y, z))
	target.Base, target.Expires = target.Center, now + 1.8
	Targets.visible(target, true)
end

function RangeService:start(player, key)
	if self:active(player) then return false, "Finish your current challenge first." end
	local profile = self.Profiles:get(player)
	if not profile or not profile.Ready then return false, "Your progress is unavailable. Please rejoin." end
	local mode, weapon = find(self.Config.Modes, key), find(self.Config.Weapons, profile.EquippedWeapon)
	local root, humanoid = rig(player)
	if not mode or not weapon or not profile.OwnedWeapons[weapon.Key] then return false, "Choose an unlocked firearm and challenge." end
	if not root then return false, "Wait for your character to respawn." end
	local bay
	for index, spec in self.Layout.Bays do if not self.Bays[index] then bay = spec; break end end
	if not bay then return false, "All eight bays are occupied. Try again when a challenge finishes." end
	local now = os.clock()
	local session = Rules.newSession(weapon, now, mode.Duration, key)
	session.Id, session.Weapon, session.Bay, session.BaySpec = HttpService:GenerateGUID(false), weapon, bay.Index, bay
	session.TargetFolder = Instance.new("Folder")
	session.TargetFolder.Name = "Bay_" .. bay.Index
	session.TargetFolder:SetAttribute("OwnerUserId", player.UserId)
	session.TargetFolder.Parent = self.Folder
	session.Targets = {}
	session.RayParams = RaycastParams.new()
	session.RayParams.FilterType = Enum.RaycastFilterType.Include
	-- No avatars are raycast candidates. Only world barriers and this player's targets.
	session.RayParams.FilterDescendantsInstances = {self.World.Geometry, self.World.Lobby, session.TargetFolder}
	for index = 1, (if key == "Bullseye" then 3 else 1) do
		local target = Targets.new(session.TargetFolder, index, if key == "Bullseye" then 3 elseif key == "Reflex" then 2.4 else 2.7)
		table.insert(session.Targets, target)
		self:placeTarget(session, target, now)
	end
	self.Sessions[player], self.Bays[bay.Index] = session, player
	root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	player.Character:PivotTo(CFrame.new(bay.Origin[1], bay.Origin[2] + 3, bay.Origin[3]))
	session.Tool = Weapons.give(player, weapon, find(self.Config.Skins, profile.EquippedSkin))
	if not session.Tool then
		session.Active = false
		self.Bays[session.Bay] = nil
		session.TargetFolder:Destroy()
		return false, "Your firearm could not equip. Please try again after respawning."
	end
	humanoid.WalkSpeed = 12
	self.Changed(player)
	return true, mode.Name .. " · Bay " .. string.format("%02d", bay.Index) .. ". Stay inside the cyan box and aim downrange."
end

function RangeService:reload(player)
	local session = self.Sessions[player]
	if not session or not Rules.reload(session, session.Weapon, os.clock()) then return false end
	self.Feedback(player, {Kind = "Reload", Weapon = session.Weapon.Key})
	return true
end

function RangeService:shoot(player, direction)
	if typeof(direction) ~= "Vector3" then return end
	local session = self.Sessions[player]
	local root = rig(player)
	if not session or not root then return end
	local now = os.clock()
	if not session.Tool or session.Tool.Parent ~= player.Character then return end
	local allowed = Rules.canShoot(session, session.Weapon, coordinates(root.Position), session.BaySpec, coordinates(direction), now)
	if not allowed then return end
	Rules.takeShot(session, now)
	local origin = root.Position + Vector3.new(0, 1.35, 0)
	local base = CFrame.lookAt(Vector3.zero, direction.Unit)
	local bestTarget, bestRatio, bestPoint = nil, math.huge, nil
	local endPoint = origin + direction.Unit * self.Layout.MaxDistance
	for _ = 1, session.Weapon.Pellets do
		local spread = math.rad(session.Weapon.Spread)
		local shotDirection = (base * CFrame.Angles(self.Random:NextNumber(-spread, spread), self.Random:NextNumber(-spread, spread), 0)).LookVector
		local result = Workspace:Raycast(origin, shotDirection * self.Layout.MaxDistance, session.RayParams)
		if result then
			endPoint = result.Position
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			if model and model.Parent == session.TargetFolder then
				local target = session.Targets[model:GetAttribute("TargetIndex")]
				if target and target.Active and target.ReadyAt &lt;= now then
					local ratio = Vector2.new(result.Position.X - target.Center.X, result.Position.Y - target.Center.Y).Magnitude / target.Radius
					if ratio &lt;= 1 and ratio &lt; bestRatio then bestTarget, bestRatio, bestPoint = target, ratio, result.Position end
				end
			end
		end
	end
	self.Feedback(nil, {Kind = "Shot", Origin = origin, Position = bestPoint or endPoint, Weapon = session.Weapon.Key,
		ShooterUserId = player.UserId, Ammo = session.Ammo})
	local score, perfect = Rules.hit(session, if bestTarget then bestRatio else nil, bestTarget and bestTarget.Center.Z &lt; -70)
	if bestTarget then
		bestTarget.ReadyAt = now + (if session.Mode == "Tracking" then 0 else 0.28)
		if session.Mode ~= "Tracking" then Targets.visible(bestTarget, false) end
		self.Feedback(player, {Kind = "Hit", Position = bestPoint, Score = score, Perfect = perfect, Combo = session.Combo,
			Ammo = session.Ammo, Weapon = session.Weapon.Key})
	else
		self.Feedback(player, {Kind = "Miss", Ammo = session.Ammo, Weapon = session.Weapon.Key})
	end
	if session.Ammo &lt;= 0 then self:reload(player) end
end

function RangeService:finish(player, completed, returnToLobby)
	local session = self.Sessions[player]
	if not session or not session.Active then return end
	-- Mark closed before persistence can yield; duplicate finish/leave/death earns nothing.
	session.Active, session.Settling = false, true
	self.Bays[session.Bay] = nil
	if session.TargetFolder then session.TargetFolder:Destroy() end
	Weapons.clear(player)
	local root, humanoid = rig(player)
	if humanoid then humanoid.WalkSpeed = 16 end
	if root and returnToLobby ~= false then
		root.AssemblyLinearVelocity = Vector3.zero
		player.Character:PivotTo(CFrame.new(vector(self.Layout.Lobby) + Vector3.new(0, 3, 0)))
	end
	local summary = Rules.summary(session, completed)
	session.Results = table.clone(summary)
	session.Results.Credits, session.Results.XP, session.Results.Pending = 0, 0, completed == true
	self.Changed(player)
	task.spawn(function()
		local ok, details = not completed, nil
		if completed then
			for attempt = 1, 3 do
				local success, _, reward = self.Profiles:awardSession(player, summary)
				ok, details = success, reward
				if ok then break end
				if attempt &lt; 3 then task.wait(1) end
			end
		end
		session.Settling, session.Results.Pending = false, false
		if ok and details then
			session.Results.Credits, session.Results.XP = details.Credits, details.XP
			session.Results.NewBest = details.NewBest
		elseif completed and not ok then
			session.Results.RewardFailed = true
			self.Notify(player, "Saving is unavailable. This challenge reward could not be granted.")
		end
		self.Feedback(player, {Kind = "SessionEnd"})
		self.Changed(player)
	end)
end

function RangeService:step(now)
	for player, session in self.Sessions do
		if session.Active then
			if now &gt;= session.Ends then self:finish(player, true)
			elseif not rig(player) then self:finish(player, false, false)
			else
				Rules.finishReload(session, session.Weapon, now)
				for _, target in session.Targets do
					if session.Mode == "Reflex" and target.Active and now &gt;= target.Expires then
						Targets.visible(target, false)
						target.ReadyAt, session.Combo = now + 0.18, 0
					end
					if not target.Active and now &gt;= target.ReadyAt then self:placeTarget(session, target, now) end
					if session.Mode == "Tracking" then
						local time = now - session.Started
						Targets.move(target, Vector3.new(session.BaySpec.Origin[1] + math.sin(time * 1.6) * 6,
							7.5 + math.sin(time * 1.1) * 1.5, -52))
					end
				end
			end
		end
	end
end

function RangeService:snapshot(player)
	local session = self.Sessions[player]
	if not session then return {Active = false, CanFire = false, Ammo = 0, Magazine = 0} end
	local now, root = os.clock(), rig(player)
	local active = session.Active == true
	return {Active = active, Settling = session.Settling == true, Mode = session.Mode,
		Remaining = if active then math.max(0, session.Ends - now) else 0,
		Score = session.Score, Hits = session.Hits, Shots = session.Shots, Accuracy = Rules.accuracy(session),
		Combo = session.Combo, BestCombo = session.BestCombo, Perfects = session.Perfects,
		Ammo = session.Ammo, Magazine = session.Weapon.Magazine, Reloading = active and session.ReloadUntil &gt; now,
		ReloadRemaining = active and math.max(0, session.ReloadUntil - now) or 0, Bay = session.Bay,
		CanFire = active and root ~= nil and Rules.inBay(coordinates(root.Position), session.BaySpec), Results = session.Results}
end

function RangeService:remove(player)
	local session = self.Sessions[player]
	if session then
		session.Active = false
		if self.Bays[session.Bay] == player then self.Bays[session.Bay] = nil end
		if session.TargetFolder then session.TargetFolder:Destroy() end
	end
	Weapons.clear(player)
	self.Sessions[player] = nil
end

return RangeService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000023F">
        <Properties>
          <string name="Name">Targets</string>
          <ProtectedString name="Source">local Targets = {}
local function disc(model, name, diameter, depth, offset, color)
	local part = Instance.new("Part")
	part.Name, part.Shape = name, Enum.PartType.Cylinder
	part.Size = Vector3.new(depth, diameter, diameter)
	part.CFrame = CFrame.new(0, 0, offset) * CFrame.Angles(0, math.pi / 2, 0)
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, true
	part.Material, part.Color = Enum.Material.SmoothPlastic, color
	part.Parent = model
	return part
end
function Targets.new(parent, index, radius)
	local model = Instance.new("Model")
	model.Name = "Target_" .. index
	model:SetAttribute("TargetIndex", index)
	local outer = disc(model, "HitPlate", radius * 2, 0.24, 0, Color3.fromRGB(232, 239, 243))
	disc(model, "OuterRing", radius * 1.7, 0.06, 0.15, Color3.fromRGB(45, 64, 81))
	disc(model, "InnerRing", radius * 1.1, 0.06, 0.2, Color3.fromRGB(72, 216, 214))
	disc(model, "Bullseye", radius * 0.44, 0.06, 0.25, Color3.fromRGB(255, 180, 77))
	model.PrimaryPart, model.Parent = outer, parent
	return {Model = model, Radius = radius, Active = false, ReadyAt = 0, Index = index}
end
function Targets.visible(target, visible)
	target.Active = visible
	for _, p in target.Model:GetChildren() do
		if p:IsA("BasePart") then p.Transparency, p.CanQuery = if visible then 0 else 1, visible end
	end
end
function Targets.move(target, center)
	target.Center = center
	target.Model:PivotTo(CFrame.new(center) * CFrame.Angles(0, math.pi / 2, 0))
end
return Targets
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000240">
        <Properties>
          <string name="Name">Weapons</string>
          <ProtectedString name="Source">-- Original toy-like firearm models. No projectile or Humanoid damage scripts.
local Weapons = {}
local function piece(tool, handle, name, size, position, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, handle.CFrame * CFrame.new(position)
	p.Color, p.Material = color, material or Enum.Material.SmoothPlastic
	p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, true
	p.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = handle, p, p
	return p
end
function Weapons.clear(player)
	for _, parent in {player.Character, player:FindFirstChildOfClass("Backpack")} do
		if parent then
			for _, item in parent:GetChildren() do
				if item:IsA("Tool") and item:GetAttribute("RangeWeapon") then item:Destroy() end
			end
		end
	end
end
function Weapons.give(player, weapon, skin)
	Weapons.clear(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not humanoid or not backpack then return nil end
	local tool = Instance.new("Tool")
	tool.Name, tool.RequiresHandle, tool.CanBeDropped, tool.ManualActivationOnly = weapon.Name, true, false, true
	tool:SetAttribute("RangeWeapon", true)
	tool:SetAttribute("WeaponKey", weapon.Key)
	tool.ToolTip = "Range targets only · R to reload"
	local handle = Instance.new("Part")
	handle.Name, handle.Size = "Handle", Vector3.new(0.45, 0.95, 0.55)
	handle.CanCollide, handle.CanTouch, handle.CanQuery, handle.Massless = false, false, false, true
	handle.Color, handle.Material = Color3.fromRGB(34, 40, 51), Enum.Material.SmoothPlastic
	handle.Parent = tool
	local c = skin and skin.Color or weapon.Color or {69, 216, 212}
	local color = Color3.fromRGB(c[1], c[2], c[3])
	local length = if weapon.Key == "Rookie" then 1.7 elseif weapon.Key == "Viper" then 2.5 elseif weapon.Key == "Sentinel" then 4.3 elseif weapon.Key == "Thunder" then 3.8 else 3.4
	piece(tool, handle, "Receiver", Vector3.new(0.68, 0.65, length * 0.6), Vector3.new(0, 0.65, -length * 0.15), color)
	piece(tool, handle, "Barrel", Vector3.new(0.27, 0.27, length * 0.6), Vector3.new(0, 0.65, -length * 0.65), Color3.fromRGB(30, 36, 46), Enum.Material.Metal)
	local tip = piece(tool, handle, "MuzzleTip", Vector3.new(0.4, 0.4, 0.14), Vector3.new(0, 0.65, -length * 0.95), Color3.fromRGB(255, 178, 78), Enum.Material.Neon)
	local muzzle = Instance.new("Attachment")
	muzzle.Name, muzzle.Parent = "Muzzle", tip
	if weapon.Key ~= "Rookie" then
		piece(tool, handle, "Stock", Vector3.new(0.54, 0.72, 1.1), Vector3.new(0, 0.3, 1), Color3.fromRGB(37, 44, 56))
		piece(tool, handle, "Magazine", Vector3.new(0.5, 0.85, 0.7), Vector3.new(0, -0.2, -0.6), color)
	end
	if weapon.Key == "Sentinel" then
		piece(tool, handle, "Scope", Vector3.new(0.5, 0.5, 1.4), Vector3.new(0, 1.28, -0.5), Color3.fromRGB(40, 51, 66))
	elseif weapon.Key == "Nova" then
		piece(tool, handle, "EnergyCell", Vector3.new(0.75, 0.16, 1.5), Vector3.new(0, 1.1, -0.6), Color3.fromRGB(137, 116, 255), Enum.Material.Neon)
	end
	tool.Grip = CFrame.new(0, -0.1, -0.35)
	tool.Parent = backpack
	humanoid:EquipTool(tool)
	return tool
end
return Weapons
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000241">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">-- Original range geometry is embedded in the place and rebuilt for Rojo users if missing.
local Lighting = game:GetService("Lighting")
local shared = game:GetService("ReplicatedStorage"):WaitForChild("ShadowRange")
local Layout = require(shared:WaitForChild("RangeLayout"))
local Scene = require(shared:WaitForChild("WorldScene"))
local World = {}

local function vector(value) return Vector3.new(value[1], value[2], value[3]) end

local function configureLighting()
	Lighting.ClockTime, Lighting.Brightness, Lighting.ExposureCompensation = 14, 2.7, 0.12
	Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(150,160,179), Color3.fromRGB(170,181,197)
	Lighting.GlobalShadows = false
	Lighting.FogStart, Lighting.FogEnd, Lighting.FogColor = 500, 1200, Color3.fromRGB(157,177,194)
	local bloom = Lighting:FindFirstChild("RangeBloom")
	if not bloom then bloom = Instance.new("BloomEffect"); bloom.Name = "RangeBloom"; bloom.Parent = Lighting end
	bloom.Intensity, bloom.Size, bloom.Threshold = 0.15, 18, 1.8
end

function World.build()
	configureLighting()
	local model = workspace:FindFirstChild("ShadowRangeWorld")
	if not model then
		model = Instance.new("Model"); model.Name = "ShadowRangeWorld"; model.Parent = workspace
		local groups = {}
		for _, name in {"Geometry", "Decor", "Lobby"} do
			local folder = Instance.new("Folder"); folder.Name, folder.Parent = name, model; groups[name] = folder
		end
		for _, spec in Scene.Parts do
			local p = Instance.new(if spec.Spawn then "SpawnLocation" else "Part")
			p.Name, p.Size = spec.Name, vector(spec.Size)
			p.CFrame = CFrame.new(vector(spec.Position)) * CFrame.Angles(math.rad(spec.Rotation[1]), math.rad(spec.Rotation[2]), math.rad(spec.Rotation[3]))
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, spec.Collide ~= false, spec.Collide ~= false, false
			p.Color, p.Material, p.Shape = Color3.fromRGB(spec.Color[1],spec.Color[2],spec.Color[3]), Enum.Material[spec.Material], Enum.PartType[spec.Shape or "Block"]
			p.TopSurface, p.BottomSurface, p.Transparency = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth, spec.Transparency or 0
			if spec.Spawn then p.Neutral, p.Duration = true, 0 end
			p.Parent = groups[spec.Group] or groups.Decor
			if spec.Light then
				local light = Instance.new("PointLight")
				light.Color, light.Brightness, light.Range, light.Shadows, light.Parent = p.Color, spec.Light, spec.LightRange or 24, false, p
			end
			if spec.Text then
				local sign = Instance.new("BillboardGui")
				sign.Name, sign.Size, sign.MaxDistance, sign.LightInfluence, sign.Parent = "Sign", UDim2.fromOffset(spec.TextWidth or 390,64), 210, 0, p
				local label = Instance.new("TextLabel")
				label.Size, label.BackgroundTransparency = UDim2.fromScale(1,1), 1
				label.Font, label.TextSize, label.TextColor3 = Enum.Font.GothamBold, spec.TextSize or 23, p.Color
				label.TextStrokeTransparency, label.Text, label.Parent = 0.6, spec.Text, sign
			end
		end
	end
	return {Model=model,Geometry=model:FindFirstChild("Geometry"),Decor=model:FindFirstChild("Decor"),Lobby=model:FindFirstChild("Lobby")}
end

function World.bay(index)
	local bay = assert(Layout.Bays[index], "Unknown range bay")
	local position = vector(bay.Origin) + Vector3.new(0,3,0)
	return CFrame.lookAt(position, position + Vector3.new(0,0,-1))
end

function World.lobby()
	local position = vector(Layout.Lobby) + Vector3.new(0,3,0)
	return CFrame.lookAt(position, position + Vector3.new(0,0,-1))
end

return World
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000242">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">32</float>
      <float name="CameraMinZoomDistance">0.5</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000243">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX00000244">
        <Properties>
          <string name="Name">ShadowRange</string>
          <ProtectedString name="Source">-- Shadow Range client: presentation and input only. The server validates every shot.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("ShadowRange")
local Config = require(shared:WaitForChild("Config"))
local remotes = shared:WaitForChild("Remotes")
local shotRemote, actionRemote = remotes:WaitForChild("Shot"), remotes:WaitForChild("Action")
local stateRemote, feedbackRemote = remotes:WaitForChild("State"), remotes:WaitForChild("Feedback")
local notifyRemote = remotes:WaitForChild("Notify")
local C = {
	Ink = Color3.fromRGB(14, 22, 30), Panel = Color3.fromRGB(23, 34, 45),
	Raised = Color3.fromRGB(34, 48, 61), Line = Color3.fromRGB(63, 80, 94),
	Text = Color3.fromRGB(244, 243, 232), Muted = Color3.fromRGB(169, 190, 199),
	Cyan = Color3.fromRGB(68, 225, 213), Amber = Color3.fromRGB(255, 195, 98),
	Red = Color3.fromRGB(255, 124, 120),
}
local state = {Profile = {}, Session = {Active = false}}
local menu, armoryTab, selectedMode = "Welcome", "Weapons", "Bullseye"
local fireHeld, focusActive, connected = false, true, false
local fireAt, reloadRequestAt, kick, hitUntil, hitPerfect = 0, 0, 0, 0, false
local toastToken, lastArmorySignature = 0, ""
local lastResult, lastResultSignature, lastViewport = nil, "", Vector2.zero
local firstPerson = false
local oldCameraMode, oldMinZoom, oldMaxZoom = player.CameraMode, player.CameraMinZoomDistance, player.CameraMaxZoomDistance
local renderMenu, openMenu, showToast, updateCameraMode
local connections = {}
local muted = false

-- These files ship with Roblox; no uploaded or externally hosted audio is used.
local shotSound = Instance.new("Sound")
shotSound.Name, shotSound.SoundId = "ShadowRangeShot", "rbxasset://sounds/impact_explosion_03.mp3"
shotSound.Volume, shotSound.PlaybackSpeed, shotSound.Parent = 0.04, 2.4, SoundService
local hitSound = Instance.new("Sound")
hitSound.Name, hitSound.SoundId = "ShadowRangeHit", "rbxasset://sounds/volume_slider.ogg"
hitSound.Volume, hitSound.PlaybackSpeed, hitSound.Parent = 0.18, 1.6, SoundService
local function playFeedback(sound, speed)
	if muted then return end
	if speed then sound.PlaybackSpeed = speed end
	sound.TimePosition = 0
	sound:Play()
end

local function make(className, parent, props)
	local object = Instance.new(className)
	if object:IsA("GuiObject") and parent:IsA("GuiObject") then object.ZIndex = parent.ZIndex + 1 end
	for key, value in pairs(props or {}) do object[key] = value end
	object.Parent = parent
	return object
end
local function corner(object, radius)
	make("UICorner", object, {CornerRadius = UDim.new(0, radius or 12)})
end
local function panel(parent, position, size, color, z)
	local object = make("Frame", parent, {Position = position, Size = size,
		BackgroundColor3 = color or C.Panel, BorderSizePixel = 0, ZIndex = z or 2})
	corner(object)
	return object
end
local function label(parent, text, size, position, dimensions, color, bold)
	return make("TextLabel", parent, {Text = text, TextSize = size, Position = position, Size = dimensions,
		TextColor3 = color or C.Text, Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		BackgroundTransparency = 1, BorderSizePixel = 0})
end
local function button(parent, text, position, dimensions, callback, accent)
	local object = make("TextButton", parent, {Text = text, TextSize = 13, Position = position, Size = dimensions,
		TextColor3 = accent and C.Ink or C.Text, Font = Enum.Font.GothamBold,
		BackgroundColor3 = accent or C.Raised, AutoButtonColor = true, BorderSizePixel = 0, Selectable = true})
	corner(object, 9)
	-- GUI-owned connections are disconnected when their row is destroyed.
	object.Activated:Connect(callback)
	return object
end
local function fmt(value)
	local text = tostring(math.floor(tonumber(value) or 0))
	return text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end
local function find(list, key)
	for _, item in ipairs(list or {}) do if item.Key == key then return item end end
	return nil
end
local function weapon()
	return find(Config.Weapons, state.Profile.EquippedWeapon) or Config.Weapons[1]
end
local function mode()
	return find(Config.Modes, selectedMode) or Config.Modes[1]
end
local function colorOf(item)
	local rgb = item.Color or {68, 225, 213}
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end
local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {Name = "ShadowRangeHUD", ResetOnSpawn = false,
	IgnoreGuiInset = false, DisplayOrder = 20, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
local root = make("Frame", gui, {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1})
local brand = panel(root, UDim2.fromOffset(16, 14), UDim2.fromOffset(184, 65))
label(brand, "SHADOW RANGE", 16, UDim2.fromOffset(13, 8), UDim2.new(1, -26, 0, 25), C.Text, true)
label(brand, "F I N D   Y O U R   F O C U S", 9, UDim2.fromOffset(13, 36), UDim2.new(1, -26, 0, 17), C.Cyan, true)
local wallet = panel(root, UDim2.new(1, -236, 0, 14), UDim2.fromOffset(220, 65))
local creditLabel = label(wallet, "0 CREDITS", 18, UDim2.fromOffset(13, 7), UDim2.new(1, -26, 0, 26), C.Amber, true)
local levelLabel = label(wallet, "LEVEL 1 / 0 XP", 10, UDim2.fromOffset(13, 37), UDim2.new(1, -26, 0, 18), C.Muted, true)
local runCard = panel(root, UDim2.new(0.5, -146, 0, 14), UDim2.fromOffset(292, 65))
local runLabel = label(runCard, "RANGE IS READY", 14, UDim2.fromOffset(14, 8), UDim2.new(1, -28, 0, 22), C.Cyan, true)
local runDetail = label(runCard, "Choose a challenge and take your bay", 10, UDim2.fromOffset(14, 36), UDim2.new(1, -28, 0, 20), C.Muted)

local scoreCard = panel(root, UDim2.fromOffset(16, 97), UDim2.fromOffset(184, 142))
label(scoreCard, "SESSION SCORE", 10, UDim2.fromOffset(13, 8), UDim2.new(1, -26, 0, 19), C.Muted, true)
local scoreLabel = label(scoreCard, "0000", 34, UDim2.fromOffset(11, 28), UDim2.new(1, -22, 0, 44), C.Text, true)
local comboLabel = label(scoreCard, "BUILD YOUR STREAK", 11, UDim2.fromOffset(13, 79), UDim2.new(1, -26, 0, 20), C.Amber, true)
local accuracyLabel = label(scoreCard, "ACCURACY  —", 10, UDim2.fromOffset(13, 109), UDim2.new(1, -26, 0, 18), C.Muted)
local ammoCard = panel(root, UDim2.new(1, -216, 1, -139), UDim2.fromOffset(200, 123))
local weaponLabel = label(ammoCard, "ROOKIE SIDEARM", 11, UDim2.fromOffset(14, 8), UDim2.new(1, -28, 0, 21), C.Cyan, true)
local ammoLabel = label(ammoCard, "12 / 12", 32, UDim2.fromOffset(12, 32), UDim2.new(1, -24, 0, 43), C.Text, true)
local reloadLabel = label(ammoCard, "R  RELOAD", 10, UDim2.fromOffset(14, 87), UDim2.new(1, -28, 0, 20), C.Muted, true)
local navigation = make("Frame", root, {Position = UDim2.new(0, 16, 1, -107), Size = UDim2.fromOffset(360, 91), BackgroundTransparency = 1})
local chooseButton = button(navigation, "CHALLENGES [E]", UDim2.new(), UDim2.fromOffset(164, 38), function() openMenu("Challenges") end, C.Cyan)
local armoryButton = button(navigation, "ARMORY [G]", UDim2.fromOffset(174, 0), UDim2.fromOffset(134, 38), function() openMenu("Armory") end)
local dailyButton = button(navigation, "DAILY REWARD", UDim2.fromOffset(0, 47), UDim2.fromOffset(164, 34), function() actionRemote:FireServer("Daily") end)
local leaveButton = button(navigation, "LEAVE BAY [Q]", UDim2.fromOffset(174, 47), UDim2.fromOffset(134, 34), function() actionRemote:FireServer("Leave") end)

local crosshair = make("Frame", root, {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, Visible = false})
for _, spec in ipairs({{18, 3, 3, 9}, {18, 28, 3, 9}, {3, 18, 9, 3}, {28, 18, 9, 3}}) do
	make("Frame", crosshair, {Position = UDim2.fromOffset(spec[1], spec[2]), Size = UDim2.fromOffset(spec[3], spec[4]), BackgroundColor3 = C.Text, BorderSizePixel = 0})
end
local hitMarker = label(root, "×", 48, UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(60, 60), C.Cyan, true)
hitMarker.AnchorPoint, hitMarker.TextXAlignment, hitMarker.Visible = Vector2.new(0.5, 0.5), Enum.TextXAlignment.Center, false
local hitText = label(root, "", 17, UDim2.new(0.5, 0, 0.5, 47), UDim2.fromOffset(330, 27), C.Amber, true)
hitText.AnchorPoint, hitText.TextXAlignment = Vector2.new(0.5, 0), Enum.TextXAlignment.Center
local rangeStatus = label(root, "SHOOTING IS ENABLED ONLY IN YOUR ASSIGNED RANGE BAY", 10,
	UDim2.new(0.5, 0, 1, -28), UDim2.new(0.6, 0, 0, 18), C.Muted, true)
rangeStatus.AnchorPoint, rangeStatus.TextXAlignment = Vector2.new(0.5, 0), Enum.TextXAlignment.Center

local toast = panel(root, UDim2.new(0.5, 0, 0, 94), UDim2.new(0.65, 0, 0, 48), C.Raised, 90)
toast.AnchorPoint, toast.Visible = Vector2.new(0.5, 0), false
make("UISizeConstraint", toast, {MaxSize = Vector2.new(700, 70)})
local toastText = label(toast, "", 13, UDim2.fromOffset(16, 4), UDim2.new(1, -32, 1, -8), C.Text, true)
toastText.TextXAlignment, toastText.TextWrapped = Enum.TextXAlignment.Center, true
showToast = function(text)
	if type(text) ~= "string" then return end
	toastToken += 1
	local token = toastToken
	toastText.Text, toast.Visible = text, true
	task.delay(4, function() if toastToken == token then toast.Visible = false end end)
end

local overlay = make("Frame", root, {Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Ink,
	BackgroundTransparency = 0.2, ZIndex = 50, Active = true})
local modal = panel(overlay, UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.91, 0.87), C.Panel, 51)
modal.AnchorPoint = Vector2.new(0.5, 0.5)
make("UISizeConstraint", modal, {MaxSize = Vector2.new(870, 650)})
make("UIStroke", modal, {Color = C.Line, Thickness = 1})
local modalEyebrow = label(modal, "SHADOW RANGE", 10, UDim2.fromOffset(24, 15), UDim2.new(1, -110, 0, 20), C.Cyan, true)
local modalTitle = label(modal, "FIND YOUR FOCUS", 29, UDim2.fromOffset(22, 37), UDim2.new(1, -109, 0, 42), C.Text, true)
modalTitle.TextTruncate = Enum.TextTruncate.AtEnd
button(modal, "CLOSE", UDim2.new(1, -96, 0, 21), UDim2.fromOffset(72, 33), function() openMenu(nil) end)
local modalDescription = label(modal, "", 12, UDim2.fromOffset(24, 85), UDim2.new(1, -48, 0, 37), C.Muted)
modalDescription.TextWrapped = true
local tabs = make("Frame", modal, {Position = UDim2.fromOffset(24, 127), Size = UDim2.new(1, -48, 0, 35), BackgroundTransparency = 1})
local scroll = make("ScrollingFrame", modal, {Position = UDim2.fromOffset(24, 174), Size = UDim2.new(1, -48, 1, -256),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = C.Cyan,
	CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y})
make("UIListLayout", scroll, {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})
local footer = label(modal, "", 10, UDim2.new(0, 24, 1, -71), UDim2.new(1, -48, 0, 18), C.Muted)
local primary = button(modal, "LOADING PROFILE...", UDim2.new(0, 24, 1, -48), UDim2.new(1, -48, 0, 34), function()
	if not state.Profile.Ready then showToast("Your range profile is still loading."); return end
	if menu == "Welcome" then openMenu("Challenges")
	elseif menu == "Challenges" or menu == "Results" then
		if state.Session.Active then showToast("Finish or leave your current run first."); return end
		actionRemote:FireServer("Start", selectedMode)
		openMenu(nil)
	elseif menu == "Armory" then openMenu("Challenges") end
end, C.Cyan)

local function clearRows()
	for _, child in ipairs(scroll:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
	for _, child in ipairs(tabs:GetChildren()) do child:Destroy() end
end
local function compact()
	return workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X &lt; 650
end
local function row(title, subtitle, badge, color, text, callback, enabled)
	local narrow = compact()
	local card = panel(scroll, UDim2.new(), UDim2.new(1, -6, 0, narrow and 126 or 91), C.Raised, 55)
	local chip = panel(card, UDim2.fromOffset(12, 15), UDim2.fromOffset(48, 57), color, 56)
	local badgeText = label(chip, badge, 18, UDim2.new(), UDim2.fromScale(1, 1), C.Ink, true)
	badgeText.TextXAlignment = Enum.TextXAlignment.Center
	local titleLabel = label(card, title, narrow and 13 or 15, UDim2.fromOffset(74, 11), UDim2.new(1, narrow and -86 or -246, 0, 27), C.Text, true)
	titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
	local description = label(card, subtitle, 11, UDim2.fromOffset(74, 39), UDim2.new(1, narrow and -86 or -246, 0, 34), C.Muted)
	description.TextWrapped = true
	local choose = button(card, text, narrow and UDim2.new(0, 74, 1, -39) or UDim2.new(1, -160, 0, 28),
		UDim2.fromOffset(narrow and 180 or 146, 30), callback, enabled and C.Cyan or nil)
	choose.TextSize = 11
	return card, choose
end
local function armorySignature()
	local p, pieces = state.Profile, {}
	for key, owned in pairs(p.OwnedWeapons or {}) do if owned then table.insert(pieces, "w" .. key) end end
	for key, owned in pairs(p.OwnedSkins or {}) do if owned then table.insert(pieces, "s" .. key) end end
	table.sort(pieces)
	return tostring(p.Credits) .. ":" .. tostring(p.Level) .. ":" .. tostring(p.EquippedWeapon) .. ":" .. tostring(p.EquippedSkin) .. ":" .. armoryTab .. table.concat(pieces)
end
local function renderArmory()
	clearRows()
	modalTitle.Text = "YOUR ARMORY"
	modalDescription.Text = "Unlock a new feel. Every firearm is earned by playing target challenges."
	button(tabs, "FIREARMS", UDim2.new(), UDim2.fromOffset(137, 32), function() armoryTab = "Weapons"; renderMenu() end, armoryTab == "Weapons" and C.Cyan or nil)
	button(tabs, "FINISHES", UDim2.fromOffset(147, 0), UDim2.fromOffset(137, 32), function() armoryTab = "Skins"; renderMenu() end, armoryTab == "Skins" and C.Cyan or nil)
	local p = state.Profile
	for index, item in ipairs(armoryTab == "Weapons" and Config.Weapons or Config.Skins or {}) do
		local owned = (armoryTab == "Weapons" and p.OwnedWeapons or p.OwnedSkins or {})[item.Key] == true
		local equipped = item.Key == (armoryTab == "Weapons" and p.EquippedWeapon or p.EquippedSkin)
		local eligible = (p.Level or 1) &gt;= (item.Level or 1)
		local price = tonumber(item.Cost) or 0
		local status = equipped and "EQUIPPED" or owned and "EQUIP" or not eligible and "LEVEL " .. (item.Level or 1) or fmt(price) .. " CREDITS"
		local subtitle = armoryTab == "Weapons" and (tostring(item.Magazine or 12) .. " rounds / " .. string.format("%.1f", item.Reload or 1.5) .. "s reload / " .. (item.Pellets and item.Pellets &gt; 1 and "wide pattern" or "single projectile")) or "A signature finish for every firearm. Cosmetic only."
		local card = row(item.Name or item.Key, subtitle, armoryTab == "Weapons" and string.format("%02d", index) or "SR", colorOf(item), status, function()
			if equipped then return end
			if state.Session.Active and armoryTab == "Weapons" then showToast("Change your firearm between range sessions."); return end
			if not eligible and not owned then showToast("Reach level " .. (item.Level or 1) .. " to unlock this item."); return end
			local action = armoryTab == "Weapons" and (owned and "EquipWeapon" or "UnlockWeapon") or (owned and "EquipSkin" or "BuySkin")
			actionRemote:FireServer(action, item.Key)
		end, owned or eligible)
		card.LayoutOrder = index
	end
	footer.Text = "Credits come from accuracy, target streaks, completed runs, and daily rewards."
	primary.Text = "BACK TO CHALLENGES"
	lastArmorySignature = armorySignature()
end
local function renderChallenges()
	clearRows()
	modalTitle.Text = "PICK YOUR CHALLENGE"
	modalDescription.Text = "Short runs. Clear goals. One more personal best. Choose your mode, then take a bay."
	label(tabs, "CURRENT FIREARM  /  " .. string.upper(weapon().Name or "Rookie"), 11, UDim2.new(), UDim2.fromScale(1, 1), C.Amber, true)
	for index, challenge in ipairs(Config.Modes or {}) do
		local chosen = challenge.Key == selectedMode
		local card = row(challenge.Name or challenge.Key, (challenge.Description or "Break targets and chase your best score.") .. "  /  " .. (challenge.Duration or 60) .. " SECONDS",
			string.format("%02d", index), chosen and C.Cyan or C.Amber, chosen and "SELECTED" or "CHOOSE", function() selectedMode = challenge.Key; renderMenu() end, chosen)
		card.LayoutOrder = index
	end
	footer.Text = "Aim inside your assigned bay. Lobby and other players are never scoring targets."
	primary.Text = state.Session.Active and "CURRENT RUN IN PROGRESS" or "BEGIN " .. string.upper(mode().Name or selectedMode) .. "  &gt;"
end
local function renderWelcome()
	clearRows()
	modalTitle.Text = "FIND YOUR FOCUS"
	modalDescription.Text = "An arcade range built for that perfect streak. Take a breath. Line it up. Make every shot count."
	label(tabs, "TARGETS ONLY. ENDLESS PERSONAL BESTS.", 11, UDim2.new(), UDim2.fromScale(1, 1), C.Amber, true)
	local controls = UserInputService.TouchEnabled and "Drag to aim / hold FIRE / tap RELOAD. Use the left stick to move." or "MOUSE / FIRE     R / RELOAD     E / CHALLENGES     G / ARMORY     M / SOUND"
	for index, spec in ipairs({
		{"01", "FIND YOUR FLOW", "Choose precision, reflex, or tracking challenges. Each run lasts 45–60 seconds."},
		{"02", "MAKE IT A STREAK", "Hit the center for more points. Keep landing shots to grow your combo."},
		{"03", "BUILD YOUR ARMORY", "Earn credits and XP. Unlock six distinct firearms and signature finishes."},
	}) do
		local card = row(spec[2], spec[3], spec[1], index == 2 and C.Amber or C.Cyan, "", function() end, false)
		card.LayoutOrder = index
		for _, child in ipairs(card:GetChildren()) do if child:IsA("TextButton") then child.Visible = false end end
	end
	footer.Text = controls
	primary.Text = state.Profile.Ready and "EXPLORE THE CHALLENGES  &gt;" or "LOADING RANGE PROFILE..."
end
local function renderResults()
	clearRows()
	local result = state.Session.Results or lastResult or {}
	modalTitle.Text = result.NewBest and "NEW PERSONAL BEST" or result.Completed and "RUN COMPLETE" or "RUN ENDED"
	modalDescription.Text = "Your next great run is one good streak away. Try another firearm or chase the center."
	label(tabs, string.upper(mode().Name or selectedMode) .. "  /  " .. string.upper(weapon().Name or "Rookie"), 11, UDim2.new(), UDim2.fromScale(1, 1), C.Amber, true)
	local specs = {
		{"SCORE", fmt(result.Score), "Your confirmed target score", C.Cyan},
		{"ACCURACY", string.format("%.0f%%", result.Accuracy or 0), tostring(result.Hits or 0) .. " hits / " .. tostring(result.Shots or 0) .. " shots", C.Amber},
		{"BEST STREAK", tostring(result.BestCombo or 0) .. " HITS", "+" .. fmt(result.Credits) .. " credits / +" .. fmt(result.XP) .. " XP", C.Cyan},
	}
	for index, spec in ipairs(specs) do
		local card = row(spec[1] .. "  /  " .. spec[2], spec[3], "SR", spec[4], "", function() end, false)
		card.LayoutOrder = index
		for _, child in ipairs(card:GetChildren()) do if child:IsA("TextButton") then child.Visible = false end end
	end
	footer.Text = result.RewardFailed and "Saving is unavailable. This run's reward could not be granted." or (result.RewardPending or result.Pending) and "Your range reward is being processed..." or "Change modes or visit the armory to try a different feel."
	primary.Text = "RUN IT AGAIN  &gt;"
end
renderMenu = function()
	if menu == "Welcome" then renderWelcome()
	elseif menu == "Challenges" then renderChallenges()
	elseif menu == "Armory" then renderArmory()
	elseif menu == "Results" then renderResults() end
end
updateCameraMode = function()
	local wantFirstPerson = state.Session.Active == true and menu == nil and focusActive
	if wantFirstPerson and not firstPerson then
		player.CameraMinZoomDistance = oldMinZoom
		player.CameraMaxZoomDistance = oldMaxZoom
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		firstPerson = true
	elseif not wantFirstPerson then
		player.CameraMode = oldCameraMode or Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = math.max(10, oldMaxZoom or 30)
		-- An open menu needs actual third-person zoom, otherwise the default
		-- camera controller can keep recapturing the cursor at head distance.
		player.CameraMinZoomDistance = menu ~= nil and 8 or (oldMinZoom or 0.5)
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		firstPerson = false
	end
	UserInputService.MouseIconEnabled = not wantFirstPerson
	if menu ~= nil then UserInputService.MouseBehavior = Enum.MouseBehavior.Default end
end
openMenu = function(nextMenu)
	menu, fireHeld = nextMenu, false
	overlay.Visible = nextMenu ~= nil
	if nextMenu then
		renderMenu()
		if UserInputService:GetLastInputType() == Enum.UserInputType.Gamepad1 then GuiService.SelectedObject = primary end
	else GuiService.SelectedObject = nil end
	updateCameraMode()
end

local touch = make("Frame", root, {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false})
local fireButton = button(touch, "FIRE", UDim2.new(1, -125, 1, -125), UDim2.fromOffset(91, 91), function() end, C.Amber)
corner(fireButton, 48)
button(touch, "RELOAD", UDim2.new(1, -149, 1, -172), UDim2.fromOffset(121, 36), function() actionRemote:FireServer("Reload") end)
local fireTouch
table.insert(connections, fireButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then fireHeld, fireTouch = true, input end
end))
table.insert(connections, fireButton.InputEnded:Connect(function(input)
	if input == fireTouch then fireHeld, fireTouch = false, nil end
end))

local function layout()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local size = camera.ViewportSize
	local narrow, short = size.X &lt; 850, size.Y &lt; 500
	brand.Size = UDim2.fromOffset(narrow and 153 or 184, short and 52 or 65)
	wallet.Position = UDim2.new(1, narrow and -191 or -236, 0, 14)
	wallet.Size = UDim2.fromOffset(narrow and 175 or 220, short and 52 or 65)
	creditLabel.TextSize = narrow and 15 or 18
	levelLabel.Position = UDim2.fromOffset(13, short and 28 or 37)
	runCard.Position = narrow and UDim2.new(0.5, 0, 0, short and 73 or 93) or UDim2.new(0.5, 0, 0, 14)
	runCard.AnchorPoint = Vector2.new(0.5, 0)
	runCard.Size = UDim2.new(narrow and 0.82 or 0, narrow and 0 or 292, 0, short and 46 or narrow and 52 or 65)
	runDetail.Position = UDim2.fromOffset(14, short and 25 or narrow and 28 or 36)
	scoreCard.Position = UDim2.fromOffset(16, narrow and (short and 129 or 160) or 97)
	scoreCard.Size = UDim2.fromOffset(narrow and 151 or 184, short and 104 or 142)
	scoreLabel.TextSize = short and 27 or 34
	comboLabel.Position, accuracyLabel.Visible = UDim2.fromOffset(13, short and 74 or 79), not short
	ammoCard.Position = UDim2.new(1, -216, 1, UserInputService.TouchEnabled and -307 or -139)
	ammoCard.Size = UDim2.fromOffset(200, UserInputService.TouchEnabled and 108 or 123)
	reloadLabel.Position = UDim2.fromOffset(14, UserInputService.TouchEnabled and 79 or 87)
	navigation.Position = UDim2.new(0, 16, 1, UserInputService.TouchEnabled and -160 or -107)
	navigation.Size = UDim2.fromOffset(308, 91)
	if size.X &lt; 520 then
		chooseButton.Size, armoryButton.Size, dailyButton.Size, leaveButton.Size = UDim2.fromOffset(127, 34), UDim2.fromOffset(105, 34), UDim2.fromOffset(127, 31), UDim2.fromOffset(105, 31)
		armoryButton.Position, leaveButton.Position = UDim2.fromOffset(136, 0), UDim2.fromOffset(136, 43)
		dailyButton.Position = UDim2.fromOffset(0, 43)
		chooseButton.Text, armoryButton.Text, dailyButton.Text, leaveButton.Text = "CHALLENGES", "ARMORY", "DAILY", "LEAVE BAY"
	else
		chooseButton.Text = UserInputService.TouchEnabled and "CHALLENGES" or "CHALLENGES [E]"
		armoryButton.Text = UserInputService.TouchEnabled and "ARMORY" or "ARMORY [G]"
		dailyButton.Text = state.Profile.DailyReady and "DAILY REWARD +" or "DAILY REWARD"
		leaveButton.Text = UserInputService.TouchEnabled and "LEAVE BAY" or "LEAVE BAY [Q]"
	end
	if UserInputService.TouchEnabled then
		-- Leave the bottom-left area to Roblox's native movement thumbstick.
		navigation.Position = UDim2.fromOffset(16, short and 73 or 92)
		navigation.Visible = not state.Session.Active
		scoreCard.Visible = not short or not state.Session.Active
	else navigation.Visible, scoreCard.Visible = true, true end
	rangeStatus.Visible = not narrow and not state.Session.Active
	modalTitle.TextSize = narrow and 22 or 29
	modal.Size = UDim2.fromScale(0.93, short and 0.96 or 0.87)
	modalEyebrow.Visible = not short
	modalTitle.Position = UDim2.fromOffset(22, short and 10 or 37)
	modalDescription.Position = UDim2.fromOffset(24, short and 52 or 85)
	modalDescription.TextSize = short and 10 or 12
	tabs.Position = UDim2.fromOffset(24, short and 92 or 127)
	scroll.Position = UDim2.fromOffset(24, short and 136 or 174)
	scroll.Size = UDim2.new(1, -48, 1, short and -218 or -256)
	toast.Size = UDim2.new(narrow and 0.92 or 0.65, 0, 0, 48)
	toast.Position = UDim2.new(0.5, 0, 0, narrow and 151 or 94)
	if menu then renderMenu() end
end

local function resultSignature(result)
	if not result then return "" end
	return tostring(result.Score) .. ":" .. tostring(result.Hits) .. ":" .. tostring(result.Shots)
		.. ":" .. tostring(result.BestCombo) .. ":" .. tostring(result.Credits) .. ":" .. tostring(result.XP)
		.. ":" .. tostring(result.RewardPending or result.Pending) .. ":" .. tostring(result.RewardFailed)
		.. ":" .. tostring(result.NewBest) .. ":" .. tostring(result.Completed) .. ":" .. tostring(result.Accuracy)
end
local function updateState(payload)
	if type(payload) ~= "table" then return end
	local wasActive = state.Session.Active
	state.Profile, state.Session = payload.Profile or state.Profile, payload.Session or state.Session
	connected = true
	local p, s, w = state.Profile, state.Session, weapon()
	creditLabel.Text = fmt(p.Credits) .. " CREDITS"
	levelLabel.Text = "LEVEL " .. fmt(p.Level or 1) .. " / " .. fmt(p.XP) .. " XP"
	runLabel.Text = s.Active and string.upper((find(Config.Modes, s.Mode) or {}).Name or s.Mode or "RANGE") .. " / " .. math.ceil(s.Remaining or 0) .. "s" or "RANGE IS READY"
	runLabel.TextColor3 = s.Active and (s.Remaining or 60) &lt; 10 and C.Amber or C.Cyan
	runDetail.Text = s.Active and ("BAY " .. string.format("%02d", s.Bay or 1) .. " / " .. (s.CanFire and "FOCUS DOWNRANGE" or "STEP INSIDE THE MARKED FIRING BAY")) or ("PERSONAL BEST " .. fmt(p.BestScore) .. " / TARGETS ONLY")
	scoreLabel.Text = string.format("%04d", s.Score or 0)
	comboLabel.Text = (s.Combo or 0) &gt; 1 and (tostring(s.Combo) .. " HIT STREAK") or "BUILD YOUR STREAK"
	accuracyLabel.Text = "ACCURACY " .. string.format("%.0f%%", s.Accuracy or 0)
	weaponLabel.Text = string.upper(w.Name or w.Key)
	ammoLabel.Text = tostring(s.Ammo or w.Magazine or 0) .. " / " .. tostring(s.Magazine or w.Magazine or 0)
	reloadLabel.Text = s.Reloading and ("RELOADING  " .. string.format("%.1fs", s.ReloadRemaining or 0)) or (s.Active and not s.CanFire and "RETURN TO YOUR FIRING BAY" or "R / X  RELOAD")
	reloadLabel.TextColor3 = s.Reloading and C.Amber or C.Muted
	dailyButton.TextColor3 = p.DailyReady and C.Amber or C.Text
	leaveButton.Visible = s.Active == true
	if s.Active then selectedMode = s.Mode or selectedMode end
	if wasActive and not s.Active then
		fireHeld = false
		if s.Results then lastResult, lastResultSignature = s.Results, resultSignature(s.Results); openMenu("Results") end
	end
	if s.Active ~= wasActive then layout() end
	if menu == "Welcome" then primary.Text = p.Ready and "EXPLORE THE CHALLENGES  &gt;" or "LOADING RANGE PROFILE..."
	elseif menu == "Armory" and armorySignature() ~= lastArmorySignature then renderMenu()
	elseif menu == "Results" and s.Results and resultSignature(s.Results) ~= lastResultSignature then
		lastResult, lastResultSignature = s.Results, resultSignature(s.Results)
		renderMenu()
	end
	updateCameraMode()
end
table.insert(connections, stateRemote.OnClientEvent:Connect(updateState))
table.insert(connections, notifyRemote.OnClientEvent:Connect(showToast))

local function tracer(origin, target, color)
	if typeof(origin) ~= "Vector3" or typeof(target) ~= "Vector3" then return end
	local distance = (target - origin).Magnitude
	if distance &lt; 0.01 or distance &gt; 400 then return end
	local beam = make("Part", workspace, {Name = "RangeTracerLocal", Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		Material = Enum.Material.Neon, Color = color, Size = Vector3.new(0.055, 0.055, distance),
		CFrame = CFrame.lookAt((origin + target) * 0.5, target), Transparency = 0.15})
	Debris:AddItem(beam, 0.075)
end
table.insert(connections, feedbackRemote.OnClientEvent:Connect(function(event)
	if type(event) ~= "table" then return end
	if event.Origin and event.Position then tracer(event.Origin, event.Position, event.Perfect and C.Amber or C.Cyan) end
	local own = event.ShooterUserId == nil or event.ShooterUserId == player.UserId
	if not own then return end
	if event.Ammo ~= nil then state.Session.Ammo = event.Ammo end
	if event.Kind == "Shot" then
		kick = math.min(kick + 0.45, 2)
		playFeedback(shotSound)
	elseif event.Kind == "Hit" then
		playFeedback(hitSound, event.Perfect and 2.1 or 1.6)
		hitUntil, hitPerfect = os.clock() + 0.22, event.Perfect == true
		hitText.Text = (event.Perfect and "BULLSEYE  " or "HIT  ") .. "+" .. tostring(event.Score or 0)
		hitText.TextColor3 = event.Perfect and C.Amber or C.Cyan
		kick = math.min(kick + 0.4, 2)
	elseif event.Kind == "Miss" then hitText.Text = "RESET. REFOCUS."; hitText.TextColor3 = C.Muted; hitUntil = os.clock() + 0.35
	end
end))

local function reload()
	if state.Session.Active and menu == nil then actionRemote:FireServer("Reload") end
end
table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
	if UserInputService:GetFocusedTextBox() then return end
	local key = input.KeyCode
	if key == Enum.KeyCode.ButtonB and menu then openMenu(nil); return end
	if processed then return end
	if key == Enum.KeyCode.M then
		muted = not muted
		if muted then shotSound:Stop(); hitSound:Stop() end
		showToast(muted and "Range audio muted. Press M to restore." or "Range audio on. Press M to mute.")
		return
	end
	if menu then
		if key == Enum.KeyCode.Escape then openMenu(nil) end
		return
	end
	if key == Enum.KeyCode.G or key == Enum.KeyCode.ButtonL1 then openMenu("Armory")
	elseif key == Enum.KeyCode.E or key == Enum.KeyCode.ButtonY then openMenu("Challenges")
	elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.DPadDown then actionRemote:FireServer("Leave")
	elseif key == Enum.KeyCode.R or key == Enum.KeyCode.ButtonX then reload()
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 or key == Enum.KeyCode.ButtonR2 then fireHeld = true end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 or input == fireTouch then fireHeld, fireTouch = false, nil end
end))
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.ButtonR2 then fireHeld = input.Position.Z &gt; 0.3 end
end))
table.insert(connections, UserInputService.WindowFocusReleased:Connect(function() focusActive, fireHeld = false, false; updateCameraMode() end))
table.insert(connections, UserInputService.WindowFocused:Connect(function() focusActive = true; updateCameraMode() end))

table.insert(connections, RunService.RenderStepped:Connect(function(dt)
	local camera = workspace.CurrentCamera
	if not camera then return end
	if camera.ViewportSize ~= lastViewport then lastViewport = camera.ViewportSize; layout() end
	local s, now = state.Session, os.clock()
	local blocked = menu ~= nil or not focusActive or UserInputService:GetFocusedTextBox() ~= nil
	local canAim = s.Active == true and not blocked
	crosshair.Visible = canAim
	touch.Visible = UserInputService.TouchEnabled and canAim
	if fireHeld and canAim and s.CanFire and not s.Reloading and (s.Ammo or 0) &gt; 0 and now &gt;= fireAt then
		local w = weapon()
		fireAt = now + math.max(0.06, w.Interval or 0.2)
		local viewport = camera.ViewportSize
		local aim = camera:ViewportPointToRay(viewport.X * 0.5, viewport.Y * 0.5)
		shotRemote:FireServer(aim.Direction.Unit)
		kick = math.min(kick + 0.25, 1.8)
	elseif fireHeld and canAim and s.CanFire and not s.Reloading and s.Ammo == 0 and now &gt;= reloadRequestAt then
		reloadRequestAt = now + 1
		actionRemote:FireServer("Reload")
	end
	hitMarker.Visible = hitUntil &gt; now and canAim and hitText.Text ~= "RESET. REFOCUS."
	hitMarker.TextColor3 = hitPerfect and C.Amber or C.Cyan
	hitText.Visible = canAim and hitUntil + 0.45 &gt; now
	if canAim and kick &gt; 0.001 then
		camera.CFrame *= CFrame.Angles(math.rad(kick * math.min(dt * 14, 0.2)), 0, 0)
	end
	kick *= math.exp(-dt * 15)
	local touchGui = player.PlayerGui:FindFirstChild("TouchGui")
	local jump = touchGui and touchGui:FindFirstChild("JumpButton", true)
	if jump and jump:IsA("GuiObject") then jump.Visible = not s.Active end
end))

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)
layout()
openMenu("Welcome")
actionRemote:FireServer("Ready")
task.delay(12, function()
	if not connected then showToast("Range server is still loading. Check Studio Output if this continues.") end
end)
table.insert(connections, script.Destroying:Connect(function()
	state.Session.Active, menu = false, nil
	updateCameraMode()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	shotSound:Destroy()
	hitSound:Destroy()
	gui:Destroy()
end))
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX00000245">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="SoundService" referent="RBX00000246">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
</roblox>