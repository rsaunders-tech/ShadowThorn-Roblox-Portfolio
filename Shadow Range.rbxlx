["Shape"] = "Block", ["Light"] = 0.9, ["LightRange"] = 22}, {["Name"] = "Plant Pot", ["Size"] = {4, 4, 4}, ["Position"] = {-100, 4, 40}, ["Rotation"] = {0, 0, 0}, ["Color"] = {89, 106, 127}, ["Material"] = "Concrete", ["Group"] = "Lobby", ["Collide"] = true, ["Shape"] = "Block"}, {["Name"] = "Plant Crown", ["Size"] = {5, 6, 5}, ["Position"] = {-100, 8.5, 40}, ["Rotation"] = {0, 0, 0}, ["Color"] = {80, 126, 117}, ["Material"] = "SmoothPlastic", ["Group"] = "Decor", ["Collide"] = false, ["Shape"] = "Ball"}, {["Name"] = "Plant Pot", ["Size"] = {4, 4, 4}, ["Position"] = {-100, 4, 111}, ["Rotation"] = {0, 0, 0}, ["Color"] = {89, 106, 127}, ["Material"] = "Concrete", ["Group"] = "Lobby", ["Collide"] = true, ["Shape"] = "Block"}, {["Name"] = "Plant Crown", ["Size"] = {5, 6, 5}, ["Position"] = {-100, 8.5, 111}, ["Rotation"] = {0, 0, 0}, ["Color"] = {80, 126, 117}, ["Material"] = "SmoothPlastic", ["Group"] = "Decor", ["Collide"] = false, ["Shape"] = "Ball"}, {["Name"] = "Plant Pot", ["Size"] = {4, 4, 4}, ["Position"] = {100, 4, 40}, ["Rotation"] = {0, 0, 0}, ["Color"] = {89, 106, 127}, ["Material"] = "Concrete", ["Group"] = "Lobby", ["Collide"] = true, ["Shape"] = "Block"}, {["Name"] = "Plant Crown", ["Size"] = {5, 6, 5}, ["Position"] = {100, 8.5, 40}, ["Rotation"] = {0, 0, 0}, ["Color"] = {80, 126, 117}, ["Material"] = "SmoothPlastic", ["Group"] = "Decor", ["Collide"] = false, ["Shape"] = "Ball"}, {["Name"] = "Plant Pot", ["Size"] = {4, 4, 4}, ["Position"] = {100, 4, 111}, ["Rotation"] = {0, 0, 0}, ["Color"] = {89, 106, 127}, ["Material"] = "Concrete", ["Group"] = "Lobby", ["Collide"] = true, ["Shape"] = "Block"}, {["Name"] = "Plant Crown", ["Size"] = {5, 6, 5}, ["Position"] = {100, 8.5, 111}, ["Rotation"] = {0, 0, 0}, ["Color"] = {80, 126, 117}, ["Material"] = "SmoothPlastic", ["Group"] = "Decor", ["Collide"] = false, ["Shape"] = "Ball"}}}
