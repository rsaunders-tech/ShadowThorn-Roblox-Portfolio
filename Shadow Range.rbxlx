    <Item class="Folder" referent="RBX00000235">
      <Properties>
        <string name="Name">ShadowRange</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX00000236">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Earn every firearm and finish through range sessions. No paid power or purchases.
return {
	Title = "Shadow Range",
	DataStoreName = "ShadowRange_Player_v1",
	StudioPersistence = false,
	XPPerLevel = 250,
	StartingCredits = 0,
	DailyCredits = 200,
	DailyXP = 50,
	Weapons = {
		{Key = "Rookie", Name = "Rookie Sidearm", Class = "Sidearm", Cost = 0, Level = 1, Magazine = 12, Reload = 1.25, Interval = 0.26, Pellets = 1, Spread = 0.25, Color = {94, 111, 133}, Description = "Precise, steady, and ready from your first session."},
		{Key = "Viper", Name = "Viper SMG", Class = "SMG", Cost = 500, Level = 2, Magazine = 30, Reload = 1.65, Interval = 0.09, Pellets = 1, Spread = 1.2, Color = {68, 219, 197}, Description = "Rapid strings for moving targets. Manage the wider spread."},
		{Key = "Ranger", Name = "Ranger Carbine", Class = "Carbine", Cost = 900, Level = 3, Magazine = 24, Reload = 1.8, Interval = 0.15, Pellets = 1, Spread = 0.45, Color = {255, 190, 82}, Description = "A flexible balance of precision, capacity, and pace."},
		{Key = "Thunder", Name = "Thunder Shotgun", Class = "Shotgun", Cost = 1500, Level = 4, Magazine = 6, Reload = 2.1, Interval = 0.8, Pellets = 6, Spread = 3.3, Color = {238, 111, 92}, Description = "Six arcade pellets per shot. Make every trigger pull count."},
		{Key = "Sentinel", Name = "Sentinel Marksman", Class = "Marksman", Cost = 2200, Level = 6, Magazine = 8, Reload = 1.8, Interval = 0.65, Pellets = 1, Spread = 0.05, Color = {150, 148, 255}, Description = "A calm rhythm and a tight grouping for distant bullseyes."},
		{Key = "Nova", Name = "Nova Pulse Rifle", Class = "Pulse", Cost = 3500, Level = 8, Magazine = 20, Reload = 1.5, Interval = 0.18, Pellets = 1, Spread = 0.18, Color = {106, 224, 255}, Description = "A signature futuristic look with crisp, controlled handling."},
	},
