      <Item class="ModuleScript" referent="RBX00000238">
        <Properties>
          <string name="Name">RangeRules</string>
          <ProtectedString name="Source">-- Pure, testable target-challenge rules. Clients never report their own hits.
local Rules = {}
function Rules.finite(n)
	return type(n) == "number" and n == n and math.abs(n) &lt; math.huge
end
function Rules.vector(v)
	return type(v) == "table" and Rules.finite(v[1]) and Rules.finite(v[2]) and Rules.finite(v[3])
end
function Rules.inBay(position, bay)
	if not Rules.vector(position) or not bay then return false end
	for i = 1, 3 do if position[i] &lt; bay.Min[i] or position[i] &gt; bay.Max[i] then return false end end
	return true
end
function Rules.direction(direction)
	if not Rules.vector(direction) then return false end
	local magnitude = math.sqrt(direction[1]^2 + direction[2]^2 + direction[3]^2)
	return magnitude &gt;= 0.98 and magnitude &lt;= 1.02 and direction[3] &lt; -0.15
end
function Rules.newSession(weapon, now, duration, mode)
	return {Active = true, Mode = mode, Started = now, Ends = now + duration,
		Score = 0, Hits = 0, Shots = 0, Combo = 0, BestCombo = 0, Perfects = 0,
		Ammo = weapon.Magazine, ReloadUntil = 0, LastShot = -math.huge}
end
function Rules.finishReload(session, weapon, now)
	if session.ReloadUntil &gt; 0 and now &gt;= session.ReloadUntil then
		session.Ammo, session.ReloadUntil = weapon.Magazine, 0
		return true
	end
	return false
end
function Rules.reload(session, weapon, now)
	if not session.Active or now &gt;= session.Ends or session.ReloadUntil &gt; 0 or session.Ammo &gt;= weapon.Magazine then return false end
	session.ReloadUntil = now + weapon.Reload
	return true
end
function Rules.canShoot(session, weapon, position, bay, direction, now)
	if not session or not session.Active or now &gt;= session.Ends then return false, "Start a target challenge first." end
	if not Rules.inBay(position, bay) then return false, "Stand inside your marked firing bay." end
	if not Rules.direction(direction) then return false, "Aim downrange at the targets." end
	if session.ReloadUntil &gt; 0 then return false, "Reloading..." end
	if session.Ammo &lt;= 0 then return false, "Reload your firearm." end
	if now - session.LastShot + 0.001 &lt; weapon.Interval then return false, "Wait for the next shot." end
	return true
end
function Rules.takeShot(session, now)
	session.LastShot, session.Ammo, session.Shots = now, session.Ammo - 1, session.Shots + 1
end
function Rules.hit(session, ratio, far)
	if not Rules.finite(ratio) or ratio &lt; 0 or ratio &gt; 1 then
		session.Combo = 0
		return 0, false
	end
	local perfect = ratio &lt;= 0.22
	local base = if perfect then 50 elseif ratio &lt;= 0.55 then 30 elseif ratio &lt;= 0.85 then 15 else 10
	session.Hits += 1
	session.Combo += 1
	session.BestCombo = math.max(session.BestCombo, session.Combo)
	if perfect then session.Perfects += 1 end
	local score = math.floor(base * (1 + math.min(20, session.Combo - 1) * 0.06) * (if far then 1.25 else 1))
	session.Score += score
	return score, perfect
end
function Rules.accuracy(session)
	return if session.Shots &gt; 0 then math.floor(session.Hits / session.Shots * 1000) / 10 else 0
end
function Rules.summary(session, completed)
	return {Score = session.Score, Hits = session.Hits, Shots = session.Shots, BestCombo = session.BestCombo,
		Perfects = session.Perfects, Mode = session.Mode, Accuracy = Rules.accuracy(session), Completed = completed == true}
end
return Rules
</ProtectedString>
        </Properties>
      </Item>
