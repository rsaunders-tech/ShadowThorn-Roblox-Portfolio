			</Properties>
			<Item class="LocalScript" referent="RBX00000490">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Presentation and input only. Treasure rolls, progression and currency belong to the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("TreasureTide", 30)
assert(shared, "Treasure Tide game files are missing")
local Config = require(shared:WaitForChild("Config"))
local action = shared:WaitForChild("Action")
local stateRemote = shared:WaitForChild("State")
local colors = {
	Navy=Color3.fromRGB(20,43,55), NavyLight=Color3.fromRGB(33,62,74), Cream=Color3.fromRGB(255,247,224),
	Muted=Color3.fromRGB(184,207,203), Teal=Color3.fromRGB(63,210,187), Gold=Color3.fromRGB(255,202,95),
	Coral=Color3.fromRGB(246,132,107), White=Color3.fromRGB(255,255,249), Border=Color3.fromRGB(78,112,117),
}
local connections, modalConnections = {}, {}
local alive, currentPanel, selectedPatch, held, holdInput = true, nil, nil, false, nil
local state = nil
local stateReceivedAt = 0
local panelRevision = ""
local localHitAt, lastDig, lastError = 0, 0, 0
local treasureById, zoneById, patches, patchColors = {}, {}, {}, {}
for _, treasure in ipairs(Config.Treasures) do treasureById[treasure.Id] = treasure end
for _, zone in ipairs(Config.Zones) do zoneById[zone.Id] = zone end

local function connect(signal, callback, list)
	local connection = signal:Connect(callback)
	table.insert(list or connections, connection)
	return connection
end
local function make(kind, parent, properties)
	local object = Instance.new(kind)
	for key, value in pairs(properties or {}) do object[key] = value end
	object.Parent = parent
	return object
end
local function round(object, radius)
	make("UICorner", object, {CornerRadius=UDim.new(0,radius or 14)})
end
local function outline(object, color, thickness)
	make("UIStroke", object, {Color=color or colors.Border, Thickness=thickness or 1, Transparency=.25})
end
local function frame(parent, size, position, color, radius)
	local result=make("Frame",parent,{Size=size,Position=position or UDim2.new(),BackgroundColor3=color or colors.Navy,BorderSizePixel=0})
	round(result,radius)
	return result
end
local function text(parent, value, size, pos, fontSize, color, bold)
	return make("TextLabel",parent,{Size=size,Position=pos or UDim2.new(),BackgroundTransparency=1,
		Text=value,TextColor3=color or colors.Cream,Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextSize=fontSize or 16,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,
		TextWrapped=true,BorderSizePixel=0})
end
local function button(parent,value,size,pos,color,callback,list)
	local result=make("TextButton",parent,{Size=size,Position=pos or UDim2.new(),Text=value,TextSize=16,
		Font=Enum.Font.GothamBold,BackgroundColor3=color or colors.Teal,TextColor3=colors.Navy,
		BorderSizePixel=0,AutoButtonColor=true,Selectable=true})
	round(result,12)
	if callback then connect(result.Activated,callback,list) end
	return result
end
local function rgb(array)
	return array and Color3.fromRGB(array[1],array[2],array[3]) or colors.Gold
end
local function number(value)
	local n=math.floor(tonumber(value) or 0)
	if n>=1000000 then return string.format("%.1fm",n/1000000) end
	if n>=10000 then return string.format("%.1fk",n/1000) end
	return tostring(n)
end
local function discovered()
	local total=0
	if state then for _,count in pairs(state.Profile.Collection or {}) do if count>0 then total+=1 end end end
	return total
end
local function send(kind,payload)
	if not state and kind~="Sync" then return end
	action:FireServer(kind,payload)
end

local gui=make("ScreenGui",player:WaitForChild("PlayerGui"),{Name="TreasureTideUI",ResetOnSpawn=false,
	IgnoreGuiInset=false,DisplayOrder=12,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
local canvas=make("Frame",gui,{Name="Canvas",Size=UDim2.fromScale(1,1),BackgroundTransparency=1})
local uiScale=make("UIScale",canvas,{Scale=1})
local header=frame(canvas,UDim2.fromOffset(274,64),UDim2.fromOffset(22,18))
outline(header)
text(header,"TREASURE TIDE",UDim2.new(1,-26,0,28),UDim2.fromOffset(14,7),21,colors.Gold,true)
local subtitle=text(header,"Your next great find is waiting",UDim2.new(1,-26,0,20),UDim2.fromOffset(14,35),12,colors.Muted)
local stats=frame(canvas,UDim2.fromOffset(410,64),UDim2.new(.5,0,0,18))
stats.AnchorPoint=Vector2.new(.5,0)
outline(stats)
local coins=text(stats,"0",UDim2.fromOffset(125,29),UDim2.fromOffset(18,5),23,colors.Gold,true)
text(stats,"COINS",UDim2.fromOffset(100,18),UDim2.fromOffset(18,36),11,colors.Muted,true)
local bag=text(stats,"0 / 10",UDim2.fromOffset(125,29),UDim2.fromOffset(154,5),23,colors.Cream,true)
text(stats,"TREASURES IN BAG",UDim2.fromOffset(130,18),UDim2.fromOffset(154,36),11,colors.Muted,true)
local finds=text(stats,"0",UDim2.fromOffset(100,29),UDim2.fromOffset(308,5),23,colors.Teal,true)
text(stats,"FINDS",UDim2.fromOffset(90,18),UDim2.fromOffset(308,36),11,colors.Muted,true)
local nav=frame(canvas,UDim2.fromOffset(300,64),UDim2.new(1,-322,0,18))
outline(nav)
local openPanel
for i,entry in ipairs({{"Shop","U"},{"Journal","J"},{"Atlas","M"}}) do
	button(nav,entry[1].."\n["..entry[2].."]",UDim2.fromOffset(88,48),UDim2.fromOffset(10+(i-1)*96,8),colors.NavyLight,function() openPanel(entry[1]) end).TextColor3=colors.Cream
end

local questCard=frame(canvas,UDim2.fromOffset(286,164),UDim2.fromOffset(22,100))
outline(questCard)
text(questCard,"YOUR NEXT ADVENTURE",UDim2.new(1,-28,0,22),UDim2.fromOffset(14,11),11,colors.Teal,true)
local questTitle=text(questCard,"Find your first treasure",UDim2.new(1,-28,0,24),UDim2.fromOffset(14,35),18,nil,true)
local questDetail=text(questCard,"Walk onto a marked sand patch. Hold E or DIG to uncover a surprise!",UDim2.new(1,-28,0,43),UDim2.fromOffset(14,64),13,colors.Muted)
local questTrack=frame(questCard,UDim2.new(1,-28,0,5),UDim2.fromOffset(14,114),colors.NavyLight,4)
local questFill=frame(questTrack,UDim2.fromScale(0,1),nil,colors.Teal,4)
local questProgress=text(questCard,"0 / 1",UDim2.fromOffset(108,22),UDim2.fromOffset(14,128),12,colors.Muted,true)
local claim=button(questCard,"CLAIM +50",UDim2.fromOffset(133,30),UDim2.new(1,-147,0,126),colors.Gold,function() send("ClaimQuest") end)
claim.Visible=false
local zoneBadge=frame(canvas,UDim2.fromOffset(270,43),UDim2.new(.5,0,0,96),colors.Navy,20)
zoneBadge.AnchorPoint=Vector2.new(.5,0)
outline(zoneBadge)
local zoneLabel=text(zoneBadge,"SUNNY SANDS",UDim2.new(1,-16,1,0),UDim2.fromOffset(8,0),14,colors.Cream,true)
zoneLabel.TextXAlignment=Enum.TextXAlignment.Center
local tide=text(canvas,"Golden Tide arrives soon",UDim2.fromOffset(320,24),UDim2.new(.5,-160,0,147),13,colors.Gold,true)
tide.TextXAlignment=Enum.TextXAlignment.Center
local save=text(canvas,"Connecting to your adventure...",UDim2.fromOffset(390,20),UDim2.fromOffset(24,0),11,colors.Muted)
save.AnchorPoint=Vector2.new(0,1)
save.Position=UDim2.new(0,24,1,-8)

local digDock=frame(canvas,UDim2.fromOffset(324,154),UDim2.new(.5,0,1,-26),colors.Navy,20)
digDock.AnchorPoint=Vector2.new(.5,1)
outline(digDock)
local targetLabel=text(digDock,"Follow the DIG HERE signs",UDim2.new(1,-24,0,25),UDim2.fromOffset(12,9),14,colors.Cream,true)
targetLabel.TextXAlignment=Enum.TextXAlignment.Center
local targetTrack=frame(digDock,UDim2.new(1,-32,0,7),UDim2.fromOffset(16,38),colors.NavyLight,4)
local targetFill=frame(targetTrack,UDim2.fromScale(0,1),nil,colors.Gold,4)
local digButton=button(digDock,"HOLD TO DIG  [E]",UDim2.fromOffset(190,62),UDim2.fromOffset(13,58),colors.Gold)
local sellButton=button(digDock,"SELL\n[B]",UDim2.fromOffset(95,62),UDim2.fromOffset(216,58),colors.Teal,function() held=false; send("Sell") end)
local bagValue=text(digDock,"Your treasures are waiting",UDim2.new(1,-22,0,20),UDim2.fromOffset(11,126),12,colors.Muted)
bagValue.TextXAlignment=Enum.TextXAlignment.Center

local toast=frame(canvas,UDim2.fromOffset(450,74),UDim2.new(.5,0,0,194),colors.Navy,16)
toast.AnchorPoint=Vector2.new(.5,0)
toast.Visible=false
outline(toast,colors.Gold,2)
local toastTitle=text(toast,"A new adventure begins",UDim2.new(1,-30,0,27),UDim2.fromOffset(15,10),19,colors.Gold,true)
toastTitle.TextXAlignment=Enum.TextXAlignment.Center
local toastDetail=text(toast,"",UDim2.new(1,-30,0,24),UDim2.fromOffset(15,40),13,colors.Cream)
toastDetail.TextXAlignment=Enum.TextXAlignment.Center
local toastSerial=0
local function notify(title,detail,color)
	toastSerial+=1
	local serial=toastSerial
	toastTitle.Text=title
	toastTitle.TextColor3=color or colors.Gold
	toastDetail.Text=detail or ""
	toast.Visible=true
	toast.BackgroundTransparency=.12
	toast.Size=UDim2.fromOffset(toast.Size.X.Offset,66)
	TweenService:Create(toast,TweenInfo.new(.18,Enum.EasingStyle.Back),{Size=UDim2.fromOffset(toast.Size.X.Offset,74)}):Play()
	task.delay(3.5,function() if alive and serial==toastSerial then toast.Visible=false end end)
end

local shade=make("TextButton",canvas,{Name="ModalShade",Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(),
	BackgroundTransparency=.3,Text="",AutoButtonColor=false,Visible=false,ZIndex=20})
local panel=frame(shade,UDim2.fromOffset(640,550),UDim2.fromScale(.5,.5),colors.Cream,22)
panel.AnchorPoint=Vector2.new(.5,.5)
panel.ZIndex=21
local panelTitle=text(panel,"Your collection",UDim2.new(1,-90,0,36),UDim2.fromOffset(24,17),25,colors.Navy,true)
local panelHint=text(panel,"",UDim2.new(1,-48,0,32),UDim2.fromOffset(24,59),13,colors.NavyLight)
local panelClose=button(panel,"X",UDim2.fromOffset(44,44),UDim2.new(1,-61,0,16),colors.NavyLight,function() openPanel(nil) end)
panelClose.TextColor3=colors.Cream
local scroll=make("ScrollingFrame",panel,{Name="Content",Position=UDim2.fromOffset(18,102),Size=UDim2.new(1,-36,1,-120),
	BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,ScrollBarImageColor3=colors.NavyLight,
	CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ZIndex=22})
local list=make("UIListLayout",scroll,{Padding=UDim.new(0,12),SortOrder=Enum.SortOrder.LayoutOrder})
make("UIPadding",scroll,{PaddingTop=UDim.new(0,2),PaddingLeft=UDim.new(0,5),PaddingRight=UDim.new(0,5),PaddingBottom=UDim.new(0,8)})
local function setLayer(object,z)
	for _,child in ipairs(object:GetDescendants()) do if child:IsA("GuiObject") then child.ZIndex=z end end
end
local function clearPanel()
	for _,connection in ipairs(modalConnections) do connection:Disconnect() end
	table.clear(modalConnections)
	for _,child in ipairs(scroll:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
end
local function section(title,detail)
	local row=frame(scroll,UDim2.new(1,-10,0,61),nil,colors.Cream,8)
	text(row,title,UDim2.new(1,-14,0,26),UDim2.fromOffset(7,0),17,colors.Navy,true)
	text(row,detail,UDim2.new(1,-14,0,29),UDim2.fromOffset(7,28),12,colors.NavyLight)
	return row
end
local function row(title,detail,accent,height)
	local compactRow=panel.Size.X.Offset<430
	local rowHeight=compactRow and math.max(height or 94,130) or height or 94
	local card=frame(scroll,UDim2.new(1,-10,0,rowHeight),nil,Color3.fromRGB(241,231,204),14)
	local stripe=frame(card,UDim2.fromOffset(5,rowHeight-22),UDim2.fromOffset(11,11),accent or colors.Teal,4)
	stripe.Name="Accent"
	text(card,title,UDim2.new(1,compactRow and -45 or -170,0,compactRow and 34 or 27),UDim2.fromOffset(29,compactRow and 7 or 13),17,colors.Navy,true)
	text(card,detail,UDim2.new(1,-170,0,rowHeight-47),UDim2.fromOffset(29,44),12,colors.NavyLight)
	return card
end
local function redrawPanel()
	clearPanel()
	if not state then return end
	local profile=state.Profile
	panelRevision=table.concat({profile.Coins,profile.Shovel,profile.Pack,profile.Finds,state.Zone},":")
	if currentPanel=="Shop" then
		panelTitle.Text="The explorer's workshop"
		panelHint.Text="Spend treasure coins. Better gear helps you explore further."
		section("SHOVELS","A stronger shovel clears every patch in fewer digs.")
		for index,item in ipairs(Config.Shovels) do
			local owned=index<=profile.Shovel
			local nextItem=index==profile.Shovel+1
			local card=row(item.Name,"Dig power "..number(item.Power).."  |  "..(owned and "In your toolkit" or number(item.Cost).." coins"),colors.Gold)
			local buy=button(card,index==profile.Shovel and "EQUIPPED" or owned and "OWNED" or nextItem and "BUY" or "LOCKED",UDim2.fromOffset(114,47),UDim2.new(1,-128,.5,-23),nextItem and colors.Gold or Color3.fromRGB(214,209,187),function() if nextItem then send("Upgrade","Shovel") end end,modalConnections)
			buy.Active=nextItem
			buy.Selectable=nextItem
		end
		section("TREASURE PACKS","More room in your bag means longer expeditions.")
		for index,item in ipairs(Config.Packs) do
			local nextItem=index==profile.Pack+1
			local card=row(item.Name,number(item.Capacity).." treasures  |  "..(index<=profile.Pack and "In your toolkit" or number(item.Cost).." coins"),colors.Teal)
			local buy=button(card,index==profile.Pack and "EQUIPPED" or index<profile.Pack and "OWNED" or nextItem and "BUY" or "LOCKED",UDim2.fromOffset(114,47),UDim2.new(1,-128,.5,-23),nextItem and colors.Teal or Color3.fromRGB(214,209,187),function() if nextItem then send("Upgrade","Pack") end end,modalConnections)
			buy.Active=nextItem
			buy.Selectable=nextItem
		end
	elseif currentPanel=="Journal" then
		panelTitle.Text="Your treasure journal"
		panelHint.Text=number(discovered()).." / "..#Config.Treasures.." treasures discovered. Selling keeps your discoveries!"
		for _,zone in ipairs(Config.Zones) do
			section(zone.Name,zone.Description or "Excavate marked patches to discover this island's treasures.")
			for _,treasure in ipairs(Config.Treasures) do
				if treasure.Zone==zone.Id then
					local count=profile.Collection[treasure.Id] or 0
					local color=rgb(Config.RarityColors[treasure.Rarity])
					local card=row(count>0 and treasure.Name or "Undiscovered treasure",count>0 and (treasure.Rarity.."  |  Base value "..number(treasure.Value).." coins") or (treasure.Rarity.."  |  Keep exploring "..zone.Name),count>0 and color or colors.Muted,82)
					local status=text(card,count>0 and ("FOUND\nx"..number(count)) or "?",UDim2.fromOffset(100,60),panel.Size.X.Offset<430 and UDim2.new(1,-115,.5,-23) or UDim2.new(1,-115,0,10),count>0 and 15 or 28,colors.Navy,true)
					status.TextXAlignment=Enum.TextXAlignment.Center
				end
			end
		end
	elseif currentPanel=="Atlas" then
		panelTitle.Text="Choose your expedition"
		panelHint.Text="Find treasures to unlock islands. Travel is always free."
		for _,zone in ipairs(Config.Zones) do
			local unlocked=profile.Finds>=zone.Required
			local here=state.Zone==zone.Id
			local card=row(zone.Name,(zone.Description or "").."\n"..(unlocked and "Ready to explore" or number(profile.Finds).." / "..number(zone.Required).." lifetime finds to unlock"),rgb(zone.Color),123)
			local travel=button(card,here and "YOU'RE HERE" or unlocked and "TRAVEL" or "LOCKED",UDim2.fromOffset(114,48),UDim2.new(1,-128,.5,-24),unlocked and colors.Teal or Color3.fromRGB(214,209,187),function() if unlocked and not here then held=false;send("Travel",zone.Id);openPanel(nil) end end,modalConnections)
			travel.Active=unlocked and not here
			travel.Selectable=unlocked and not here
		end
		section("A little explorer advice","Hold DIG near a marked patch. Sell a full bag, claim quests, and upgrade your shovel!")
	end
	setLayer(panel,23)
	scroll.ZIndex=22
	panelClose.ZIndex=24
end
openPanel=function(name)
	held=false
	holdInput=nil
	currentPanel=name
	shade.Visible=name~=nil
	if name then
		redrawPanel()
		if string.find(UserInputService:GetLastInputType().Name,"Gamepad") then GuiService.SelectedObject=panelClose end
	elseif GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(panel) then GuiService.SelectedObject=nil end
end
connect(shade.Activated,function() openPanel(nil) end)
-- The modal itself intercepts input so clicks inside it do not dismiss the shade.
panel.Active=true

local highlight=make("Highlight",workspace,{Name="TreasureTideTarget",FillColor=colors.Gold,OutlineColor=colors.Cream,
	FillTransparency=.76,OutlineTransparency=0,DepthMode=Enum.HighlightDepthMode.Occluded,Enabled=false})
local localEffects=make("Folder",workspace,{Name="TreasureTideLocalEffects"})
local function patchPosition(patchId)
	local patch=patches[patchId]
	return patch and patch.Position or nil
end
local function cosmeticPart(parent,name,pos,size,color,material)
	return make("Part",parent,{Name=name,Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,
		Position=pos,Size=size,Color=color,Material=material or Enum.Material.SmoothPlastic})
end
local function dirt(patchId)
	local position=patchPosition(patchId)
	if not position then return end
	for index=1,5 do
		local angle=index*2.4+os.clock()
		local start=position+Vector3.new(math.cos(angle)*2,1,math.sin(angle)*2)
		local chip=cosmeticPart(localEffects,"Sand spark",start,Vector3.new(.36,.36,.36),colors.Gold)
		chip.CFrame*=CFrame.Angles(index,angle,index*.5)
		TweenService:Create(chip,TweenInfo.new(.45,Enum.EasingStyle.Quad),{Position=start+Vector3.new(math.cos(angle)*4,3,math.sin(angle)*4),Transparency=1,Size=Vector3.new(.05,.05,.05)}):Play()
		Debris:AddItem(chip,.5)
	end
	local character=player.Character
	local tool=character and character:FindFirstChildOfClass("Tool")
	if tool then
		local grip=tool.Grip
		tool.Grip=grip*CFrame.Angles(-.55,0,0)
		task.delay(.19,function() if tool.Parent then tool.Grip=grip end end)
	end
end
local function reveal(event)
	local origin=patchPosition(event.PatchId)
	if not origin then return end
	local treasure=event.Treasure or {}
	local rarityColor=rgb(Config.RarityColors[treasure.Rarity])
	local chest=make("Model",localEffects,{Name="Discovered treasure"})
	local center=origin+Vector3.new(0,2,0)
	local body=cosmeticPart(chest,"Chest",center,Vector3.new(3.5,2,2.7),Color3.fromRGB(132,80,42),Enum.Material.WoodPlanks)
	local lid=cosmeticPart(chest,"Lid",center+Vector3.new(0,1.15,0),Vector3.new(3.7,.55,2.9),colors.Gold,Enum.Material.Metal)
	local clasp=cosmeticPart(chest,"Golden clasp",center+Vector3.new(0,.1,1.4),Vector3.new(.65,1.1,.15),colors.Gold,Enum.Material.Metal)
	for _,offset in ipairs({-1.1,1.1}) do cosmeticPart(chest,"Gold band",center+Vector3.new(offset,0,0),Vector3.new(.2,2.1,2.8),colors.Gold,Enum.Material.Metal) end
	local glow=cosmeticPart(chest,"Treasure light",center+Vector3.new(0,1,0),Vector3.new(1.5,1.5,1.5),rarityColor,Enum.Material.Neon)
	glow.Shape=Enum.PartType.Ball
	make("PointLight",glow,{Color=rarityColor,Brightness=2,Range=13})
	TweenService:Create(lid,TweenInfo.new(.5,Enum.EasingStyle.Back),{CFrame=CFrame.new(center+Vector3.new(0,2,-1))*CFrame.Angles(math.rad(-55),0,0)}):Play()
	TweenService:Create(glow,TweenInfo.new(1.5,Enum.EasingStyle.Sine),{Position=center+Vector3.new(0,5,0),Transparency=.35}):Play()
	local bill=make("BillboardGui",body,{Size=UDim2.fromOffset(260,70),StudsOffset=Vector3.new(0,5,0),AlwaysOnTop=true})
	local title=text(bill,treasure.Name or "Treasure!",UDim2.new(1,0,0,35),nil,20,rarityColor,true)
	title.TextXAlignment=Enum.TextXAlignment.Center
	make("UIStroke",title,{Color=colors.Navy,Thickness=2})
	local value=text(bill,"+"..number(treasure.Value).." bag value",UDim2.new(1,0,0,25),UDim2.fromOffset(0,37),14,colors.White,true)
	value.TextXAlignment=Enum.TextXAlignment.Center
	make("UIStroke",value,{Color=colors.Navy,Thickness=1.5})
	Debris:AddItem(chest,3)
	for index=1,12 do
		local angle=index*math.pi/6
		local spark=cosmeticPart(localEffects,"Discovery sparkle",center,Vector3.new(.25,.7,.25),rarityColor,Enum.Material.Neon)
		TweenService:Create(spark,TweenInfo.new(.8,Enum.EasingStyle.Quad),{Position=center+Vector3.new(math.cos(angle)*7,2+index%3,math.sin(angle)*7),Transparency=1,Size=Vector3.new(.05,.05,.05)}):Play()
		Debris:AddItem(spark,1)
	end
end

local function indexWorld()
	local world=workspace:FindFirstChild("TreasureTideWorld")
	if not world then return end
	for _,object in ipairs(world:GetDescendants()) do
		if object:IsA("BasePart") and object:GetAttribute("PatchId") then
			patches[object:GetAttribute("PatchId")]=object
			patchColors[object]=patchColors[object] or object.Color
		end
	end
end
local function eligible(patch,now)
	if not state or not patch.Parent or patch:GetAttribute("ZoneId")~=state.Zone then return false end
	local entry=state.PatchProgress and state.PatchProgress[patch:GetAttribute("PatchId")]
	return not entry or not entry.ReadyAt or entry.ReadyAt<=now
end
local function choosePatch()
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	if not state or not root or not humanoid or humanoid.Health<=0 then return nil end
	local now=workspace:GetServerTimeNow()
	if selectedPatch and eligible(selectedPatch,now) and (selectedPatch.Position-root.Position).Magnitude<=Config.DigRange then return selectedPatch end
	local nearest,distance=nil,Config.DigRange
	for _,patch in pairs(patches) do
		if eligible(patch,now) then
			local d=(patch.Position-root.Position).Magnitude
			if d<distance then nearest,distance=patch,d end
		end
	end
	return nearest
end
local function dig()
	if currentPanel or not state then return end
	if #state.Profile.Bag>=state.Capacity then
		if os.clock()-lastError>3 then notify("Your bag is full of treasure!","Tap SELL to turn your finds into coins.",colors.Gold);lastError=os.clock() end
		return
	end
	local now=os.clock()
	if now-lastDig<(Config.DigCooldown or .48)+.025 then return end
	local patch=choosePatch()
	if not patch then
		if now-lastError>3 then notify("Follow the marked dig patches","Walk closer to a patch, then hold DIG.",colors.Teal);lastError=now end
		return
	end
	lastDig=now
	send("Dig",patch:GetAttribute("PatchId"))
end
connect(digButton.InputBegan,function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
		held=true;holdInput=input;dig()
	end
end)
connect(digButton.Activated,function()
	if UserInputService.GamepadEnabled and not held then dig() end
end)
connect(UserInputService.InputEnded,function(input)
	if input==holdInput or input.UserInputType==Enum.UserInputType.MouseButton1 or input.KeyCode==Enum.KeyCode.E or input.KeyCode==Enum.KeyCode.ButtonR2 then held=false;holdInput=nil end
end)
connect(UserInputService.WindowFocusReleased,function() held=false;holdInput=nil end)
connect(UserInputService.InputBegan,function(input,processed)
	if processed then return end
	if input.KeyCode==Enum.KeyCode.E or input.KeyCode==Enum.KeyCode.ButtonR2 then held=true;holdInput=input;dig()
	elseif input.KeyCode==Enum.KeyCode.B or input.KeyCode==Enum.KeyCode.ButtonX then held=false;send("Sell")
	elseif input.KeyCode==Enum.KeyCode.U or input.KeyCode==Enum.KeyCode.ButtonY then
		if currentPanel=="Shop" then openPanel(nil) else openPanel("Shop") end
	elseif input.KeyCode==Enum.KeyCode.J then
		if currentPanel=="Journal" then openPanel(nil) else openPanel("Journal") end
	elseif input.KeyCode==Enum.KeyCode.M then
		if currentPanel=="Atlas" then openPanel(nil) else openPanel("Atlas") end
	elseif input.KeyCode==Enum.KeyCode.Escape or input.KeyCode==Enum.KeyCode.ButtonB then openPanel(nil)
	elseif input.UserInputType==Enum.UserInputType.MouseButton1 then
		local mouse=player:GetMouse()
		local target=mouse.Target
		if target and target:GetAttribute("PatchId") then selectedPatch=target;dig() end
	end
end)
connect(UserInputService.TouchTapInWorld,function(position,processed)
	if processed or currentPanel then return end
	local camera=workspace.CurrentCamera
	if not camera then return end
	local ray=camera:ScreenPointToRay(position.X,position.Y)
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={player.Character,localEffects}
	local result=workspace:Raycast(ray.Origin,ray.Direction*300,params)
	if result and result.Instance:GetAttribute("PatchId") then selectedPatch=result.Instance;dig() end
end)

local function updateHud()
	if not state then return end
	local profile=state.Profile
	coins.Text=number(profile.Coins)
	bag.Text=number(#profile.Bag).." / "..number(state.Capacity)
	bag.TextColor3=#profile.Bag>=state.Capacity and colors.Coral or colors.Cream
	finds.Text=number(profile.Finds)
	bagValue.Text=#profile.Bag>0 and ("Bag value: "..number(state.BagValue).." coins  |  Sell anytime") or "Find treasure, then sell it for coins!"
	save.Text=state.SaveStatus or ""
	subtitle.Text=profile.Finds==0 and "Your first treasure is a special one!" or number(discovered()).." / "..#Config.Treasures.." treasures in your journal"
	local zone=zoneById[state.Zone]
	zoneLabel.Text=zone and string.upper(zone.Name) or "TREASURE ISLAND"
	local quest=state.Quest
	if quest then
		questTitle.Text=quest.Title or "Explore at your own pace"
		questDetail.Text=quest.Detail or "Collect every treasure and enjoy the islands!"
		local goal=math.max(1,quest.Goal or 1)
		questFill.Size=UDim2.fromScale(math.clamp((quest.Progress or 0)/goal,0,1),1)
		questProgress.Text=quest.Completed and "All quests complete!" or number(quest.Progress).." / "..number(quest.Goal)
		claim.Visible=quest.Ready==true and not quest.Completed
		claim.Text="CLAIM +"..number(quest.Reward)
	end
	local revision=table.concat({profile.Coins,profile.Shovel,profile.Pack,profile.Finds,state.Zone},":")
	if currentPanel and revision~=panelRevision then redrawPanel() end
end
connect(stateRemote.OnClientEvent,function(snapshot,event)
	if type(snapshot)~="table" or type(snapshot.Profile)~="table" then return end
	state=snapshot
	stateReceivedAt=workspace:GetServerTimeNow()
	updateHud()
	if type(event)~="table" then return end
	if event.Kind=="Hit" then
		localHitAt=os.clock()
		dirt(event.PatchId)
	elseif event.Kind=="Find" then
		selectedPatch=nil
		reveal(event)
		local treasure=event.Treasure or {}
		notify((treasure.New and "NEW DISCOVERY!  " or "TREASURE FOUND!  ")..(treasure.Name or ""),
			(treasure.Rarity or "Treasure").."  |  "..number(treasure.Value).." coin value  |  "..(event.Message or "Added to your bag"),rgb(Config.RarityColors[treasure.Rarity]))
	elseif event.Kind=="Sold" then
		notify("Treasure sold!",event.Message,colors.Teal)
	elseif event.Kind=="Upgrade" then
		notify("Ready for a bigger adventure",event.Message,colors.Gold)
	elseif event.Kind=="Quest" then
		notify("Adventure complete!",event.Message,colors.Gold)
	elseif event.Kind=="Travel" then
		held=false;selectedPatch=nil
		notify("Welcome, explorer",event.Message,colors.Teal)
	elseif event.Message and event.Message~="" then
		notify("Explorer tip",event.Message,colors.Teal)
	end
end)

local function layout()
	local camera=workspace.CurrentCamera
	local viewport=camera and camera.ViewportSize or Vector2.new(1280,720)
	local scale=math.clamp(viewport.Y/850,.85,1.12)
	uiScale.Scale=scale
	canvas.Size=UDim2.new(1/scale,0,1/scale,0)
	local width,height=gui.AbsoluteSize.X/scale,gui.AbsoluteSize.Y/scale
	local compact=width<1080
	local narrow=width<760
	header.Visible=not compact
	stats.Size=UDim2.fromOffset(math.min(410,width-32),64)
	stats.Position=compact and UDim2.new(0,16,0,12) or UDim2.new(.5,0,0,18)
	stats.AnchorPoint=compact and Vector2.new(0,0) or Vector2.new(.5,0)
	local sw=stats.Size.X.Offset
	coins.Position=UDim2.fromOffset(16,5)
	bag.Position=UDim2.fromOffset(sw*.36,5)
	finds.Position=UDim2.fromOffset(sw*.76,5)
	for _,child in ipairs(stats:GetChildren()) do
		if child:IsA("TextLabel") then
			if child.Text=="TREASURES IN BAG" then child.Position=UDim2.fromOffset(sw*.36,36) end
			if child.Text=="FINDS" then child.Position=UDim2.fromOffset(sw*.76,36) end
		end
	end
	nav.Position=narrow and UDim2.new(0,16,0,84) or UDim2.new(1,-316,0,compact and 12 or 18)
	questCard.Position=UDim2.fromOffset(16,narrow and 160 or 96)
	questCard.Size=UDim2.fromOffset(narrow and math.min(width-32,380) or 286,narrow and 145 or 164)
	questDetail.Position=UDim2.fromOffset(14,narrow and 59 or 64)
	questTrack.Position=UDim2.fromOffset(14,narrow and 102 or 114)
	questProgress.Position=UDim2.fromOffset(14,narrow and 112 or 128)
	claim.Position=UDim2.new(1,-147,0,narrow and 108 or 126)
	zoneBadge.Visible=not narrow
	zoneBadge.Position=UDim2.new(.5,compact and 74 or 0,0,compact and 88 or 96)
	tide.Position=narrow and UDim2.new(.5,-160,0,140) or UDim2.new(.5,compact and -86 or -160,0,compact and 137 or 147)
	digDock.Position=UDim2.new(.5,0,1,UserInputService.TouchEnabled and -20 or -28)
	digButton.Text=UserInputService.TouchEnabled and "HOLD TO DIG" or "HOLD TO DIG  [E]"
	sellButton.Text=UserInputService.TouchEnabled and "SELL" or "SELL\n[B]"
	local pw=math.min(670,width-24)
	local ph=math.min(560,height-40)
	panel.Size=UDim2.fromOffset(pw,ph)
	toast.Size=UDim2.fromOffset(math.min(450,width-30),74)
	toast.Position=UDim2.new(.5,0,0,narrow and 315 or 192)
	save.Visible=not narrow
end
connect(gui:GetPropertyChangedSignal("AbsoluteSize"),layout)
local loopAccumulator, scanAccumulator, lastCountdown = 0,0,-1
connect(RunService.Heartbeat,function(dt)
	loopAccumulator+=dt
	scanAccumulator+=dt
	if held and loopAccumulator>.06 then loopAccumulator=0;dig() end
	if scanAccumulator<.1 then return end
	scanAccumulator=0
	if not next(patches) then indexWorld() end
	local target=not currentPanel and choosePatch() or nil
	highlight.Adornee=target
	highlight.Enabled=target~=nil
	if state then
		-- These colors exist only on this client; each explorer sees their own excavation.
		local serverNow=workspace:GetServerTimeNow()
		for patchId,patch in pairs(patches) do
			local progress=state.PatchProgress and state.PatchProgress[patchId]
			local amount=0
			if progress then
				if progress.ReadyAt then amount=serverNow<progress.ReadyAt and .85 or 0
				else amount=math.clamp((progress.Hits or 0)/math.max(1,progress.Goal or 1),0,1)*.65 end
			end
			if patch.Parent then patch.Color=patchColors[patch]:Lerp(Color3.fromRGB(105,71,46),amount) end
		end
		local full=#state.Profile.Bag>=state.Capacity
		if full then targetLabel.Text="Bag full! Sell your treasures";digButton.Text="BAG FULL";digButton.BackgroundColor3=colors.Coral
		elseif target then
			local progress=state.PatchProgress and state.PatchProgress[target:GetAttribute("PatchId")]
			local hit=progress and progress.Hits or 0
			local shovel=Config.Shovels[state.Profile.Shovel]
			local goal=progress and progress.Goal or math.ceil(({sands=3,crystal=5,ruins=7})[state.Zone]/shovel.Power)
			targetLabel.Text=hit>0 and ("Treasure below!  "..hit.." / "..goal.." digs") or "Treasure below! Hold DIG to uncover it"
			targetFill.Size=UDim2.fromScale(math.clamp(hit/math.max(1,goal),0,1),1)
			digButton.Text=UserInputService.TouchEnabled and "HOLD TO DIG" or "HOLD TO DIG  [E]"
			digButton.BackgroundColor3=os.clock()-localHitAt<.17 and colors.Cream or colors.Gold
		else
			targetLabel.Text="Walk closer to a marked dig patch"
			targetFill.Size=UDim2.fromScale(0,1)
			digButton.Text=UserInputService.TouchEnabled and "HOLD TO DIG" or "HOLD TO DIG  [E]"
			digButton.BackgroundColor3=colors.Gold
		end
		local countdown=math.max(0,math.ceil((state.EventCountdown or 0)-(workspace:GetServerTimeNow()-stateReceivedAt)))
		if countdown~=lastCountdown or state.EventActive then
			lastCountdown=countdown
			tide.Text=state.EventActive and ("GOLDEN TIDE!  +50% treasure value  |  "..countdown.."s") or ("Golden Tide in "..math.floor(countdown/60)..":"..string.format("%02d",countdown%60).."  |  Bonus treasure value")
		end
	end
end)
connect(player.CharacterAdded,function() held=false;holdInput=nil;selectedPatch=nil end)
connect(script.Destroying,function()
	alive=false
	for _,connection in ipairs(connections) do connection:Disconnect() end
	for _,connection in ipairs(modalConnections) do connection:Disconnect() end
	for patch,color in pairs(patchColors) do if patch.Parent then patch.Color=color end end
	highlight:Destroy()
	localEffects:Destroy()
	gui:Destroy()
end)
task.spawn(function()
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack,false) end)
	for _=1,8 do
		if not alive or state then break end
		send("Sync")
		task.wait(1.5)
	end
end)
indexWorld()
layout()
print("[Treasure Tide] Explorer interface ready")
