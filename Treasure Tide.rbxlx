local patchIndex = {}
local spawnPoints = {sands=Vector3.new(0,7,38),crystal=Vector3.new(220,7,38),ruins=Vector3.new(440,7,38)}
local function indexPatches(root)
    table.clear(patchIndex)
    for _, obj in root:GetDescendants() do
        if obj:IsA("BasePart") and obj.Name == "DigPatch" then
            -- Restore metadata when importing a map through an attribute-stripping tool.
            if not obj:GetAttribute("PatchId") then
                for _, spec in parts do
                    if spec.Attributes and (obj.Position-Vector3.new(table.unpack(spec.Position))).Magnitude < .1 then
                        for key,value in spec.Attributes do obj:SetAttribute(key,value) end
                        break
                    end
                end
            end
            local id=obj:GetAttribute("PatchId")
            if id then patchIndex[id] = obj end
        end
    end
end
function World.build()
    local existing = workspace:FindFirstChild("TreasureTideWorld")
    if existing then indexPatches(existing); return existing end
    local root=Instance.new("Folder")
    root.Name="TreasureTideWorld"
    local regions={}
    for _, spec in parts do
        local region=regions[spec.Region]
        if not region then
            region=Instance.new("Folder");region.Name=spec.Region;region.Parent=root;regions[spec.Region]=region
        end
        local obj=Instance.new(if spec.Spawn then "SpawnLocation" else "Part")
        obj.Name=spec.Name;obj.Anchored=true;obj.CanCollide=spec.Collide~=false
        obj.TopSurface=Enum.SurfaceType.Smooth;obj.BottomSurface=Enum.SurfaceType.Smooth
        obj.Size=Vector3.new(table.unpack(spec.Size))
        local r=spec.Rotation
        obj.CFrame=CFrame.new(table.unpack(spec.Position))*CFrame.Angles(math.rad(r[1]),math.rad(r[2]),math.rad(r[3]))
        obj.Color=Color3.fromRGB(table.unpack(spec.Color));obj.Material=Enum.Material[spec.Material]
        obj.Transparency=spec.Transparency or 0
        if obj:IsA("Part") then obj.Shape=Enum.PartType[spec.Shape or "Block"] end
        if obj:IsA("SpawnLocation") then obj.Neutral=true;obj.Duration=0 end
        for key,value in spec.Attributes or {} do obj:SetAttribute(key,value) end
        obj.Parent=region
        if spec.Light then
            local light=Instance.new("PointLight");light.Color=obj.Color;light.Brightness=spec.Light;light.Range=16;light.Parent=obj
        end
        if spec.Text then
            local gui=Instance.new("BillboardGui");gui.Name="Sign";gui.Size=UDim2.fromOffset(spec.TextWidth or 260,72)
            gui.StudsOffset=Vector3.new(0,spec.TextOffset or 0,0);gui.MaxDistance=100;gui.Parent=obj
            local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1
            label.Font=Enum.Font.GothamBold;label.TextColor3=Color3.fromRGB(table.unpack(spec.TextColor or {255,244,211}))
            label.TextStrokeColor3=Color3.fromRGB(28,55,63);label.TextStrokeTransparency=.35
            label.TextSize=spec.TextSize or 20;label.TextWrapped=true;label.Text=spec.Text;label.Parent=gui
        end
    end
    root.Parent=workspace
    indexPatches(root)
    return root
end
function World.patch(id)
    return patchIndex[id]
end
function World.spawn(zoneId)
    return spawnPoints[zoneId] or spawnPoints.sands
end
return World
]]></ProtectedString>
