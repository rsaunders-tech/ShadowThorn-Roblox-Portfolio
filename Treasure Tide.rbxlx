			<Item class="ModuleScript" referent="RBX00000484">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Treasure Tide is built from native Roblox shapes; no paid assets required.
local Config: any = {
	Title = "Treasure Tide",
	DataStoreName = "TreasureTide_v1",
	StudioPersistence = false,
	DigCooldown = 0.48,
	DigRange = 18,
	PatchRespawn = 7,
	EventInterval = 180,
	EventDuration = 40,
	Zones = {
		{Id="sands", Name="Sunny Sands", Required=0, Center={0,0,0}, Spawn={0,7,38}, Color={243,203,130}, Description="Warm sand, buried keepsakes, and your first big discovery."},
		{Id="crystal", Name="Crystal Cavern", Required=10, Center={220,0,0}, Spawn={220,7,38}, Color={143,180,227}, Description="Glowing crystals hide shimmering relics. Unlock with 10 finds."},
		{Id="ruins", Name="Sunken Ruins", Required=30, Center={440,0,0}, Spawn={440,7,38}, Color={115,190,172}, Description="An ancient island holds legendary treasure. Unlock with 30 finds."},
	},
	Shovels = {
		{Name="Beach Shovel", Cost=0, Power=1},
		{Name="Explorer Spade", Cost=100, Power=2},
		{Name="Crystal Digger", Cost=450, Power=3},
		{Name="Royal Excavator", Cost=1600, Power=5},
	},
	Packs = {
		{Name="Pocket Satchel", Cost=0, Capacity=10},
		{Name="Explorer Pack", Cost=150, Capacity=20},
		{Name="Treasure Trunk", Cost=650, Capacity=40},
	},
	RarityColors = {
		Common={198,213,216}, Uncommon={128,224,168}, Rare={108,183,255},
		Epic={202,148,255}, Legendary={255,211,98},
	},
	Treasures = {
		{Id="sands_shell", Name="Pearl Shell", Zone="sands", Rarity="Common", Value=15, Weight=30, Color={248,215,194}},
		{Id="sands_coin", Name="Old Pirate Coin", Zone="sands", Rarity="Common", Value=20, Weight=25, Color={228,182,89}},
		{Id="sands_compass", Name="Brass Compass", Zone="sands", Rarity="Uncommon", Value=35, Weight=18, Color={238,199,106}},
		{Id="sands_bottle", Name="Message in a Bottle", Zone="sands", Rarity="Uncommon", Value=40, Weight=14, Color={126,213,207}},
		{Id="sands_starter", Name="Captain's Lucky Locket", Zone="sands", Rarity="Rare", Value=90, Weight=7, Color={255,210,107}},
		{Id="sands_pearl", Name="Moonlit Pearl", Zone="sands", Rarity="Rare", Value=100, Weight=4, Color={213,224,255}},
		{Id="sands_map", Name="Enchanted Treasure Map", Zone="sands", Rarity="Epic", Value=180, Weight=1.5, Color={207,153,255}},
		{Id="sands_crown", Name="Sun King's Crown", Zone="sands", Rarity="Legendary", Value=350, Weight=0.5, Color={255,202,77}},
		{Id="crystal_shard", Name="Singing Crystal", Zone="crystal", Rarity="Common", Value=35, Weight=30, Color={129,207,255}},
		{Id="crystal_fossil", Name="Spiral Fossil", Zone="crystal", Rarity="Common", Value=40, Weight=25, Color={206,209,228}},
		{Id="crystal_amulet", Name="Azure Amulet", Zone="crystal", Rarity="Uncommon", Value=65, Weight=18, Color={100,182,245}},
		{Id="crystal_geode", Name="Violet Geode", Zone="crystal", Rarity="Uncommon", Value=75, Weight=14, Color={172,125,240}},
		{Id="crystal_beetle", Name="Sapphire Scarab", Zone="crystal", Rarity="Rare", Value=150, Weight=7, Color={102,149,255}},
		{Id="crystal_heart", Name="Cavern Heart", Zone="crystal", Rarity="Rare", Value=175, Weight=4, Color={240,133,204}},
		{Id="crystal_wand", Name="Prismatic Wand", Zone="crystal", Rarity="Epic", Value=300, Weight=1.5, Color={202,156,255}},
		{Id="crystal_dragon", Name="Sleeping Dragon Gem", Zone="crystal", Rarity="Legendary", Value=550, Weight=0.5, Color={255,224,122}},
		{Id="ruins_tile", Name="Mosaic Fragment", Zone="ruins", Rarity="Common", Value=65, Weight=30, Color={131,213,185}},
		{Id="ruins_goblet", Name="Ancient Goblet", Zone="ruins", Rarity="Common", Value=75, Weight=25, Color={206,176,115}},
		{Id="ruins_key", Name="Emerald Vault Key", Zone="ruins", Rarity="Uncommon", Value=110, Weight=18, Color={109,226,153}},
		{Id="ruins_idol", Name="Guardian Idol", Zone="ruins", Rarity="Uncommon", Value=130, Weight=14, Color={138,199,171}},
		{Id="ruins_mask", Name="Tidal Oracle Mask", Zone="ruins", Rarity="Rare", Value=240, Weight=7, Color={111,195,230}},
		{Id="ruins_orb", Name="Ocean Memory Orb", Zone="ruins", Rarity="Rare", Value=280, Weight=4, Color={143,188,255}},
		{Id="ruins_trident", Name="Stormcaller's Trident", Zone="ruins", Rarity="Epic", Value=450, Weight=1.5, Color={197,142,255}},
		{Id="ruins_relic", Name="Heart of Atlantis", Zone="ruins", Rarity="Legendary", Value=850, Weight=0.5, Color={255,218,112}},
	},
}
Config.ById = {}
Config.ZoneById = {}
for _, treasure in ipairs(Config.Treasures) do Config.ById[treasure.Id] = treasure end
for _, zone in ipairs(Config.Zones) do Config.ZoneById[zone.Id] = zone end
return Config
]]></ProtectedString>
					<string name="ScriptGuid">{F0B15177-5286-40A1-B563-1C421E7F796D}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Config</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">316b2c375fa0c1da0af32d0400000861</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000485">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Currency, loot, and progression are changed only by the server.
local Config: any = require(script.Parent.Config)
local Rules = {}
local MAX_COUNT, MAX_COINS = 1_000_000_000, 1_000_000_000_000
local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end
local function integer(value: any, low: number, high: number, fallback: number): number
	return if finite(value) then math.floor(math.clamp(value, low, high)) else fallback
end
function Rules.newProfile(): any
	return {Coins=0, Shovel=1, Pack=1, Finds=0, Sold=0, Sales=0, Quest=1, Collection={}, Bag={}, DryStreak=0}
end
function Rules.capacity(p: any): number
	return Config.Packs[integer(p.Pack,1,#Config.Packs,1)].Capacity
end
function Rules.collectionCount(p: any): number
	local count = 0
	for _, amount in pairs(p.Collection) do if type(amount) == "number" and amount > 0 then count += 1 end end
	return count
end
function Rules.bagValue(p: any): number
	local total = 0
	for _, entry in ipairs(p.Bag) do total += entry.Value end
	return math.min(MAX_COINS,total)
end
function Rules.sanitize(raw: any, _config: any?): any
	local p = Rules.newProfile()
	if type(raw) ~= "table" then return p end
	p.Coins = integer(raw.Coins,0,MAX_COINS,0)
	p.Shovel = integer(raw.Shovel,1,#Config.Shovels,1)
	p.Pack = integer(raw.Pack,1,#Config.Packs,1)
	p.Quest = integer(raw.Quest,1,7,1)
	p.Sold = integer(raw.Sold,0,MAX_COUNT,0)
	p.Sales = integer(raw.Sales,0,MAX_COUNT,0)
	p.DryStreak = integer(raw.DryStreak,0,7,0)
	if type(raw.Collection) == "table" then
		for id, amount in pairs(raw.Collection) do
			if Config.ById[id] then
				local count = integer(amount,0,MAX_COUNT,0)
				if count > 0 then p.Collection[id] = count; p.Finds += count end
			end
		end
	end
	if type(raw.Bag) == "table" then
		local included: {[string]: number} = {}
		for _, entry in ipairs(raw.Bag) do
			if #p.Bag >= Rules.capacity(p) then break end
			if type(entry) == "table" then
				local record: any = entry
				local treasure = Config.ById[record.Id]
				if treasure and (included[record.Id] or 0) < (p.Collection[record.Id] or 0) then
					included[record.Id] = (included[record.Id] or 0)+1
					table.insert(p.Bag,{Id=record.Id,Value=integer(record.Value,1,treasure.Value*2,treasure.Value)})
				end
			end
		end
	end
	return p
end
function Rules.snapshot(p: any): any
	local result = {}
	for key, value in pairs(p) do
		if key == "Bag" then
			local bag = {}
			for _, entry in ipairs(value) do table.insert(bag,{Id=entry.Id,Value=entry.Value}) end
			result[key] = bag
		elseif key == "Collection" then
			local collection = {}; for id, count in pairs(value) do collection[id] = count end
			result[key] = collection
		elseif type(value) ~= "table" then result[key] = value end
	end
	return result
end
function Rules.unlocked(p: any, zoneId: string): boolean
	local zone = Config.ZoneById[zoneId]
	return zone ~= nil and p.Finds >= zone.Required
end
function Rules.hits(p: any, zoneId: string): number
	local base = if zoneId == "crystal" then 5 elseif zoneId == "ruins" then 7 else 3
	return math.max(1,math.ceil(base/Config.Shovels[integer(p.Shovel,1,#Config.Shovels,1)].Power))
end
function Rules.roll(p: any, zoneId: string, random01: number): any
	if not Config.ZoneById[zoneId] then return nil end
	if p.Finds == 0 and zoneId == "sands" then return Config.ById.sands_starter end
	local pity = p.DryStreak >= 7
	local total = 0
	for _, treasure in ipairs(Config.Treasures) do
		if treasure.Zone == zoneId and (not pity or treasure.Rarity == "Rare" or treasure.Rarity == "Epic" or treasure.Rarity == "Legendary") then total += treasure.Weight end
	end
	local unit = if finite(random01) then math.clamp(random01,0,1-1e-12) else 0.5
	local target = unit*total
	local selected: any = nil
	for _, treasure in ipairs(Config.Treasures) do
		if treasure.Zone == zoneId and (not pity or treasure.Rarity == "Rare" or treasure.Rarity == "Epic" or treasure.Rarity == "Legendary") then
			selected = treasure; target -= treasure.Weight
			if target < 0 then break end
		end
	end
	return selected
end
function Rules.award(p: any, treasure: any, multiplier: number?): any
	local canonical = type(treasure) == "table" and Config.ById[treasure.Id] or nil
	if not canonical or #p.Bag >= Rules.capacity(p) then return nil end
	local isNew = p.Collection[canonical.Id] == nil
	local boost = if finite(multiplier) then math.clamp(multiplier :: number,1,1.5) else 1
	local value = math.floor(canonical.Value*boost)
	p.Collection[canonical.Id] = math.min(MAX_COUNT,(p.Collection[canonical.Id] or 0)+1)
	p.Finds += 1
	p.DryStreak = if canonical.Rarity == "Rare" or canonical.Rarity == "Epic" or canonical.Rarity == "Legendary" then 0 else math.min(7,p.DryStreak+1)
	table.insert(p.Bag,{Id=canonical.Id,Value=value})
	return {Treasure=canonical.Id, Name=canonical.Name, Rarity=canonical.Rarity, Value=value, New=isNew, Count=p.Collection[canonical.Id], Color=canonical.Color}
end
function Rules.sell(p: any): number
	local count, value = #p.Bag, Rules.bagValue(p)
	if count == 0 then return 0 end
	p.Coins = math.min(MAX_COINS,p.Coins+value)
	p.Sold += count; p.Sales += 1; p.Bag = {}
	return value
end
function Rules.upgrade(p: any, kind: string): (boolean, string)
	if kind ~= "Shovel" and kind ~= "Pack" then return false,"Choose a shovel or backpack." end
	local list = if kind == "Shovel" then Config.Shovels else Config.Packs
	local nextItem = list[p[kind]+1]
	if not nextItem then return false,"Fully upgraded!" end
	if p.Coins < nextItem.Cost then return false,string.format("%d more coins needed for %s.",nextItem.Cost-p.Coins,nextItem.Name) end
	p.Coins -= nextItem.Cost; p[kind] += 1
	return true,"Equipped " .. nextItem.Name .. "!"
end
function Rules.quest(p: any): any
	local definitions = {
		{Title="Your first treasure", Detail="Walk onto a dig patch and hold DIG. A lucky find is waiting!", Progress=p.Finds, Goal=1, Reward=50},
		{Title="Pocket full of gold", Detail="Sell your bag with SELL. Your collection keeps every discovery.", Progress=p.Sales, Goal=1, Reward=50},
		{Title="Tools of the trade", Detail="Open SHOP and buy the Explorer Spade for 100 coins.", Progress=p.Shovel-1, Goal=1, Reward=80},
		{Title="A new horizon", Detail="Find 10 treasures to unlock Crystal Cavern in the ATLAS.", Progress=p.Finds, Goal=10, Reward=120},
		{Title="Curious collector", Detail="Discover 8 different treasures. The journal records them forever.", Progress=Rules.collectionCount(p), Goal=8, Reward=200},
		{Title="Secrets of the tide", Detail="Find 30 treasures to unlock the Sunken Ruins.", Progress=p.Finds, Goal=30, Reward=300},
	}
	local q: any = definitions[p.Quest]
	if not q then return {Title="Master treasure hunter", Detail="Discover all 24 treasures. Golden tides boost every find!", Progress=Rules.collectionCount(p), Goal=#Config.Treasures, Reward=0, Ready=false, Completed=true} end
	q.Progress = math.min(q.Progress,q.Goal); q.Ready = q.Progress >= q.Goal
	return q
end
function Rules.claimQuest(p: any): (boolean, string)
	local q = Rules.quest(p)
	if q.Completed then return false,"All starter quests complete. Keep exploring!" end
	if not q.Ready then return false,q.Detail end
	p.Coins = math.min(MAX_COINS,p.Coins+q.Reward); p.Quest += 1
	return true,string.format("Quest complete! +%d coins",q.Reward)
end
return Rules
]]></ProtectedString>
