			<Item class="ModuleScript" referent="RBX0000048A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Server-owned, session-only excavation state. No engine dependencies.
local DigSession = {}

function DigSession.new()
	return {Zone = "sands", Progress = {}, LastDig = -math.huge}
end

function DigSession.hit(session, profile, config, rules, patchId, now, random01, golden)
	if type(patchId) ~= "string" or #patchId > 32 then return false, "Choose a glowing dig patch." end
	if now - session.LastDig < config.DigCooldown then return false, nil end
	if not rules.unlocked(profile, session.Zone) then return false, "This island is still locked." end
	if #profile.Bag >= rules.capacity(profile) then return false, "Your bag is full! Sell your finds to keep digging." end
	local progress = session.Progress[patchId]
	if progress and progress.ReadyAt and now < progress.ReadyAt then return false, "This patch is refilling. Try the next one!" end
	local goal = rules.hits(profile, session.Zone)
	if not progress or progress.ReadyAt then progress = {Hits = 0, Goal = goal}; session.Progress[patchId] = progress end
	progress.Goal = goal
	session.LastDig = now
	progress.Hits += 1
	if progress.Hits < progress.Goal then
		return true, {Kind = "Hit", PatchId = patchId, Hits = progress.Hits, Goal = goal,
			Message = "Keep going! There is treasure below."}
	end
	local treasure = rules.roll(profile, session.Zone, random01)
	local award, reason = rules.award(profile, treasure, golden and 1.5 or 1)
	if not award then progress.Hits -= 1; return false, reason end
	progress.ReadyAt = now + config.PatchRespawn
	return true, {Kind = "Find", PatchId = patchId, Treasure = award, Hits = goal, Goal = goal,
		Message = (award.New and "NEW DISCOVERY! " or "Found ") .. award.Name .. "  +" .. award.Value .. " bag value"}
end

function DigSession.travel(session, profile, config, rules, zoneId)
	if type(zoneId) ~= "string" then return false, "Choose an island on your atlas." end
	local zone
	for _, entry in config.Zones do if entry.Id == zoneId then zone = entry; break end end
	if not zone then return false, "That island does not exist." end
	if not rules.unlocked(profile, zoneId) then return false, "Discover " .. zone.Required .. " treasures to unlock " .. zone.Name .. "." end
	session.Zone = zoneId
	return true, {Kind = "Travel", Message = "Welcome to " .. zone.Name .. "!"}
end

return DigSession
]]></ProtectedString>
					<string name="ScriptGuid">{ECB47C52-7616-4A85-9119-ACADB8315948}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DigSession</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">316b2c375fa0c1da0af32d0400000866</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX0000048B">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Treasure Tide: all treasure rolls, coins, upgrades and range checks live here.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local shared = ReplicatedStorage:WaitForChild("TreasureTide")
local Config = require(shared:WaitForChild("Config"))
local Rules = require(shared:WaitForChild("Rules"))
local Profiles = require(script.Parent.Profiles)
local World = require(script.Parent.World)
local DigSession = require(script.Parent.DigSession)
local world = World.build()
local function remote(name)
	local obj = shared:FindFirstChild(name)
	if not obj then obj = Instance.new("RemoteEvent"); obj.Name = name; obj.Parent = shared end
	return obj
end
local Action, State = remote("Action"), remote("State")
local profiles = Profiles.new(Config, Rules)
local sessions, connections, rate, clocks = {}, {}, {}, {}
local started = workspace:GetServerTimeNow()
local random = Random.new()

local function tide()
	local elapsed = workspace:GetServerTimeNow() - started
	local interval, duration = Config.EventInterval, Config.EventDuration
	local phase = elapsed % interval
	return phase >= interval - duration, math.ceil(phase >= interval - duration and interval - phase or interval - duration - phase)
end
local function alive(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return root and humanoid and humanoid.Health > 0 and root or nil
end
local function stats(player, p)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then return end
	leaderstats.Coins.Value = p.Coins
	leaderstats.Finds.Value = p.Finds
	leaderstats.Discovered.Value = Rules.collectionCount(p)
end
local function send(player, event)
	local p, session = profiles:get(player), sessions[player]
	if not p or not session or not player.Parent then return end
	local active, countdown = tide()
	stats(player, p)
	State:FireClient(player, {
		Profile = Rules.snapshot(p), Zone = session.Zone, SaveStatus = profiles:status(player),
		Quest = Rules.quest(p), PatchProgress = session.Progress,
		NextShovel = Config.Shovels[p.Shovel + 1], NextPack = Config.Packs[p.Pack + 1],
		BagValue = Rules.bagValue(p), Capacity = Rules.capacity(p), EventActive = active,
		EventCountdown = countdown,
	}, event)
end
local function equipShovel(player)
	local p = profiles:get(player)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not p or not character or not backpack then return end
	for _, container in {character, backpack} do
		for _, obj in container:GetChildren() do if obj:IsA("Tool") and obj:GetAttribute("TreasureTideShovel") then obj:Destroy() end end
	end
	local tool = Instance.new("Tool")
	tool.Name = Config.Shovels[p.Shovel].Name
	tool.CanBeDropped, tool.RequiresHandle = false, true
	tool:SetAttribute("TreasureTideShovel", true)
	tool.Grip = CFrame.new(0, -0.5, 0) * CFrame.Angles(math.rad(-35), 0, 0)
	local handle = Instance.new("Part")
	handle.Name, handle.Size = "Handle", Vector3.new(.25, 3.4, .25)
	handle.Color, handle.Material = Color3.fromRGB(125, 83, 52), Enum.Material.Wood
	handle.CanCollide, handle.Massless = false, true
	handle.Parent = tool
	local blade = Instance.new("Part")
	blade.Name, blade.Size = "Blade", Vector3.new(1.1, 1.25, .18)
	blade.Color = ({Color3.fromRGB(170, 188, 192), Color3.fromRGB(61, 204, 198),
		Color3.fromRGB(168, 122, 235), Color3.fromRGB(255, 206, 86)})[p.Shovel]
	blade.Material, blade.CanCollide, blade.Massless = Enum.Material.Metal, false, true
	blade.CFrame = handle.CFrame * CFrame.new(0, -1.9, 0)
	blade.Parent = tool
	local weld = Instance.new("WeldConstraint"); weld.Part0, weld.Part1, weld.Parent = handle, blade, blade
	tool.Parent = backpack
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid:EquipTool(tool) end
end
local function place(player)
	local session = sessions[player]
	local root = alive(player)
	if not session or not root then return end
	local pos = World.spawn(session.Zone)
	player.Character:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1)))
	root.AssemblyLinearVelocity = Vector3.zero
end
local function respawn(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root or not humanoid or player.Character ~= character then return end
	humanoid.WalkSpeed = 20
	if sessions[player] then place(player); equipShovel(player) end
end
local function joined(player)
	if sessions[player] then return end
	connections[player] = player.CharacterAdded:Connect(function(character) task.spawn(respawn, player, character) end)
	if not profiles:load(player) then
		if player.Parent then player:Kick("Your treasure progress could not be loaded safely. Please rejoin in a moment.") end
		return
	end
	if not player.Parent then profiles:remove(player); return end
	sessions[player] = DigSession.new()
	local folder = Instance.new("Folder"); folder.Name = "leaderstats"; folder.Parent = player
	for _, name in {"Coins", "Finds", "Discovered"} do
		local value = Instance.new("IntValue"); value.Name = name; value.Parent = folder
	end
	if player.Character then task.spawn(respawn, player, player.Character) end
	send(player, {Kind = "Info", Message = "Welcome, explorer! Walk onto a glowing dig patch and hold DIG."})
end

local function allowed(player, action)
	local now = os.clock()
	local bucket = rate[player]
	if not bucket or now - bucket.Start >= 1 then bucket = {Start = now, Count = 0}; rate[player] = bucket end
	bucket.Count += 1
	if bucket.Count > 18 then return false end
	clocks[player] = clocks[player] or {}
	local last = clocks[player][action] or -math.huge
	local interval = action == "Dig" and Config.DigCooldown or action == "Sync" and .5 or .22
	if now - last < interval then return false end
	clocks[player][action] = now
	return true
end
local actions = {Sync=true, Dig=true, Sell=true, Upgrade=true, Travel=true, ClaimQuest=true}
Action.OnServerEvent:Connect(function(player, action, payload)
	if type(action) ~= "string" or not actions[action] or not allowed(player, action) then return end
	local session = sessions[player]
	if not session then return end
	if action == "Sync" then send(player); return end
	if not alive(player) then send(player, {Kind = "Info", Message = "Your explorer is respawning. Try again in a moment."}); return end
	if action == "Dig" then
		if type(payload) ~= "string" or #payload > 32 then return end
		local patch = World.patch(payload)
		if not patch or patch:GetAttribute("ZoneId") ~= session.Zone then return end
		local root = alive(player)
		local distance = root and (root.Position - patch.Position).Magnitude or math.huge
		if distance ~= distance or distance > Config.DigRange then
			send(player, {Kind = "Info", Message = "Walk closer to a glowing dig patch."}); return
		end
	end
	local active = tide()
	local ok, accepted, event = profiles:mutate(player, function(p)
		if action == "Dig" then
			return DigSession.hit(session, p, Config, Rules, payload, workspace:GetServerTimeNow(), random:NextNumber(), active)
		elseif action == "Sell" then
			local value = Rules.sell(p)
			return value > 0, {Kind = "Sold", Message = value > 0 and "Treasure sold! +" .. value .. " coins" or "Your bag is empty. Let's find some treasure!"}
		elseif action == "Upgrade" then
			if payload ~= "Shovel" and payload ~= "Pack" then return false, nil end
			local success, message = Rules.upgrade(p, payload)
			return success, {Kind = success and "Upgrade" or "Info", Message = message}
		elseif action == "Travel" then return DigSession.travel(session, p, Config, Rules, payload)
		elseif action == "ClaimQuest" then
			local success, message = Rules.claimQuest(p)
			return success, {Kind = success and "Quest" or "Info", Message = message}
		end
		return false, nil
	end)
	if not ok then send(player, {Kind = "Info", Message = accepted}); return end
	if type(event) == "string" then event = {Kind = "Info", Message = event} end
	if accepted then
		if action == "Travel" then place(player) end
		if action == "Upgrade" and payload == "Shovel" then equipShovel(player) end
	end
	if event or accepted then send(player, event) end
end)
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player)
	if connections[player] then connections[player]:Disconnect(); connections[player] = nil end
	sessions[player], rate[player], clocks[player] = nil, nil, nil
	profiles:remove(player)
end)
for _, player in Players:GetPlayers() do task.spawn(joined, player) end
game:BindToClose(function() profiles:close() end)
local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
	for player, _ in sessions do
		local root = alive(player)
		if root and root.Position.Y < -8 then place(player) end
	end
	elapsed += dt
	if elapsed < 1 then return end
	elapsed = 0
	for player, _ in sessions do
		send(player)
	end
end)
print("Treasure Tide ready: dig, discover, sell, upgrade, explore!")
]]></ProtectedString>
