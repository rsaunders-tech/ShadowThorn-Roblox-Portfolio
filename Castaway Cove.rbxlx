function World.build(_Config: any): Instance
    local existing = workspace:FindFirstChild("CastawayCove")
    if existing then return existing end
    local root = Instance.new("Folder")
    root.Name = "CastawayCove"
    root.Parent = workspace
    local regions: {[string]: Folder} = {}
    for _, spec in parts do
        local region = regions[spec.Region]
        if not region then
            region = Instance.new("Folder")
            region.Name = spec.Region
            region.Parent = root
            regions[spec.Region] = region
        end
        local obj = Instance.new(if spec.Spawn then "SpawnLocation" else "Part") :: BasePart
        obj.Name = spec.Name
        obj.Anchored = true
        obj.CanCollide = spec.Collide ~= false
        obj.TopSurface = Enum.SurfaceType.Smooth
        obj.BottomSurface = Enum.SurfaceType.Smooth
        obj.Size = Vector3.new(table.unpack(spec.Size))
        local r = spec.Rotation
        obj.CFrame = CFrame.new(table.unpack(spec.Position)) * CFrame.Angles(math.rad(r[1]), math.rad(r[2]), math.rad(r[3]))
        obj.Color = Color3.fromRGB(table.unpack(spec.Color))
        obj.Material = Enum.Material[spec.Material]
        obj.Transparency = spec.Transparency or 0
        if obj:IsA("Part") then obj.Shape = Enum.PartType[spec.Shape or "Block"] end
        if obj:IsA("SpawnLocation") then obj.Neutral = true; obj.Duration = 0 end
        obj.Parent = region
        if spec.Light then
            local light = Instance.new("PointLight")
            light.Color, light.Brightness, light.Range = obj.Color, spec.Light, 13
            light.Parent = obj
        end
        if spec.Text then
            local gui = Instance.new("BillboardGui")
            gui.Name = "Sign"
            gui.Size = UDim2.fromOffset(spec.TextWidth or 260, 72)
            gui.StudsOffset = Vector3.new(0, spec.TextOffset or 3, 0)
            gui.MaxDistance = 120
            gui.Parent = obj
            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.GothamBold
            label.TextColor3 = Color3.fromRGB(table.unpack(spec.TextColor or {255,244,211}))
            label.TextStrokeTransparency = .6
            label.TextSize = 20
            label.TextWrapped = true
            label.Text = spec.Text
            label.Parent = gui
        end
    end
    return root
end

return World
