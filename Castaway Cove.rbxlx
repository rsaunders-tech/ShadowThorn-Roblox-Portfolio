					<ProtectedString name="Source"><![CDATA[--!strict
-- Generated by tools/build_place.py. Edit its scene() to change world geometry.
local World = {}
local parts = {
{["Region"]="Scenery",["Name"]="Endless blue",["Position"]={450,-22,-20},["Size"]={1450,2,900},["Color"]={67,135,162},["Material"]="SmoothPlastic",["Rotation"]={0,0,0},["Collide"]=true},
{["Region"]="meadow",["Name"]="Island foundation",["Position"]={0,-9,-10},["Size"]={152,16,192},["Color"]={58,131,72},["Material"]="Slate",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Rounded shore",["Position"]={0,0,50},["Size"]={150,6,60},["Color"]={100,173,114},["Material"]="Grass",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="West bank",["Position"]={-68,-1,-35},["Size"]={16,4,110},["Color"]={100,173,114},["Material"]="Grass",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="East bank",["Position"]={68,-1,-35},["Size"]={16,4,110},["Color"]={100,173,114},["Material"]="Grass",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Far bank",["Position"]={0,-1,-98},["Size"]={150,4,16},["Color"]={100,173,114},["Material"]="Grass",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Lake bed",["Position"]={0,-6,-35},["Size"]={120,2,112},["Color"]={110,167,163},["Material"]="Sand",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Fishing water",["Position"]={0,1.1,-35},["Size"]={120,0.35,110},["Color"]={52,171,189},["Material"]="SmoothPlastic",["Rotation"]={0,0,0},["Transparency"]=0.19,["Collide"]=false},
{["Region"]="meadow",["Name"]="Water glint",["Position"]={-59,1.31,-35},["Size"]={0.16,0.05,108},["Color"]={190,235,231},["Material"]="SmoothPlastic",["Rotation"]={0,0,0},["Collide"]=false,["Transparency"]=0.4},
{["Region"]="meadow",["Name"]="Water glint",["Position"]={59,1.31,-35},["Size"]={0.16,0.05,108},["Color"]={190,235,231},["Material"]="SmoothPlastic",["Rotation"]={0,0,0},["Collide"]=false,["Transparency"]=0.4},
{["Region"]="meadow",["Name"]="Water glint",["Position"]={0,1.31,-89},["Size"]={116,0.05,0.16},["Color"]={190,235,231},["Material"]="SmoothPlastic",["Rotation"]={0,0,0},["Collide"]=false,["Transparency"]=0.4},
{["Region"]="meadow",["Name"]="Water glint",["Position"]={0,1.31,19},["Size"]={116,0.05,0.16},["Color"]={190,235,231},["Material"]="SmoothPlastic",["Rotation"]={0,0,0},["Collide"]=false,["Transparency"]=0.4},
{["Region"]="meadow",["Name"]="Fishing dock",["Position"]={0,4,14},["Size"]={14,0.9,62},["Color"]={143,104,74},["Material"]="WoodPlanks",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Dock front",["Position"]={0,4,-17},["Size"]={24,0.9,10},["Color"]={143,104,74},["Material"]="WoodPlanks",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Pier post",["Position"]={-8,0.5,-19},["Size"]={1.15,10,1.15},["Color"]={102,77,68},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Post cap",["Position"]={-8,5.7,-19},["Size"]={1.8,0.4,1.8},["Color"]={242,220,173},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Pier post",["Position"]={8,0.5,-19},["Size"]={1.15,10,1.15},["Color"]={102,77,68},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Post cap",["Position"]={8,5.7,-19},["Size"]={1.8,0.4,1.8},["Color"]={242,220,173},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Pier post",["Position"]={-8,0.5,-2},["Size"]={1.15,10,1.15},["Color"]={102,77,68},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Post cap",["Position"]={-8,5.7,-2},["Size"]={1.8,0.4,1.8},["Color"]={242,220,173},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Pier post",["Position"]={8,0.5,-2},["Size"]={1.15,10,1.15},["Color"]={102,77,68},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Post cap",["Position"]={8,5.7,-2},["Size"]={1.8,0.4,1.8},["Color"]={242,220,173},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Pier post",["Position"]={-8,0.5,16},["Size"]={1.15,10,1.15},["Color"]={102,77,68},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Post cap",["Position"]={-8,5.7,16},["Size"]={1.8,0.4,1.8},["Color"]={242,220,173},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Pier post",["Position"]={8,0.5,16},["Size"]={1.15,10,1.15},["Color"]={102,77,68},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Post cap",["Position"]={8,5.7,16},["Size"]={1.8,0.4,1.8},["Color"]={242,220,173},["Material"]="Wood",["Rotation"]={0,0,0}},
{["Region"]="meadow",["Name"]="Pier post",["Position"]={-8,0.5,39},["Size"]={1.15,10,1.15},["Color"]={102,77,68},["Material"]="Wood",["Rotation"]={0,0,0}},
