			<Item class="ModuleScript" referent="RBX0000037B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Pure authoritative fishing state machine. Clock and randomness come from server.
local Session = {}
function Session.new()
	return {Phase = "idle", Sequence = 0, Zone = "meadow", Relaxed = false, BiteAt = 0, ReelAt = 0,
		ReelPeriod = 2.4, ReelWidth = 0.5, ExpiresAt = 0, Message = "Cast a line and discover your first fish!"}
end
local function miss(s, message)
	s.Phase, s.Message, s.Last = "result", message, {Caught = false}
end
function Session.advance(s, now)
	if (s.Phase == "waiting" or s.Phase == "bite") and now >= s.BiteAt then
		if not s.Relaxed and now > s.ExpiresAt then
			miss(s, "The fish swam away. Cast again!"); s.Sequence += 1; return true
		elseif s.Phase == "waiting" then s.Phase = "bite"; s.Message = "A bite! Tap HOOK!"; return true end
	elseif s.Phase == "reeling" and now > s.ExpiresAt then
		miss(s, "Your line went slack. Try another cast!"); s.Sequence += 1; return true
	end
	return false
end
function Session.main(s, profile, config, rules, now, randomUnit, randomWeight)
	if s.Phase == "idle" or s.Phase == "result" then
		s.Last = nil
		s.Phase, s.Message = "waiting", "Watch your bobber..."
		local rod = config.Rods[profile.Rod] or config.Rods[1]
		s.BiteAt = now + (profile.Catches == 0 and 1.5 or rod.Wait) + randomWeight * 1.2
		s.ExpiresAt = s.BiteAt + (s.Relaxed and 120 or 4.5)
	elseif s.Phase == "waiting" or s.Phase == "bite" then
		if now < s.BiteAt - 0.12 then miss(s, "Too soon! Wait for the bobber to dip.")
		elseif not s.Relaxed and now > s.ExpiresAt then miss(s, "The fish swam away. Cast again!")
		else
			s.Phase, s.ReelAt = "reeling", now
			s.ReelPeriod, s.ReelWidth = s.Relaxed and 3.2 or 2.4, s.Relaxed and 0.8 or 0.5
			s.ExpiresAt = now + 24
			s.Message = "Tap REEL while the marker is inside the green!"
		end
	elseif s.Phase == "reeling" then
		if now > s.ExpiresAt then miss(s, "Your line went slack. Cast again!")
		elseif math.abs(rules.marker(now, s.ReelAt, s.ReelPeriod) - 0.5) <= s.ReelWidth / 2 + 0.09 then
			local fish, weight, value = rules.roll(config, s.Zone, profile.Rod, randomUnit, randomWeight)
			if not fish then return false, "This fishing area is unavailable." end
			local fresh, bonus = rules.award(profile, fish, weight, value)
			s.Phase = "result"
			s.Last = {Caught = true, Fish = fish.Id, Weight = weight, Value = value, New = fresh, Bonus = bonus}
			s.Message = (fresh and "New discovery! " or "Nice catch! ") .. fish.Name
		else miss(s, "Almost! Aim for the green on your next cast.") end
	else return false, "Wait for your current cast." end
	return true
end
return Session
]]></ProtectedString>
					<string name="ScriptGuid">{CBB1A984-28B0-4D0C-A996-5D3585E7149E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">FishingSession</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">531bf8b792add7d80af2cd5300000757</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX0000037C">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local shared = ReplicatedStorage:WaitForChild("CastawayCove")
local Config = require(shared:WaitForChild("Config"))
local Rules = require(shared:WaitForChild("FishingRules"))
local Session = require(script.Parent:WaitForChild("FishingSession"))
local Profiles = require(script.Parent:WaitForChild("Profiles")).new(Config, Rules)
local action = shared:WaitForChild("Action")
local stateRemote = shared:WaitForChild("State")
require(script.Parent:WaitForChild("World")).build(Config)
local sessions, limits, characterConnections = {}, {}, {}
local rng = Random.new()
local function publish(player, message)
	local s, p = sessions[player], Profiles:get(player)
	if not s or not p or player.Parent ~= Players then return end
	local packet = table.clone(s)
	packet.Profile, packet.SaveStatus = Rules.snapshot(p), Profiles:status(player)
	if message then packet.Message = message end
	stateRemote:FireClient(player, packet)
	local stats = player:FindFirstChild("leaderstats")
	if stats then stats.Fish.Value, stats.Discoveries.Value, stats.Coins.Value = p.Catches, p.Discovered, p.Coins end
end
local function atDock(player, s)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local zone = Config.ZoneById[s.Zone]
	return root and humanoid and humanoid.Health > 0 and zone and (root.Position - Vector3.new(table.unpack(zone.Spawn))).Magnitude < 58
end
local function move(player, zoneId)
	local zone = Config.ZoneById[zoneId]
	local character = player.Character
	if not zone or not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		local pos = Vector3.new(table.unpack(zone.Spawn))
		character:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, -20)))
		root.AssemblyLinearVelocity = Vector3.zero
	end
end
local function added(player)
	sessions[player] = Session.new()
	limits[player] = {At = 0, Sync = 0}
	local stats = Instance.new("Folder"); stats.Name = "leaderstats"; stats.Parent = player
	for _, key in ipairs({"Fish", "Discoveries", "Coins"}) do local v = Instance.new("IntValue"); v.Name = key; v.Parent = stats end
	characterConnections[player] = player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		local s = sessions[player]
		if s then s.Phase, s.Last, s.Message = "idle", nil, "Back on the dock. Cast a line!"; s.Sequence += 1; move(player, s.Zone); publish(player) end
	end)
	if not Profiles:load(player) then
		if player.Parent == Players then player:Kick("Your saved fishing progress could not load safely. Please rejoin in a moment.") end
		return
	end
	move(player, "meadow"); publish(player)
end
action.OnServerEvent:Connect(function(player, kind, sequence, payload)
	local s, limiter = sessions[player], limits[player]
	if not s or not limiter or type(kind) ~= "string" then return end
	local now = workspace:GetServerTimeNow()
	if kind == "sync" then
		if now - limiter.Sync >= 1 then limiter.Sync = now; publish(player) end
		return
	end
	if now - limiter.At < 0.14 then return end
	limiter.At = now
	if type(sequence) ~= "number" or sequence ~= sequence or sequence ~= s.Sequence then publish(player); return end
	local p = Profiles:get(player)
	if not p then return end
	Session.advance(s, now)
	local ok, result = Profiles:mutate(player, function(profile)
		if kind == "main" then
			if not atDock(player, s) then return "Head back to your fishing dock to cast." end
			local success, message = Session.main(s, profile, Config, Rules, now, rng:NextNumber(), rng:NextNumber())
			if not success then return message end
		elseif kind == "cancel" then s.Phase, s.Last, s.Message = "idle", nil, "Ready for a fresh cast."
		elseif kind == "relaxed" then
			if s.Phase ~= "idle" and s.Phase ~= "result" then return "Change relaxed fishing between casts." end
			s.Relaxed = not s.Relaxed
			s.Message = s.Relaxed and "Relaxed fishing on: unhurried bites and a wider reel target." or "Classic fishing on."
		elseif kind == "travel" then
			if type(payload) ~= "string" or #payload > 30 or not Rules.canTravel(profile, payload, Config) then return "Catch more fish to unlock that island." end
			s.Zone, s.Phase, s.Last = payload, "idle", nil
			s.Message = "Welcome to " .. Config.ZoneById[payload].Name .. "!"
			move(player, payload)
		elseif kind == "sell" then
			local count, coins = Rules.sell(profile)
			return count > 0 and ("Sold " .. count .. " fish for " .. coins .. " coins! Your journal keeps every discovery.") or "Your bag is empty. Catch a fish first!"
		elseif kind == "upgrade" then
			local _, message = Rules.upgrade(profile, Config); return message
		else return "Unknown fishing action." end
		return nil
	end)
	s.Sequence += 1
	publish(player, not ok and (result or "Please try again.") or result)
end)
local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
	elapsed += dt
	if elapsed < 0.1 then return end
	elapsed = 0
	local now = workspace:GetServerTimeNow()
	for player, s in pairs(sessions) do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root.Position.Y < -3 then
			s.Phase, s.Last, s.Message = "idle", nil, "Back on the dock. Your collection is safe!"
			s.Sequence += 1; move(player, s.Zone); publish(player)
		elseif Session.advance(s, now) then publish(player) end
	end
end)
Players.PlayerAdded:Connect(added)
Players.PlayerRemoving:Connect(function(player)
	if characterConnections[player] then characterConnections[player]:Disconnect(); characterConnections[player] = nil end
	sessions[player], limits[player] = nil, nil
	Profiles:remove(player)
end)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(added, player) end
game:BindToClose(function() Profiles:close() end)
print("Castaway Cove ready - 120 fish, six islands. Studio practice is session-only by default.")
]]></ProtectedString>
