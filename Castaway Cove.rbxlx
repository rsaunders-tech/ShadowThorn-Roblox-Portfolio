		<Item class="StarterPlayerScripts" referent="RBX00000380">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">StarterPlayerScripts</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">531bf8b792add7d80af2cd530000075c</UniqueId>
			</Properties>
			<Item class="LocalScript" referent="RBX00000381">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- The client paints the interface and cosmetic rod. All catches and money are server-owned.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("CastawayCove", 30)
assert(shared, "Castaway Cove shared files are missing")
local Config = require(shared:WaitForChild("Config"))
local actionRemote = shared:WaitForChild("Action")
local stateRemote = shared:WaitForChild("State")
local ink = Color3.fromRGB(27, 53, 66)
local muted = Color3.fromRGB(91, 112, 116)
local paper = Color3.fromRGB(255, 251, 235)
local teal = Color3.fromRGB(28, 117, 116)
local coral = Color3.fromRGB(218, 111, 76)
local green = Color3.fromRGB(98, 168, 113)
local state = { Profile = {Coins=0, Rod=1, Catches=0, Discovered=0, Collection={}, Bag={}},
	Phase="loading", Zone="meadow", Sequence=0, Message="Opening your fishing journal...", SaveStatus="Connecting" }
local currentPanel = nil
local filterZone = "all"
local lastSent = 0
local connections = {}
local alive = true

local function rgb(values)
	return Color3.fromRGB(values[1], values[2], values[3])
end

local function make(className, parent, props)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do object[key] = value end
	object.Parent = parent
	return object
end

local function round(object, radius)
	make("UICorner", object, {CornerRadius=UDim.new(0, radius or 12)})
end

local function outline(object, color, thickness)
	make("UIStroke", object, {Color=color or Color3.fromRGB(217, 226, 214), Thickness=thickness or 1})
end

local function label(parent, text, size, position, textSize, color, bold)
	return make("TextLabel", parent, {Text=text, Size=size, Position=position,
		BackgroundTransparency=1, TextColor3=color or ink, TextSize=textSize or 16,
		Font=if bold then Enum.Font.GothamBold else Enum.Font.Gotham,
		TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center,
		TextWrapped=true, BorderSizePixel=0})
end

local function button(parent, text, size, position, fill, callback)
	local object = make("TextButton", parent, {Text=text, Size=size, Position=position,
		BackgroundColor3=fill or teal, TextColor3=Color3.new(1,1,1), TextSize=15,
		Font=Enum.Font.GothamBold, BorderSizePixel=0, AutoButtonColor=true})
	round(object, 10)
	table.insert(connections, object.Activated:Connect(callback))
	return object
end

local function send(kind, payload)
	if state.Phase == "loading" and kind ~= "sync" then return end
	local now = os.clock()
	if kind ~= "sync" and now-lastSent < 0.17 then return end
	lastSent = now
	actionRemote:FireServer(kind, state.Sequence, payload)
end

local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
	Name="CastawayCoveUI", ResetOnSpawn=false, ZIndexBehavior=Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset=false, DisplayOrder=10})
local screen = make("Frame", gui, {Name="Layout", Size=UDim2.fromScale(1,1), BackgroundTransparency=1})

local header = make("Frame", screen, {Name="Header", BackgroundColor3=paper,
	Size=UDim2.new(0.94,0,0,94), Position=UDim2.new(0.03,0,0,12), BorderSizePixel=0})
round(header,16)
outline(header)
local title = label(header, "CASTAWAY COVE", UDim2.new(0.46,0,0,27), UDim2.fromOffset(16,10), 18, ink, true)
local subtitle = label(header, "A little cast. A big discovery.", UDim2.new(0.6,-20,0,20), UDim2.fromOffset(16,37), 12, muted)
local stats = label(header, "0 coins  ·  0 catches", UDim2.new(0.55,-26,0,24), UDim2.new(0.45,0,0,12), 16, teal, true)
stats.TextXAlignment = Enum.TextXAlignment.Right
local collectionStat = label(header, "JOURNAL   0 / 120", UDim2.new(0.44,-25,0,20), UDim2.new(0.56,0,0,39), 12, ink, true)
collectionStat.TextXAlignment=Enum.TextXAlignment.Right
local progressTrack = make("Frame", header, {Size=UDim2.new(1,-32,0,6),Position=UDim2.fromOffset(16,72),BackgroundColor3=Color3.fromRGB(225,232,215),BorderSizePixel=0})
round(progressTrack,3)
local progressFill = make("Frame",progressTrack,{Size=UDim2.fromScale(0,1),BackgroundColor3=green,BorderSizePixel=0})
round(progressFill,3)

local nav = make("Frame", screen, {Name="Navigation",BackgroundTransparency=1,Size=UDim2.new(0.94,0,0,40),Position=UDim2.new(0.03,0,0,114)})
local navLayout = make("UIListLayout",nav,{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder})
local openPanel
local journalButton = button(nav,"Journal [C]",UDim2.new(0.25,-6,1,0),UDim2.new(),teal,function() openPanel("journal") end)
local zonesButton = button(nav,"Travel [Z]",UDim2.new(0.25,-6,1,0),UDim2.new(),teal,function() openPanel("zones") end)
local rodsButton = button(nav,"Rods [U]",UDim2.new(0.25,-6,1,0),UDim2.new(),teal,function() openPanel("rods") end)
local helpButton = button(nav,"How to play",UDim2.new(0.25,-6,1,0),UDim2.new(),teal,function() openPanel("help") end)
journalButton.LayoutOrder=1; zonesButton.LayoutOrder=2; rodsButton.LayoutOrder=3; helpButton.LayoutOrder=4

local zoneLabel = label(screen,"MEADOW LAKE",UDim2.new(0.7,0,0,27),UDim2.new(0.03,0,0,168),17,Color3.new(1,1,1),true)
zoneLabel.TextStrokeColor3=ink
zoneLabel.TextStrokeTransparency=0.45
local saveLabel = label(screen,"",UDim2.new(0.8,0,0,20),UDim2.new(0.03,0,0,195),11,Color3.new(1,1,1))
saveLabel.TextStrokeColor3=ink
saveLabel.TextStrokeTransparency=0.35

local footer = make("Frame",screen,{Name="FishingCard",AnchorPoint=Vector2.new(0.5,1),
	Size=UDim2.new(0.94,0,0,216),Position=UDim2.new(0.5,0,1,-12),BackgroundColor3=paper,BorderSizePixel=0})
make("UISizeConstraint",footer,{MaxSize=Vector2.new(670,216)})
local footerScale=make("UIScale",footer,{Scale=1})
round(footer,18); outline(footer)
local statusTitle = label(footer,"Ready when you are",UDim2.new(1,-32,0,27),UDim2.fromOffset(16,13),20,ink,true)
local statusDescription = label(footer,"Stand on the dock and cast your line.",UDim2.new(1,-32,0,34),UDim2.fromOffset(16,43),14,muted)
local timingTrack = make("Frame",footer,{Name="ReelTrack",Size=UDim2.new(1,-40,0,20),Position=UDim2.fromOffset(20,86),BackgroundColor3=Color3.fromRGB(218,227,217),BorderSizePixel=0})
round(timingTrack,10)
local target = make("Frame",timingTrack,{Size=UDim2.fromScale(0.5,1),Position=UDim2.fromScale(0.25,0),BackgroundColor3=green,BorderSizePixel=0})
round(target,10)
local marker = make("Frame",timingTrack,{AnchorPoint=Vector2.new(0.5,0.5),Size=UDim2.new(0,5,1,10),Position=UDim2.fromScale(0.5,0.5),BackgroundColor3=ink,BorderSizePixel=0})
round(marker,3)
local mainButton = button(footer,"Cast your line  [SPACE]",UDim2.new(1,-32,0,46),UDim2.fromOffset(16,117),coral,function() if not currentPanel then send("main") end end)
local bagButton = button(footer,"Sell bag · 0 coins",UDim2.new(0.57,-20,0,30),UDim2.fromOffset(16,174),teal,function() send("sell") end)
local relaxedButton = button(footer,"Relaxed: OFF",UDim2.new(0.43,-20,0,30),UDim2.new(0.57,4,0,174),Color3.fromRGB(113,133,120),function() send("relaxed") end)
bagButton.TextSize=12; relaxedButton.TextSize=12

local reward = make("Frame",screen,{Name="CatchReward",AnchorPoint=Vector2.new(0.5,0.5),
	Position=UDim2.fromScale(0.5,0.47),Size=UDim2.fromOffset(280,110),BackgroundColor3=paper,BorderSizePixel=0,Visible=false})
round(reward,20); outline(reward)
local rewardFish = make("Frame",reward,{Position=UDim2.fromOffset(16,26),Size=UDim2.fromOffset(72,50),BackgroundTransparency=1})
local rewardName = label(reward,"",UDim2.new(1,-100,0,48),UDim2.fromOffset(92,15),19,ink,true)
local rewardDetail = label(reward,"",UDim2.new(1,-100,0,34),UDim2.fromOffset(92,62),12,muted)

local veil = make("TextButton",screen,{Name="ModalShade",Size=UDim2.fromScale(1,1),BackgroundColor3=ink,BackgroundTransparency=0.3,BorderSizePixel=0,Text="",Visible=false,AutoButtonColor=false,ZIndex=30})
local modal = make("Frame",veil,{Name="Panel",AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.new(0.94,0,0.78,0),BackgroundColor3=paper,BorderSizePixel=0,ZIndex=31})
make("UISizeConstraint",modal,{MaxSize=Vector2.new(720,620)})
round(modal,18)
local modalTitle = label(modal,"Your journal",UDim2.new(1,-90,0,34),UDim2.fromOffset(20,16),23,ink,true)
modalTitle.ZIndex=32
local modalSubtitle = label(modal,"",UDim2.new(1,-40,0,36),UDim2.fromOffset(20,54),13,muted)
modalSubtitle.ZIndex=32
local closeButton = button(modal,"X",UDim2.fromOffset(36,36),UDim2.new(1,-54,0,14),teal,function() openPanel(nil) end)
closeButton.ZIndex=33
local filters = make("ScrollingFrame",modal,{Name="Filters",Size=UDim2.new(1,-40,0,36),Position=UDim2.fromOffset(20,100),BackgroundTransparency=1,BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.X,ScrollingDirection=Enum.ScrollingDirection.X,ScrollBarThickness=2,ZIndex=32})
make("UIListLayout",filters,{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
local content = make("ScrollingFrame",modal,{Name="Content",Size=UDim2.new(1,-40,1,-158),Position=UDim2.fromOffset(20,148),BackgroundTransparency=1,BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=4,ScrollBarImageColor3=teal,ZIndex=32})
local listLayout = make("UIListLayout",content,{Padding=UDim.new(0,9),SortOrder=Enum.SortOrder.LayoutOrder})
make("UIPadding",content,{PaddingRight=UDim.new(0,7),PaddingBottom=UDim.new(0,10)})

local function fishIcon(parent, color, locked)
	for _,child in parent:GetChildren() do child:Destroy() end
	color=if locked then Color3.fromRGB(174,188,181) else color
	local tail=make("Frame",parent,{Size=UDim2.fromScale(0.32,0.48),Position=UDim2.fromScale(0.02,0.24),Rotation=45,BackgroundColor3=color,BorderSizePixel=0,ZIndex=parent.ZIndex})
	round(tail,4)
	local body=make("Frame",parent,{Size=UDim2.fromScale(0.73,0.62),Position=UDim2.fromScale(0.22,0.19),BackgroundColor3=color,BorderSizePixel=0,ZIndex=parent.ZIndex})
	round(body,30)
	local fin=make("Frame",body,{Size=UDim2.fromScale(0.20,0.45),Position=UDim2.fromScale(0.40,0.36),Rotation=-20,BackgroundColor3=color:Lerp(ink,0.22),BorderSizePixel=0,ZIndex=parent.ZIndex})
	round(fin,5)
	local eye=make("Frame",body,{Size=UDim2.fromOffset(5,5),Position=UDim2.fromScale(0.76,0.32),BackgroundColor3=ink,BorderSizePixel=0,ZIndex=parent.ZIndex+1})
	round(eye,5)
	if locked then
		local question=label(parent,"?",UDim2.fromScale(1,1),UDim2.new(),22,paper,true)
		question.TextXAlignment=Enum.TextXAlignment.Center; question.ZIndex=parent.ZIndex+2
	end
end

local function clearRows()
	for _, child in content:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
	end
end

local function row(height)
	local frame=make("Frame",content,{Size=UDim2.new(1,0,0,height or 86),BackgroundColor3=Color3.fromRGB(243,243,226),BorderSizePixel=0,ZIndex=33})
	round(frame,12)
	return frame
end

local function rowLabel(parent,text,size,pos,textSize,color,bold)
	local item=label(parent,text,size,pos,textSize,color,bold)
	item.ZIndex=34
	return item
end

local function bagTotals()
	local count,value=0,0
	for _,entry in pairs(state.Profile.Bag or {}) do
		count+=entry.Count or 0
		value+=entry.Value or 0
	end
	return count,value
end

local rebuildPanel
local function addFilter(text,id)
	local item=button(filters,text,UDim2.fromOffset(if id=="all" then 72 else 116,30),UDim2.new(),if filterZone==id then teal else Color3.fromRGB(123,145,133),function()
		filterZone=id; rebuildPanel()
	end)
	item.ZIndex=33; item.TextSize=11
end

rebuildPanel=function()
	if not currentPanel then return end
	clearRows()
	for _,child in filters:GetChildren() do if child:IsA("GuiButton") then child:Destroy() end end
	-- Destroyed rows disconnect their events; discard their handles as well.
	for index=#connections,1,-1 do
		if not connections[index].Connected then table.remove(connections,index) end
	end
	filters.Visible=currentPanel=="journal"
	content.Position=UDim2.fromOffset(20,if currentPanel=="journal" then 148 else 100)
	content.Size=UDim2.new(1,-40,1,if currentPanel=="journal" then -158 else -110)
	if currentPanel=="journal" then
		modalTitle.Text="Your fish journal"
		modalSubtitle.Text=string.format("%d / %d discovered · Selling fish keeps your discoveries.",state.Profile.Discovered or 0,#Config.Fish)
		addFilter("All waters","all")
		for _,zone in ipairs(Config.Zones) do addFilter(zone.Name,zone.Id) end
		for index,fish in ipairs(Config.Fish) do
			if filterZone~="all" and fish.Zone~=filterZone then continue end
			local entry=state.Profile.Collection[fish.Id]
			local found=entry and (entry.Count or 0)>0
			local frame=row(86)
			frame.LayoutOrder=index
			local icon=make("Frame",frame,{Size=UDim2.fromOffset(57,43),Position=UDim2.fromOffset(11,20),BackgroundTransparency=1,ZIndex=34})
			fishIcon(icon,rgb(fish.Color),not found)
			rowLabel(frame,if found then fish.Name else "Undiscovered fish",UDim2.new(1,-89,0,27),UDim2.fromOffset(77,10),15,ink,true)
			local zone=Config.ZoneById[fish.Zone]
			rowLabel(frame,(zone and zone.Name or fish.Zone).." · "..fish.Rarity,UDim2.new(1,-89,0,20),UDim2.fromOffset(77,36),12,rgb(Config.Rarities[fish.Rarity].Color))
			rowLabel(frame,if found then string.format("Caught %d · Best %.2f kg",entry.Count,entry.Best or 0) else "Cast here to reveal this journal entry.",UDim2.new(1,-89,0,20),UDim2.fromOffset(77,57),11,muted)
		end
	elseif currentPanel=="zones" then
		modalTitle.Text="Find your next fishing spot"
		modalSubtitle.Text="Catch fish to open new waters. Travel is free."
		for index,zone in ipairs(Config.Zones) do
			local frame=row(110)
			frame.LayoutOrder=index
			local unlocked=state.Profile.Catches>=zone.Unlock
			rowLabel(frame,zone.Name,UDim2.new(1,-130,0,25),UDim2.fromOffset(14,10),17,ink,true)
			rowLabel(frame,zone.Description,UDim2.new(1,-28,0,36),UDim2.fromOffset(14,39),12,muted)
			rowLabel(frame,if unlocked then "20 fish to discover" else string.format("Opens at %d lifetime catches (%d to go)",zone.Unlock,zone.Unlock-state.Profile.Catches),UDim2.new(1,-28,0,20),UDim2.fromOffset(14,80),11,muted)
			local b=button(frame,if state.Zone==zone.Id then "You are here" elseif unlocked then "Travel" else "Locked",UDim2.fromOffset(102,30),UDim2.new(1,-116,0,10),if unlocked then teal else Color3.fromRGB(148,158,145),function() if unlocked then send("travel",zone.Id); openPanel(nil) end end)
			b.TextSize=11; b.ZIndex=34
		end
	elseif currentPanel=="rods" then
		modalTitle.Text="A trusty rod for every journey"
		modalSubtitle.Text="Better rods bring quicker bites and better rare-fish odds."
		for index,rod in ipairs(Config.Rods) do
			local frame=row(116)
			frame.LayoutOrder=index
			rowLabel(frame,rod.Name,UDim2.new(1,-28,0,25),UDim2.fromOffset(14,10),17,ink,true)
			rowLabel(frame,string.format("Luck x%.1f · Base bite wait %.1fs",rod.Luck,rod.Wait),UDim2.new(1,-28,0,25),UDim2.fromOffset(14,40),12,muted)
			local caption=if index<=state.Profile.Rod then (if index==state.Profile.Rod then "Equipped" else "Owned") elseif index==state.Profile.Rod+1 then string.format("Upgrade · %d coins",rod.Cost) else string.format("%d coins · Buy previous rod first",rod.Cost)
			local buy=button(frame,caption,UDim2.new(1,-28,0,30),UDim2.fromOffset(14,76),if index==state.Profile.Rod+1 then coral else Color3.fromRGB(123,145,133),function() if index==state.Profile.Rod+1 then send("upgrade") end end)
			buy.ZIndex=34; buy.TextSize=12
		end
	else
		modalTitle.Text="A simple day on the water"
		modalSubtitle.Text="Unlimited bait. No rush. Every discovery stays in your journal."
		local steps={
			{"1   CAST", "Walk onto the dock. Tap Cast your line or press Space."},
			{"2   WAIT FOR THE BITE", "When the button says HOOK, tap it. Pulling early lets the fish escape."},
			{"3   REEL IT IN", "Tap when the dark marker crosses the green part of the meter. One good tap catches the fish."},
			{"4   COLLECT & EXPLORE", "Sell your bag for coins, upgrade rods, and unlock six waters through lifetime catches. Every 10 new fish grants a bonus."},
			{"TAKE IT EASY", "Enable Relaxed between casts for a generous fishing window. You can cancel a cast by opening Travel and choosing a destination."},
			{"CONTROLS", "Space: fishing · C: journal · U: rods · Z: travel. All controls also have touch buttons."},
		}
		for index,step in ipairs(steps) do
			local frame=row(104)
			frame.LayoutOrder=index
			rowLabel(frame,step[1],UDim2.new(1,-28,0,24),UDim2.fromOffset(14,8),14,teal,true)
			rowLabel(frame,step[2],UDim2.new(1,-28,0,61),UDim2.fromOffset(14,34),13,muted)
		end
	end
end

openPanel=function(name)
	if currentPanel==name then name=nil end
	currentPanel=name
	veil.Visible=name~=nil
	if name then
		content.CanvasPosition=Vector2.zero
		rebuildPanel()
	end
end

local function updateHud()
	local profile=state.Profile
	stats.Text=string.format("%d coins  ·  %d catches",profile.Coins or 0,profile.Catches or 0)
	collectionStat.Text=string.format("JOURNAL   %d / %d",profile.Discovered or 0,#Config.Fish)
	progressFill.Size=UDim2.fromScale(math.clamp((profile.Discovered or 0)/#Config.Fish,0,1),1)
	local zone=Config.ZoneById[state.Zone]
	zoneLabel.Text=string.upper(zone and zone.Name or state.Zone)
	local rod=Config.Rods[profile.Rod or 1]
	saveLabel.Text=(rod and rod.Name or "Starter rod").."  ·  "..tostring(state.SaveStatus or "")
	local count,value=bagTotals()
	bagButton.Text=string.format("Sell %d fish · %d coins",count,value)
	relaxedButton.Text="Relaxed: "..(if state.Relaxed then "ON" else "OFF")
	relaxedButton.BackgroundColor3=if state.Relaxed then teal else Color3.fromRGB(113,133,120)
	timingTrack.Visible=state.Phase=="reeling"
	if currentPanel then rebuildPanel() end
	local result=state.Last
	reward.Visible=state.Phase=="result" and result~=nil and result.Caught~=false and result.Fish~=nil
	if reward.Visible then
		local fish=Config.ById[result.Fish]
		if fish then
			fishIcon(rewardFish,rgb(fish.Color),false)
			rewardName.Text=(if result.New then "NEW! " else "")..fish.Name
			rewardDetail.Text=string.format("%.2f kg · %d coins\n%s",result.Weight or 0,result.Value or 0,fish.Rarity)
		end
	end
end

local function updateFishingCard()
	local phase=state.Phase
	local now=workspace:GetServerTimeNow()
	mainButton.Active=true
	mainButton.BackgroundColor3=coral
	if phase=="loading" then
		statusTitle.Text="Getting your gear ready"
		statusDescription.Text=state.Message or "Connecting to the cove..."
		mainButton.Text="Loading..."
		mainButton.Active=false
	elseif phase=="idle" then
		statusTitle.Text="What will you discover?"
		statusDescription.Text=if state.Message and state.Message~="" then state.Message else "Stand on your dock and cast. Bait is unlimited."
		mainButton.Text=if UserInputService.TouchEnabled then "Cast your line" else "Cast your line  [SPACE]"
	elseif phase=="waiting" or phase=="bite" then
		if phase=="bite" or now >= (state.BiteAt or math.huge) then
			statusTitle.Text="A fish is biting!"
			statusDescription.Text=if state.Relaxed then "Take your time. Tap Hook to start reeling." else "Tap Hook before this fish gets away!"
			mainButton.Text="HOOK!"
			mainButton.BackgroundColor3=teal
		else
			statusTitle.Text="A quiet moment on the water..."
			statusDescription.Text="Watch your bobber. Wait for the bite!"
			mainButton.Text="Waiting for a bite..."
			mainButton.BackgroundColor3=Color3.fromRGB(128,146,135)
		end
	elseif phase=="reeling" then
		statusTitle.Text="Bring it home!"
		statusDescription.Text=state.Message or "Tap once when the dark marker is inside the green."
		mainButton.Text="REEL IT IN!"
		local period=state.ReelPeriod or 2.4
		local markerPosition=1-math.abs(((math.max(0,now-(state.ReelAt or now))%period)/period)*2-1)
		marker.Position=UDim2.fromScale(markerPosition,0.5)
		local width=state.ReelWidth or 0.5
		target.Size=UDim2.fromScale(width,1)
		target.Position=UDim2.fromScale((1-width)/2,0)
	elseif phase=="result" then
		local result=state.Last
		local fish=result and Config.ById[result.Fish]
		if result and result.Caught~=false and fish then
			statusTitle.Text=if result.New then "A new page in your journal!" else "A lovely catch!"
			statusDescription.Text=string.format("%s · %.2f kg · %d coins%s",fish.Name,result.Weight or 0,result.Value or 0,if (result.Bonus or 0)>0 then " + collection bonus!" else "")
		else
			statusTitle.Text="The next one is yours"
			statusDescription.Text=state.Message or "This fish slipped away. Cast again!"
		end
		mainButton.Text="Next cast"
	else
		statusTitle.Text="A moment, please"
		statusDescription.Text=state.Message or "Your fishing session is catching up."
		mainButton.Text="Wait..."
		mainButton.Active=false
	end
end

local function responsive()
	local width=screen.AbsoluteSize.X
	local height=screen.AbsoluteSize.Y
	local compact=width<560
	local short=height<500
	footerScale.Scale=if short then math.clamp(height/520,0.62,1) else 1
	header.Size=UDim2.new(0.94,0,0,if short then 60 else 94)
	nav.Position=UDim2.new(0.03,0,0,if short then 80 else 114)
	subtitle.Visible=not short
	progressTrack.Visible=not short
	zoneLabel.Visible=not short
	saveLabel.Visible=not short
	title.TextSize=if compact then 14 else 18
	stats.TextSize=if compact then 12 else 16
	subtitle.Text=if compact then "Catch. Collect. Explore." else "A little cast. A big discovery."
	for _,b in ipairs({journalButton,zonesButton,rodsButton,helpButton}) do b.TextSize=if compact then 11 else 14 end
	journalButton.Text=if compact then "Journal" else "Journal [C]"
	zonesButton.Text=if compact then "Travel" else "Travel [Z]"
	rodsButton.Text=if compact then "Rods" else "Rods [U]"
	helpButton.Text=if compact then "Help" else "How to play"
	statusTitle.TextSize=if compact then 17 else 20
	statusDescription.TextSize=if compact then 12 else 14
	modalTitle.TextSize=if compact then 18 else 23
	zoneLabel.TextSize=if compact then 14 else 17
	reward.Size=if compact then UDim2.fromOffset(250,102) else UDim2.fromOffset(280,110)
	reward.Visible=reward.Visible and screen.AbsoluteSize.Y>540
end

-- Cosmetic rod and bobber are intentionally local and cannot award fish.
local cosmetics=make("Folder",workspace,{Name="CastawayCoveLocalFishing"})
local rod=make("Part",cosmetics,{Name="Rod",Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,Size=Vector3.new(0.09,4.4,0.09),Color=Color3.fromRGB(118,78,47),Material=Enum.Material.Wood})
local tip=make("Attachment",rod,{Position=Vector3.new(0,2.2,0)})
local bobber=make("Part",cosmetics,{Name="Bobber",Shape=Enum.PartType.Ball,Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,Size=Vector3.new(0.45,0.45,0.45),Color=coral,Material=Enum.Material.SmoothPlastic,Transparency=1})
local bobberAttachment=make("Attachment",bobber,{})
local line=make("Beam",cosmetics,{Attachment0=tip,Attachment1=bobberAttachment,FaceCamera=true,Width0=0.018,Width1=0.018,Color=ColorSequence.new(Color3.fromRGB(244,242,214)),Enabled=false,LightEmission=0.1})

table.insert(connections,stateRemote.OnClientEvent:Connect(function(payload)
	if type(payload)~="table" or type(payload.Profile)~="table" then return end
	if type(payload.Sequence)~="number" then return end
	if payload.Sequence<state.Sequence then return end
	state=payload
	state.Profile.Collection=state.Profile.Collection or {}
	state.Profile.Bag=state.Profile.Bag or {}
	updateHud()
	updateFishingCard()
	responsive()
end))

table.insert(connections,UserInputService.InputBegan:Connect(function(input,processed)
	if processed or UserInputService:GetFocusedTextBox() then return end
	if input.KeyCode==Enum.KeyCode.Space then
		if not currentPanel then send("main") end
	elseif input.KeyCode==Enum.KeyCode.C then openPanel("journal")
	elseif input.KeyCode==Enum.KeyCode.U then openPanel("rods")
	elseif input.KeyCode==Enum.KeyCode.Z then openPanel("zones")
	elseif input.KeyCode==Enum.KeyCode.Escape and currentPanel then openPanel(nil)
	end
end))
table.insert(connections,UserInputService.WindowFocused:Connect(function() send("sync") end))
table.insert(connections,screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(responsive))
table.insert(connections,RunService.RenderStepped:Connect(function()
	if not alive then return end
	updateFishingCard()
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	local fishing=state.Phase=="waiting" or state.Phase=="bite" or state.Phase=="reeling"
	rod.Transparency=if root and humanoid and humanoid.Health>0 then 0 else 1
	if root then
		rod.CFrame=root.CFrame*CFrame.new(1.1,0.7,-1.3)*CFrame.Angles(math.rad(-38),0,math.rad(-10))
	end
	local zone=Config.ZoneById[state.Zone]
	if fishing and zone then
		local time=workspace:GetServerTimeNow()
		local bite=time>=(state.BiteAt or math.huge)
		bobber.Position=Vector3.new(zone.Spawn[1]+2,2.5+math.sin(time*(if bite then 12 else 2))*0.14,-22)
		bobber.Transparency=0
		line.Enabled=true
	else
		bobber.Transparency=1
		line.Enabled=false
	end
end))

table.insert(connections,script.Destroying:Connect(function()
	alive=false
	for _,connection in ipairs(connections) do connection:Disconnect() end
	cosmetics:Destroy()
	gui:Destroy()
end))

updateHud()
updateFishingCard()
responsive()
send("sync")
-- Covers a first sync racing the server's profile load without repeatedly polling.
task.delay(4,function() if alive and state.Phase=="loading" then send("sync") end end)
]]></ProtectedString>
