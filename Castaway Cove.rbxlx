					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Original collection: twenty distinct fish in each of six habitats.
local Config: any = {
	Title = "Castaway Cove",
	DataStoreName = "CastawayCove_v1",
	-- Set true only in a separately published TEST experience with Studio API access.
	-- Published Roblox servers always save; Studio practice is temporary by default.
	StudioPersistence = false,
	Zones = {
		{Id="meadow", Name="Meadow Pond", Unlock=0, Description="A cozy pond for your first cast.", Color={118,181,118}, Water={81,176,181}, Spawn={0,8,20}},
		{Id="river", Name="Willow River", Unlock=10, Description="Follow the current to river giants.", Color={100,166,139}, Water={70,152,189}, Spawn={180,8,20}},
		{Id="coral", Name="Coral Lagoon", Unlock=25, Description="Bright reef fish and hidden treasures.", Color={244,157,120}, Water={51,196,202}, Spawn={360,8,20}},
		{Id="frost", Name="Frostwater Lake", Unlock=50, Description="Icy waters hide shimmering catches.", Color={167,209,230}, Water={100,165,220}, Spawn={540,8,20}},
		{Id="volcanic", Name="Ember Springs", Unlock=80, Description="A warm crater full of fiery surprises.", Color={225,127,86}, Water={164,94,103}, Spawn={720,8,20}},
		{Id="celestial", Name="Starlight Bay", Unlock=120, Description="Cast beneath the stars for cosmic fish.", Color={173,147,225}, Water={104,99,184}, Spawn={900,8,20}},
	},
	Rods = {
		{Name="Driftwood Rod", Cost=0, Luck=1, Wait=4},
		{Name="Willow Rod", Cost=350, Luck=1.3, Wait=3.6},
		{Name="Coral Rod", Cost=1400, Luck=1.7, Wait=3.2},
		{Name="Starlight Rod", Cost=4500, Luck=2.2, Wait=2.8},
	},
	Rarities = {
		Common={Color={185,206,206}, Weight=10, Rank=1},
		Uncommon={Color={119,222,154}, Weight=5, Rank=2},
		Rare={Color={112,181,255}, Weight=2, Rank=3},
		Epic={Color={207,145,255}, Weight=0.6, Rank=4},
		Legendary={Color={255,210,102}, Weight=0.15, Rank=5},
	},
	Fish = {},
	ById = {},
	ZoneById = {},
}

-- Name, minimum weight in kg, maximum weight in kg. These are game breeds,
-- not a biological field guide. Fantasy entries are intentionally whimsical.
local breeds = {
	{
		{"Silver Minnow",0.05,0.3}, {"Sunny Sunfish",0.2,1.2}, {"Moss Perch",0.3,1.8}, {"Pebble Guppy",0.02,0.15},
		{"Puddle Roach",0.2,1.5}, {"Duckweed Dace",0.1,0.8}, {"Copper Bream",0.4,2.5}, {"Reed Stickleback",0.03,0.2},
		{"Bluebell Trout",0.8,4}, {"Willow Carp",1,6}, {"Button Bluegill",0.3,1.7}, {"Lilypad Loach",0.2,1.4}, {"Velvet Catfish",1.5,8},
		{"Painted Koi",1,5}, {"Glass Eel",0.4,2}, {"Ribbon Shiner",0.2,1.1}, {"Honey Tench",1.2,7},
		{"Moonpetal Gourami",0.8,3.5}, {"Crown Goldfish",0.5,3}, {"Pondkeeper Sturgeon",8,35},
	},
	{
		{"Brook Chub",0.2,1.6}, {"River Barbel",0.7,5}, {"Sand Gudgeon",0.1,0.7}, {"Banded Sculpin",0.1,0.9},
		{"Current Bleak",0.2,1}, {"Speckled Darter",0.05,0.4}, {"Creek Sucker",0.4,3}, {"Stone Goby",0.1,0.6},
		{"Rainbow Trout",0.8,7}, {"Leaping Salmon",2,12}, {"Smallmouth Bass",0.8,4.5}, {"Channel Catfish",2,14}, {"Whisker Burbot",1,7},
		{"Tiger Muskie",4,20}, {"Spotted Gar",3,15}, {"Royal Grayling",1,6}, {"Silver Paddlefish",5,28},
		{"Waterfall Arowana",3,18}, {"Jade Mahseer",6,32}, {"River King Arapaima",15,80},
	},
	{
		{"Clown Anemonefish",0.1,0.5}, {"Lemon Damselfish",0.1,0.7}, {"Parrotfish",1,7}, {"Striped Sergeant",0.2,1.2},
		{"Butterflyfish",0.1,1.1}, {"Sailfin Blenny",0.1,0.6}, {"Neon Cleaner Wrasse",0.1,0.8}, {"Spotted Puffer",0.4,2.3},
		{"Blue Tang",0.5,3}, {"Mandarin Dragonet",0.1,0.9}, {"Hawkfish",0.3,1.6}, {"Coral Grouper",2,14}, {"Banner Moorish Idol",0.3,2},
		{"Lionfish",0.7,4}, {"Pearl Triggerfish",1,6}, {"Ribbon Moray",1.5,9}, {"Giant Trevally",5,30},
		{"Prism Angelfish",1,5}, {"Seashell Seahorse",0.1,0.8}, {"Reef Guardian Napoleon",12,70},
	},
	{
		{"Ice Smelt",0.1,0.8}, {"Snow Herring",0.2,1.7}, {"Frost Saffron Cod",0.4,3}, {"Polar Capelin",0.1,0.9},
		{"Glacier Sculpin",0.2,1.2}, {"Silver Whitefish",0.7,4}, {"Winter Ruffe",0.2,1.3}, {"Chill Cisco",0.5,2.8},
		{"Arctic Char",1,8}, {"Lake Trout",1.5,12}, {"Crystal Haddock",1,7}, {"Snowflake Flounder",1.2,8}, {"Woolly Wolffish",2,15},
		{"Aurora Dolly Varden",1.5,9}, {"Frostfang Pike",3,18}, {"Mirror Halibut",5,35}, {"Lantern Icefish",0.3,2},
		{"Crown Taimen",8,45}, {"Opal Oarfish",6,32}, {"Glacier Emperor Cod",15,85},
	},
	{
		{"Ash Anchovy",0.1,0.6}, {"Ember Mullet",0.5,3}, {"Cinder Goby",0.1,0.9}, {"Obsidian Loach",0.3,1.6},
		{"Soot Sardine",0.1,0.7}, {"Copper Killifish",0.1,0.5}, {"Steam Tilapia",0.8,5}, {"Pebble Pupfish",0.05,0.4},
		{"Flare Betta",0.1,0.8}, {"Magma Discus",0.4,2.5}, {"Coalfin Catfish",2,14}, {"Ruby Snapper",1.5,10}, {"Torch Cichlid",0.7,4},
		{"Firecrest Lionfish",1,6}, {"Lava Serpent Eel",3,20}, {"Sunforge Sturgeon",7,35}, {"Blazing Barracuda",3,22},
		{"Phoenix Sailfish",8,40}, {"Molten Dragonfish",5,28}, {"Volcano Sovereign Coelacanth",18,90},
	},
	{
		{"Stardust Sprat",0.1,0.8}, {"Comet Tetra",0.1,0.6}, {"Orbit Rasbora",0.1,0.7}, {"Moonbeam Medaka",0.05,0.5},
		{"Twilight Danio",0.1,0.8}, {"Satellite Saury",0.4,2.5}, {"Nebula Noodlefish",0.2,1.3}, {"Lunar Flyingfish",0.5,3},
		{"Astral Hatchetfish",0.3,2}, {"Meteor Marlin",6,32}, {"Eclipse Knifefish",1,8}, {"Galaxy Guitarfish",4,22}, {"Constellation Lanternfish",0.4,3},
		{"Quasar Swordfish",8,45}, {"Cosmic Sunfish",10,55}, {"Dreamweaver Angler",3,18}, {"Wishing Star Ray",6,35},
		{"Celestial Dragon Koi",4,24}, {"Infinity Ribbonfish",8,48}, {"Starwhale Leviathan",25,120},
	},
}

for zoneIndex, zone in ipairs(Config.Zones) do
	Config.ZoneById[zone.Id] = zone
	for fishIndex, row in ipairs(breeds[zoneIndex]) do
		local rarity = if fishIndex <= 8 then "Common" elseif fishIndex <= 13 then "Uncommon" elseif fishIndex <= 17 then "Rare" elseif fishIndex <= 19 then "Epic" else "Legendary"
		local base = ({8,16,38,90,250})[Config.Rarities[rarity].Rank]
		local fish = {
			Id = string.format("%s_%02d", zone.Id, fishIndex), Name=row[1], Zone=zone.Id, Rarity=rarity,
			Value=base * zoneIndex, MinWeight=row[2], MaxWeight=row[3],
			Color={math.min(255,zone.Color[1] + (fishIndex%3)*17), math.max(45,zone.Color[2] - (fishIndex%4)*13), math.min(255,zone.Color[3] + (fishIndex%5)*11)},
		}
		table.insert(Config.Fish, fish)
		Config.ById[fish.Id] = fish
	end
end

return Config
]]></ProtectedString>
					<string name="ScriptGuid">{FBE1A52F-D78E-4A73-B1D1-E660920E9C4B}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Config</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">531bf8b792add7d80af2cd5300000752</UniqueId>
