			<Item class="ModuleScript" referent="RBX0000037D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Exclusive session leases prevent a quick rejoin from overwriting newer progress.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Profiles = {}
local LEASE, INTERVAL = 180, 45

function Profiles.new(config, rules)
	local self, states, closing = {}, {}, false
	local studio = RunService:IsStudio()
	local sessionOnly = studio and config.StudioPersistence ~= true
	local store = not sessionOnly and DataStoreService:GetDataStore((studio and "Dev_" or "") .. (config.DataStoreName or "CastawayCove_v1")) or nil
	local function retry(callback)
		for attempt = 1, 3 do
			local ok, result = pcall(callback)
			if ok then return true, result end
			if attempt < 3 then task.wait(attempt) else warn("Castaway Cove save service:", result) end
		end
		return false, nil
	end
	local function decode(raw)
		if raw == nil then return {Schema = 1, Profile = rules.newProfile()} end
		if type(raw) ~= "table" or raw.Schema ~= 1 or type(raw.Profile) ~= "table" then return nil end
		local p = raw.Profile
		if type(p.Coins) ~= "number" or p.Coins ~= p.Coins or p.Coins < 0 or p.Coins >= math.huge
			or type(p.Rod) ~= "number" or type(p.Collection) ~= "table" or type(p.Bag) ~= "table" then return nil end
		if raw.Session ~= nil and (type(raw.Session) ~= "table" or type(raw.Session.Id) ~= "string"
			or type(raw.Session.Expires) ~= "number" or raw.Session.Expires ~= raw.Session.Expires
			or raw.Session.Expires < 0 or raw.Session.Expires >= math.huge) then return nil end
		return raw
	end
	local function usable(s)
		return s and s.Ready and s.Healthy and not s.Removing and not s.Released
			and (sessionOnly or os.time() < s.LeaseUntil)
	end
	local function saveState(s, release)
		if s.Released then return true end
		if s.Lost then return false end
		if sessionOnly then s.Released = release; return true end
		local snapshot = rules.snapshot(s.Profile)
		local writeId = HttpService:GenerateGUID(false)
		local declined = false
		local ok, result = retry(function()
			return store:UpdateAsync(s.Key, function(raw)
				declined = false
				local old = decode(raw)
				-- An ambiguous transport failure can follow a committed write.
				if old and old.WriteId == writeId then
					if release or (old.Session and old.Session.Id == s.Id) then return old end
					declined = true; return nil
				end
				if not old or not old.Session or old.Session.Id ~= s.Id then declined = true; return nil end
				return {Schema = 1, Profile = snapshot, WriteId = writeId,
					Session = not release and {Id = s.Id, Expires = os.time() + LEASE} or nil}, {s.UserId}
			end)
		end)
		if not ok or not result or declined then s.Healthy = false; s.Lost = s.Lost or declined; return false end
		s.Healthy, s.Released = true, release
		if not release then s.LeaseUntil = result.Session.Expires end
		return true
	end
	function self:load(player)
		if closing or states[player] then return false end
		local s = {Key = "Player_" .. player.UserId, UserId = player.UserId,
			Id = game.JobId .. ":" .. HttpService:GenerateGUID(false), Profile = rules.newProfile(),
			Ready = false, Healthy = true, LeaseUntil = 0, Busy = true}
		states[player] = s
		if not sessionOnly then
			local ok, result = retry(function()
				return store:UpdateAsync(s.Key, function(raw)
					local old = decode(raw)
					if not old then return nil end
					if old.Session and old.Session.Id ~= s.Id and old.Session.Expires > os.time() then return nil end
					return {Schema = 1, Profile = old.Profile, WriteId = old.WriteId,
						Session = {Id = s.Id, Expires = os.time() + LEASE}}, {player.UserId}
				end)
			end)
			if not ok or not result or not result.Session or result.Session.Id ~= s.Id then states[player] = nil; return false end
			s.Profile, s.LeaseUntil = rules.sanitize(result.Profile, config), result.Session.Expires
		end
		s.Ready, s.Busy = true, false
		if closing or s.Removing or not player.Parent then
			saveState(s, true); states[player] = nil; return false
		end
		return true
	end
	function self:get(player)
		local s = states[player]
		if s and s.Ready then return s.Profile end
		return nil
	end
	function self:status(player)
		local s = states[player]
		if not s or not s.Ready then return "Loading progress..." end
		if not usable(s) then return "Saving unavailable - progress paused. Reconnect shortly." end
		if sessionOnly then return "Studio practice - progress resets when stopped" end
		return "Autosave on"
	end
	function self:mutate(player, callback)
		local s = states[player]
		if not usable(s) then return false, self:status(player) end
		if s.Busy then return false, "Saving your progress. Try again in a moment." end
		-- Callbacks are server-owned and must not yield.
		s.Busy = true
		local results = table.pack(pcall(callback, s.Profile))
		s.Busy = false
		if not results[1] then warn("Castaway Cove profile action:", results[2]); return false, "Please try that action again." end
		return true, table.unpack(results, 2, results.n)
	end
	function self:save(player, release)
		local s = states[player]
		if not s or not s.Ready then return false end
		if release then s.Removing = true end
		while s.Busy do task.wait() end
		if states[player] ~= s then return false end
		s.Busy = true
		local ok = saveState(s, release == true)
		s.Busy = false
		return ok
	end
	function self:remove(player)
		local s = states[player]
		if not s then return end
		s.Removing = true
		if not s.Ready then return end -- The in-flight loader releases its lease.
		self:save(player, true)
		if states[player] == s then states[player] = nil end
	end
	function self:close()
		closing = true
		local pending, deadline = 0, os.clock() + 25
		for player, s in pairs(states) do
			s.Removing = true
			if s.Ready then
				pending += 1
				task.spawn(function() self:save(player, true); pending -= 1 end)
			end
		end
		local function loading()
			for _, s in pairs(states) do if not s.Ready then return true end end
			return false
		end
		while (pending > 0 or loading()) and os.clock() < deadline do task.wait(0.05) end
	end
	task.spawn(function()
		while not closing do
			task.wait(INTERVAL)
			if closing then break end
			for player, s in pairs(states) do
				if s.Ready and not s.Removing and not s.Released and not s.Lost then task.spawn(function() self:save(player, false) end) end
			end
		end
	end)
	return self
end
return Profiles
]]></ProtectedString>
