			</Item>
			<Item class="ModuleScript" referent="RBX00000376">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Engine-independent domain rules. All mutating calls belong on the server.
local Rules = {}
local MAX_COUNT = 1_000_000_000
local MAX_COINS = 1_000_000_000_000

function Rules.finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function bounded(value: any, low: number, high: number, fallback: number): number
	return if Rules.finite(value) then math.clamp(value, low, high) else fallback
end

function Rules.newProfile(): any
	return {Coins=0, Rod=1, Catches=0, Collection={}, Bag={}, Discovered=0}
end

function Rules.sanitize(raw: any, Config: any): any
	local profile = Rules.newProfile()
	if type(raw) ~= "table" then return profile end
	profile.Coins = math.floor(bounded(raw.Coins, 0, MAX_COINS, 0))
	profile.Rod = math.floor(bounded(raw.Rod, 1, #Config.Rods, 1))
	if type(raw.Collection) == "table" then
		for id, entry in pairs(raw.Collection) do
			local fish = Config.ById[id]
			if fish and type(entry) == "table" then
				local record: any = entry
				local count = math.floor(bounded(record.Count, 0, MAX_COUNT, 0))
				if count > 0 then
					profile.Collection[id] = {Count=count, Best=bounded(record.Best, fish.MinWeight, fish.MaxWeight, fish.MinWeight)}
					profile.Catches += count
					profile.Discovered += 1
				end
			end
		end
	end
	if type(raw.Bag) == "table" then
		for id, entry in pairs(raw.Bag) do
			local fish, known = Config.ById[id], profile.Collection[id]
			if fish and known and type(entry) == "table" then
				local record: any = entry
				local count = math.floor(bounded(record.Count, 0, known.Count, 0))
				if count > 0 then
					profile.Bag[id] = {Count=count, Value=math.floor(bounded(record.Value, count, math.min(MAX_COINS,count * fish.Value * 2), count * fish.Value))}
				end
			end
		end
	end
	return profile
end

function Rules.roll(Config: any, zoneId: string, rodIndex: number, randomUnit: number, randomWeight: number?): (any, number, number)
	if not Config.ZoneById[zoneId] then return nil, 0, 0 end
	local rod = Config.Rods[math.floor(bounded(rodIndex,1,#Config.Rods,1))]
	local total = 0
	for _, fish in ipairs(Config.Fish) do
		if fish.Zone == zoneId then
			local rarity = Config.Rarities[fish.Rarity]
			total += rarity.Weight * rod.Luck ^ (rarity.Rank-1)
		end
	end
	local target = bounded(randomUnit,0,1-1e-12,0) * total
	local selected: any = nil
	for _, fish in ipairs(Config.Fish) do
		if fish.Zone == zoneId then
			selected = fish
			local rarity = Config.Rarities[fish.Rarity]
			target -= rarity.Weight * rod.Luck ^ (rarity.Rank-1)
			if target < 0 then break end
		end
	end
	local weightUnit = bounded(randomWeight, 0, 1, 0.5)
	local weight = math.floor((selected.MinWeight + (selected.MaxWeight-selected.MinWeight)*weightUnit)*100+0.5)/100
	local value = math.max(1, math.floor(selected.Value * (0.8 + 0.6*weight/selected.MaxWeight)))
	return selected, weight, value
end

function Rules.award(profile: any, fish: any, weight: number, value: number): (boolean, number)
	local entry = profile.Collection[fish.Id]
	local isNew = entry == nil
	weight = bounded(weight, fish.MinWeight, fish.MaxWeight, fish.MinWeight)
	value = math.floor(bounded(value,1,fish.Value*2,fish.Value))
	if not entry then entry = {Count=0, Best=0}; profile.Collection[fish.Id] = entry end
	entry.Count = math.min(MAX_COUNT, entry.Count+1)
	entry.Best = math.max(entry.Best,weight)
	local bag = profile.Bag[fish.Id]
	if not bag then bag = {Count=0,Value=0}; profile.Bag[fish.Id] = bag end
	bag.Count = math.min(MAX_COUNT,bag.Count+1)
	bag.Value = math.min(MAX_COINS,bag.Value+value)
	profile.Catches += 1
	if isNew then profile.Discovered += 1 end
	local bonus = if isNew and profile.Discovered % 10 == 0 then 100 else 0
	profile.Coins = math.min(MAX_COINS,profile.Coins+bonus)
	return isNew, bonus
end

function Rules.sell(profile: any): (number, number)
	local count, value = 0, 0
	for _, entry in pairs(profile.Bag) do count += entry.Count; value += entry.Value end
	profile.Coins = math.min(MAX_COINS,profile.Coins+value)
	profile.Bag = {}
	return count, value
end

function Rules.upgrade(profile: any, Config: any): (boolean, string)
	local nextRod = Config.Rods[profile.Rod+1]
	if not nextRod then return false, "Your rod is fully upgraded!" end
	if profile.Coins < nextRod.Cost then return false, string.format("You need %d coins for the %s.",nextRod.Cost,nextRod.Name) end
	profile.Coins -= nextRod.Cost
	profile.Rod += 1
	return true, "Equipped " .. nextRod.Name .. "!"
end

function Rules.canTravel(profile: any, zone: any, Config: any): boolean
	local entry = if type(zone) == "string" then Config.ZoneById[zone] elseif type(zone) == "table" then Config.ZoneById[zone.Id] else nil
	return entry ~= nil and profile.Catches >= entry.Unlock
end

function Rules.marker(now: number, started: number, period: number): number
	if not Rules.finite(now) or not Rules.finite(started) or not Rules.finite(period) or period <= 0 then return 0 end
	return 1-math.abs(((math.max(0,now-started) % period)/period)*2-1)
end

function Rules.snapshot(profile: any): any
	local result = {Coins=profile.Coins,Rod=profile.Rod,Catches=profile.Catches,Discovered=profile.Discovered,Collection={},Bag={}}
	for id, entry in pairs(profile.Collection) do result.Collection[id] = {Count=entry.Count,Best=entry.Best} end
	for id, entry in pairs(profile.Bag) do result.Bag[id] = {Count=entry.Count,Value=entry.Value} end
	return result
end

return Rules
]]></ProtectedString>
